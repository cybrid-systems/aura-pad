;; M3.5: command-helper race on the 3-line goal "hi" / "  aura" / "pad"
;; with the finer editor commands, plus world undo of a KEEP.
;; Fixtures (fixtures/m35/): define gate reject, bad-token heal, worse DROP
;; (kid REJECTs for undo/yank/kill-region/dedent/bob), undo KEEP 43,
;; region tie DROP 43, best KEEP 45, helper-undo x2 (45->43->28) with an
;; honest re-score, helper-undo REJECT when empty, best KEEP again.
;; No HTTP. fiber_live only when every join lands.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/rules.aura")
(load "/workspace/aura-pad/soft/pad/lines.aura")
(load "/workspace/aura-pad/soft/pad/helper.aura")
(load "/workspace/aura-pad/soft/pad/edit.aura")

(define *fail* 0)
(define *fx* "/workspace/aura-pad/soft/pad/fixtures/m35/")

(define (fail! tag)
  (display tag)
  (newline)
  (set! *fail* (+ *fail* 1))
  *fail*)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (pad:nstr got))
  (if (and (number? got) (= got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display (pad:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-str tag got want)
  (display tag)
  (display "=")
  (display got)
  (if (and (string? got) (string=? got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display want)
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (tag-of r)
  (if (and (pair? r) (pair? (cdr r))) (car (cdr r)) "none"))

(define (propose! name want)
  (let ((r (pd:helper-propose-file! (string-append *fx* name))))
    (expect-str (string-append "TAG_" name) (tag-of r) want)
    r))

(define (main-text) (pad:dot-text (pad:es-L *e-state*)))

(define (main)
  (display "DIALECT=live-soft-editor-pad-m35")
  (newline)
  (pad:helper-use-goal3!)
  (expect-str "GOAL" *helper-goal* "goal3")
  (let ((seeded (pd:helper-seed! (pd:clean (read-file (string-append *fx* "main.lambda"))))))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        (display "PAD_M35_FAIL seed\n")
        (begin
          (expect "MAIN_START" *main-score* 28)
          (expect-str "MAIN_TEXT" (main-text) "hi|aura|pad")
          ;; nothing kept yet: undo is refused, world untouched
          (expect-str "UNDO_EMPTY" (tag-of (pd:helper-undo!)) "helper_undo_reject")
          (expect "UNDO_EMPTY_SCORE" *main-score* 28)
          (propose! "bad.lambda" "helper_reject")
          (expect-str "WORD_BAD" *helper-word* "define")
          (propose! "ugly.lambda" "helper_heal")
          (expect-str "HEAL_WHY" *helper-why* "bad-token")
          (propose! "worse.lambda" "helper_drop")
          (expect "WORSE_TRIAL" *helper-trial* 11)
          (propose! "undo.lambda" "helper_keep")
          (expect "UNDO_TRIAL" *helper-trial* 43)
          (expect-str "TEXT_UNDO" (main-text) "hi|..aura|pad")
          (propose! "region.lambda" "helper_drop")
          (expect "REGION_TRIAL" *helper-trial* 43)
          (expect-str "REGION_WHY" *drop-reason* "tie-is-not-better-rollback")
          (propose! "best.lambda" "helper_keep")
          (expect "BEST_BASE" *helper-base* 43)
          (expect "BEST_TRIAL" *helper-trial* 45)
          (expect "MAIN_BEST" *main-score* 45)
          (expect "HISTORY" (length *helper-history*) 2)
          ;; world undo: 45 -> 43 -> 28, then refused
          (expect-str "UNDO_1" (tag-of (pd:helper-undo!)) "helper_undo")
          (expect "UNDO_1_SCORE" *main-score* 43)
          (expect "UNDO_1_STAMP" *e-score* 43)
          (expect-str "UNDO_2" (tag-of (pd:helper-undo!)) "helper_undo")
          (expect "UNDO_2_SCORE" *main-score* 28)
          (expect-str "UNDO_2_TEXT" (main-text) "hi|aura|pad")
          (expect-str "UNDO_3" (tag-of (pd:helper-undo!)) "helper_undo_reject")
          ;; the slots really point at the restored main
          (expect "SLOT_MAIN" (pd:hscore (pd:hshadow)) 28)
          ;; best again: beats the restored 28
          (propose! "best.lambda" "helper_keep")
          (expect "AGAIN_BASE" *helper-base* 28)
          (expect "AGAIN_TRIAL" *helper-trial* 45)
          (expect-str "TEXT_FINAL" (main-text) "hi|..aura|pad")
          (expect "KEEPS" *helper-keeps* 3)
          (expect "DROPS" *helper-drops* 2)
          (expect "UNDOS" *helper-undos* 2)
          (pad:stamp-world!)
          (if (string=? *world-line* "fiber_live")
              (if (not (and (> *race-backend* 0)
                            (= *race-joined* *race-spawned*)
                            (= *race-spawned* 10)))
                  (fail! "WORLD_FAIL"))
              (if (not (string=? *world-line* "host-sequential"))
                  (fail! "WORLD_FAIL")))
          (display "MAIN helper score=")
          (display (pad:nstr *main-score*))
          (display " body=")
          (display *helper-main-body*)
          (newline)
          (if (= *fail* 0)
              (display "PAD_M35_OK\n")
              (display "PAD_M35_FAIL\n"))))))

(main)

;; Step 45. Before KEEP, SAY names the define the change touches.
;; The BLAST count is query:calls. A mismatch leaves the projection.
;; Soft reserved: never bind quote.
(define *pad-home*
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))

(load (string-append *pad-home* "/soft/pad/std.aura"))
(load (string-append *pad-home* "/soft/pad/buffer.aura"))
(load (string-append *pad-home* "/soft/pad/lines.aura"))
(load (string-append *pad-home* "/soft/pad/edit.aura"))
(load (string-append *pad-home* "/soft/pad/hl.aura"))
(load (string-append *pad-home* "/soft/pad/jump.aura"))
(load (string-append *pad-home* "/soft/pad/view.aura"))
(load (string-append *pad-home* "/soft/pad/lc.aura"))
(load (string-append *pad-home* "/soft/pad/keys.aura"))
(load (string-append *pad-home* "/soft/pad/card.aura"))
(load (string-append *pad-home* "/soft/pad/who.aura"))
(load (string-append *pad-home* "/soft/pad/play_in.aura"))
(load (string-append *pad-home* "/soft/pad/vi.aura"))
(load (string-append *pad-home* "/soft/pad/screen.aura"))
(load (string-append *pad-home* "/soft/pad/emacs.aura"))
(load (string-append *pad-home* "/soft/pad/query.aura"))
(load (string-append *pad-home* "/soft/pad/ws.aura"))
(load (string-append *pad-home* "/soft/pad/pen.aura"))
(load (string-append *pad-home* "/soft/pad/why.aura"))
(load (string-append *pad-home* "/soft/pad/ux.aura"))
(load (string-append *pad-home* "/soft/pad/ai.aura"))
(load (string-append *pad-home* "/soft/pad/tx.aura"))

(define page
  (string-append ";; keep this\n\n"
    (string-append "(define (hello x)\n  (+ x 1))\n"
      "(define (main) (hello 3))\n")))

;; The parameter uses the define's name, so the soft site count is
;; one higher than the engine's call list. The score is still higher.
(define shadow
  (string-append "hello=(lambda (hello) (+ hello 2))\n"
    "check hello 3 5\n"))

(define (say s)
  (display s)
  (newline)
  0)

(define (mark m)
  (say (string-append "MARK " m)))

(define (pad:blast-classic?)
  (let ((v (getenv "PAD_CLASSIC")))
    (and (string? v) (string=? v "1"))))

(define (yn b)
  (if b "yes" "no"))

(define (arm!)
  (pad:play-reset! page)
  (set! *pi-collect* #t)
  (set! *ux-lines* (pad:v-lines page))
  (if (string? (try *read-proj* (catch (e) #f)))
      (set! *read-proj* page)
      0)
  (set! *vi-on* #t)
  (set! *vi-mode* "normal")
  (set! *tx-card* #f)
  (set! *tx-better* #f)
  (set! *tx-card-ops* (list))
  (set! *tx-touches* #f)
  (set! *tx-blast-ok* #f)
  0)

(define (shot! ev)
  (let ((p (getenv ev)))
    (if (and (string? p) (> (string-length p) 0))
        (write-file p (pad:tx-page))
        0)))

(define (see! tag)
  (let ((src (pad:tx-page)))
    (say (string-append "CHECK " (string-append tag (string-append " say=" *pl-say*))))
    (say (string-append "CHECK " (string-append tag
          (if (number? *tx-card*) " card=on" " card=off"))))
    (say (string-append "CHECK " (string-append tag
          (if (string=? src page) " page=same" " page=moved"))))
    (say (string-append "CHECK " (string-append tag
          (string-append " comment=" (yn (string-contains? src ";; keep this"))))))
    (say (string-append "CHECK " (string-append tag
          (string-append " old=" (yn (string-contains? src "(define (hello x)"))))))
    (say (string-append "CHECK " (string-append tag
          (string-append " new="
            (yn (string-contains? src "(define hello (lambda (x) (+ x 2)))"))))))
    (say (string-append "CHECK " (string-append tag
          (string-append " main=" (yn (string-contains? src "(define (main)"))))))
    0))

(define (enter!)
  (if (pad:blast-classic?)
      (pad:play-step! "IN 13")
      (pad:ux-key! "IN 13")))

(define (step!)
  (if (pad:blast-classic?)
      (pad:play-step! "IN 9")
      (pad:ux-key! "KEY right")))

(define (run!)
  (set! *ux-keys* 0)
  (arm!)
  (shot! "BLAST_ARROW_BEFORE")
  (mark "arrow-start")
  (pad:tx-propose!)
  (see! "arrow-ready")
  (step!)
  (shot! "BLAST_ARROW_AFTER")
  (see! "arrow")
  (mark "arrow")
  (arm!)
  (shot! "BLAST_KEEP_BEFORE")
  (mark "keep-start")
  (pad:tx-propose!)
  (see! "keep-ready")
  (enter!)
  (shot! "BLAST_KEEP_AFTER")
  (see! "keep")
  (mark "keep")
  (arm!)
  (shot! "BLAST_BAD_BEFORE")
  (mark "bad-start")
  (pad:tx-propose-text! shadow)
  (see! "bad-ready")
  (enter!)
  (shot! "BLAST_BAD_AFTER")
  (see! "bad")
  (mark "bad")
  (say (string-append "CHECK ux-keys=" (number->string *ux-keys*)))
  (if (pad:blast-classic?)
      (say "BLAST_CLASSIC_OK")
      (say "BLAST_SENTENCE_OK")))

(run!)

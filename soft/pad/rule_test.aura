;; Step 58. The sentence tab 4 calls the kid rule command.
;; One swap log carries milliseconds. An out-of-range body heals.
;; Soft reserved: never bind quote.
(define *pad-home*
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))

(load (string-append *pad-home* "/soft/pad/std.aura"))
(load (string-append *pad-home* "/soft/pad/buffer.aura"))
(load (string-append *pad-home* "/soft/pad/lines.aura"))
(load (string-append *pad-home* "/soft/pad/edit.aura"))
(load (string-append *pad-home* "/soft/pad/hl.aura"))
(load (string-append *pad-home* "/soft/pad/jump.aura"))
(load (string-append *pad-home* "/soft/pad/view.aura"))
(load (string-append *pad-home* "/soft/pad/query.aura"))
(load (string-append *pad-home* "/soft/pad/lc.aura"))
(load (string-append *pad-home* "/soft/pad/keys.aura"))
(load (string-append *pad-home* "/soft/pad/ws.aura"))
(load (string-append *pad-home* "/soft/pad/pen.aura"))
(load (string-append *pad-home* "/soft/pad/who.aura"))
(load (string-append *pad-home* "/soft/pad/who_pen.aura"))
(load (string-append *pad-home* "/soft/pad/eng_who.aura"))
(load (string-append *pad-home* "/soft/pad/why.aura"))
(load (string-append *pad-home* "/soft/pad/blast.aura"))
(load (string-append *pad-home* "/soft/pad/robot.aura"))
(load (string-append *pad-home* "/soft/pad/time.aura"))
(load (string-append *pad-home* "/soft/pad/world.aura"))
(load (string-append *pad-home* "/soft/pad/ux.aura"))
(load (string-append *pad-home* "/soft/pad/hot.aura"))
(load (string-append *pad-home* "/soft/pad/tx.aura"))

(define *ru-fail* 0)

(define *ru-page*
  (string-append
    "(define (tab-size) 2)\n"
    "(define (say-max) 120)\n"
    "(define (indent n) (* n (tab-size)))\n"))

(define (ru:check tag ok)
  (set! *ru-fail* (if ok *ru-fail* (+ *ru-fail* 1)))
  (display "CHECK ")
  (display tag)
  (display "=")
  (display (if ok "ok" "fail"))
  (newline))

(define (ru:has? s xs)
  (cond
    ((null? xs) #f)
    ((string=? s (car xs)) #t)
    (#t (ru:has? s (cdr xs)))))

(define (ru:fp)
  (let ((nid (pad:ew-nid "tab-size")))
    (if nid
        (try (hash-ref (query:node-provenance nid) "author-fingerprint")
             (catch (e) -1))
        -1)))

(define (ru:tab)
  (try (tab-size) (catch (e) -1)))

(define (ru:run)
  (ru:check "intent-tab" (string=? (car (pad:say-intent "tab 4")) "tab"))
  (ru:check "intent-bare" (string=? (car (pad:say-intent "tab")) "later"))
  (ru:check "intent-table" (string=? (car (pad:say-intent "table 4")) "later"))
  (ru:check "intent-nope" (string=? (car (pad:say-intent "nope")) "later"))
  (ru:check "bound-before" (not (try pad:kr-cmd! (catch (e) #f))))
  (pad:play-reset! *ru-page*)
  (pad:who-reset!)
  (set! *pen-undo* (list))
  (set! *robot-undo* (list))
  (set! *who-keep-codes* (list))
  (ru:check "load" (string=? (car (pad:who-check!)) "ok"))
  (set! *ux-focus* "line")
  (set! *ux-line* "tab 4")
  (pad:say-run!)
  (ru:check "bound-after" (if (try pad:kr-cmd! (catch (e) #f)) #t #f))
  (ru:check "verdict" (and (pair? *kr-last*) (string=? (car *kr-last*) "KEEP")))
  (ru:check "value" (= (ru:tab) 4))
  (ru:check "say" (and (string? *pl-say*)
                       (string-contains? *pl-say* "4")
                       (string-contains? *pl-say* "indent")))
  (ru:check "fp" (= (ru:fp) 1))
  (ru:check "who" (string=? (pad:ew-who-of (ru:fp)) "kid"))
  (ru:check "pen" (not (ru:has? "kid" *pen-whos*)))
  (ru:check "swaps" (= *hs-rule-swaps* 1))
  (display "NOTE say=")
  (display *pl-say*)
  (newline)
  (set! *ux-line* "tab 40")
  (pad:say-run!)
  (ru:check "heal-value" (= (ru:tab) 4))
  (ru:check "heal-say" (and (string? *pl-say*)
                            (string-contains? *pl-say* "heal")
                            (string-contains? *pl-say* "4")))
  (ru:check "heals" (= *hs-rule-heals* 1))
  (ru:check "fp-kept" (= (ru:fp) 1))
  (ru:check "who-kept" (string=? (pad:ew-who-of (ru:fp)) "kid"))
  (display "NOTE heal=")
  (display *pl-say*)
  (newline))

(ru:run)
(if (= *ru-fail* 0)
    (display "RULE_UNIT_OK\n")
    (begin
      (display "RULE_UNIT_FAIL ")
      (display *ru-fail*)
      (newline)))

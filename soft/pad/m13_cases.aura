;; aura-pad M13 test cases (aura notebook), loaded by m13_test.aura.
;; Soft reserved: never bind quote.

(define *m13-fail* 0)
(define *m13-checks* 0)
(define *m13-acc0* 0)
(define *m13-page* "(define (hello x) (+ x 1))\n(hello 3)")

(define (m13:mark! ok tag shown want)
  (set! *m13-checks* (+ *m13-checks* 1))
  (newline)
  (display "T ") (display tag) (display "=") (display shown)
  (if ok (display " OK")
      (begin (display " WANT=") (display want) (set! *m13-fail* (+ *m13-fail* 1))))
  (newline)
  ok)
(define (m13:expect tag got want)
  (m13:mark! (and (number? got) (= got want)) tag
             (if (number? got) (number->string got) "?") (number->string want)))
(define (m13:expect-str tag got want)
  (m13:mark! (and (string? got) (string=? got want)) tag
             (if (string? got) got "?") want))
(define (m13:expect-true tag got)
  (m13:expect-str tag (if got "yes" "no") "yes"))
(define (m13:nth xs i)
  (if (or (null? xs) (< i 0)) #f
      (if (= i 0) (car xs) (m13:nth (cdr xs) (- i 1)))))

(define (m13:acc-begin!) (set! *m13-acc0* *m13-fail*))
(define (m13:acc-end! n)
  (newline)
  (display "M13_ACC ") (display (number->string n))
  (display (if (= *m13-fail* *m13-acc0*) " OK" " FAIL"))
  (newline))

;; M13.1 pad + HL tape kinds
(define (m13:sec-1)
  (m13:acc-begin!)
  (pad:aura-page! *m13-page*)
  (m13:expect-str "PAD" *aura-pad-name* "aura")
  (let ((tape (pad:aura-tape))
        (kinds (pad:aura-kinds-seen)))
    (m13:expect-true "TAPE_LEN" (>= (string-length tape) (string-length *m13-page*)))
    (m13:expect-true "KIND_P" (string-contains? kinds "P"))
    (m13:expect-true "KIND_K" (string-contains? kinds "K"))
    (m13:expect-true "KIND_S" (string-contains? kinds "S"))
    (m13:expect-true "KIND_N" (string-contains? kinds "N"))
    (m13:expect-str "KINDS" kinds "PKSN"))
  (m13:acc-end! 1)
  #t)

;; M13.2 jump Soft HL; with workspace, engine define-lookup is consulted
(define (m13:sec-2)
  (m13:acc-begin!)
  (pad:aura-page! *m13-page*)
  (let* ((use 28)
         (j (pad:js-at *m13-page* use))
         (r (pad:aura-goto! j)))
    (m13:expect-str "GOTO_SOFT" (car r) "ok")
    (m13:expect "GOTO_SOFT_PT" (cadr r) 9)
    (m13:expect-str "JUMP_SRC_SOFT" *pad-jump-src* "hl"))
  (m13:expect-true "WS_LOAD" (pad:aura-ws-load! *m13-page*))
  (let* ((use 28)
         (j (pad:js-at *m13-page* use))
         (r (pad:aura-goto! j)))
    (m13:expect-str "GOTO_WS" (car r) "ok")
    (m13:expect "GOTO_WS_PT" (cadr r) 9)
    ;; tip define-lookup line/col is 0 (#4347) → Soft HL places cursor
    (m13:expect-true "JUMP_SRC_WS"
                     (or (string=? *pad-jump-src* "hl")
                         (string=? *pad-jump-src* "hl+engine")
                         (string=? *pad-jump-src* "engine"))))
  (m13:acc-end! 2)
  #t)

;; M13.3 hygienic play gap → refuse mutate
(define (m13:sec-3)
  (m13:acc-begin!)
  (let ((g (pad:aura-probe!)))
    (pad:aura-gaps-line!)
    (m13:expect-str "GAPS" g "GAPS hygienic-play")
    (m13:expect-str "GAPS_NAME" *aura-gaps* "hygienic-play")
    (m13:expect-true "NO_HYGIENIC" (not *aura-hygienic*)))
  (let ((r (pad:aura-hygienic-play! "(define (kid-name x) x)")))
    (m13:expect-str "REFUSE" (car r) "REFUSE")
    (m13:expect-str "REFUSE_SAY" (cadr r) "hygienic play is not ready, nothing changed")
    (m13:expect "REFUSES" *aura-refuses* 1))
  (m13:acc-end! 3)
  #t)

;; M13.4 fixture race: good (+ x 1) KEEP path, bad (* x 2) DROP
(define (m13:sec-4)
  (m13:acc-begin!)
  (let ((r (pad:aura-fixture-race! "(+ x 1)" "(* x 2)")))
    (newline) (display "FIXTURE ") (display r) (newline)
    (m13:expect-str "RACE" (car r) "RACE")
    (m13:expect-str "GOOD" (cadr r) "KEEP")
    (m13:expect-str "BAD" (caddr r) "DROP")
    (m13:expect "GOOD_SCORE" (m13:nth r 3) 1)
    (m13:expect "BAD_SCORE" (m13:nth r 4) 0))
  (m13:acc-end! 4)
  #t)

(define (m13:intro)
  (newline)
  (display "M13 aura notebook on Soft tip")
  (newline)
  #t)

(define (m13:outro)
  (pad:aura-stats-line!)
  (newline)
  (display "TESTS checks=") (display (number->string *m13-checks*))
  (display " fail=") (display (number->string *m13-fail*))
  (newline)
  (if (= *m13-fail* 0)
      (begin (display "PAD_M13_TEST_OK") (newline))
      (begin (display "PAD_M13_TEST_FAIL") (newline)))
  #t)

(define (m13:run-all)
  (m13:intro)
  (m13:sec-1)
  (m13:sec-2)
  (m13:sec-3)
  (m13:sec-4)
  (m13:outro)
  #t)

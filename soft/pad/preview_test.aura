;; M16 preview windows. Prints PAD_M16_OK or PAD_M16_FAIL.
;; Soft reserved: never bind quote.
(define *pad-home*
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))
(load (string-append *pad-home* "/soft/pad/buffer.aura"))
(load (string-append *pad-home* "/soft/pad/lines.aura"))
(load (string-append *pad-home* "/soft/pad/edit.aura"))
(load (string-append *pad-home* "/soft/pad/hl.aura"))
(load (string-append *pad-home* "/soft/pad/jump.aura"))
(load (string-append *pad-home* "/soft/pad/view.aura"))
(load (string-append *pad-home* "/soft/pad/lc.aura"))
(load (string-append *pad-home* "/soft/pad/keys.aura"))
(load (string-append *pad-home* "/soft/pad/card.aura"))
(load (string-append *pad-home* "/soft/pad/who.aura"))
(load (string-append *pad-home* "/soft/pad/play_in.aura"))
(load (string-append *pad-home* "/soft/pad/vi.aura"))
(load (string-append *pad-home* "/soft/pad/screen.aura"))
(load (string-append *pad-home* "/soft/pad/emacs.aura"))
(load (string-append *pad-home* "/soft/pad/file.aura"))
(load (string-append *pad-home* "/soft/pad/win.aura"))

(define *fail* 0)
(define *checks* 0)

(define (pt-ok tag)
  (set! *checks* (+ *checks* 1))
  (display "T ") (display tag) (display " OK") (newline))

(define (pt-bad tag got)
  (set! *checks* (+ *checks* 1))
  (set! *fail* (+ *fail* 1))
  (display "T ") (display tag) (display " FAIL ") (display got) (newline))

(define (pt-eq tag got want)
  (if (equal? got want) (pt-ok tag) (pt-bad tag got)))

(define (pt-has tag s needle)
  (pt-eq tag (if (string-contains? s needle) 1 0) 1))

(define (pt-named? store name)
  (cond
    ((null? store) 0)
    ((string=? (car (car store)) name) 1)
    (#t (pt-named? (cdr store) name))))

(pt-eq "quiet" (if *pv-ready* 1 0) 0)
(pad:play-reset! "ab")
(set! *vi-on* #t)
(pad:play-step! "IN 108")
(pt-eq "quiet-key" (if *pv-ready* 1 0) 0)
(display "LATENCY before=insert 3.6 ms, cursor 1.3 ms, twelve-row page, docs/ROADMAP.md. preview is not on the key path.")
(newline)

;; The first preview command loads the file. A letter never does.
(pad:play-reset! "hello")
(set! *vi-on* #t)
(set! *vw-rows* 16)
(set! *vw-cols* 40)
(pt-eq "hook" (pad:wn-command "preview" "hi\naura") "vi-do")
(pt-eq "hook-ready" (if *pv-ready* 1 0) 1)
(pt-eq "hook-say" *pl-say* "Look, the helper made a new page next to yours!")
(display *pl-say*)
(newline)

(load (string-append *pad-home* "/soft/pad/preview.aura"))
(pt-eq "ready" (if *pv-ready* 1 0) 1)

(define (pt-page! src)
  (pad:wn-reset!)
  (pad:play-reset! src)
  (set! *vi-on* #t)
  (set! *vw-rows* 16)
  (set! *vw-cols* 40)
  (set! *pv-on* #f)
  (set! *pv-hist* (list))
  0)

(pt-page! "hello")
(let ((n (length *wn-store*)))
  (pt-eq "ban" (pad:pv-open! "please eval this") "reject")
  (pt-eq "ban-say" *pl-say* "the helper is not allowed to do that")
  (pt-eq "ban-on" (if *pv-on* 1 0) 0)
  (pt-eq "ban-many" (if (pad:wn-many?) 1 0) 0)
  (pt-eq "ban-store" (length *wn-store*) n)
  (pt-eq "ban-name" (pt-named? *wn-store* "preview") 0))

(pt-eq "mean" (pad:pv-open! "you are stupid") "reject")
(pt-eq "mean-say" *pl-say* "that is not a kind page")
(pt-eq "mean-on" (if *pv-on* 1 0) 0)

(pt-eq "nope" (pad:pv-open! "do exec") "reject")
(pt-eq "nope-say" *pl-say* "the helper is not allowed to do that")

(pt-eq "empty" (pad:pv-open! "") "reject")
(pt-eq "empty-say" *pl-say* "the helper had nothing to show")

(pt-eq "odd" (pad:pv-open! "a\tb") "reject")
(pt-eq "odd-say" *pl-say* "the helper had nothing to show")

(pt-eq "big" (pad:pv-open! "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "reject")
(pt-eq "big-say" *pl-say* "that page would be too big")
(pt-eq "big-on" (if *pv-on* 1 0) 0)

(set! *vw-cols* 10)
(pt-eq "tiny" (pad:pv-open! "hi\naura") "reject")
(pt-eq "tiny-say" *pl-say* "that page would be too tiny")
(pt-eq "tiny-on" (if *pv-on* 1 0) 0)
(set! *vw-cols* 40)

(pt-page! "hello")
(pt-eq "open" (pad:pv-open! "hi\naura") "open")
(pt-eq "look" *pl-say* "Look, the helper made a new page next to yours!")
(display *pl-say*)
(newline)
(pt-eq "many" (if (pad:wn-many?) 1 0) 1)
(pt-eq "main" (pad:play-src) "hello")
(pt-eq "live" (string=? *wn-live* "preview") #f)
(pt-eq "sel" *wn-sel* (car (cadr *wn-tree*)))
(pt-eq "ded" (list-ref (caddr *wn-tree*) 6) 1)
(pt-eq "st" (list-ref (caddr *wn-tree*) 7) 1)
(pt-eq "who" (list-ref (caddr *wn-tree*) 8) "helper")
(pt-eq "side-w" (list-ref (cadr (pad:wn-place *wn-tree* 0 0 16 40)) 4) 12)
(pt-has "snap" (pad:vw-frame (pad:play-snap)) "st=1 wh=1")
(pt-has "snap-text" (pad:vw-frame (pad:play-snap)) "hi")

(pt-eq "stay-key" (pad:wn-other!) "vi-do")
(pt-eq "stay-say" *pl-say* "that page is the helper")
(pt-eq "stay-src" (pad:play-src) "hello")

(set! *wn-sel* (car (caddr *wn-tree*)))
(pt-eq "ded-sw" (pad:wn-switch! "story") "vi-do")
(pt-eq "ded-say" *pl-say* "that page stays")
(pt-eq "ded-name" (cadr (caddr *wn-tree*)) "preview")
(set! *wn-sel* (car (cadr *wn-tree*)))

(pt-eq "only" (pad:wn-delete!) "vi-do")
(pt-eq "only-say" *pl-say* "this is the only page")
(pt-eq "only-on" (if *pv-on* 1 0) 1)

(pt-eq "keep" (pad:pv-keep!) "keep")
(pt-eq "kept" (pad:play-src) "hi\naura")
(pt-eq "kept-say" *pl-say* "your page kept the new one!")
(display *pl-say*)
(newline)
(pt-eq "kept-on" (if *pv-on* 1 0) 0)
(pt-eq "kept-one" (if (pad:wn-many?) 1 0) 0)
(pt-eq "kept-name" (pt-named? *wn-store* "preview") 0)

(pt-eq "undo" (pad:pv-undo!) "undo")
(pt-eq "undo-src" (pad:play-src) "hello")
(pt-eq "undo-say" *pl-say* "took back the last keep")

(pt-page! "hello")
(pad:pv-open! "hi\naura")
(pt-eq "bad-undo" (pad:pv-undo-mismatch!) "reject")
(pad:pv-keep!)
(pt-eq "mis" (pad:pv-undo-mismatch!) "fail")

(pt-page! "hi\naura")
(pt-eq "worse-open" (pad:pv-open! "hello") "open")
(pt-eq "worse" (pad:pv-keep!) "drop")
(pt-eq "worse-src" (pad:play-src) "hi\naura")
(pt-eq "worse-on" (if *pv-on* 1 0) 0)
(pt-eq "worse-say" *pl-say* "keeping your page")
(display *pl-say*)
(newline)

(pt-page! "hello")
(pt-eq "tie-open" (pad:pv-open! "hello") "open")
(pt-eq "tie" (pad:pv-keep!) "drop")
(pt-eq "tie-src" (pad:play-src) "hello")
(pt-eq "tie-on" (if *pv-on* 1 0) 0)

(pt-page! "hello")
(pad:pv-open! "hi\naura")
(pt-eq "quit" (pad:pv-drop!) "drop")
(pt-eq "quit-src" (pad:play-src) "hello")
(pt-eq "quit-on" (if *pv-on* 1 0) 0)
(pt-eq "quit-say" *pl-say* "keeping your page")

(pt-eq "cmd" (pad:pv-run! "preview" "hi\naura") "vi-do")
(pt-eq "cmd-say" *pl-say* "Look, the helper made a new page next to yours!")
(pt-eq "cmd-keep" (pad:pv-run! "preview:keep" "") "vi-do")
(pt-eq "cmd-src" (pad:play-src) "hi\naura")

(pt-has "map-look" (pad:wn-map "page") "Look, the helper made a new page next to yours!")
(pt-has "map-keep" (pad:wn-map "page") "preview:keep")
(pt-has "map-drop" (pad:wn-map "page") "preview:drop")

(display "CHECKS ") (display *checks*)
(display " FAIL ") (display *fail*) (newline)
(if (= *fail* 0)
    (display "PAD_M16_OK")
    (display "PAD_M16_FAIL"))
(newline)

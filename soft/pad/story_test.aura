;; M17 living storybook. Prints PAD_M17_OK or PAD_M17_FAIL.
;; Soft reserved: never bind quote.
(define *pad-home*
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))
(load (string-append *pad-home* "/soft/pad/buffer.aura"))
(load (string-append *pad-home* "/soft/pad/lines.aura"))
(load (string-append *pad-home* "/soft/pad/edit.aura"))
(load (string-append *pad-home* "/soft/pad/hl.aura"))
(load (string-append *pad-home* "/soft/pad/jump.aura"))
(load (string-append *pad-home* "/soft/pad/view.aura"))
(load (string-append *pad-home* "/soft/pad/lc.aura"))
(load (string-append *pad-home* "/soft/pad/keys.aura"))
(load (string-append *pad-home* "/soft/pad/card.aura"))
(load (string-append *pad-home* "/soft/pad/who.aura"))
(load (string-append *pad-home* "/soft/pad/play_in.aura"))
(load (string-append *pad-home* "/soft/pad/vi.aura"))
(load (string-append *pad-home* "/soft/pad/screen.aura"))
(load (string-append *pad-home* "/soft/pad/emacs.aura"))
(load (string-append *pad-home* "/soft/pad/file.aura"))
(load (string-append *pad-home* "/soft/pad/win.aura"))

(define *fail* 0)
(define *checks* 0)

(define (st-ok tag)
  (set! *checks* (+ *checks* 1))
  (display "T ") (display tag) (display " OK") (newline))

(define (st-bad tag got)
  (set! *checks* (+ *checks* 1))
  (set! *fail* (+ *fail* 1))
  (display "T ") (display tag) (display " FAIL ") (display got) (newline))

(define (st-eq tag got want)
  (if (equal? got want) (st-ok tag) (st-bad tag got)))

(define (st-has tag s needle)
  (st-eq tag (if (string-contains? s needle) 1 0) 1))

(define (st-h-of rects)
  (if (null? rects)
      0
      (if (= (car (car (car rects))) *wn-sel*)
          (list-ref (car rects) 3)
          (st-h-of (cdr rects)))))

(define (st-sel-h)
  (st-h-of (pad:wn-place *wn-tree* 0 0 (pad:wn-rows) (pad:wn-cols))))

(st-eq "quiet" (if *sb-ready* 1 0) 0)
(pad:play-reset! "ab")
(set! *vi-on* #t)
(pad:play-step! "IN 108")
(st-eq "quiet-key" (if *sb-ready* 1 0) 0)
(display "LATENCY before=insert 3.6 ms, cursor 1.3 ms, twelve-row page, docs/ROADMAP.md. storybook is not on the key path.")
(newline)

;; The first story command loads the file. A letter never does.
(pad:wn-reset!)
(pad:play-reset! "hello hello")
(set! *vi-on* #t)
(set! *vw-rows* 16)
(set! *vw-cols* 40)
(set! *wn-live* "story")
(set! *wn-store* (list (list "story" (car *pl-st*))))
(pad:wn-split! "V")
(st-eq "hook" (pad:wn-command "story:grow" "") "vi-do")
(st-eq "hook-ready" (if *sb-ready* 1 0) 1)
(st-eq "hook-say" *pl-say* "this page is growing!")
(display *pl-say*)
(newline)
(st-eq "hook-ratio" (pad:wn-ratio *wn-tree*) 60)

(pad:sb-arm! "hello hello")
(pad:wn-split! "V")
(let ((h0 (st-sel-h)))
  (st-eq "grow" (pad:sb-grow!) "grow")
  (st-eq "grow-say" *pl-say* "this page is growing!")
  (display *pl-say*)
  (newline)
  (st-eq "grow-taller" (if (> (st-sel-h) h0) 1 0) 1)
  (st-eq "grow-hist" (length *ly-hist*) 0)
  (st-eq "grow-ratio" (pad:wn-ratio *wn-tree*) 60))

(pad:sb-arm! "h")
(pad:wn-split! "V")
(let ((h0 (st-sel-h)))
  (st-eq "shrink" (pad:sb-shrink!) "grow")
  (st-eq "shrink-shorter" (if (< (st-sel-h) h0) 1 0) 1)
  (st-eq "shrink-hist" (length *ly-hist*) 0))

(pad:sb-arm! "h")
(set! *vw-cols* 20)
(pad:wn-split! "H")
(let ((ratio (pad:wn-ratio *wn-tree*))
      (hist (length *ly-hist*))
      (sel *wn-sel*))
  (st-eq "big" (pad:sb-resize! 40) "reject")
  (st-eq "big-say" *pl-say* "that page would be too big")
  (display *pl-say*)
  (newline)
  (st-eq "big-ratio" (pad:wn-ratio *wn-tree*) ratio)
  (st-eq "big-hist" (length *ly-hist*) hist)
  (st-eq "big-sel" *wn-sel* sel)
  (st-eq "tiny" (pad:sb-resize! -40) "reject")
  (st-eq "tiny-say" *pl-say* "that page would be too tiny")
  (display *pl-say*)
  (newline)
  (st-eq "tiny-ratio" (pad:wn-ratio *wn-tree*) ratio)
  (st-eq "tiny-hist" (length *ly-hist*) hist))

(pad:sb-arm! "hi\naur")
(pad:wn-split! "V")
(st-eq "mood" (pad:sb-mood!) "mood")
(st-eq "mood-say" *pl-say* "almost there!")
(display *pl-say*)
(newline)
(st-eq "mood-st" (list-ref (pad:wn-find *wn-tree* *wn-sel*) 7) 1)
(st-eq "mood-hist" (length *ly-hist*) 0)

(pad:sb-arm! "hello")
(st-eq "far" (pad:sb-cheer!) "reject")
(st-eq "far-say" *pl-say* "keep writing, you are not there yet")
(st-eq "far-one" (if (pad:wn-many?) 1 0) 0)
(st-eq "far-hist" (length *ly-hist*) 0)

(pad:sb-arm! "hi\naura")
(st-eq "cheer" (pad:sb-cheer!) "keep")
(st-eq "cheer-say" *pl-say* "celebration page opened")
(display *pl-say*)
(newline)
(st-eq "cheer-n" (pad:wn-count *wn-tree*) 4)
(st-eq "cheer-ded" (pad:wn-nded *wn-tree*) 4)
(st-eq "cheer-st" (list-ref (pad:wn-find *wn-tree* *wn-sel*) 7) 2)
(st-eq "cheer-src" (pad:play-src) "hi\naura")
(let ((s (pad:vw-frame (pad:play-snap))))
  (display "ORACLE line=")
  (display (pad:nstr (cadr *pl-st*)))
  (display " col=")
  (display (pad:nstr (caddr *pl-st*)))
  (display " top=")
  (display (pad:nstr *vw-top*))
  (display " left=")
  (display (pad:nstr *vw-left*))
  (newline)
  (display s)
  (st-has "cheer-snap" s "WINS n=4")
  (st-has "cheer-who" s "wh=0")
  (st-has "cheer-style" s "st=2"))

(st-eq "undo" (pad:sb-undo!) "undo")
(st-eq "undo-one" (if (pad:wn-many?) 1 0) 0)
(st-eq "undo-src" (pad:play-src) "hi\naura")
(st-eq "undo-say" *pl-say* "took back the last keep")

(pad:sb-arm! "hi\naura")
(pad:sb-cheer!)
(st-eq "mis" (pad:sb-undo-mismatch!) "fail")

(pad:sb-arm! "hi\naura")
(pad:sb-cheer!)
(let ((id *wn-sel*))
  (st-eq "flip" (pad:sb-run! "flip" "") "vi-do")
  (st-eq "flip-say" *pl-say* "now this page")
  (st-eq "flip-moved" (if (= *wn-sel* id) 1 0) 0)
  (st-eq "flip-src" (pad:play-src) "the cat")
  (st-eq "flip-ded" (if (pad:wn-ded? (pad:wn-find *wn-tree* *wn-sel*)) 1 0) 0))

(pad:sb-arm! "h")
(pad:wn-split! "V")
(st-eq "step" (pad:sb-run! "story" "") "vi-do")
(st-eq "step-shorter" (if (< (pad:wn-ratio *wn-tree*) 50) 1 0) 1)

(st-has "map-grow" (pad:wn-map "page") "this page is growing!")
(st-has "map-mood" (pad:wn-map "page") "almost there!")
(st-has "map-cheer" (pad:wn-map "page") "celebration page opened")
(st-has "map-flip" (pad:wn-map "page") "flip")
(st-has "map-undo" (pad:wn-map "page") "story:undo")

(display "CHECKS ") (display *checks*)
(display " FAIL ") (display *fail*) (newline)
(if (= *fail* 0)
    (display "PAD_M17_OK")
    (display "PAD_M17_FAIL"))
(newline)

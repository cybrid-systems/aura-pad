;; aura-pad per-key breakdown probe (docs/perf.md, docs/perf-emacs.md).
;; Prints one PROBE line of microseconds per key on the 12-row page, the
;; harness cost (rep + thunk calls) already subtracted. Not a gate: the
;; gates live in perf.aura / emacs_test.aura. Uses only play-level API,
;; so the same file runs on older trees for before/after tables.
;; bash scripts/run_soft.sh /workspace/aura-pad/soft/pad/perf_probe.aura
;; Soft reserved: never bind quote.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/lines.aura")
(load "/workspace/aura-pad/soft/pad/edit.aura")
(load "/workspace/aura-pad/soft/pad/hl.aura")
(load "/workspace/aura-pad/soft/pad/jump.aura")
(load "/workspace/aura-pad/soft/pad/view.aura")
(load "/workspace/aura-pad/soft/pad/lc.aura")
(load "/workspace/aura-pad/soft/pad/keys.aura")
(define (pp:now) (current-time-ms))
(define (pp:rep n th) (if (> n 0) (begin (th) (pp:rep (- n 1) th)) 0))
(define (pp:us n th)
  (let ((t0 (pp:now))) (pp:rep n th) (quotient (* 1000 (- (pp:now) t0)) n)))
(define pp-base (pp:us 400 (lambda () 0)))
(define (pp:net n th) (- (pp:us n th) pp-base))
(define (pp:goto! row col)
  (pad:play-reset! *lc-big-page*)
  (pp:rep row (lambda () (pad:play-cmd! "next-line")))
  (pad:play-cmd! "home")
  (pp:rep col (lambda () (pad:play-cmd! "right")))
  (pad:play-snap))
(define (pp:key c) (pad:play-cmd! c) (pad:play-snap))
;; one Soft procedure call with the pad loaded (Aura #4343 / #4350)
(define u-call (pp:net 400 (lambda () (pad:lc-k "a" 0))))
;; re-tokenize one 28-char row from scratch
(define u-tok (pp:net 20 (lambda () (pad:lc-line-toks "(define (greet n) (add n 1))"))))
;; end of row 6 "(hello 3)": type a / backspace, pairs -> per key
(pp:goto! 6 9)
(define u-cmd (quotient (pp:net 20 (lambda () (pad:play-cmd! 97) (pad:play-cmd! "back"))) 2))
(pp:goto! 6 9)
(define u-ins (quotient (pp:net 20 (lambda () (pp:key 97) (pp:key "back"))) 2))
(define u-same (pp:net 20 (lambda () (pad:play-snap))))
;; cursor left/right where the name under the cursor stays "" (try_cursor_movement)
(pp:goto! 6 9)
(define u-cur (quotient (pp:net 20 (lambda () (pp:key "left") (pp:key "right"))) 2))
;; cursor between "(" and "hello" on row 11: marks move on 5 rows
(pp:goto! 11 0)
(define u-name (quotient (pp:net 10 (lambda () (pp:key "right") (pp:key "left"))) 2))
;; generic frame: enter / join on the small page
(pad:play-reset! *play-start*)
(pad:play-cmd! "end")
(pad:play-snap)
(define u-enter (quotient (pp:net 6 (lambda () (pp:key "enter") (pp:key "back"))) 2))
;; string open/close at the end of row 4 (rows below change syntax
;; state; the M7 tree re-lexed the whole page here), then typing inside
;; the open string
(pp:goto! 4 18)
(define u-full (quotient (pp:net 4 (lambda () (pp:key 34) (pp:key "back"))) 2))
(pp:goto! 4 18)
(pp:key 34)
(define u-instr (quotient (pp:net 3 (lambda () (pp:key 97) (pp:key "back"))) 2))
(display "PROBE harness_us=") (display pp-base)
(display " call_us=") (display u-call)
(display " line_tok_us=") (display u-tok)
(display " cmd_insert_us=") (display u-cmd)
(display " key_insert_us=") (display u-ins)
(display " snap_nochange_us=") (display u-same)
(display " key_cursor_us=") (display u-cur)
(display " key_cursor_marks_us=") (display u-name)
(display " key_enter_join_us=") (display u-enter)
(display " key_open_string_us=") (display u-full)
(display " key_in_open_string_us=") (display u-instr)
(newline)

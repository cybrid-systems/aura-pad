;; aura-pad per-key breakdown probe (docs/perf.md "Where one key goes").
;; Prints one PROBE line of microsecond costs on the 12-row page. Not a gate.
;; bash scripts/run_soft.sh /workspace/aura-pad/soft/pad/perf_probe.aura
;; Soft reserved: never bind quote.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/lines.aura")
(load "/workspace/aura-pad/soft/pad/edit.aura")
(load "/workspace/aura-pad/soft/pad/hl.aura")
(load "/workspace/aura-pad/soft/pad/jump.aura")
(load "/workspace/aura-pad/soft/pad/view.aura")
(load "/workspace/aura-pad/soft/pad/lc.aura")
(load "/workspace/aura-pad/soft/pad/keys.aura")
(define (now) (current-time-ms))
(define (rep n th) (if (> n 0) (begin (th) (rep (- n 1) th)) 0))
(define (us n th) (let ((t0 (now))) (rep n th) (quotient (* 1000 (- (now) t0)) n)))
(define row "(define (greet n) (add n 1))")
(define (setup!)
  (pad:play-reset! *lc-big-page*)
  (rep 6 (lambda () (pad:play-cmd! "next-line")))
  (pad:play-cmd! "end") (pad:play-cmd! 120) (pad:play-snap))
(setup!)
(define u-floor (us 2000 (lambda () (pad:lc-k "a" 0))))
(define u-empty (us 2000 (lambda () 0)))
(define u-tok (us 50 (lambda () (pad:lc-line-toks row))))
(define u-entry (us 50 (lambda () (pad:lc-entry (pad:type-codes row)))))
(define u-snap-same (us 20 (lambda () (pad:play-snap))))
(define u-left (us 20 (lambda () (pad:play-cmd! "left") (pad:play-cmd! "right"))))
(define u-ins-cmd (us 20 (lambda () (pad:play-cmd! 97))))
(setup!)
(define u-ins-key (us 20 (lambda () (pad:play-cmd! 97) (pad:play-snap))))
(setup!)
(define u-frame-ins (us 20 (lambda () (pad:play-cmd! 97)
  (pad:lc-frame! (pad:es-L *pl-st*) (pad:es-l *pl-st*) (pad:es-col *pl-st*)))))
(define u-join (us 50 (lambda () (apply string-append (vector->list *lc-rowv*)))))
(display "PROBE floor_call_us=") (display u-floor)
(display " empty_thunk_us=") (display u-empty)
(display " line_tok_us=") (display u-tok)
(display " line_entry_us=") (display u-entry)
(display " snap_nochange_us=") (display u-snap-same)
(display " cursor_cmd_pair_us=") (display u-left)
(display " insert_cmd_us=") (display u-ins-cmd)
(display " insert_key_us=") (display u-ins-key)
(display " insert_cmd_plus_frame_us=") (display u-frame-ins)
(display " rows_join_us=") (display u-join)
(newline)

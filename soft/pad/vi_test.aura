;; Vi normal / insert and emacs ctrl-b f p n. Runs the play key path
;; (play_in.aura + vi.aura) without PAD_VI, then turns the mode on
;; itself. Prints PAD_VI_TEST_OK or PAD_VI_TEST_FAIL.
;; Soft reserved: never bind quote.
(define *pad-home*
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))
(load (string-append *pad-home* "/soft/pad/buffer.aura"))
(load (string-append *pad-home* "/soft/pad/lines.aura"))
(load (string-append *pad-home* "/soft/pad/edit.aura"))
(load (string-append *pad-home* "/soft/pad/hl.aura"))
(load (string-append *pad-home* "/soft/pad/jump.aura"))
(load (string-append *pad-home* "/soft/pad/view.aura"))
(load (string-append *pad-home* "/soft/pad/lc.aura"))
(load (string-append *pad-home* "/soft/pad/keys.aura"))
(load (string-append *pad-home* "/soft/pad/card.aura"))
(load (string-append *pad-home* "/soft/pad/who.aura"))
(load (string-append *pad-home* "/soft/pad/play_in.aura"))
(load (string-append *pad-home* "/soft/pad/vi.aura"))
(load (string-append *pad-home* "/soft/pad/screen.aura"))
(load (string-append *pad-home* "/soft/pad/emacs.aura"))

(define *fail* 0)
(define *checks* 0)

(define (vt-ok tag)
  (set! *checks* (+ *checks* 1))
  (display "T ") (display tag) (display " OK") (newline))

(define (vt-bad tag got)
  (set! *checks* (+ *checks* 1))
  (set! *fail* (+ *fail* 1))
  (display "T ") (display tag) (display " FAIL ") (display got) (newline))

(define (vt-eq tag got want)
  (if (equal? got want) (vt-ok tag) (vt-bad tag got)))

(define (vt-arm! src)
  (pad:play-reset! src)
  (set! *vi-on* #t)
  (set! *vi-mode* "normal")
  (set! *vi-vanchor* -1)
  (set! *vi-op* "")
  (set! *vi-cx* #f)
  (set! *vi-line* "")
  (set! *vi-pat* "")
  (set! *vi-pat-word* #f)
  (set! *em-hit* #f)
  (set! *em-anchor* #f)
  (set! *vi-base* "t")
  (set! *vi-num* 0)
  (set! *vi-num-op* 0)
  (set! *vi-seek* "")
  (set! *vi-obj* "")
  (set! *vi-find-ch* 0)
  (set! *vi-find-dir* 1)
  (set! *vi-find-till* 0)
  (set! *vi-last* #f)
  (set! *vi-chg* #f)
  (set! *vi-ins* (list))
  (set! *vi-ins-how* "")
  (set! *vi-ins-times* 1)
  (set! *vi-dotting* #f)
  (set! *vi-did* 0)
  (set! *vi-pend-rec* #f)
  (pad:vi-title!))

(define (vt-at tag l col)
  (vt-eq (string-append tag "-l") (pad:es-l *pl-st*) l)
  (vt-eq (string-append tag "-c") (pad:es-col *pl-st*) col))

;; emacs movement in normal mode
(vt-arm! "ab\ncd")
(vt-eq "boot-mode" *vi-mode* "normal")
(vt-eq "boot-title" *pl-title* "t [normal]")
(pad:play-step! "IN 6")
(vt-at "cf" 0 1)
(pad:play-step! "IN 14")
(vt-at "cn" 1 1)
(pad:play-step! "IN 16")
(vt-at "cp" 0 1)
(pad:play-step! "IN 2")
(vt-at "cb" 0 0)
(vt-eq "move-text" (pad:play-src) "ab\ncd")

;; edge: ctrl-b at the start does not insert and does not jump back
(pad:play-step! "IN 2")
(vt-eq "cb-edge" *pl-say* "cannot move past the edge")
(vt-at "cb-stay" 0 0)

;; hjkl
(pad:play-step! "IN 108")
(pad:play-step! "IN 106")
(pad:play-step! "IN 107")
(pad:play-step! "IN 104")
(vt-at "hjkl" 0 0)
(vt-eq "hjkl-text" (pad:play-src) "ab\ncd")

;; a normal-mode letter with no command is not inserted
(pad:play-step! "IN 113")
(vt-eq "q-say" *pl-say* "press i to type")
(vt-eq "q-text" (pad:play-src) "ab\ncd")
(vt-eq "q-mode" *vi-mode* "normal")

;; i types, esc returns, l moves
(pad:play-step! "IN 105")
(vt-eq "ins-mode" *vi-mode* "insert")
(vt-eq "ins-title" *pl-title* "t [insert]")
(vt-eq "ins-say" *pl-say* "insert - type, esc goes back")
(pad:play-step! "IN 90")
(vt-eq "typed" (pad:play-src) "Zab\ncd")
(vt-eq "still-ins" *vi-mode* "insert")
(pad:play-step! "IN 27")
(vt-eq "esc-mode" *vi-mode* "normal")
(vt-eq "esc-text" (pad:play-src) "Zab\ncd")
(pad:play-step! "IN 108")
(vt-at "l-moves" 0 2)
(vt-eq "l-text" (pad:play-src) "Zab\ncd")

;; emacs keys in insert mode move and stay in insert
(vt-arm! "ab\ncd")
(pad:play-step! "IN 105")
(pad:play-step! "IN 6")
(pad:play-step! "IN 14")
(vt-eq "ins-move-mode" *vi-mode* "insert")
(vt-at "ins-move" 1 1)
(pad:play-step! "IN 81")
(vt-eq "ins-q" (pad:play-src) "ab\ncQd")
(pad:play-step! "IN 2")
(vt-eq "ins-cb-mode" *vi-mode* "insert")
(vt-at "ins-cb" 1 1)
(vt-eq "ins-cb-text" (pad:play-src) "ab\ncQd")

;; append moves one step then types
(vt-arm! "ab\ncd")
(pad:play-step! "IN 97")
(vt-eq "app-mode" *vi-mode* "insert")
(vt-at "app-at" 0 1)
(pad:play-step! "IN 88")
(vt-eq "app-text" (pad:play-src) "aXb\ncd")

;; append at the end of the buffer just types
(vt-arm! "ab")
(pad:play-step! "IN 5")
(pad:play-step! "IN 97")
(vt-eq "app-end-mode" *vi-mode* "insert")
(vt-at "app-end-at" 0 2)
(pad:play-step! "IN 89")
(vt-eq "app-end-text" (pad:play-src) "abY")

;; one read, several bytes: hj, then i A B esc
(vt-arm! "ab\ncd")
(pad:play-step! "IN 108 106")
(vt-at "multi-move" 1 1)
(pad:play-step! "IN 105 65 66 27")
(vt-eq "multi-text" (pad:play-src) "ab\ncABd")
(vt-eq "multi-mode" *vi-mode* "normal")

;; arrow in the same read still moves, and does not leave insert
(vt-arm! "ab\ncd")
(pad:play-step! "IN 27 91 66")
(vt-at "arrow-n" 1 0)
(vt-eq "arrow-mode" *vi-mode* "normal")
(pad:play-step! "IN 105")
(pad:play-step! "IN 27 91 67")
(vt-eq "arrow-ins" *vi-mode* "insert")
(vt-at "arrow-f" 1 1)

;; old ctrl-b / ctrl-p jobs moved, they did not disappear
(vt-arm! "ab\ncd")
(pad:play-step! "IN 29")
(vt-eq "jump" *pl-say* "nowhere to jump back to")
(pad:play-step! "IN 22")
(vt-eq "copy" *pl-say* "set a mark first")
(vt-eq "copy-text" (pad:play-src) "ab\ncd")

;; x deletes the letter under the cursor; X deletes the one before
(vt-arm! "ab\ncd")
(pad:play-step! "IN 120")
(vt-eq "x-text" (pad:play-src) "b\ncd")
(vt-eq "x-say" *pl-say* "deleted a letter")
(vt-at "x-at" 0 0)
(pad:play-step! "IN 36")
(pad:play-step! "IN 120")
(vt-eq "x-eol" *pl-say* "nothing under the cursor")
(vt-eq "x-eol-t" (pad:play-src) "b\ncd")
(vt-arm! "ab")
(pad:play-step! "IN 108")
(pad:play-step! "IN 88")
(vt-eq "X-text" (pad:play-src) "b")
(vt-at "X-at" 0 0)
(pad:play-step! "IN 88")
(vt-eq "X-edge" *pl-say* "nothing before the cursor")

;; D deletes to the end of the line and does not join
(vt-arm! "abcd\nzz")
(pad:play-step! "IN 108")
(pad:play-step! "IN 108")
(pad:play-step! "IN 68")
(vt-eq "D-text" (pad:play-src) "ab\nzz")

;; dd deletes the line; p puts it back; u takes the paste back
(vt-arm! "ab\ncd\nef")
(pad:play-step! "IN 106")
(pad:play-step! "IN 100")
(vt-eq "d-wait" (pad:play-src) "ab\ncd\nef")
(vt-eq "d-say" *pl-say* "d - press d again to delete the line, or a motion")
(pad:play-step! "IN 100")
(vt-eq "dd-text" (pad:play-src) "ab\nef")
(vt-eq "dd-say" *pl-say* "deleted the line")
(pad:play-step! "IN 112")
(vt-eq "p-text" (pad:play-src) "ab\ncd\nef")
(pad:play-step! "IN 117")
(vt-eq "u-text" (pad:play-src) "ab\nef")
(vt-arm! "ab\ncd")
(pad:play-step! "IN 106")
(pad:play-step! "IN 100 100")
(vt-eq "dd-last" (pad:play-src) "ab")
(vt-at "dd-last-at" 0 2)
(pad:play-step! "IN 112")
(vt-eq "p-last" (pad:play-src) "ab\ncd")
(vt-arm! "ab")
(pad:play-step! "IN 100 100")
(vt-eq "dd-only" (pad:play-src) "")
(pad:play-step! "IN 112")
(vt-eq "p-only" (pad:play-src) "ab")
(vt-arm! "")
(pad:play-step! "IN 100 100")
(vt-eq "dd-empty" *pl-say* "nothing to delete")
(vt-eq "dd-empty-t" (pad:play-src) "")

;; yy copies the line
(vt-arm! "ab\ncd")
(pad:play-step! "IN 121 121")
(vt-eq "yy-text" (pad:play-src) "ab\ncd")
(pad:play-step! "IN 106")
(pad:play-step! "IN 48")
(pad:play-step! "IN 112")
(vt-eq "yy-p" (pad:play-src) "ab\nab\ncd")

;; V selects lines. y copies them. p pastes at the cursor.
(vt-arm! "ab\ncd\nef")
(pad:play-step! "IN 86")
(vt-eq "vis-mode" *vi-mode* "visual")
(vt-eq "vis-title" *pl-title* "t [visual]")
(vt-eq "vis-say" *pl-say* "visual - this line, y copies, d deletes")
(vt-eq "vis-hl" (if (string-contains? (pad:vw-frame (pad:play-snap)) "\nM vv\n") 1 0) 1)
(pad:play-step! "IN 106")
(vt-eq "vis-2" *pl-say* "visual - 2 lines, y copies, d deletes")
(pad:play-step! "IN 121")
(vt-eq "vis-y-mode" *vi-mode* "normal")
(vt-eq "vis-y-say" *pl-say* "copied 2 lines")
(vt-eq "vis-y-src" (pad:play-src) "ab\ncd\nef")
(pad:play-step! "IN 71")
(pad:play-step! "IN 48")
(pad:play-step! "IN 112")
(vt-eq "vis-p" (pad:play-src) "ab\ncd\nab\ncd\nef")
(vt-arm! "ab\ncd\nef")
(pad:play-step! "IN 106")
(pad:play-step! "IN 106")
(pad:play-step! "IN 86")
(pad:play-step! "IN 107")
(vt-eq "vis-up" *pl-say* "visual - 2 lines, y copies, d deletes")
(pad:play-step! "IN 27")
(vt-eq "vis-esc" *vi-mode* "normal")
(vt-eq "vis-esc-say" *pl-say* "normal - press i to type")
(vt-eq "vis-esc-src" (pad:play-src) "ab\ncd\nef")
(vt-arm! "ab")
(pad:play-step! "IN 105")
(pad:play-step! "IN 86")
(vt-eq "ins-V" (pad:play-src) "Vab")
(vt-eq "ins-V-mode" *vi-mode* "insert")

;; Visual d deletes the selected lines. The mark tape is blue in C.
(vt-arm! "ab\ncd\nef")
(pad:play-step! "IN 86")
(pad:play-step! "IN 106")
(pad:play-step! "IN 100")
(vt-eq "vis-d-mode" *vi-mode* "normal")
(vt-eq "vis-d-say" *pl-say* "deleted 2 lines")
(vt-eq "vis-d-src" (pad:play-src) "ef")
(vt-arm! "ab\ncd")
(pad:play-step! "IN 86")
(pad:play-step! "IN 100")
(vt-eq "vis-d1" *pl-say* "deleted the line")
(vt-eq "vis-d1-src" (pad:play-src) "cd")
(pad:play-step! "IN 112")
(vt-eq "vis-d1-p" (pad:play-src) "ab\ncd")

;; d takes a motion. dG and dgg are linewise. dw and d$ are not.
(vt-arm! "ab\ncd\nef")
(pad:play-step! "IN 106")
(pad:play-step! "IN 100 71")
(vt-eq "dG" (pad:play-src) "ab")
(vt-arm! "ab\ncd\nef")
(pad:play-step! "IN 106")
(pad:play-step! "IN 100")
(pad:play-step! "IN 103 103")
(vt-eq "dgg" (pad:play-src) "ef")
(vt-arm! "ab\ncd\nef")
(pad:play-step! "IN 100 106")
(vt-eq "dj" (pad:play-src) "ef")
(vt-eq "dj-say" *pl-say* "deleted 2 lines")
(vt-arm! "ab")
(pad:play-step! "IN 100 106")
(vt-eq "dj-none" *pl-say* "nothing to delete")
(vt-eq "dj-src" (pad:play-src) "ab")
(vt-arm! "ab cd")
(pad:play-step! "IN 100 119")
(vt-eq "dw" (pad:play-src) "cd")
(vt-arm! "abcd")
(pad:play-step! "IN 108")
(pad:play-step! "IN 100 36")
(vt-eq "d-dollar" (pad:play-src) "a")
(vt-arm! "ab cd")
(pad:play-step! "IN 121 119")
(vt-eq "yw-src" (pad:play-src) "ab cd")
(pad:play-step! "IN 36")
(pad:play-step! "IN 112")
(vt-eq "yw-p" (pad:play-src) "ab cdab ")
(vt-arm! "ab\ncd")
(pad:play-step! "IN 121 71")
(vt-eq "yG-say" *pl-say* "copied 2 lines")
(vt-eq "yG-src" (pad:play-src) "ab\ncd")
(vt-arm! "ab\ncd")
(pad:play-step! "IN 99 99")
(vt-eq "cc-src" (pad:play-src) "\ncd")
(vt-eq "cc-mode" *vi-mode* "insert")
(vt-arm! "ab cd")
(pad:play-step! "IN 99 119")
(vt-eq "cw-src" (pad:play-src) "cd")
(vt-eq "cw-mode" *vi-mode* "insert")
(vt-arm! "ab")
(pad:play-step! "IN 105")
(pad:play-step! "IN 99")
(vt-eq "ins-c" (pad:play-src) "cab")

;; Counts. 3dd deletes three lines. d3j deletes this line and three more.
(vt-arm! "ab\ncd\nef\ngh\nij")
(pad:play-step! "IN 51 100 100")
(vt-eq "3dd" (pad:play-src) "gh\nij")
(vt-at "3dd-at" 0 0)
(pad:play-step! "IN 112")
(vt-eq "3dd-p" (pad:play-src) "ab\ncd\nef\ngh\nij")
(vt-arm! "ab")
(pad:play-step! "IN 51 100 100")
(vt-eq "3dd-one" (pad:play-src) "")
(vt-arm! "a b c d e")
(pad:play-step! "IN 100 51 119")
(vt-eq "d3w" (pad:play-src) "d e")
(vt-arm! "a b c d e f g")
(pad:play-step! "IN 50 100 51 119")
(vt-eq "2d3w" (pad:play-src) "g")
(vt-arm! "ab\ncd\nef\ngh")
(pad:play-step! "IN 51 106")
(vt-at "3j" 3 0)
(vt-arm! "a\nb\nc\nd\ne\nf\ng\nh\ni\nj\nk")
(pad:play-step! "IN 49 48 106")
(vt-at "10j" 10 0)
(vt-arm! "abcd")
(pad:play-step! "IN 108")
(pad:play-step! "IN 48")
(vt-at "zero-still" 0 0)
(vt-arm! "ab")
(pad:play-step! "IN 105")
(pad:play-step! "IN 51")
(vt-eq "ins-3" (pad:play-src) "3ab")
(vt-arm! "a\nb\nc\nd")
(pad:play-step! "IN 51 71")
(vt-at "3G" 2 0)
(vt-arm! "a\nb\nc\nd")
(pad:play-step! "IN 51 103 103")
(vt-at "3gg" 2 0)
(vt-arm! "a\nb\nc\nd\ne")
(pad:play-step! "IN 100 51 71")
(vt-eq "d3G" (pad:play-src) "d\ne")
(vt-arm! "abcd")
(pad:play-step! "IN 51 120")
(vt-eq "3x" (pad:play-src) "d")
(vt-arm! "a\nb\nc\nd\ne")
(pad:play-step! "IN 51 100 106")
(vt-eq "3dj" (pad:play-src) "e")
(vt-arm! "ab\ncd\nef")
(pad:play-step! "IN 100 100")
(pad:play-step! "IN 71")
(pad:play-step! "IN 100 106")
(vt-eq "dj-last" *pl-say* "nothing to delete")
(vt-eq "dj-last-src" (pad:play-src) "cd\nef")
(pad:play-step! "IN 46")
(vt-eq "dot-keeps" (pad:play-src) "cd")

;; f t F T on this line. ; repeats, , reverses.
(vt-arm! "abxcdx")
(pad:play-step! "IN 102 120")
(vt-at "fx" 0 2)
(pad:play-step! "IN 59")
(vt-at "semi" 0 5)
(pad:play-step! "IN 44")
(vt-at "comma" 0 2)
(vt-arm! "abxcd")
(pad:play-step! "IN 116 120")
(vt-at "tx" 0 1)
(vt-arm! "abxcd")
(pad:play-step! "IN 100 102 120")
(vt-eq "dfx" (pad:play-src) "cd")
(vt-arm! "abxcd")
(pad:play-step! "IN 100 116 120")
(vt-eq "dtx" (pad:play-src) "xcd")
(vt-arm! "ab")
(pad:play-step! "IN 102 122")
(vt-eq "fz-say" *pl-say* "not on this line")
(vt-eq "fz-src" (pad:play-src) "ab")
(vt-arm! "ab")
(pad:play-step! "IN 105")
(pad:play-step! "IN 102")
(vt-eq "ins-f" (pad:play-src) "fab")
(vt-arm! "ab")
(pad:play-step! "IN 105")
(pad:play-step! "IN 46")
(vt-eq "ins-dot" (pad:play-src) ".ab")
(vt-arm! "abxcd")
(pad:play-step! "IN 36")
(pad:play-step! "IN 70 120")
(vt-at "Fx" 0 2)

;; . repeats the last change. A count in front replaces the stored count.
(vt-arm! "ab\ncd\nef")
(pad:play-step! "IN 100 100")
(pad:play-step! "IN 46")
(vt-eq "dot-dd" (pad:play-src) "ef")
(vt-eq "dot-dd-say" *pl-say* "repeated")
(vt-arm! "ab cd ef")
(pad:play-step! "IN 99 119")
(pad:play-step! "IN 90")
(pad:play-step! "IN 27")
(pad:play-step! "IN 46")
(vt-eq "dot-cw" (pad:play-src) "ZZef")
(vt-arm! "ab")
(pad:play-step! "IN 46")
(vt-eq "dot-none" *pl-say* "nothing to repeat")
(vt-arm! "ab\ncd")
(pad:play-step! "IN 121 121")
(pad:play-step! "IN 46")
(vt-eq "dot-yy" *pl-say* "nothing to repeat")
(vt-eq "dot-yy-src" (pad:play-src) "ab\ncd")
(vt-arm! "abcdef")
(pad:play-step! "IN 51 120")
(pad:play-step! "IN 50 46")
(vt-eq "dot-2x" (pad:play-src) "f")
(vt-arm! "ab")
(pad:play-step! "IN 51 105")
(pad:play-step! "IN 90")
(pad:play-step! "IN 27")
(vt-eq "3i" (pad:play-src) "ZZZab")

;; Text objects. iw is the word, aw includes a space.
(vt-arm! "ab cd ef")
(pad:play-step! "IN 108")
(pad:play-step! "IN 100 105 119")
(vt-eq "diw" (pad:play-src) " cd ef")
(vt-arm! "ab cd")
(pad:play-step! "IN 100 97 119")
(vt-eq "daw" (pad:play-src) "cd")
(vt-arm! "ab cd")
(pad:play-step! "IN 108")
(pad:play-step! "IN 108")
(pad:play-step! "IN 100 105 119")
(vt-eq "diw-sp" (pad:play-src) "ab ")
(vt-arm! "say \"hi\" there")
(pad:play-step! "IN 102 104")
(pad:play-step! "IN 100 105 34")
(vt-eq "diq" (pad:play-src) "say \"\" there")
(vt-arm! "(ab)")
(pad:play-step! "IN 100 105 40")
(vt-eq "dip" (pad:play-src) "()")
(vt-arm! "ab cd")
(pad:play-step! "IN 121 105 119")
(vt-eq "yiw-say" *pl-say* "copied")
(vt-eq "yiw-src" (pad:play-src) "ab cd")
(vt-arm! "ab cd ef")
(pad:play-step! "IN 100 105 50 119")
(vt-eq "di2w" (pad:play-src) " ef")
(vt-arm! "ab cd ef")
(pad:play-step! "IN 50 100 105 119")
(vt-eq "2diw" (pad:play-src) " ef")

;; ends of the line, top and bottom, words
(vt-arm! "ab cd\nzz")
(pad:play-step! "IN 36")
(vt-at "dollar" 0 5)
(pad:play-step! "IN 48")
(vt-at "zero" 0 0)
(pad:play-step! "IN 119")
(vt-at "w" 0 3)
(pad:play-step! "IN 98")
(vt-at "b" 0 0)
(pad:play-step! "IN 71")
(vt-at "G" 1 2)
(pad:play-step! "IN 103 103")
(vt-at "gg" 0 0)

;; gd jumps to the define. gD and space c D walk every use.
(vt-arm! "(define (hello) 1)\n(hello)\n(hello)")
(set! *pl-st* (pad:es-move *pl-st* 1 1))
(pad:play-step! "IN 103 100")
(vt-at "gd" 0 9)
(vt-eq "gd-say" *pl-say* "jumped to where hello is born")
(vt-eq "gd-text" (pad:play-src) "(define (hello) 1)\n(hello)\n(hello)")
(pad:play-step! "IN 29")
(vt-at "gd-back" 1 1)
(set! *pl-st* (pad:es-move *pl-st* 0 9))
(pad:play-step! "IN 103")
(pad:play-step! "IN 68")
(vt-at "gD" 1 1)
(vt-eq "gD-say" *pl-say* "hello 2/3 line 2")
(pad:play-step! "IN 32 99 68")
(vt-at "spc-D" 2 1)
(vt-eq "spc-D-say" *pl-say* "hello 3/3 line 3")
(pad:play-step! "IN 32")
(pad:play-step! "IN 99")
(pad:play-step! "IN 68")
(vt-at "spc-wrap" 0 9)
(vt-eq "spc-wrap-say" *pl-say* "hello 1/3 line 1 again")
(pad:play-step! "IN 32 99 78")

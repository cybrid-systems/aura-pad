  (vt-eq "win-rows" (if (string-contains? s "ROWS n=2") 1 0) 1)
  (vt-eq "win-origin" (if (string-contains? s "ORIGIN") 1 0) 0))
(pad:play-step! "IN 106")
(pad:play-step! "IN 106")
(let ((s (pad:vw-frame (pad:play-snap))))
  (vt-eq "win-ol" (if (string-contains? s "ORIGIN line=1") 1 0) 1)
  (vt-eq "win-cur" (if (string-contains? s "CURSOR line=1") 1 0) 1))
(set! *vw-rows* 200)
(set! *vw-cols* 400)
(set! *vw-top* 0)
(set! *vw-left* 0)


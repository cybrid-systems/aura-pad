(load (string-append *pad-home* "/soft/pad/win.aura"))
(load (string-append *pad-home* "/soft/pad/ai.aura"))

(define (vt-ai! src)
  (vt-arm! src)
  (set! *pf-on* #f)
  (set! *pf-ro* #f)
  (pad:wn-reset!)
  (set! *ai-hist* (list))
  (set! *ai-fake* #f)
  (set! *ai-key* #f)
  (set! *vi-mx* #f))

(define (vt-mx! line)
  (set! *vi-op* ":")
  (set! *vi-line* line)
  (set! *vi-mx* #t)
  (pad:vi-colon!))

(define (vt-has tag s bit)
  (vt-eq tag (if (string-contains? s bit) 1 0) 1))

;; Empty M-x still runs the page after the window wrapper loads.
(vt-ai! "(+ 1 2)")
(pad:play-step! "IN 27 120")
(pad:play-step! "IN 13")
(vt-eq "ai-mx" *pl-say* "ran: 3")
(vt-eq "ai-mx-src" (pad:play-src) "(+ 1 2)")

;; M-x ask puts the answer on the chat page. switch:page comes back.
(vt-ai! "(+ 1 2)")
(set! *ai-fake* "three")
(pad:play-step! "IN 27 120")
(pad:play-step! "IN 97 115 107 32 119 104 97 116 13")
(vt-has "ask-you" (pad:play-src) "you: what")
(vt-has "ask-chat" (pad:play-src) "chat: three")
(vt-has "ask-say" *pl-say* "the chat answered")
(vt-has "ask-back" *pl-say* "switch:page")
(vt-eq "ask-live" *wn-live* "chat")
(pad:wn-switch! "page")
(vt-eq "ask-page" (pad:play-src) "(+ 1 2)")

;; An empty question on a page asks the chat to explain it.
(vt-ai! "(+ 1 2)")
(set! *ai-fake* "it adds")
(vt-mx! "ask")
(vt-has "ask-ex" (pad:play-src) "you: explain this page")
(vt-has "ask-ex-a" (pad:play-src) "chat: it adds")

;; A second question stays on the chat page and keeps the first turn.
(set! *ai-fake* "two")
(vt-mx! "ask second")
(vt-has "hist-1" (pad:play-src) "you: explain this page")
(vt-has "hist-2" (pad:play-src) "you: second")
(vt-has "hist-a" (pad:play-src) "chat: two")

(vt-ai! "")
(set! *ai-fake* "nope")
(vt-mx! "ask")
(vt-eq "ask-none" *pl-say* "tell the chat what to ask")
(vt-eq "ask-none-src" (pad:play-src) "")

(vt-ai! "hello")
(set! *ai-fake* (list->string (list 200)))
(vt-mx! "ask hi")
(vt-eq "ask-blank" *pl-say* "the chat had nothing to say")
(vt-eq "ask-blank-src" (pad:play-src) "hello")

;; M-x chat opens the page. rewrite refuses to change that page.
(vt-ai! "hello")
(vt-mx! "chat")
(vt-has "chat-hint" (pad:play-src) "Ask with M-x ask")
(vt-eq "chat-say" *pl-say* "this page is the chat. M-x ask, then your words")
(vt-eq "chat-live" *wn-live* "chat")
(vt-mx! "rewrite add")
(vt-eq "rw-chat" *pl-say* "switch to your page to rewrite it")
(vt-has "rw-chat-src" (pad:play-src) "Ask with M-x ask")

;; rewrite replaces this page. u puts the old page back.
(vt-ai! "hello")
(set! *ai-fake* "hello aura")
(vt-mx! "rewrite add aura")
(vt-eq "rw-src" (pad:play-src) "hello aura")
(vt-eq "rw-say" *pl-say* "the chat rewrote this page. press u to put yours back")
(vt-eq "rw-live" *wn-live* "page")
(pad:play-step! "IN 117")
(vt-eq "rw-undo" (pad:play-src) "hello")

(vt-ai! "hello")
(set! *ai-fake* "```\nhello aura\n```")
(vt-mx! "rewrite add aura")
(vt-eq "rw-fence" (pad:play-src) "hello aura")

(vt-ai! "hello")
(vt-mx! "rewrite")
(vt-eq "rw-how" *pl-say* "tell the chat how to change this page")
(vt-eq "rw-how-src" (pad:play-src) "hello")

(vt-ai! "")
(vt-mx! "rewrite add")
(vt-eq "rw-empty" *pl-say* "the page is empty")

(vt-ai! "hello")
(set! *pf-ro* #t)
(set! *ai-fake* "nope")
(vt-mx! "rewrite add")
(vt-eq "rw-ro" *pl-say* "this page is look only")
(vt-eq "rw-ro-src" (pad:play-src) "hello")

;; gptel is the same three commands. A missing key does not call out.
(vt-ai! "hello")
(vt-mx! "gptel")
(vt-eq "gptel-live" *wn-live* "chat")
(vt-ai! "(+ 1 2)")
(set! *ai-fake* "six")
(vt-mx! "gptel-send what")
(vt-has "send" (pad:play-src) "chat: six")
(vt-ai! "(+ 1 2)")
(set! *ai-fake* "seven")
(vt-mx! "gptel what")
(vt-has "gptel-ask" (pad:play-src) "chat: seven")
(vt-ai! "ab")
(pad:play-step! "IN 27 120")
(pad:play-step! "IN 103 112 116 101 108 9")
(vt-eq "mx-gptel" *vi-line* "gptel ")

(vt-ai! "hello")
(set! *ai-key* "")
(vt-mx! "ask hi")
(vt-eq "no-key" *pl-say* "the chat has no key yet")
(vt-eq "no-key-src" (pad:play-src) "hello")

(vt-eq "plain" (pad:ai-plain-s (list->string (list 104 105 200 33))) "hi!")
(vt-eq "unfence" (pad:ai-unfence "```\nhello aura\n```") "hello aura")
(vt-eq "pick-ok" (cadr (pad:ai-pick "{\"choices\":[{\"message\":{\"content\":\"hi\"}}]}")) "hi")
(vt-eq "pick-bad" (cadr (pad:ai-pick "{\"error\":{\"message\":\"nope\"}}")) "the chat could not answer")
(vt-eq "pick-empty" (car (pad:ai-pick "")) "no")
(define *ai-body-s* (json-encode (pad:ai-body "sys" (list) "hi")))
(vt-has "body-model" *ai-body-s* "deepseek-flash")
(vt-has "body-think" *ai-body-s* "disabled")
(vt-has "body-effort" *ai-body-s* "none")
(vt-has "map-ask" (pad:wn-map "page") "ask QUESTION")
(vt-has "map-ds" (pad:wn-map "page") "DeepSeek v4.1 flash")
(set! *ai-fake* #f)
(set! *ai-key* #f)
(set! *ai-hist* (list))

(display "CHECKS ")
(display (number->string *checks*))
(display " FAIL ")
(display (number->string *fail*))
(newline)
(if (= *fail* 0)
    (display "PAD_VI_TEST_OK\n")
    (display "PAD_VI_TEST_FAIL\n"))

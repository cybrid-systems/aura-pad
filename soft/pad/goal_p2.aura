(define (pd:goal-sync!)
  (hot-strategy:swap! "pd:gshadow" *goal-main-body* "goal-shadow")
  (hot-strategy:swap! "pd:goal" *goal-main-body* "goal-choose")
  *goal-main-body*)

(define (pd:goal-out! tag)
  (set! *goal-tag* tag)
  (display "PROPOSE kind=goal tag=")
  (display tag)
  (newline)
  (list (string=? tag "goal_keep") tag))

(define (pd:goal-card-say trial base)
  (cond
    ((> trial base) "b is closer")
    ((= trial base) (pad:card-kid "tie"))
    (#t "a is closer")))

(define (pd:goal-race! clean)
  (let* ((base-plan (pd:gshadow))
         (trial-plan (pd:goal))
         (pair (pad:race-thunks!
                (lambda () (pad:gscore-plan base-plan))
                (lambda () (pad:gscore-plan trial-plan))))
         (base (car pair))
         (trial (car (cdr pair))))
    (set! *goal-base* base)
    (set! *goal-trial* trial)
    (let ((audit (pad:gsim trial-plan "pd:goal" 1)))
      (if (> (pad:g-rej audit) 4)
          (begin
            (display "REJECTS kind=goal total=")
            (display (number->string (pad:g-rej audit)))
            (display " shown=4")
            (newline))))
    (display "RACE goal base=")
    (display (pad:nstr base))
    (display " trial=")
    (display (pad:nstr trial))
    (newline)
    (if (> trial base)
        (begin
          (set! *goal-history*
                (pad:take *goal-history-max*
                          (cons (list *goal-main-body* base
                                      (pad:lines-text *g-page*))
                                *goal-history*)))
          (set! *goal-main-body* clean)
          (set! *main-score* trial)
          (set! *main-name* "pd:goal")
          (set! *keep-reason* "higher-score-stamp")
          (set! *goal-keeps* (+ *goal-keeps* 1))
          (set! *g-card* (pad:card-emit! base trial "b"
                                         (pd:goal-card-say trial base)))
          (display "KEEP kind=goal reason=higher-score-stamp score=")
          (display (pad:nstr trial))
          (display " say=\"")
          (display (pd:goal-card-say trial base))
          (display "\"")
          (newline)
          (pad:gstamp! trial-plan "pd:goal")
          (pd:goal-out! "goal_keep"))
        (begin
          (hot-strategy:heal!)
          (set! *drop-reason* (if (= trial base)
                                  "tie"
                                  "lower-score-rollback"))
          (set! *goal-drops* (+ *goal-drops* 1))
          (set! *g-card* (pad:card-emit! base trial "a"
                                         (pd:goal-card-say trial base)))
          (display "HEAL name=pd:goal reason=score")
          (newline)
          (display "DROP kind=goal reason=")
          (display *drop-reason*)
          (display " score=")
          (display (pad:nstr trial))
          (display " say=\"")
          (display (pd:goal-card-say trial base))
          (display "\"")
          (newline)
          (pd:goal-out! "goal_drop")))))

(define (pd:goal-propose-body! body)
  (let ((clean (pd:clean body)))
    (set! *goal-word* "")
    (set! *goal-why* "")
    (let ((why (pd:goal-body-why clean)))
      (cond
        ((string=? why "gate")
         (set! *goal-word* (pd:goal-bad-word clean))
         (if (= (string-length *goal-word*) 0)
             (set! *goal-word* (pd:goal-cap-word clean)))
         (pd:gate-reject! "gate" *goal-word*)
         (pd:goal-out! "goal_reject"))
        ((string=? why "kind")
         (set! *goal-word* (pad:mean-word-goal clean))
         (display "GATE reject reason=kind word=")
         (display *goal-word*)
         (display " say=\"let us use kind words\"")
         (newline)
         (pd:goal-out! "goal_reject"))
        ((string=? why "not-allowed")
         (set! *goal-word* (pd:goal-cap-word clean))
         (display "REJECT mid=8 reason=not-allowed cmd=goal word=")
         (display *goal-word*)
         (display " say=\"")
         (display (pad:card-kid "not-allowed"))
         (display "\"")
         (newline)
         (pd:goal-out! "goal_reject"))
        (#t
         (let ((sw (hot-strategy:swap! "pd:goal" clean "goal-propose")))
           (if (not (and (pair? sw) (equal? (car sw) #t)))
               (begin
                 (pd:gate-reject! "swap" "")
                 (pd:goal-out! "goal_reject"))
               (let ((pwhy (pad:plan-check (try (pd:goal) (catch (e) #f)))))
                 (if (not (string=? pwhy "ok"))
                     (begin
                       (set! *goal-why* pwhy)
                       (hot-strategy:heal!)
                       (display "HEAL name=pd:goal reason=probe why=")
                       (display pwhy)
                       (newline)
                       (pd:goal-out! "goal_heal"))
                     (begin
                       (display "SWAP name=pd:goal reason=propose")
                       (newline)
                       (pd:goal-race! clean)))))))))))

(define (pd:goal-propose-file! path)
  (pd:goal-sync!)
  (display "PROPOSE kind=goal file=")
  (display path)
  (newline)
  (let ((body (try (read-file path) (catch (e) #f))))
    (if (not (string? body))
        (begin
          (pd:gate-reject! "read" "")
          (pd:goal-out! "goal_reject"))
        (pd:goal-propose-body! body))))

;; Kid-facing goal: command (used by tests + play when goal.aura is loaded).
(define (pad:goal-cmd! cmd)
  (let ((text (pad:card-goal-text cmd)))
    (cond
      ((= (string-length text) 0)
       (display "REJECT mid=8 reason=no-goal cmd=goal: say=\"")
       (display (pad:card-kid "no-goal"))
       (display "\"")
       (newline)
       (list #f "no-goal" (pad:card-kid "no-goal") *g-page* *g-score*
             (length *goal-history*)))
      (#t
       (pad:goal-set-text! text)
       (list #t "goal-set" text *g-goal-lines*)))))

;; Undo last KEEP: restore previous main, re-score; mismatch -> PAD_M8_UNDO_FAIL.
(define (pd:goal-undo!)
  (if (null? *goal-history*)
      (begin
        (display "REJECT mid=8 reason=nothing-to-undo cmd=goal-undo slot=")
        (display *main-name*)
        (display " say=\"")
        (display (pad:kid-say "nothing-to-undo"))
        (display "\"")
        (newline)
        (list #f "goal_undo_reject"))
      (let* ((top (car *goal-history*))
             (body (car top))
             (want (car (cdr top)))
             (from *main-score*))
        (set! *goal-history* (cdr *goal-history*))
        (set! *goal-main-body* body)
        (pd:goal-sync!)
        (let* ((p (try (pd:gshadow) (catch (e) #f)))
               (got (pad:gscore-plan p)))
          (set! *main-score* got)
          (set! *main-name* "pd:gshadow")
          (set! *goal-undos* (+ *goal-undos* 1))
          (pad:gstamp! p "pd:gshadow")
          (display "UNDO kind=goal from=")
          (display (pad:nstr from))
          (display " to=")
          (display (pad:nstr got))
          (display " want=")
          (display (pad:nstr want))
          (display " left=")
          (display (number->string (length *goal-history*)))
          (display " say=\"took back the last keep\"")
          (newline)
          (if (= got want)
              (list #t "goal_undo")
              (begin
                (display "PAD_M8_UNDO_FAIL rescore\n")
                (list #f "goal_undo_fail")))))))

;; Force a mismatch for the loud-fail fixture (tests only).
(define (pd:goal-undo-mismatch!)
  (if (null? *goal-history*)
      (list #f "goal_undo_reject")
      (begin
        (set! *goal-history*
              (cons (list (car (car *goal-history*))
                          (+ (car (cdr (car *goal-history*))) 1)
                          (car (cdr (cdr (car *goal-history*)))))
                    (cdr *goal-history*)))
        (pd:goal-undo!))))

;; aura-pad -- vi normal / insert, evil-style, plus emacs movement.
;; Loaded by play.aura. Off unless PAD_VI=1 (aura-pad sets that; the
;; smokes do not, so the modeless keymap in keys.aura stays put).
;;
;; Normal (the start):
;;   h j k l move, i types, a appends, Esc stays.
;;   x / X delete a letter, dd deletes the line, D deletes to the end
;;   of the line (it does not join), yy copies the line, p pastes.
;;   u takes the last edit back. 0 / $ go to the ends of the line,
;;   gg / G to the top and the bottom. gd jumps to where a name is born.
;;   gD and space c D find every use. The line says which one (2/3) and
;;   the line number. space c N and gN go back one use.
;;   * finds the word under the cursor. n walks forward, N backward.
;;   # walks backward from this word. / opens the same search as ctrl-s.
;;   ctrl-r repeats the search backward. ctrl-a / ctrl-e / ctrl-k are
;;   the emacs line keys (start, end, delete to the end).
;;   V selects whole lines. y copies them. p pastes at the cursor.
;;   w / b move by words.
;;   I / A / o / O open insert at the start, the end, below, above.
;;   r replaces the letter under the cursor.
;;   : opens a command line: e / eval / run runs the page, w saves,
;;   q quits, wq saves and quits. ZZ saves and quits, ZQ quits.
;; Insert: letters type, Esc returns to normal. : is a letter there.
;; Both modes: ctrl-b left, ctrl-f right, ctrl-p up, ctrl-n down,
;; and the arrow keys. ctrl-] jumps back (ctrl-b used to). ctrl-v
;; copies the region (ctrl-p used to).
;; ctrl-x ctrl-c quits (with a file, file.aura owns that chord and
;; warns once when the page is not saved). ctrl-x ctrl-e runs the page.
;; Alt-x is the bytes 27 120 in ONE read (a lone 27 is still Esc).
;; Enter on an empty Alt-x line runs the page. The same read can also
;; carry alt-f, alt-b, and alt-d (forward word, back word, delete word).
;; ctrl-g cancels a prefix, a prompt, or a half-typed command.
;; ctrl-x ctrl-f opens a file, ctrl-x ctrl-b lists buffers, ctrl-x b
;; switches. M-x find-file and M-x search do the same jobs. In M-x, tab
;; completes the first word. Space lists the matches and types a space.
;; It does not grow the word. A space after that word is the argument.
;;
;; Running the page uses (eval ...), not set-code, so the editor stays
;; loaded. display and newline inside the page are caught so they do
;; not write into the SNAP stream. On this Aura a let that binds those
;; names sticks to the top level, so the real primitives are put back
;; before the next frame.
;;
;; Esc is byte 27, which is also the start of an arrow. C sends one
;; read() as one "IN b1 b2 ..." line, and a real Esc is a one-byte
;; read, so a lone 27 leaves insert. 27 91 / 27 79 in the SAME line
;; is still an arrow. A split "IN 27" then "IN 120" is Esc, then x,
;; not Alt-x.
;; Soft reserved: never bind quote. No named let captures an outer local.

(define *vi-mode* "normal")
(define *vi-vanchor* -1)
(define *vi-base* "")
(define *vi-op* "")
(define *vi-line* "")
;; Last search * n N should repeat. *vi-pat-word* is true when the
;; pattern is a whole word (* and #), false for a typed search.
(define *vi-pat* "")
(define *vi-pat-word* #f)
(define *vi-prompt* ": ")
(define *vi-mx* #f)
(define *vi-cx* #f)
(define *vi-arg* 0)
;; A count in front of a command. 0 means there is no count. Digits
;; after an operator are the motion count; digits before it are the
;; operator count. The two multiply (2d3w deletes 6 words).
(define *vi-num* 0)
(define *vi-num-op* 0)
;; "f"/"t"/"F"/"T" while the next byte is the letter to find.
;; "i"/"a" while the next byte finishes a text object (w, quote, paren).
(define *vi-seek* "")
(define *vi-obj* "")
(define *vi-find-ch* 0)
(define *vi-find-dir* 1)
(define *vi-find-till* 0)
;; Last change . can repeat, and the text of the insert that followed it.
(define *vi-last* #f)
(define *vi-chg* #f)
(define *vi-ins* (list))
(define *vi-ins-how* "")
(define *vi-ins-times* 1)
(define *vi-dotting* #f)
(define *vi-did* 0)
(define *vi-pend-rec* #f)
(define *vi-out* (list ""))
(define *vi-ran* #f)
(define *vi-gap* (list->string (list 32 47 32)))
(define *vi-disp* display)
(define *vi-nl* newline)

;; emacs.aura fills these in. The stubs keep :q and empty M-x working
;; before that file is loaded, and they never touch *pf-* (file.aura
;; may not be loaded yet).
(define *em-anchor* #f)
(define *em-from* 0)
(define *em-hit* #f)
(define *em-files* #f)
(define (pad:em-other-dirty) "")
(define (pad:em-hint!)
  (set! *pl-say* (string-append *vi-prompt* *vi-line*))
  "vi-do")
(define (pad:em-search-now!) (pad:em-hint!))
(define (pad:em-search-next!) (pad:em-search-now!))
(define (pad:em-enter!) (pad:vi-colon!))
(define (pad:em-command w rest mx) #f)
;; emacs.aura replaces these. Before that file loads, tab leaves the
;; line alone and space is still a space, so :q works with vi.aura alone.
(define (pad:em-complete!)
  (set! *pl-say* (string-append *vi-prompt* *vi-line*))
  "vi-do")
(define (pad:em-cands!)
  (if (< (string-length *vi-line*) 160)
      (set! *vi-line* (string-append *vi-line* " "))
      0)
  (set! *pl-say* (string-append *vi-prompt* *vi-line*))
  "vi-do")
(define (pad:wn-on-cx! b) #f)
(define (pad:wn-on-line! line) #f)
(define (pad:em-abort-point!)
  (if (pair? *em-anchor*)
      (set! *pl-st* (list (car *pl-st*) (car *em-anchor*) (cadr *em-anchor*)
                          (list-ref *pl-st* 3) (list-ref *pl-st* 4) (list-ref *pl-st* 5)))
      0)
  (set! *em-anchor* #f)
  0)
(define (pad:em-keyboard-quit!)
  (pad:em-abort-point!)
  (set! *vi-op* "")
  (set! *vi-line* "")
  (set! *vi-mx* #f)
  (set! *vi-cx* #f)
  (set! *em-hit* #f)
  (pad:vi-clear-num!)
  (if (string=? *vi-mode* "visual")
      (begin (pad:vi-repaint!)
             (set! *vi-mode* "normal")
             (set! *vi-vanchor* -1)
             (pad:vi-title!))
      0)
  (set! *pl-say* "quit")
  "vi-do")
(define (pad:em-find-start!)
  (pad:vi-clear-num!)
  (set! *vi-op* "find")
  (set! *vi-line* "")
  (set! *vi-mx* #f)
  (set! *vi-cx* #f)
  (set! *vi-prompt* "Find file: ")
  (set! *pl-say* "Find file: ")
  "vi-do")
(define (pad:em-list!)
  (set! *pl-say* "no buffers yet")
  "vi-do")
(define (pad:em-buf-start!)
  (pad:vi-clear-num!)
  (set! *vi-op* "buf")
  (set! *vi-line* "")
  (set! *vi-mx* #f)
  (set! *vi-cx* #f)
  (set! *vi-prompt* "Switch buffer: ")
  (set! *pl-say* "Switch buffer: ")
  "vi-do")
(define (pad:em-search-start!)
  (pad:vi-clear-num!)
  (set! *em-anchor* (list (cadr *pl-st*) (caddr *pl-st*)))
  (set! *vi-op* "s")
  (set! *vi-line* "")
  (set! *vi-mx* #f)
  (set! *vi-cx* #f)
  (set! *vi-prompt* "Search: ")
  (set! *pl-say* "Search: ")
  "vi-do")
(define (pad:em-meta! b)
  (if (= b 120) (pad:vi-colon-start! #t) "to-normal"))

(define (pad:vi-title!)
  (set! *pl-title*
        (string-append *vi-base*
                       (cond
                         ((string=? *vi-mode* "insert") " [insert]")
                         ((string=? *vi-mode* "visual") " [visual]")
                         (#t " [normal]")))))

(define (pad:vi-has-file?)
  (let ((v (getenv "PAD_FILE")))
    (and (string? v) (> (string-length v) 0))))

;; Call after the file title is set (play.aura). Returns #t when modal.
(define (pad:vi-boot!)
  (let ((v (getenv "PAD_VI")))
    (if (and (string? v) (string=? v "1"))
        (begin
          (set! *vi-on* #t)
          (set! *vi-mode* "normal")
          (set! *vi-vanchor* -1)
          (set! *vi-op* "")
          (set! *vi-cx* #f)
          (set! *vi-base* *pl-title*)
          (pad:vi-title!)
          (if (pad:vi-has-file?)
              0
              (set! *pl-say* "normal - :eval runs this page, ctrl-x ctrl-c quits")))
        (set! *vi-on* #f))
    *vi-on*))

;; Controls that are not the emacs movement keys, looked up in the
;; modeless map. 2 and 16 are movement here, so they never reach this.
(define (pad:vi-ctrl b)
  (let ((w (pad:kv-get *keymap* b)))
    (if w w "unknown")))

(define (pad:vi-can-right?)
  (let* ((st *pl-st*)
         (L (car st))
         (l (cadr st))
         (col (caddr st))
         (n (length L))
         (len (length (list-ref L l))))
    (not (and (= l (- n 1)) (>= col len)))))

(define (pad:vi-mode-word? cmd)
  (or (string=? cmd "vi-do")
      (string=? cmd "to-insert")
      (string=? cmd "to-normal")
      (string=? cmd "append")
      (string=? cmd "normal-key")))

;; --- command line and running the page ---

;; A let/define of display inside eval sticks to the top level on this
;; Aura, and set! of the primitive before that stick is an error. Put
;; the primitives back when the names are variables, and ignore the
;; error when the page never ran.
(define (pad:vi-restore-io!)
  (try (set! display *vi-disp*) (catch (e) 0))
  (try (set! newline *vi-nl*) (catch (e) 0)))

(define (pad:vi-cut s)
  (if (> (string-length s) 160) (string-append (substring s 0 160) "...") s))

(define (pad:vi-ol s i n acc k)
  (if (or (>= i n) (>= k 160))
      acc
      (let ((c (string-ref s i)))
        (pad:vi-ol s (+ i 1) n
                   (string-append acc
                                  (if (or (= c 10) (= c 13) (= c 9))
                                      " "
                                      (list->string (list c))))
                   (+ k 1)))))

(define (pad:vi-one-line s)
  (if (string? s) (pad:vi-ol s 0 (string-length s) "" 0) ""))

(define (pad:vi-plist v d n)
  (cond
    ((> n 6) "...")
    ((null? v) "")
    ((not (pair? v)) (string-append ". " (pad:vi-p v (+ d 1))))
    ((null? (cdr v)) (pad:vi-p (car v) (+ d 1)))
    (#t (string-append (pad:vi-p (car v) (+ d 1)) " "
                       (pad:vi-plist (cdr v) d (+ n 1))))))

(define (pad:vi-p v d)
  (cond
    ((> d 4) "...")
    ((string? v) (pad:vi-one-line v))
    ((number? v) (number->string v))
    ((null? v) "()")
    ((equal? v #t) "#t")
    ((equal? v #f) "#f")
    ((pair? v) (string-append "(" (pad:vi-plist v d 0) ")"))
    (#t "a value")))

(define (pad:vi-add-s! s)
  (let ((cur (car *vi-out*)))
    (if (>= (string-length cur) 160)
        0
        (set-car! *vi-out* (string-append cur (pad:vi-one-line s))))))

(define (pad:vi-add! v)
  (pad:vi-add-s! (pad:vi-p v 0)))

(define (pad:vi-wrap src)
  (string-append
    "(try (cons 1 (let () (define (display v) (pad:vi-add! v)) (define (newline) (pad:vi-add! *vi-gap*)) "
    src
    ")) (catch (e) (cons 0 e)))"))

(define (pad:vi-skip-sp s i n)
  (if (or (>= i n) (not (= (string-ref s i) 32)))
      i
      (pad:vi-skip-sp s (+ i 1) n)))

(define (pad:vi-word-end s i n)
  (if (or (>= i n) (= (string-ref s i) 32))
      i
      (pad:vi-word-end s (+ i 1) n)))

(define (pad:vi-word s)
  (let ((n (string-length s)))
    (substring s (pad:vi-skip-sp s 0 n) (pad:vi-word-end s (pad:vi-skip-sp s 0 n) n))))

;; The text after the first word, with the gap spaces dropped.
(define (pad:vi-rest s)
  (let* ((n (string-length s))
         (a (pad:vi-skip-sp s 0 n))
         (b (pad:vi-word-end s a n))
         (c (pad:vi-skip-sp s b n)))
    (substring s c n)))

(define (pad:vi-first-line s)
  (let ((i (if (string? s) (string-index s "\n" 0) -1)))
    (cond
      ((not (string? s)) "")
      ((< i 0) s)
      (#t (substring s 0 i)))))

(define (pad:vi-after s mark)
  (let ((i (string-index s mark 0)))
    (if (< i 0) "" (substring s (+ i (string-length mark)) (string-length s)))))

;; Kid words only. The raw interpreter line can contain "unbound
;; variable" / "error:", and the smokes treat those as a Soft crash.
(define (pad:vi-soften s)
  (let* ((line (pad:vi-first-line s))
         (name (pad:vi-word (pad:vi-after line "unbound variable: "))))
    (cond
      ((> (string-length name) 0) (string-append name " is not defined yet"))
      ((or (string-contains? line "error:") (string-contains? line "unbound"))
       "did not run - check the parens")
      ((string=? line "") "did not run - check the parens")
      (#t (pad:vi-cut line)))))

(define (pad:vi-blank-i s i n)
  (if (>= i n)
      #t
      (let ((c (string-ref s i)))
        (if (or (= c 32) (= c 10) (= c 13) (= c 9))
            (pad:vi-blank-i s (+ i 1) n)
            #f))))

(define (pad:vi-blank? s)
  (pad:vi-blank-i s 0 (string-length s)))

(define (pad:vi-exec src)
  (set-car! *vi-out* "")
  (set! *vi-ran* (try (eval (pad:vi-wrap src)) (catch (e) (cons 0 e))))
  (pad:vi-restore-io!)
  *vi-ran*)

(define (pad:vi-report! r)
  (let ((out (pad:vi-cut (pad:vi-one-line (car *vi-out*)))))
    (set! *pl-say*
          (cond
            ((not (pair? r)) "did not run - check the parens")
            ((and (number? (car r)) (= (car r) 0))
             (string-append "did not run: " (pad:vi-soften (cdr r))))
            ((and (number? (car r)) (= (car r) 1))
             (let ((v (cdr r)))
               (cond
                 ((and (null? v) (string=? out "")) "ran, and it returned nothing")
                 ((string=? out "") (string-append "ran: " (pad:vi-cut (pad:vi-p v 0))))
                 ((null? v) (string-append "ran, printed: " out))
                 (#t (string-append "ran: " (pad:vi-cut (pad:vi-p v 0)) " printed: " out)))))
            (#t "did not run - check the parens")))))

(define (pad:vi-eval!)
  (if (pad:vi-blank? (pad:play-src))
      (begin
        (set! *pl-say* "the page is empty")
        (set! *pl-keys* (+ *pl-keys* 1))
        "vi-do")
      (begin
        (pad:vi-report! (pad:vi-exec (pad:play-src)))
        (set! *pl-keys* (+ *pl-keys* 1))
        "vi-do")))

(define (pad:vi-quit-name)
  (if (string=? (pad:play-src) *pf-saved*)
      (let ((o (pad:em-other-dirty)))
        (if (string=? o "") *pf-name* o))
      *pf-name*))

(define (pad:vi-quit! force)
  (cond
    ;; No pad file, and find-file has not opened one either. Do not
    ;; touch *pf-* here: this runs in tests before file.aura loads.
    ((and (not (pad:vi-has-file?)) (not *em-files*)
          (string=? (pad:em-other-dirty) ""))
     "quit")
    (force "quit")
    (*pf-ro* "quit")
    ((and (string=? (pad:play-src) *pf-saved*)
          (string=? (pad:em-other-dirty) ""))
     "quit")
    (*pf-quit*
     (set! *pf-quit* #f)
     "quit")
    (#t
     (set! *pf-quit* #t)
     (set! *pl-say* (string-append (pad:vi-quit-name) " is not saved yet - ctrl-x ctrl-s saves,"
                                  " ctrl-x ctrl-c again quits"))
     "vi-do")))

(define (pad:vi-write! and-quit)
  (if (not (pad:vi-has-file?))
      (if and-quit
          "quit"
          (begin
            (set! *pl-say* "no file to save")
            "vi-do"))
      (let ((r (pad:pf-save!)))
        (if (and and-quit (string=? r "saved"))
            "quit"
            "vi-do"))))

(define (pad:vi-colon!)
  (let* ((line *vi-line*)
         (mx *vi-mx*)
         (w (pad:vi-word line))
         (rest (pad:vi-rest line)))
    (set! *vi-op* "")
    (set! *vi-line* "")
    (set! *vi-mx* #f)
    (let ((did (pad:em-command w rest mx)))
      (if did
          did
          (cond
            ((or (string=? w "e") (string=? w "eval") (string=? w "run")) (pad:vi-eval!))
            ((or (string=? w "q") (string=? w "quit")) (pad:vi-quit! #f))
            ((or (string=? w "q!") (string=? w "quit!")) (pad:vi-quit! #t))
            ((or (string=? w "w") (string=? w "write") (string=? w "save")) (pad:vi-write! #f))
            ((or (string=? w "wq") (string=? w "x")) (pad:vi-write! #t))
            ((string=? w "help")
             (set! *pl-say* "M-x help opens the map: split, search, find-file")
             "vi-do")
            ((string=? w "")
             (if mx
                 (pad:vi-eval!)
                 (begin
                   (set! *pl-say* "eval runs this page, M-x help opens the map, w saves, q quits")
                   "vi-do")))
            (#t
             (set! *pl-say* (string-append "no command " w " - M-x help opens the map"))
             "vi-do"))))))

(define (pad:vi-colon-start! mx)
  (pad:vi-clear-num!)
  (set! *vi-op* ":")
  (set! *vi-line* "")
  (set! *vi-mx* mx)
  (set! *vi-cx* #f)
  (set! *vi-prompt* (if mx "M-x " ": "))
  (set! *pl-say*
        (if mx
            "M-x - tab completes the word, space shows the matches and types a space, enter runs it. help opens the map, find-file opens, ask chats"
            ": - eval runs this page, w saves, q quits, M-x help opens the map"))
  "vi-do")

(define (pad:vi-type! b)
  (if (number? *tx-card*)
      (pad:tx-card-byte! b)
      (begin
        (if (< (string-length *vi-line*) 160)
            (set! *vi-line* (string-append *vi-line* (list->string (list b))))
            0)
        (cond
          ((string=? *vi-op* "s") (pad:em-search-now!))
          ((or (string=? *vi-op* "find") (string=? *vi-op* "buf")) (pad:em-hint!))
          (#t
           (set! *pl-say* (string-append *vi-prompt* *vi-line*))
           "vi-do")))))

(define (pad:vi-bs!)
  (let ((n (string-length *vi-line*)))
    (if (= n 0)
        (pad:vi-cancel!)
        (begin
          (set! *vi-line* (substring *vi-line* 0 (- n 1)))
          (cond
            ((string=? *vi-op* "s") (pad:em-search-now!))
            ((or (string=? *vi-op* "find") (string=? *vi-op* "buf")) (pad:em-hint!))
            (#t
             (set! *pl-say* (string-append *vi-prompt* *vi-line*))
             "vi-do"))))))

;; --- line edits (normal mode) ---

(define (pad:vi-undo-push U)
  (let ((un (length U)))
    (cond
      ((<= *undo-max* 0) (list))
      ((> un *undo-max*) (reverse (drop (reverse U) (- un *undo-max*))))
      (#t U))))

(define (pad:vi-drop-line!)
  (let* ((st *pl-st*)
         (L (car st))
         (l (cadr st))
         (col (caddr st))
         (n (length L))
         (ln (list-ref L l)))
    (if (and (= n 1) (null? ln))
        (begin
          (set! *pl-rej* (+ *pl-rej* 1))
          (set! *vi-did* 0)
          (set! *vi-pend-rec* #f)
          (set! *pl-say* (if *vi-dotting* "nothing to repeat" "nothing to delete"))
          "vi-do")
        (let* ((only (= n 1))
               (last (and (not only) (= l (- n 1))))
               (L2 (if only
                       (list (list))
                       (append (reverse (drop (reverse L) (- n l)))
                               (drop L (+ l 1)))))
               (l2 (cond (only 0) (last (- l 1)) (#t l)))
               (ln2 (list-ref L2 l2))
               (len2 (length ln2))
               (col2 (cond (last len2) (only 0) ((> col len2) len2) (#t col)))
               (kill (if only (list ln) (if last (list (list) ln) (list ln (list)))))
               (U (pad:vi-undo-push (cons (list L l col) (list-ref st 5)))))
          (set! *pl-st* (list L2 l2 col2 kill (list) U))
          (pad:vi-note! "d")
          (pad:play-ok! "deleted the line")
          "vi-do"))))

(define (pad:vi-x!)
  (pad:vi-x-go! (pad:vi-use-num!) #t))

(define (pad:vi-x-go! k forward)
  (let* ((st *pl-st*)
         (L (car st))
         (l (cadr st))
         (col (caddr st))
         (ln (list-ref L l))
         (len (length ln))
         (have (if forward (- len col) col)))
    (if (<= have 0)
        (begin
          (set! *pl-rej* (+ *pl-rej* 1))
          (set! *vi-did* 0)
          (set! *pl-say*
                (if *vi-dotting*
                    "nothing to repeat"
                    (if forward "nothing under the cursor" "nothing before the cursor")))
          "vi-do")
        (let* ((n (if (> k have) have k))
               (at (if forward col (- col n)))
               (chs (pad:take n (pad:drop at ln)))
               (ln2 (append (pad:take at ln) (pad:drop (+ at n) ln)))
               (rows (length L))
               (L2 (append (pad:take l L) (cons ln2 (pad:drop (+ l 1) L))))
               (U (pad:vi-undo-push (cons (list L l col) (list-ref st 5)))))
          (set! *pl-st* (list L2 l at (list chs) (list) U))
          (set! *vi-did* 1)
          (if (not *vi-dotting*)
              (pad:vi-remember! (if forward (list "x" k) (list "X" k)))
              0)
          (pad:play-ok! "deleted a letter")
          "vi-do"))))

(define (pad:vi-X!)
  (pad:vi-x-go! (pad:vi-use-num!) #f))

(define (pad:vi-D!)
  (pad:vi-use-num!)
  (let* ((st *pl-st*)
         (col (caddr st))
         (ln (list-ref (car st) (cadr st))))
    (if (>= col (length ln))
        (begin
          (set! *pl-rej* (+ *pl-rej* 1))
          (set! *vi-did* 0)
          (set! *pl-say* (if *vi-dotting* "nothing to repeat" "nothing under the cursor"))
          "vi-do")
        (begin
          (pad:play-cmd! "kill-line")
          (set! *vi-did* 1)
          (if (not *vi-dotting*) (pad:vi-remember! (list "D")) 0)
          (set! *pl-say* "deleted to the end of the line")
          "vi-do"))))

(define (pad:vi-yy!)
  (let* ((k (pad:vi-prod!))
         (L (car *pl-st*))
         (l (cadr *pl-st*))
         (last (- (length L) 1))
         (hi0 (+ l (- k 1)))
         (hi (if (> hi0 last) last hi0)))
    (set! *vi-op* "")
    (pad:vi-yank-lines! l hi)))

(define (pad:vi-p!)
  (let ((k (pad:vi-use-num!)))
    (pad:vi-p-go! k k)))

(define (pad:vi-p-go! k left)
  (if (<= left 0)
      (begin
        (set! *vi-did* 1)
        (if (not *vi-dotting*) (pad:vi-remember! (list "p" k)) 0)
        (set! *pl-say* "pasted")
        "vi-do")
      (let ((r (pad:play-cmd! "yank")))
        (if (string=? r "ok")
            (pad:vi-p-go! k (- left 1))
            (begin (set! *vi-did* 0) "vi-do")))))

(define (pad:vi-rep-ch b k acc)
  (if (<= k 0) acc (pad:vi-rep-ch b (- k 1) (cons b acc))))

(define (pad:vi-replace! b)
  (let* ((k (pad:vi-use-num!))
         (st *pl-st*)
         (L (car st))
         (l (cadr st))
         (col (caddr st))
         (ln (list-ref L l))
         (len (length ln)))
    (if (or (>= col len) (> (+ col k) len))
        (begin
          (set! *pl-rej* (+ *pl-rej* 1))
          (set! *vi-did* 0)
          (set! *pl-say* (if *vi-dotting* "nothing to repeat" "nothing under the cursor"))
          "vi-do")
        (let* ((ln2 (append (pad:take col ln) (pad:vi-rep-ch b k (list)) (pad:drop (+ col k) ln)))
               (L2 (append (pad:take l L) (cons ln2 (pad:drop (+ l 1) L))))
               (U (pad:vi-undo-push (cons (list L l col) (list-ref st 5)))))
          (set! *pl-st* (list L2 l col (list-ref st 3) (list) U))
          (set! *vi-did* 1)
          (if (not *vi-dotting*) (pad:vi-remember! (list "r" k b)) 0)
          (pad:play-ok! "replaced")
          "vi-do"))))

(define (pad:vi-insert-here!)
  (set! *vi-mode* "insert")
  (set! *vi-op* "")
  (set! *vi-cx* #f)
  (pad:vi-title!)
  (set! *pl-say* "insert - type, esc goes back")
  "vi-do")

(define (pad:vi-open-below!)
  (pad:vi-begin-ins! "o")
  (pad:play-cmd! "end")
  (let ((r (pad:play-cmd! "enter")))
    (if (string=? r "ok")
        (pad:vi-insert-here!)
        (begin (set! *vi-ins-how* "") "vi-do"))))

(define (pad:vi-open-above!)
  (pad:vi-begin-ins! "O")
  (pad:play-cmd! "home")
  (let ((r (pad:play-cmd! "open-line")))
    (if (string=? r "ok")
        (pad:vi-insert-here!)
        (begin (set! *vi-ins-how* "") "vi-do"))))

(define (pad:vi-go-insert! cmd how)
  (pad:vi-begin-ins! how)
  (let ((r (pad:play-cmd! cmd)))
    (if (string=? r "ok")
        (pad:vi-insert-here!)
        (begin (set! *vi-ins-how* "") "vi-do"))))

;; Words are runs of letters that are not spaces. w moves to the next
;; one, including the next line; b moves back to the start of a word.
(define (pad:vi-skip-word ln i len)
  (if (or (>= i len) (= (list-ref ln i) 32)) i (pad:vi-skip-word ln (+ i 1) len)))

(define (pad:vi-skip-spaces ln i len)
  (if (or (>= i len) (not (= (list-ref ln i) 32)))
      i
      (pad:vi-skip-spaces ln (+ i 1) len)))

(define (pad:vi-w!)
  (let* ((st *pl-st*)
         (L (car st))
         (l (cadr st))
         (col (caddr st))
         (n (length L))
         (ln (list-ref L l))
         (len (length ln))
         (i (pad:vi-skip-spaces ln (pad:vi-skip-word ln col len) len)))
    (cond
      ((< i len)
       (set! *pl-st* (list L l i (list-ref st 3) (list-ref st 4) (list-ref st 5)))
       (pad:play-ok! *pl-say*)
       "vi-do")
      ((< l (- n 1))
       (set! *pl-st* (list L (+ l 1) 0 (list-ref st 3) (list-ref st 4) (list-ref st 5)))
       (pad:play-ok! *pl-say*)
       "vi-do")
      (#t
       (pad:play-reject! "too-far")
       "vi-do"))))

(define (pad:vi-skip-back-sp ln i)
  (if (or (< i 0) (not (= (list-ref ln i) 32)))
      i
      (pad:vi-skip-back-sp ln (- i 1))))

(define (pad:vi-word-start ln i)
  (if (or (<= i 0) (= (list-ref ln (- i 1)) 32))
      i
      (pad:vi-word-start ln (- i 1))))

(define (pad:vi-b-pos L l col)
  (if (and (= l 0) (= col 0))
      #f
      (let* ((prev (= col 0))
             (l2 (if prev (- l 1) l))
             (ln (list-ref L l2))
             (start (if prev (length ln) col)))
        (if (= start 0)
            (pad:vi-b-pos L l2 0)
            (let ((i (pad:vi-skip-back-sp ln (- start 1))))
              (if (< i 0)
                  (if (= l2 0) #f (pad:vi-b-pos L l2 0))
                  (list l2 (pad:vi-word-start ln i))))))))

(define (pad:vi-b!)
  (let* ((st *pl-st*)
         (pos (pad:vi-b-pos (car st) (cadr st) (caddr st))))
    (if (not pos)
        (begin (pad:play-reject! "too-far") "vi-do")
        (begin
          (set! *pl-st* (list (car st) (car pos) (cadr pos)
                              (list-ref st 3) (list-ref st 4) (list-ref st 5)))
          (pad:play-ok! *pl-say*)
          "vi-do"))))

(define (pad:vi-cancel!)
  (pad:em-abort-point!)
  (set! *vi-op* "")
  (set! *vi-line* "")
  (set! *vi-mx* #f)
  (pad:vi-clear-num!)
  (set! *pl-say* "normal - press i to type")
  "vi-do")

(define (pad:vi-pend! op say)
  (set! *vi-op* op)
  (set! *vi-line* "")
  (set! *vi-mx* #f)
  (set! *vi-cx* #f)
  (set! *pl-say* say)
  "vi-do")

(define (pad:vi-op-pend! op say)
  (set! *vi-num-op* (if (> *vi-num* 0) *vi-num* 0))
  (set! *vi-num* 0)
  (set! *vi-seek* "")
  (set! *vi-obj* "")
  (pad:vi-pend! op say))

(define (pad:vi-redo! b)
  (set! *vi-op* "")
  (pad:vi-cmd b))

(define (pad:vi-act! name)
  (set! *vi-op* "")
  (cond
    ((string=? name "dd") (pad:vi-dd!))
    ((string=? name "x") (pad:vi-x!))
    ((string=? name "X") (pad:vi-X!))
    ((string=? name "D") (pad:vi-D!))
    ((string=? name "yy") (pad:vi-yy!))
    ((string=? name "p") (pad:vi-p!))
    ((string=? name "r") (pad:vi-replace! *vi-arg*))
    ((string=? name "o") (pad:vi-open-below!))
    ((string=? name "O") (pad:vi-open-above!))
    ((string=? name "I") (pad:vi-go-insert! "home" "I"))
    ((string=? name "A") (pad:vi-go-insert! "end" "A"))
    ((string=? name "w") (pad:vi-w-n!))
    ((string=? name "b") (pad:vi-b-n!))
    ((string=? name "eval") (pad:vi-eval!))
    ((string=? name "ZZ") (pad:vi-write! #t))
    ((string=? name "ZQ") (pad:vi-quit! #t))
    ((string=? name "cx")
     (set! *pl-say* "ctrl-x - now ctrl-c quits, ctrl-e runs this page, ctrl-f finds a file")
     "vi-do")
    ((string=? name "cx-no")
     (set! *pl-say* "ctrl-x and that key do not go together")
     "vi-do")
    ((string=? name "c-hint")
     (set! *pl-say* "to quit press ctrl-q (ctrl-x ctrl-c works too)")
     "vi-do")
    ((string=? name "d-hint")
     (pad:vi-clear-num!)
     (set! *pl-say* "d needs a motion")
     "vi-do")
    ((string=? name "y-hint")
     (pad:vi-clear-num!)
     (set! *pl-say* "y needs a motion")
     "vi-do")
    ((string=? name "r-hint")
     (set! *pl-say* "r replaces one letter")
     "vi-do")
    (#t (pad:vi-cancel!))))

(define (pad:vi-prompt?)
  (or (string=? *vi-op* ":") (string=? *vi-op* "find")
      (string=? *vi-op* "buf") (string=? *vi-op* "s")))

;; A word is letters, digits, and the scheme marks ! - ? _. A symbol
;; token wins when the cursor sits on a name, so * does not cut a
;; name in half. Otherwise the letters around the cursor are the word.
(define (pad:vi-word-char? c)
  (or (and (>= c 48) (<= c 57))
      (and (>= c 65) (<= c 90))
      (and (>= c 97) (<= c 122))
      (= c 33) (= c 45) (= c 63) (= c 95)))

(define (pad:vi-word-left ln i)
  (if (<= i 0)
      i
      (if (pad:vi-word-char? (list-ref ln (- i 1)))
          (pad:vi-word-left ln (- i 1))
          i)))

(define (pad:vi-word-right ln i len)
  (if (>= i len)
      i
      (if (pad:vi-word-char? (list-ref ln i))
          (pad:vi-word-right ln (+ i 1) len)
          i)))

;; (word start-point). start-point is -1 when there is no word.
(define (pad:vi-word-span)
  (let* ((L (pad:es-L *pl-st*))
         (tok (pad:sym-tok-in (pad:lc-toks L) (pad:play-point))))
    (if tok
        (list (car (cdr (cdr (cdr tok)))) (cadr tok))
        (let* ((l (cadr *pl-st*))
               (col (caddr *pl-st*))
               (ln (list-ref L l))
               (len (length ln)))
          (if (>= col len)
              (list "" -1)
              (if (not (pad:vi-word-char? (list-ref ln col)))
                  (list "" -1)
                  (let* ((a (pad:vi-word-left ln col))
                         (b (pad:vi-word-right ln col len)))
                    (list (list->string
                           (map integer->char
                                (pad:take (- b a) (pad:drop a ln))))
                          (pad:v-point L l a)))))))))

(define (pad:vi-bound? src i k)
  (let ((n (string-length src)))
    (and (if (= i 0) #t (not (pad:vi-word-char? (string-ref src (- i 1)))))
         (if (>= (+ i k) n)
             #t
             (not (pad:vi-word-char? (string-ref src (+ i k))))))))

(define (pad:vi-skip-src-word src i n)
  (if (>= i n)
      i
      (if (pad:vi-word-char? (string-ref src i))
          (pad:vi-skip-src-word src (+ i 1) n)
          i)))

;; Next exact hit at or after `from`. Whole-word hits must sit on a
;; word boundary, so "hello" does not match inside "hellothere".
(define (pad:vi-find-at src q word from)
  (let ((n (if (string? src) (string-length src) 0))
        (k (string-length q)))
    (if (<= k 0)
        -1
        (if (< from 0)
            -1
            (if (>= from n)
                -1
                (let ((i (string-index src q from)))
                  (cond
                    ((< i 0) -1)
                    ((if word (pad:vi-bound? src i k) #t) i)
                    (#t (pad:vi-find-at src q word
                                        (pad:vi-skip-src-word src i n))))))))))

;; Last hit strictly before `upto`, or best (start with -1).
(define (pad:vi-find-before src q word from upto best)
  (if (>= from upto)
      best
      (let ((i (pad:vi-find-at src q word from)))
        (cond
          ((< i 0) best)
          ((>= i upto) best)
          (#t (pad:vi-find-before src q word (+ i 1) upto i))))))

;; where is "top", "bottom", or "search" (keep the Search: prompt).
;; origin is the match we started from, or -1. Landing on it again
;; means this is the only one.
(define (pad:vi-land-hit! hit q wrapped where origin)
  (let* ((lc (pad:v-linecol (car *pl-st*) hit))
         (here (and (= (cadr *pl-st*) (car lc)) (= (caddr *pl-st*) (cadr lc))))
         (only (or here (and wrapped (>= origin 0) (= hit origin)))))
    (set! *em-hit* hit)
    (if here
        0
        (set! *pl-st* (list (car *pl-st*) (car lc) (cadr lc)
                            (list-ref *pl-st* 3) (list-ref *pl-st* 4)
                            (list-ref *pl-st* 5))))
    (set! *pl-say*
          (cond
            ((string=? where "search") (string-append "Search: " q))
            (only (string-append "only this " q))
            (wrapped
             (string-append "found " q
                            (if (string=? where "bottom")
                                ", from the bottom"
                                ", from the top")))
            (#t (string-append "found " q))))
    "vi-do"))

;; dir 1 searches at/after `from`. dir -1 searches strictly before it.
(define (pad:vi-search-go! q word from dir where origin)
  (let* ((src (pad:play-src))
         (n (string-length src))
         (hit (if (= dir 1)
                  (pad:vi-find-at src q word from)
                  (pad:vi-find-before src q word 0 from -1))))
    (if (>= hit 0)
        (pad:vi-land-hit! hit q #f where origin)
        (let ((hit2 (if (= dir 1)
                        (if (> from 0) (pad:vi-find-at src q word 0) -1)
                        (pad:vi-find-before src q word 0 n -1))))
          (if (< hit2 0)
              (begin (set! *em-hit* #f) (set! *pl-say* "no match") "vi-do")
              (pad:vi-land-hit! hit2 q #t where origin))))))

(define (pad:vi-star! dir)
  (let* ((span (pad:vi-word-span))
         (q (car span))
         (origin (cadr span)))
    (if (or (string=? q "") (< origin 0))
        (begin (set! *pl-say* "put the cursor on a word first") "vi-do")
        (begin
          (set! *vi-pat* q)
          (set! *vi-pat-word* #t)
          (pad:vi-search-go! q #t
                             (if (= dir 1) (+ origin (string-length q)) origin)
                             dir
                             (if (= dir 1) "top" "bottom")
                             origin)))))

(define (pad:vi-again! dir)
  (if (string=? *vi-pat* "")
      (begin (set! *pl-say* "press * or / to search first") "vi-do")
      (let ((origin (if (number? *em-hit*) *em-hit* -1))
            (pt (pad:play-point)))
        (pad:vi-search-go! *vi-pat* *vi-pat-word*
                           (if (= dir 1) (+ pt 1) pt)
                           dir
                           (if (= dir 1) "top" "bottom")
                           origin))))

;; Next reference start after pt, or -1 to wrap to the first.
(define (pad:vi-next-ref refs pt)
  (cond
    ((null? refs) -1)
    ((> (car refs) pt) (car refs))
    (#t (pad:vi-next-ref (cdr refs) pt))))

(define (pad:vi-ref-last refs)
  (if (null? (cdr refs)) (car refs) (pad:vi-ref-last (cdr refs))))

(define (pad:vi-ref-prev refs pt best)
  (cond
    ((null? refs) best)
    ((< (car refs) pt) (pad:vi-ref-prev (cdr refs) pt (car refs)))
    (#t best)))

(define (pad:vi-ref-index refs dest i)
  (cond
    ((null? refs) 0)
    ((= (car refs) dest) i)
    (#t (pad:vi-ref-index (cdr refs) dest (+ i 1)))))

;; dir 1 is the next use, dir -1 the previous. (dest wrapped?)
(define (pad:vi-ref-pick refs pt dir)
  (if (= dir 1)
      (let ((nxt (pad:vi-next-ref refs pt)))
        (if (< nxt 0) (list (car refs) #t) (list nxt #f)))
      (let ((prv (pad:vi-ref-prev refs pt -1)))
        (if (< prv 0)
            (list (pad:vi-ref-last refs) #t)
            (list prv #f)))))

(define (pad:vi-jump! cmd)
  (pad:play-jump! cmd)
  "vi-do")

;; gD / space c D walk every use. The line says "name 2/3 line 4" (the
;; line number matches the gutter, which starts at 1). space c N / gN
;; walk back. n and N stay on the search, not on this list.
(define (pad:vi-refs! dir)
  (let* ((src (pad:play-src))
         (pt (pad:play-point))
         (toks (pad:lc-toks (pad:es-L *pl-st*)))
         (name (pad:sym-at-in toks pt))
         (r (pad:find-refs-cmd-in (pad:js src pt *pl-stack*) toks)))
    (if (not (string=? (car r) "ok"))
        (pad:play-reject! (car r))
        (let* ((refs (list-ref r 3))
               (n (length refs))
               (pick (pad:vi-ref-pick refs pt dir))
               (dest (car pick))
               (wrapped (cadr pick))
               (idx (pad:vi-ref-index refs dest 0))
               (lc (pad:v-linecol (pad:es-L *pl-st*) dest)))
          (if (= dest pt)
              0
              (begin
                (set! *pl-stack* (cons pt *pl-stack*))
                (pad:play-move-to! dest)))
          (pad:play-ok!
           (string-append name " "
                          (number->string (+ idx 1)) "/" (number->string n)
                          " line " (number->string (+ (car lc) 1))
                          (if (and wrapped (> n 1)) " again" "")))))
    "vi-do"))

;; Ask the next wire-v2 frame to resend every row. Selection color lives
;; in the mark tape, and a one-row delta would leave the old color up.
(define (pad:vi-repaint!)
  (try (set! *w2-full* #t) (catch (e) 0)))

;; Visual line mode. V anchors the current line. Motions extend the
;; selection. The mark letter v paints those lines. y copies them.
;; d deletes them. p pastes and leaves visual.
(define (pad:vi-vcount)
  (let ((a *vi-vanchor*) (b (cadr *pl-st*)))
    (if (< a 0)
        1
        (if (<= a b) (+ (- b a) 1) (+ (- a b) 1)))))

(define (pad:vi-visual-say!)
  (let ((n (pad:vi-vcount)))
    (set! *pl-say*
          (if (= n 1)
              "visual - this line, y copies, d deletes"
              (string-append "visual - " (number->string n)
                             " lines, y copies, d deletes")))
    0))

(define (pad:vi-visual-move! cmd)
  (pad:vi-repaint!)
  (pad:vi-move-go! cmd (pad:vi-use-num!) #f *pl-say*)
  (pad:vi-visual-say!)
  "vi-do")

(define (pad:vi-visual-off!)
  (pad:vi-repaint!)
  (set! *vi-mode* "normal")
  (set! *vi-vanchor* -1)
  (set! *vi-op* "")
  (pad:vi-title!)
  0)

(define (pad:vi-visual!)
  (if (string=? *vi-mode* "visual")
      (begin
        (pad:vi-visual-off!)
        (set! *pl-say* "normal - press i to type")
        "vi-do")
      (begin
        (pad:vi-repaint!)
        (set! *vi-mode* "visual")
        (set! *vi-vanchor* (cadr *pl-st*))
        (set! *vi-op* "")
        (set! *vi-cx* #f)
        (pad:vi-title!)
        (pad:vi-visual-say!)
        "vi-do")))

(define (pad:vi-vy!)
  (let* ((st *pl-st*)
         (a *vi-vanchor*)
         (b (cadr st))
         (lo (if (<= a b) a b))
         (hi (if (<= a b) b a))
         (lines (pad:sublist (car st) lo (+ hi 1)))
         (n (pad:vi-vcount)))
    (set! *pl-st* (list (car st) (cadr st) (caddr st)
                        (append lines (list (list))) (list) (list-ref st 5)))
    (pad:vi-visual-off!)
    (set! *pl-say* (if (= n 1) "copied the line"
                       (string-append "copied " (number->string n) " lines")))
    "vi-do"))

(define (pad:vi-visual-range)
  (let ((a *vi-vanchor*) (b (cadr *pl-st*)))
    (if (<= a b) (list a b) (list b a))))

(define (pad:vi-visual-d!)
  (let* ((r (pad:vi-visual-range))
         (n (+ (- (cadr r) (car r)) 1)))
    (pad:vi-clear-num!)
    (set! *vi-pend-rec* (list "dd" n))
    (pad:vi-visual-off!)
    (pad:vi-delete-lines! (car r) (cadr r))))

(define (pad:vi-visual-c!)
  (let* ((r (pad:vi-visual-range))
         (n (+ (- (cadr r) (car r)) 1)))
    (pad:vi-clear-num!)
    (set! *vi-pend-rec* (list "cc" n))
    (pad:vi-visual-off!)
    (pad:vi-change-lines! (car r) (cadr r))))

(define (pad:vi-visual-byte b)
  (cond
    ((= b 27) (begin (set! *vi-vanchor* -1) "to-normal"))
    ((= b 86) (pad:vi-visual!))
    ((pad:vi-digit? b) (pad:vi-num-add! b))
    ((= b 121) (begin (pad:vi-clear-num!) (pad:vi-vy!)))
    ((or (= b 100) (= b 120)) (pad:vi-visual-d!))
    ((= b 99) (pad:vi-visual-c!))
    ((= b 112) (begin (pad:vi-visual-off!) (pad:vi-p!)))
    ((or (= b 104) (= b 2)) (pad:vi-visual-move! "left"))
    ((or (= b 108) (= b 6)) (pad:vi-visual-move! "right"))
    ((or (= b 106) (= b 14)) (pad:vi-visual-move! "next-line"))
    ((or (= b 107) (= b 16)) (pad:vi-visual-move! "prev-line"))
    ((or (= b 48) (= b 1)) (pad:vi-visual-move! "home"))
    ((or (= b 36) (= b 5)) (pad:vi-visual-move! "end"))
    ((= b 71)
     (if (> *vi-num* 0)
         (begin
           (pad:vi-goto! (pad:vi-use-num!))
           (pad:vi-repaint!)
           (pad:vi-visual-say!)
           "vi-do")
         (pad:vi-visual-move! "eob")))
    ((= b 119)
     (begin (pad:vi-w-n!) (pad:vi-repaint!) (pad:vi-visual-say!) "vi-do"))
    ((= b 98)
     (begin (pad:vi-b-n!) (pad:vi-repaint!) (pad:vi-visual-say!) "vi-do"))
    ((= b 103) (pad:vi-pend! "g" "g to the top"))
    ((or (= b 102) (= b 70) (= b 116) (= b 84))
     (pad:vi-seek! (list->string (list b))))
    ((= b 59) (pad:vi-again-find! #f))
    ((= b 44) (pad:vi-again-find! #t))
    ((= b 46) (begin (pad:vi-clear-num!) (pad:vi-visual-say!) "vi-do"))
    (#t (begin (pad:vi-visual-say!) "vi-do"))))

;; Counts, f/t, dot, and text objects. A failed change does not replace
;; the last one . will repeat.

(define (pad:vi-clear-num!)
  (set! *vi-num* 0)
  (set! *vi-num-op* 0)
  (set! *vi-seek* "")
  (set! *vi-obj* "")
  (set! *vi-pend-rec* #f)
  0)

(define (pad:vi-digit? b)
  (if (and (>= b 49) (<= b 57))
      #t
      (if (and (= b 48) (> *vi-num* 0)) #t #f)))

(define (pad:vi-num-add! b)
  (let ((n (+ (* *vi-num* 10) (- b 48))))
    (set! *vi-num* (if (> n 99) 99 n))
    (set! *pl-say* (number->string *vi-num*))
    "vi-do"))

(define (pad:vi-use-num!)
  (let ((n (if (> *vi-num* 0) *vi-num* 1)))
    (set! *vi-num* 0)
    (set! *vi-num-op* 0)
    n))

(define (pad:vi-prod!)
  (let* ((a (if (> *vi-num-op* 0) *vi-num-op* 1))
         (b (if (> *vi-num* 0) *vi-num* 1))
         (p (* a b)))
    (set! *vi-num* 0)
    (set! *vi-num-op* 0)
    (if (> p 99) 99 p)))

(define (pad:vi-word! w)
  (set! *vi-num* 0)
  (set! *vi-num-op* 0)
  w)

(define (pad:vi-remember! spec)
  (set! *vi-last* (list "do" spec #f))
  0)

(define (pad:vi-arm-change! spec)
  (set! *vi-chg* spec)
  (set! *vi-ins-how* "c")
  (set! *vi-ins* (list))
  (set! *vi-ins-times* 1)
  0)

(define (pad:vi-note! kind)
  (set! *vi-did* 1)
  (if *vi-dotting*
      (set! *vi-pend-rec* #f)
      (cond
        ((string=? kind "y") (set! *vi-pend-rec* #f))
        ((string=? kind "c")
         (begin
           (if *vi-pend-rec* (pad:vi-arm-change! *vi-pend-rec*) 0)
           (set! *vi-pend-rec* #f)))
        (#t
         (begin
           (if *vi-pend-rec* (pad:vi-remember! *vi-pend-rec*) 0)
           (set! *vi-pend-rec* #f)))))
  0)

(define (pad:vi-begin-ins! how)
  (set! *vi-ins-how* how)
  (set! *vi-ins* (list))
  (set! *vi-ins-times*
        (if (or (string=? how "i") (string=? how "a"))
            (if (> *vi-num* 0) *vi-num* 1)
            1))
  (set! *vi-num* 0)
  (set! *vi-num-op* 0)
  (set! *vi-seek* "")
  (set! *vi-obj* "")
  0)

(define (pad:vi-put-text! bs)
  (if (null? bs)
      0
      (let ((r (pad:play-cmd! (car bs))))
        (if (string=? r "ok") (pad:vi-put-text! (cdr bs)) 0))))

(define (pad:vi-put-times! text n)
  (if (<= n 0)
      0
      (begin (pad:vi-put-text! text) (pad:vi-put-times! text (- n 1)))))

(define (pad:vi-ins-byte! b)
  (if (string=? *vi-ins-how* "")
      0
      (set! *vi-ins* (cons b *vi-ins*))))

(define (pad:vi-ins-pop!)
  (if (pair? *vi-ins*) (set! *vi-ins* (cdr *vi-ins*)) 0))

(define (pad:vi-ins-close!)
  (let ((how *vi-ins-how*)
        (text (reverse *vi-ins*))
        (times *vi-ins-times*))
    (set! *vi-ins-how* "")
    (set! *vi-ins* (list))
    (set! *vi-ins-times* 1)
    (cond
      ((string=? how "") 0)
      ((string=? how "c")
       (begin
         (if *vi-chg* (set! *vi-last* (list "do" *vi-chg* text)) 0)
         (set! *vi-chg* #f)
         0))
      ((null? text) 0)
      (#t
       (begin
         (if (> times 1) (pad:vi-put-times! text (- times 1)) 0)
         (if (not *vi-dotting*)
             (set! *vi-last* (list "type" how text times))
             0)
         0)))))

(define (pad:vi-maybe-text! text)
  (if (pair? text) (pad:vi-put-text! text) 0))

(define (pad:vi-move-go! cmd n moved say)
  (if (<= n 0)
      "vi-do"
      (let ((r (pad:play-cmd! cmd)))
        (if (string=? r "ok")
            (pad:vi-move-go! cmd (- n 1) #t say)
            (begin
              (if moved
                  (begin (set! *pl-rej* (- *pl-rej* 1)) (set! *pl-say* say))
                  0)
              "vi-do")))))

(define (pad:vi-move-n! cmd)
  (pad:vi-move-go! cmd (pad:vi-use-num!) #f *pl-say*))

(define (pad:vi-goto! line1)
  (let* ((L (car *pl-st*))
         (n (length L))
         (l (cond ((< line1 1) 0) ((> line1 n) (- n 1)) (#t (- line1 1)))))
    (set! *pl-st* (list L l 0 (list-ref *pl-st* 3) (list-ref *pl-st* 4) (list-ref *pl-st* 5)))
    (pad:play-ok! *pl-say*)
    "vi-do"))

(define (pad:vi-G!)
  (if (> *vi-num* 0)
      (pad:vi-goto! (pad:vi-use-num!))
      (pad:vi-word! "eob")))

(define (pad:vi-dd-go! k)
  (let* ((L (car *pl-st*))
         (l (cadr *pl-st*))
         (last (- (length L) 1))
         (hi0 (+ l (- k 1)))
         (hi (if (> hi0 last) last hi0)))
    (set! *vi-op* "")
    (if (not *vi-dotting*) (set! *vi-pend-rec* (list "dd" k)) 0)
    (pad:vi-delete-lines! l hi)))

(define (pad:vi-dd!)
  (pad:vi-dd-go! (pad:vi-prod!)))

(define (pad:vi-cc-go! k)
  (let* ((L (car *pl-st*))
         (l (cadr *pl-st*))
         (last (- (length L) 1))
         (hi0 (+ l (- k 1)))
         (hi (if (> hi0 last) last hi0)))
    (set! *vi-op* "")
    (if (not *vi-dotting*) (set! *vi-pend-rec* (list "cc" k)) 0)
    (pad:vi-change-lines! l hi)))

(define (pad:vi-cc!)
  (pad:vi-cc-go! (pad:vi-prod!)))

(define (pad:vi-line-to l nlines k)
  (if (>= l (- nlines 1))
      #f
      (let ((t (+ l k)))
        (if (>= t nlines) (- nlines 1) t))))

(define (pad:vi-line-up l k)
  (if (<= l 0) #f (if (> k l) 0 (- l k))))

(define (pad:vi-line-motion! op dir k)
  (let* ((l (cadr *pl-st*))
         (nlines (length (car *pl-st*)))
         (t (if (> dir 0) (pad:vi-line-to l nlines k) (pad:vi-line-up l k))))
    (if (not t)
        (pad:vi-op-fail! op)
        (begin
          (if (and (not *vi-dotting*) (not (string=? op "y")))
              (set! *vi-pend-rec* (list (if (> dir 0) "lj" "lk") op k))
              0)
          (pad:vi-op-lines! op l t)))))

(define (pad:vi-hop L l col dir k)
  (if (<= k 0)
      (list l col)
      (let* ((len (length (list-ref L l)))
             (nlines (length L))
             (nxt (if (> dir 0)
                      (if (< col len)
                          (list l (+ col 1))
                          (if (< l (- nlines 1)) (list (+ l 1) 0) #f))
                      (if (> col 0)
                          (list l (- col 1))
                          (if (> l 0)
                              (list (- l 1) (length (list-ref L (- l 1))))
                              #f)))))
        (if nxt
            (let ((r (pad:vi-hop L (car nxt) (cadr nxt) dir (- k 1))))
              (if r r nxt))
            #f))))

(define (pad:vi-w-dest-go L l col k last)
  (if (<= k 0)
      last
      (let ((p (pad:vi-w-pos L l col)))
        (if p (pad:vi-w-dest-go L (car p) (cadr p) (- k 1) p) last))))

(define (pad:vi-w-dest L l col k)
  (pad:vi-w-dest-go L l col k #f))

(define (pad:vi-b-dest-go L l col k last)
  (if (<= k 0)
      last
      (let ((p (pad:vi-b-pos L l col)))
        (if p (pad:vi-b-dest-go L (car p) (cadr p) (- k 1) p) last))))

(define (pad:vi-b-dest L l col k)
  (pad:vi-b-dest-go L l col k #f))

(define (pad:vi-char-motion! op kind k)
  (let* ((st *pl-st*)
         (L (car st))
         (l (cadr st))
         (col (caddr st))
         (len (length (list-ref L l)))
         (dest (cond
                 ((string=? kind "h") (pad:vi-hop L l col -1 k))
                 ((string=? kind "l") (pad:vi-hop L l col 1 k))
                 ((string=? kind "0") (if (> col 0) (list l 0) #f))
                 ((string=? kind "$") (if (< col len) (list l len) #f))
                 ((string=? kind "w") (pad:vi-w-dest L l col k))
                 ((string=? kind "b") (pad:vi-b-dest L l col k))
                 (#t #f))))
    (if (not dest)
        (pad:vi-op-fail! op)
        (begin
          (if (and (not *vi-dotting*) (not (string=? op "y")))
              (set! *vi-pend-rec* (list "ch" op kind k))
              0)
          (pad:vi-char-op! op (car dest) (cadr dest))))))

(define (pad:vi-w-n!)
  (let* ((k (pad:vi-use-num!))
         (st *pl-st*)
         (p (pad:vi-w-dest (car st) (cadr st) (caddr st) k)))
    (if p
        (begin
          (set! *pl-st* (list (car st) (car p) (cadr p)
                              (list-ref st 3) (list-ref st 4) (list-ref st 5)))
          (pad:play-ok! *pl-say*)
          "vi-do")
        (begin (pad:play-reject! "too-far") "vi-do"))))

(define (pad:vi-b-n!)
  (let* ((k (pad:vi-use-num!))
         (st *pl-st*)
         (p (pad:vi-b-dest (car st) (cadr st) (caddr st) k)))
    (if p
        (begin
          (set! *pl-st* (list (car st) (car p) (cadr p)
                              (list-ref st 3) (list-ref st 4) (list-ref st 5)))
          (pad:play-ok! *pl-say*)
          "vi-do")
        (begin (pad:play-reject! "too-far") "vi-do"))))

(define (pad:vi-G-op! op)
  (let* ((k (if (> *vi-num* 0) *vi-num* (if (> *vi-num-op* 0) *vi-num-op* 0)))
         (nlines (length (car *pl-st*)))
         (line (if (> k 0)
                   (if (> k nlines) (- nlines 1) (- k 1))
                   (- nlines 1))))
    (set! *vi-num* 0)
    (set! *vi-num-op* 0)
    (if (and (not *vi-dotting*) (not (string=? op "y")))
        (set! *vi-pend-rec* (if (> k 0) (list "lno" op line) (list "lG" op)))
        0)
    (pad:vi-op-lines! op (cadr *pl-st*) line)))

(define (pad:vi-gg-op! op)
  (let* ((k (if (> *vi-num* 0) *vi-num* (if (> *vi-num-op* 0) *vi-num-op* 0)))
         (nlines (length (car *pl-st*)))
         (line (if (> k 0) (if (> k nlines) (- nlines 1) (- k 1)) 0)))
    (set! *vi-num* 0)
    (set! *vi-num-op* 0)
    (if (string=? *vi-mode* "visual")
        (begin
          (pad:vi-repaint!)
          (set! *pl-st* (list (car *pl-st*) line 0
                              (list-ref *pl-st* 3) (list-ref *pl-st* 4)
                              (list-ref *pl-st* 5)))
          (set! *pl-keys* (+ *pl-keys* 1))
          (pad:vi-visual-say!)
          "vi-do")
        (begin
          (if (and (not *vi-dotting*) (not (string=? op "y")))
              (set! *vi-pend-rec* (if (> k 0) (list "lno" op line) (list "lg" op)))
              0)
          (pad:vi-op-lines! op (cadr *pl-st*) line)))))

(define (pad:vi-scan-fwd ln i len ch k)
  (if (>= i len)
      -1
      (if (= (list-ref ln i) ch)
          (if (<= k 1) i (pad:vi-scan-fwd ln (+ i 1) len ch (- k 1)))
          (pad:vi-scan-fwd ln (+ i 1) len ch k))))

(define (pad:vi-scan-back ln i ch k)
  (if (< i 0)
      -1
      (if (= (list-ref ln i) ch)
          (if (<= k 1) i (pad:vi-scan-back ln (- i 1) ch (- k 1)))
          (pad:vi-scan-back ln (- i 1) ch k))))

(define (pad:vi-find-dest dir till match col)
  (if (> dir 0)
      (let ((d (if (= till 0) (+ match 1) match)))
        (if (= d col) -1 d))
      (let ((d (if (= till 0) match (+ match 1))))
        (if (= d col) -1 d))))

(define (pad:vi-find-land-col dir till match)
  (cond
    ((and (> dir 0) (= till 0)) match)
    ((and (> dir 0) (= till 1)) (- match 1))
    ((and (< dir 0) (= till 0)) match)
    (#t (+ match 1))))

(define (pad:vi-find-land! l land)
  (let ((st *pl-st*))
    (set! *pl-st* (list (car st) l land (list-ref st 3) (list-ref st 4) (list-ref st 5)))
    (if (string=? *vi-mode* "visual")
        (begin
          (pad:vi-repaint!)
          (set! *pl-keys* (+ *pl-keys* 1))
          (pad:vi-visual-say!)
          "vi-do")
        (begin (pad:play-ok! "moved") "vi-do"))))

(define (pad:vi-find-go! op dir till ch k)
  (let* ((st *pl-st*)
         (L (car st))
         (l (cadr st))
         (col (caddr st))
         (ln (list-ref L l))
         (len (length ln))
         (match (if (> dir 0)
                    (pad:vi-scan-fwd ln (+ col 1) len ch k)
                    (pad:vi-scan-back ln (- col 1) ch k))))
    (set! *vi-op* "")
    (if (< match 0)
        (begin
          (set! *pl-rej* (+ *pl-rej* 1))
          (set! *vi-did* 0)
          (set! *vi-pend-rec* #f)
          (set! *pl-say* (if *vi-dotting* "nothing to repeat" "not on this line"))
          "vi-do")
        (if (string=? op "")
            (let ((land (pad:vi-find-land-col dir till match)))
              (if (= land col)
                  (begin
                    (set! *pl-rej* (+ *pl-rej* 1))
                    (set! *pl-say* "not on this line")
                    "vi-do")
                  (pad:vi-find-land! l land)))
            (let ((dest (pad:vi-find-dest dir till match col)))
              (if (< dest 0)
                  (pad:vi-op-fail! op)
                  (begin
                    (if (and (not *vi-dotting*) (not (string=? op "y")))
                        (set! *vi-pend-rec* (list "find" op dir till ch k))
                        0)
                    (pad:vi-char-op! op l dest))))))))

(define (pad:vi-run-find! op dir till ch)
  (pad:vi-find-go! op dir till ch (pad:vi-prod!)))

(define (pad:vi-do-find! op kind ch)
  (let ((dir (if (or (string=? kind "F") (string=? kind "T")) -1 1))
        (till (if (or (string=? kind "t") (string=? kind "T")) 1 0)))
    (set! *vi-find-ch* ch)
    (set! *vi-find-dir* dir)
    (set! *vi-find-till* till)
    (pad:vi-run-find! op dir till ch)))

(define (pad:vi-seek! kind)
  (set! *vi-seek* kind)
  (if (not (or (string=? *vi-op* "d") (string=? *vi-op* "c") (string=? *vi-op* "y")))
      (set! *vi-op* kind)
      0)
  (set! *pl-say* (string-append kind " - type the letter"))
  "vi-do")

(define (pad:vi-seek-char! b)
  (let ((kind *vi-seek*)
        (op *vi-op*))
    (set! *vi-seek* "")
    (cond
      ((= b 7) (pad:em-keyboard-quit!))
      ((= b 27) (begin (set! *vi-op* "") "to-normal"))
      ((and (>= b 32) (<= b 126))
       (pad:vi-do-find!
         (if (or (string=? op "d") (string=? op "c") (string=? op "y")) op "")
         kind b))
      (#t
       (set! *vi-op* "")
       (set! *pl-rej* (+ *pl-rej* 1))
       (set! *pl-say* "not on this line")
       "vi-do"))))

(define (pad:vi-again-find! flip)
  (if (= *vi-find-ch* 0)
      (begin
        (set! *vi-op* "")
        (pad:vi-clear-num!)
        (set! *pl-say* "press f or t first")
        "vi-do")
      (let ((dir (if flip (- 0 *vi-find-dir*) *vi-find-dir*))
            (op (if (or (string=? *vi-op* "d") (string=? *vi-op* "c") (string=? *vi-op* "y"))
                    *vi-op* "")))
        (pad:vi-run-find! op dir *vi-find-till* *vi-find-ch*))))

(define (pad:vi-obj-pend! kind)
  (set! *vi-obj* kind)
  (set! *pl-say* (string-append kind " - w, quote, or paren"))
  "vi-do")

(define (pad:vi-next-kw ln i len)
  (if (>= i len)
      -1
      (if (pad:vi-word-char? (list-ref ln i))
          i
          (pad:vi-next-kw ln (+ i 1) len))))

(define (pad:vi-prev-kw ln i)
  (if (< i 0)
      -1
      (if (pad:vi-word-char? (list-ref ln i))
          i
          (pad:vi-prev-kw ln (- i 1)))))

(define (pad:vi-iw-one ln col len)
  (if (and (< col len) (>= col 0) (pad:vi-word-char? (list-ref ln col)))
      (list (pad:vi-word-left ln col) (pad:vi-word-right ln col len))
      (let ((a (pad:vi-next-kw ln (if (>= col len) len (if (< col 0) 0 col)) len)))
        (if (>= a 0)
            (list a (pad:vi-word-right ln a len))
            (let ((p (pad:vi-prev-kw ln (if (>= col len) (- len 1) (- col 1)))))
              (if (< p 0)
                  #f
                  (list (pad:vi-word-left ln p) (pad:vi-word-right ln p len))))))))

(define (pad:vi-iw-more ln b len n)
  (if (<= n 1)
      b
      (let ((a (pad:vi-next-kw ln b len)))
        (if (< a 0)
            b
            (pad:vi-iw-more ln (pad:vi-word-right ln a len) len (- n 1))))))

(define (pad:vi-back-sp ln i)
  (if (<= i 0)
      i
      (if (= (list-ref ln (- i 1)) 32)
          (pad:vi-back-sp ln (- i 1))
          i)))

(define (pad:vi-span-op! op a b)
  (set! *vi-op* "")
  (let* ((st *pl-st*)
         (L (car st))
         (l (cadr st))
         (col (caddr st)))
    (if (>= a b)
        (pad:vi-op-fail! op)
        (let ((kill (pad:region-text L l a l b)))
          (if (string=? op "y")
              (begin
                (set! *pl-st* (list L l col kill (list-ref st 4) (list-ref st 5)))
                (pad:vi-note! "y")
                (pad:play-ok! "copied")
                "vi-do")
              (let ((L2 (pad:region-delete L l a l b))
                    (U (pad:vi-undo-push (cons (list L l col) (list-ref st 5)))))
                (set! *pl-st* (list L2 l a kill (list) U))
                (pad:vi-note! (if (string=? op "c") "c" "d"))
                (if (and (string=? op "c") (not *vi-dotting*))
                    (begin (pad:play-ok! "insert - type, esc goes back")
                           (pad:vi-insert-here!))
                    (begin (pad:play-ok! "deleted") "vi-do"))))))))

(define (pad:vi-apply-span! op a b spec)
  (if (or (< a 0) (<= b a))
      (pad:vi-op-fail! op)
      (begin
        (if (and (not *vi-dotting*) (not (string=? op "y")))
            (set! *vi-pend-rec* spec)
            0)
        (pad:vi-span-op! op a b))))

(define (pad:vi-obj-word! op kind k)
  (let* ((L (car *pl-st*))
         (l (cadr *pl-st*))
         (col (caddr *pl-st*))
         (ln (list-ref L l))
         (len (length ln))
         (s (pad:vi-iw-one ln col len)))
    (if (not s)
        (pad:vi-op-fail! op)
        (let* ((a (car s))
               (b (pad:vi-iw-more ln (cadr s) len k))
               (b2 (if (string=? kind "aw") (pad:vi-skip-spaces ln b len) b))
               (a2 (if (and (string=? kind "aw") (= b2 b)) (pad:vi-back-sp ln a) a)))
          (pad:vi-apply-span! op a2 b2 (list "obj" op kind k 0))))))

(define (pad:vi-qpairs ln q i len acc)
  (if (>= i len)
      acc
      (if (= (list-ref ln i) q)
          (pad:vi-qpairs2 ln q (+ i 1) len i acc)
          (pad:vi-qpairs ln q (+ i 1) len acc))))

(define (pad:vi-qpairs2 ln q i len open acc)
  (if (>= i len)
      acc
      (if (= (list-ref ln i) q)
          (pad:vi-qpairs ln q (+ i 1) len (cons (list open i) acc))
          (pad:vi-qpairs2 ln q (+ i 1) len open acc))))

(define (pad:vi-better-in best p)
  (if (not best) p (if (> (car p) (car best)) p best)))

(define (pad:vi-better-next best p col)
  (if (< (car p) col)
      best
      (if (not best) p (if (< (car p) (car best)) p best))))

(define (pad:vi-best-pair ps col best-in best-next)
  (if (null? ps)
      (if best-in best-in best-next)
      (let ((p (car ps)))
        (pad:vi-best-pair (cdr ps) col
                          (if (and (>= col (car p)) (<= col (cadr p)))
                              (pad:vi-better-in best-in p)
                              best-in)
                          (pad:vi-better-next best-next p col)))))

(define (pad:vi-obj-quote! op kind q k)
  (let* ((ln (list-ref (car *pl-st*) (cadr *pl-st*)))
         (col (caddr *pl-st*))
         (pair (pad:vi-best-pair (pad:vi-qpairs ln q 0 (length ln) (list)) col #f #f)))
    (if (not pair)
        (pad:vi-op-fail! op)
        (let ((a (if (string=? kind "iq") (+ (car pair) 1) (car pair)))
              (b (if (string=? kind "iq") (cadr pair) (+ (cadr pair) 1))))
          (pad:vi-apply-span! op a b (list "obj" op kind k q))))))

(define (pad:vi-plist ln i len stack acc)
  (if (>= i len)
      acc
      (let ((c (list-ref ln i)))
        (cond
          ((= c 40)
           (pad:vi-plist ln (+ i 1) len (cons i stack) acc))
          ((and (= c 41) (pair? stack))
           (pad:vi-plist ln (+ i 1) len (cdr stack) (cons (list (car stack) i) acc)))
          (#t (pad:vi-plist ln (+ i 1) len stack acc))))))

(define (pad:vi-obj-paren! op kind k)
  (let* ((ln (list-ref (car *pl-st*) (cadr *pl-st*)))
         (col (caddr *pl-st*))
         (pair (pad:vi-best-pair (pad:vi-plist ln 0 (length ln) (list) (list)) col #f #f)))
    (if (not pair)
        (pad:vi-op-fail! op)
        (let ((a (if (string=? kind "ip") (+ (car pair) 1) (car pair)))
              (b (if (string=? kind "ip") (cadr pair) (+ (cadr pair) 1))))
          (pad:vi-apply-span! op a b (list "obj" op kind k 0))))))

(define (pad:vi-obj-go! op kind k extra)
  (cond
    ((or (string=? kind "iw") (string=? kind "aw")) (pad:vi-obj-word! op kind k))
    ((or (string=? kind "iq") (string=? kind "aq")) (pad:vi-obj-quote! op kind extra k))
    (#t (pad:vi-obj-paren! op kind k))))

(define (pad:vi-obj-char! b)
  (let ((kind *vi-obj*)
        (op *vi-op*)
        (k (pad:vi-prod!)))
    (set! *vi-obj* "")
    (cond
      ((= b 119)
       (pad:vi-obj-word! op (if (string=? kind "a") "aw" "iw") k))
      ((or (= b 34) (= b 39))
       (pad:vi-obj-quote! op (if (string=? kind "a") "aq" "iq") b k))
      ((or (= b 40) (= b 41) (= b 98))
       (pad:vi-obj-paren! op (if (string=? kind "a") "ap" "ip") k))
      (#t (pad:vi-op-fail! op)))))

(define (pad:vi-spec-n spec k)
  (if (<= k 0)
      spec
      (let ((t (car spec)))
        (cond
          ((or (string=? t "dd") (string=? t "cc") (string=? t "x")
               (string=? t "X") (string=? t "p"))
           (list t k))
          ((string=? t "r") (list "r" k (list-ref spec 2)))
          ((or (string=? t "lj") (string=? t "lk"))
           (list t (list-ref spec 1) k))
          ((string=? t "ch")
           (list "ch" (list-ref spec 1) (list-ref spec 2) k))
          ((string=? t "find")
           (list "find" (list-ref spec 1) (list-ref spec 2)
                 (list-ref spec 3) (list-ref spec 4) k))
          ((string=? t "obj")
           (list "obj" (list-ref spec 1) (list-ref spec 2) k (list-ref spec 4)))
          ((string=? t "lno")
           (list "lno" (list-ref spec 1) (- k 1)))
          (#t spec)))))

(define (pad:vi-replay-type! how text times)
  (cond
    ((string=? how "a") (if (pad:vi-can-right?) (pad:play-cmd! "right") 0))
    ((string=? how "I") (pad:play-cmd! "home"))
    ((string=? how "A") (pad:play-cmd! "end"))
    ((string=? how "o") (begin (pad:play-cmd! "end") (pad:play-cmd! "enter")))
    ((string=? how "O") (begin (pad:play-cmd! "home") (pad:play-cmd! "open-line")))
    (#t 0))
  (pad:vi-put-times! text times)
  (set! *vi-did* 1)
  "vi-do")

(define (pad:vi-replay-do! spec text)
  (let ((t (car spec)))
    (cond
      ((string=? t "dd") (pad:vi-dd-go! (list-ref spec 1)))
      ((string=? t "cc")
       (begin
         (pad:vi-cc-go! (list-ref spec 1))
         (if (> *vi-did* 0) (pad:vi-maybe-text! text) 0)
         "vi-do"))
      ((string=? t "x") (pad:vi-x-go! (list-ref spec 1) #t))
      ((string=? t "X") (pad:vi-x-go! (list-ref spec 1) #f))
      ((string=? t "p") (pad:vi-p-go! (list-ref spec 1) (list-ref spec 1)))
      ((string=? t "r")
       (begin
         (set! *vi-arg* (list-ref spec 2))
         (set! *vi-num* (list-ref spec 1))
         (pad:vi-replace! *vi-arg*)))
      ((string=? t "D") (pad:vi-D!))
      ((or (string=? t "lj") (string=? t "lk"))
       (begin
         (pad:vi-line-motion! (list-ref spec 1) (if (string=? t "lj") 1 -1) (list-ref spec 2))
         (if (> *vi-did* 0) (pad:vi-maybe-text! text) 0)
         "vi-do"))
      ((or (string=? t "lG") (string=? t "lg") (string=? t "lno"))
       (let ((line (cond
                     ((string=? t "lg") 0)
                     ((string=? t "lno") (list-ref spec 2))
                     (#t (- (length (car *pl-st*)) 1)))))
         (begin
           (pad:vi-op-lines! (list-ref spec 1) (cadr *pl-st*) line)
           (if (> *vi-did* 0) (pad:vi-maybe-text! text) 0)
           "vi-do")))
      ((string=? t "ch")
       (begin
         (pad:vi-char-motion! (list-ref spec 1) (list-ref spec 2) (list-ref spec 3))
         (if (> *vi-did* 0) (pad:vi-maybe-text! text) 0)
         "vi-do"))
      ((string=? t "find")
       (begin
         (pad:vi-find-go! (list-ref spec 1) (list-ref spec 2) (list-ref spec 3)
                          (list-ref spec 4) (list-ref spec 5))
         (if (> *vi-did* 0) (pad:vi-maybe-text! text) 0)
         "vi-do"))
      ((string=? t "obj")
       (begin
         (pad:vi-obj-go! (list-ref spec 1) (list-ref spec 2) (list-ref spec 3) (list-ref spec 4))
         (if (> *vi-did* 0) (pad:vi-maybe-text! text) 0)
         "vi-do"))
      (#t
       (set! *pl-say* "nothing to repeat")
       "vi-do"))))

(define (pad:vi-replay! rec k)
  (if (string=? (car rec) "type")
      (pad:vi-replay-type! (list-ref rec 1) (list-ref rec 2)
                           (if (> k 0) k (list-ref rec 3)))
      (pad:vi-replay-do! (pad:vi-spec-n (list-ref rec 1) k) (list-ref rec 2))))

(define (pad:vi-dot!)
  (let ((k (if (> *vi-num* 0) *vi-num* 0)))
    (set! *vi-num* 0)
    (set! *vi-num-op* 0)
    (set! *vi-seek* "")
    (set! *vi-obj* "")
    (if (not *vi-last*)
        (begin
          (set! *pl-rej* (+ *pl-rej* 1))
          (set! *pl-say* "nothing to repeat")
          "vi-do")
        (begin
          (set! *vi-dotting* #t)
          (set! *vi-did* 0)
          (let ((r (pad:vi-replay! *vi-last* k)))
            (set! *vi-dotting* #f)
            (set! *vi-ins-how* "")
            (if (> *vi-did* 0)
                (begin
                  (set! *vi-mode* "normal")
                  (pad:vi-title!)
                  (set! *pl-say* "repeated"))
                0)
            r)))))

;; d, c, and y take a motion. A line motion covers whole lines from
;; here through the landing line. A character motion covers the text
;; between the two points and does not include the point you land on.
(define (pad:vi-op-fail! op)
  (set! *vi-op* "")
  (set! *vi-seek* "")
  (set! *vi-obj* "")
  (set! *vi-num* 0)
  (set! *vi-num-op* 0)
  (set! *vi-pend-rec* #f)
  (set! *vi-did* 0)
  (set! *pl-rej* (+ *pl-rej* 1))
  (set! *pl-say*
        (if *vi-dotting*
            "nothing to repeat"
            (cond
              ((string=? op "y") "nothing to copy")
              ((string=? op "c") "nothing to change")
              (#t "nothing to delete"))))
  "vi-do")

(define (pad:vi-yank-lines! lo hi)
  (let* ((st *pl-st*)
         (L (car st))
         (lines (pad:sublist L lo (+ hi 1)))
         (n (length lines)))
    (set! *pl-st* (list L (cadr st) (caddr st)
                        (append lines (list (list)))
                        (list-ref st 4) (list-ref st 5)))
    (pad:play-ok! (if (= n 1) "copied the line"
                      (string-append "copied " (number->string n) " lines")))
    "vi-do"))

(define (pad:vi-delete-lines! lo hi)
  (if (= lo hi)
      (pad:vi-drop-line!)
      (let* ((st *pl-st*)
             (L (car st))
             (lines (pad:sublist L lo (+ hi 1)))
             (n (length lines))
             (L2 (append (pad:take lo L) (pad:drop (+ hi 1) L)))
             (L3 (if (null? L2) (list (list)) L2))
             (l2 (if (>= lo (length L3)) (- (length L3) 1) lo))
             (U (pad:vi-undo-push (cons (list L (cadr st) (caddr st)) (list-ref st 5)))))
        (set! *pl-st* (list L3 l2 0 (append lines (list (list))) (list) U))
        (pad:vi-note! "d")
        (pad:play-ok! (string-append "deleted " (number->string n) " lines"))
        "vi-do")))

(define (pad:vi-change-lines! lo hi)
  (let* ((st *pl-st*)
         (L (car st))
         (lines (pad:sublist L lo (+ hi 1)))
         (rest (append (pad:take lo L) (pad:drop (+ hi 1) L)))
         (L2 (append (pad:take lo rest) (cons (list) (pad:drop lo rest))))
         (U (pad:vi-undo-push (cons (list L (cadr st) (caddr st)) (list-ref st 5)))))
    (set! *pl-st* (list L2 lo 0 (append lines (list (list))) (list) U))
    (pad:vi-note! "c")
    (if *vi-dotting*
        (begin (pad:play-ok! "deleted") "vi-do")
        (begin (pad:play-ok! "insert - type, esc goes back")
               (pad:vi-insert-here!)))))

(define (pad:vi-op-lines! op lo hi)
  (set! *vi-op* "")
  (let ((a (if (<= lo hi) lo hi))
        (b (if (<= lo hi) hi lo)))
    (cond
      ((string=? op "y") (pad:vi-yank-lines! a b))
      ((string=? op "c") (pad:vi-change-lines! a b))
      (#t (pad:vi-delete-lines! a b)))))

(define (pad:vi-char-op! op l2 c2)
  (set! *vi-op* "")
  (let* ((st *pl-st*)
         (L (car st))
         (l1 (cadr st))
         (c1 (caddr st)))
    (if (and (= l1 l2) (= c1 c2))
        (pad:vi-op-fail! op)
        (let* ((fwd (or (< l1 l2) (and (= l1 l2) (< c1 c2))))
               (al (if fwd l1 l2))
               (ac (if fwd c1 c2))
               (bl (if fwd l2 l1))
               (bc (if fwd c2 c1))
               (kill (pad:region-text L al ac bl bc)))
          (if (string=? op "y")
              (begin
                (set! *pl-st* (list L l1 c1 kill (list-ref st 4) (list-ref st 5)))
                (pad:vi-note! "y")
                (pad:play-ok! "copied")
                "vi-do")
              (let ((L2 (pad:region-delete L al ac bl bc))
                    (U (pad:vi-undo-push (cons (list L l1 c1) (list-ref st 5)))))
                (set! *pl-st* (list L2 al ac kill (list) U))
                (pad:vi-note! (if (string=? op "c") "c" "d"))
                (if (and (string=? op "c") (not *vi-dotting*))
                    (begin (pad:play-ok! "insert - type, esc goes back")
                           (pad:vi-insert-here!))
                    (begin (pad:play-ok! "deleted") "vi-do"))))))))

(define (pad:vi-w-pos L l col)
  (let* ((n (length L))
         (ln (list-ref L l))
         (len (length ln))
         (i (pad:vi-skip-spaces ln (pad:vi-skip-word ln col len) len)))
    (cond
      ((< i len) (list l i))
      ((< l (- n 1)) (list (+ l 1) 0))
      (#t #f))))

(define (pad:vi-op-self? op b)
  (or (and (string=? op "d") (= b 100))
      (and (string=? op "y") (= b 121))
      (and (string=? op "c") (= b 99))))

(define (pad:vi-op-move! op b)
  (cond
    ((pad:vi-op-self? op b)
     (cond
       ((string=? op "d") (pad:vi-dd!))
       ((string=? op "y") (pad:vi-yy!))
       (#t (pad:vi-cc!))))
    ((= b 103) (pad:vi-pend! (string-append op "-g") "g to the top"))
    ((or (= b 106) (= b 14)) (pad:vi-line-motion! op 1 (pad:vi-prod!)))
    ((or (= b 107) (= b 16)) (pad:vi-line-motion! op -1 (pad:vi-prod!)))
    ((= b 71) (pad:vi-G-op! op))
    ((or (= b 104) (= b 2)) (pad:vi-char-motion! op "h" (pad:vi-prod!)))
    ((or (= b 108) (= b 6)) (pad:vi-char-motion! op "l" (pad:vi-prod!)))
    ((or (= b 48) (= b 1)) (pad:vi-char-motion! op "0" (pad:vi-prod!)))
    ((or (= b 36) (= b 5)) (pad:vi-char-motion! op "$" (pad:vi-prod!)))
    ((= b 119) (pad:vi-char-motion! op "w" (pad:vi-prod!)))
    ((= b 98) (pad:vi-char-motion! op "b" (pad:vi-prod!)))
    ((or (= b 102) (= b 70) (= b 116) (= b 84))
     (pad:vi-seek! (list->string (list b))))
    ((= b 59) (pad:vi-again-find! #f))
    ((= b 44) (pad:vi-again-find! #t))
    ((= b 105) (pad:vi-obj-pend! "i"))
    ((= b 97) (pad:vi-obj-pend! "a"))
    (#t #f)))

(define (pad:vi-op-or-hint! op b)
  (let ((r (pad:vi-op-move! op b)))
    (if r
        r
        (cond
          ((string=? op "y") (pad:vi-act! "y-hint"))
          ((string=? op "c")
           (set! *vi-op* "")
           (pad:vi-clear-num!)
           (set! *pl-say* "c needs a motion")
           "vi-do")
          (#t (pad:vi-act! "d-hint"))))))

(define (pad:vi-g-op? s)
  (and (= (string-length s) 3) (string=? (substring s 1 3) "-g")))

(define (pad:vi-op-word! op cmd)
  (cond
    ((string=? cmd "next-line") (pad:vi-op-or-hint! op 14))
    ((string=? cmd "prev-line") (pad:vi-op-or-hint! op 16))
    ((string=? cmd "left") (pad:vi-op-or-hint! op 2))
    ((string=? cmd "right") (pad:vi-op-or-hint! op 6))
    ((string=? cmd "home") (pad:vi-op-or-hint! op 1))
    ((string=? cmd "end") (pad:vi-op-or-hint! op 5))
    ((string=? cmd "eob") (pad:vi-op-or-hint! op 71))
    ((string=? cmd "bob") (pad:vi-gg-op! op))
    (#t (begin (set! *vi-op* "") (pad:play-cmd! cmd) "vi-do"))))

(define (pad:vi-op-byte b)
  (cond
    ((pad:vi-prompt?)
     (cond
       ((= b 7) (pad:em-keyboard-quit!))
       ((= b 27) (pad:vi-cancel!))
       ((or (= b 10) (= b 13)) (pad:em-enter!))
       ((or (= b 8) (= b 127)) (pad:vi-bs!))
       ((and (string=? *vi-op* "s") (= b 19)) (pad:em-search-next!))
       ((and (string=? *vi-op* "s") (= b 18))
        (if (string=? *vi-line* "")
            (pad:em-hint!)
            (pad:vi-search-go! *vi-line* #f (pad:play-point) -1 "search" -1)))
       ((and (= b 9) *vi-mx* (string=? *vi-op* ":")) (pad:em-complete!))
       ((and (= b 32) *vi-mx* (string=? *vi-op* ":")) (pad:em-cands!))
       ((and (>= b 32) (<= b 126)) (pad:vi-type! b))
       (#t (pad:vi-type-keep!))))
    ((not (string=? *vi-seek* "")) (pad:vi-seek-char! b))
    ((not (string=? *vi-obj* ""))
     (if (pad:vi-digit? b) (pad:vi-num-add! b) (pad:vi-obj-char! b)))
    ((pad:vi-g-op? *vi-op*)
     (let ((op (substring *vi-op* 0 1)))
       (set! *vi-op* "")
       (if (= b 103)
           (pad:vi-gg-op! op)
           (pad:vi-redo! b))))
    ((or (string=? *vi-op* "d") (string=? *vi-op* "y") (string=? *vi-op* "c"))
     (if (pad:vi-digit? b)
         (pad:vi-num-add! b)
         (pad:vi-op-or-hint! *vi-op* b)))
    ((string=? *vi-op* "g")
     (set! *vi-op* "")
     (cond
       ((= b 103)
        (if (> *vi-num* 0)
            (if (string=? *vi-mode* "visual")
                (begin
                  (pad:vi-goto! (pad:vi-use-num!))
                  (pad:vi-repaint!)
                  (pad:vi-visual-say!)
                  "vi-do")
                (pad:vi-goto! (pad:vi-use-num!)))
            (if (string=? *vi-mode* "visual")
                (pad:vi-visual-move! "bob")
                "bob")))
       ((= b 100) (begin (pad:vi-clear-num!) (pad:vi-jump! "goto-def")))
       ((= b 68) (begin (pad:vi-clear-num!) (pad:vi-refs! 1)))
       ((= b 78) (begin (pad:vi-clear-num!) (pad:vi-refs! -1)))
       (#t (begin (pad:vi-clear-num!) (pad:vi-redo! b)))))
    ((string=? *vi-op* "spc")
     (set! *vi-op* "")
     (if (= b 99)
         (pad:vi-pend! "spc-c" "D next use, N the one before")
         (pad:vi-redo! b)))
    ((string=? *vi-op* "spc-c")
     (set! *vi-op* "")
     (cond
       ((= b 68) (pad:vi-refs! 1))
       ((= b 78) (pad:vi-refs! -1))
       ((= b 100) (pad:vi-jump! "goto-def"))
       (#t (pad:vi-redo! b))))
    ((string=? *vi-op* "r")
     (set! *vi-op* "")
     (if (and (>= b 32) (<= b 126))
         (begin (set! *vi-arg* b) (pad:vi-act! "r"))
         (pad:vi-act! "r-hint")))
    ((string=? *vi-op* "Z")
     (set! *vi-op* "")
     (cond
       ((= b 90) (pad:vi-act! "ZZ"))
       ((= b 81) (pad:vi-act! "ZQ"))
       (#t (pad:vi-redo! b))))
    (#t (pad:vi-cancel!))))

(define (pad:vi-type-keep!)
  (set! *pl-say* (string-append *vi-prompt* *vi-line*))
  "vi-do")

(define (pad:vi-cx-start!)
  (set! *vi-cx* #t)
  (set! *vi-op* "")
  (pad:vi-act! "cx"))

(define (pad:vi-cx-byte b)
  (set! *vi-cx* #f)
  (let ((w (pad:wn-on-cx! b)))
    (if w
        w
        (cond
    ((= b 3) "quit")
    ((= b 5) (pad:vi-act! "eval"))
    ((= b 17) "quit")
    ((= b 6) (pad:em-find-start!))
    ((= b 2) (pad:em-list!))
    ((= b 98) (pad:em-buf-start!))
    (#t (pad:vi-act! "cx-no"))))))

;; One idle byte -> a command word, a char code, or a mode word
;; (to-insert / to-normal / append / normal-key / vi-do).
(define (pad:vi-cmd b)
  (cond
    ((= b 7) (pad:em-keyboard-quit!))
    ((not (string=? *vi-op* "")) (pad:vi-op-byte b))
    (*vi-cx* (begin (pad:vi-clear-num!) (pad:vi-cx-byte b)))
    ((string=? *vi-mode* "visual") (pad:vi-visual-byte b))
    ((= b 27) "to-normal")
    ((= b 24) (begin (pad:vi-clear-num!) (pad:vi-cx-start!)))
    ((= b 3) (begin (pad:vi-clear-num!) (pad:vi-act! "c-hint")))
    ((= b 19) (pad:em-search-start!))
    ((= b 18) (begin (pad:vi-clear-num!) (pad:vi-again! -1)))
    ((= b 1) (pad:vi-word! "home"))
    ((= b 5) (pad:vi-word! "end"))
    ((= b 11) (pad:vi-word! "kill-line"))
    ((= b 25) (pad:vi-word! "yank"))
    ((= b 2) (pad:vi-move-n! "left"))
    ((= b 6) (pad:vi-move-n! "right"))
    ((= b 14) (pad:vi-move-n! "next-line"))
    ((= b 16) (pad:vi-move-n! "prev-line"))
    ((= b 29) (pad:vi-word! "jump-back"))
    ((= b 22) (pad:vi-word! "copy-region"))
    ((string=? *vi-mode* "insert")
     (if (and (>= b 32) (<= b 126))
         (begin (pad:vi-ins-byte! b) b)
         (let ((w (pad:vi-ctrl b)))
           (if (string=? w "back") (pad:vi-ins-pop!) 0)
           w)))
    ((pad:vi-digit? b) (pad:vi-num-add! b))
    ((= b 104) (pad:vi-move-n! "left"))
    ((= b 106) (pad:vi-move-n! "next-line"))
    ((= b 107) (pad:vi-move-n! "prev-line"))
    ((= b 108) (pad:vi-move-n! "right"))
    ((= b 105) "to-insert")
    ((= b 97) "append")
    ((= b 120) (pad:vi-act! "x"))
    ((= b 88) (pad:vi-act! "X"))
    ((= b 100) (pad:vi-op-pend! "d" "d - press d again to delete the line, or a motion"))
    ((= b 68) (pad:vi-act! "D"))
    ((= b 67) (pad:vi-op-move! "c" 36))
    ((= b 99) (pad:vi-op-pend! "c" "c - c again changes the line, or a motion"))
    ((= b 121) (pad:vi-op-pend! "y" "y - y again copies the line, or a motion"))
    ((= b 89) (pad:vi-act! "yy"))
    ((= b 83) (pad:vi-cc!))
    ((= b 115) (pad:vi-op-move! "c" 108))
    ((= b 112) (pad:vi-act! "p"))
    ((= b 117) (pad:vi-word! "undo"))
    ((= b 48) (pad:vi-word! "home"))
    ((= b 36) (pad:vi-word! "end"))
    ((= b 103) (pad:vi-pend! "g" "g to the top, d jumps, D next use, N previous"))
    ((= b 32) (pad:vi-pend! "spc" "space c D finds every use"))
    ((= b 42) (begin (pad:vi-clear-num!) (pad:vi-star! 1)))
    ((= b 35) (begin (pad:vi-clear-num!) (pad:vi-star! -1)))
    ((= b 110) (begin (pad:vi-clear-num!) (pad:vi-again! 1)))
    ((= b 78) (begin (pad:vi-clear-num!) (pad:vi-again! -1)))
    ((= b 47) (pad:em-search-start!))
    ((= b 71) (pad:vi-G!))
    ((= b 73) (pad:vi-act! "I"))
    ((= b 65) (pad:vi-act! "A"))
    ((= b 111) (pad:vi-act! "o"))
    ((= b 79) (pad:vi-act! "O"))
    ((= b 114) (pad:vi-pend! "r" "r - type a letter to replace"))
    ((= b 119) (pad:vi-w-n!))
    ((= b 98) (pad:vi-b-n!))
    ((= b 86) (pad:vi-visual!))
    ((= b 58) (pad:vi-colon-start! #f))
    ((= b 90) (begin (pad:vi-clear-num!) (pad:vi-pend! "Z" "Z - Z saves and quits, Q quits")))
    ((or (= b 102) (= b 70) (= b 116) (= b 84))
     (pad:vi-seek! (list->string (list b))))
    ((= b 59) (pad:vi-again-find! #f))
    ((= b 44) (pad:vi-again-find! #t))
    ((= b 46) (pad:vi-dot!))
    ((and (>= b 32) (<= b 126)) (begin (pad:vi-clear-num!) "normal-key"))
    (#t (begin (pad:vi-clear-num!) (pad:vi-ctrl b)))))

;; Apply a mode word. Returns "snap" (the caller writes one frame)
;; or "quit". "vi-do" was already carried out in pad:vi-cmd.
(define (pad:vi-meta! c)
  (cond
    ((string=? c "vi-do") "snap")
    ((string=? c "to-insert")
     (pad:vi-begin-ins! "i")
     (set! *vi-mode* "insert")
     (set! *vi-op* "")
     (set! *vi-cx* #f)
     (pad:vi-title!)
     (pad:play-ok! "insert - type, esc goes back")
     "snap")
    ((string=? c "to-normal")
     (pad:vi-ins-close!)
     (if (string=? *vi-mode* "visual") (pad:vi-repaint!) 0)
     (set! *vi-mode* "normal")
     (set! *vi-vanchor* -1)
     (set! *vi-op* "")
     (pad:vi-title!)
     (pad:play-ok! "normal - press i to type")
     "snap")
    ((string=? c "append")
     (pad:vi-begin-ins! "a")
     (let ((moved (pad:vi-can-right?)))
       (if moved (pad:play-cmd! "right") 0)
       (set! *vi-mode* "insert")
       (set! *vi-op* "")
       (set! *vi-cx* #f)
       (pad:vi-title!)
       (set! *pl-say* "insert - type, esc goes back")
       (if moved 0 (set! *pl-keys* (+ *pl-keys* 1)))
       "snap"))
    (#t
     (pad:play-reject! "normal-key")
     "snap")))

(define (pad:vi-emit! r)
  (cond
    ((string=? r "quit") "quit")
    ((string=? r "pending") "pending")
    (#t
     (if *pi-collect*
         (set! *pi-out* (cons (pad:vw-frame (pad:play-snap)) *pi-out*))
         (display (pad:vw-frame (pad:play-snap))))
     "go")))

(define (pad:vi-took! cmd rest)
  (let* ((r (if (pad:vi-mode-word? cmd) (pad:vi-meta! cmd) (pad:play-cmd! cmd)))
         (e (pad:vi-emit! r)))
    (if (string=? e "quit") "quit" (pad:vi-each rest (list)))))

;; Rest of a multi-byte line. esc is the escape-sequence state, passed
;; in so the loop does not capture an outer local. A trailing lone 27
;; leaves insert; 27 followed by 91 or 79 in this same line is an arrow.
;; 27 followed by 120 in this same line is Alt-x.
(define (pad:vi-each xs esc)
  (if (null? xs)
      (begin (set! *pl-esc* esc) "go")
      (let ((b (car xs)) (rest (cdr xs)))
        (cond
          ((and (null? esc) (string=? *vi-op* "")
                (= b 27) (pair? rest)
                (or (= (car rest) 120) (= (car rest) 102)
                    (= (car rest) 98) (= (car rest) 100)
                    (= (car rest) 60) (= (car rest) 62)))
           (pad:vi-took! (pad:em-meta! (car rest)) (cdr rest)))
          ((pair? esc)
           (let* ((step (pad:key-step esc b))
                  (cmd (car step))
                  (esc2 (car (cdr step))))
             (if (and (string? cmd) (string=? cmd "pending"))
                 (pad:vi-each rest esc2)
                 (if (or (string=? *vi-op* "d") (string=? *vi-op* "c")
                         (string=? *vi-op* "y"))
                     (pad:vi-took! (pad:vi-op-word! *vi-op* cmd) rest)
                     (if (> *vi-num* 0)
                         (if (string=? *vi-mode* "visual")
                             (pad:vi-took! (pad:vi-visual-move! cmd) rest)
                             (pad:vi-took! (pad:vi-move-n! cmd) rest))
                         (let ((r (pad:play-cmd! cmd)))
                           (if (string=? *vi-mode* "visual") (pad:vi-visual-say!) 0)
                           (let ((e (pad:vi-emit! r)))
                             (if (string=? e "quit") "quit" (pad:vi-each rest (list))))))))))
          ((and (= b 27) (pair? rest) (or (= (car rest) 91) (= (car rest) 79)))
           (pad:vi-each rest (list 27)))
          ((and (= b 15) (null? esc))
           (let ((e (pad:vi-emit! (pad:who-key!))))
             (if (string=? e "quit") "quit" (pad:vi-each rest (list)))))
          (#t (pad:vi-took! (pad:vi-cmd b) rest))))))

(define (pad:vi-bytes! line)
  (set! *pi-slow* (+ *pi-slow* 1))
  (let ((bs (pad:pi-parse line)))
    (if (not bs)
        (begin
          (pad:play-reject! "unknown")
          (if *pi-collect*
              (set! *pi-out* (cons (pad:vw-frame (pad:play-snap)) *pi-out*))
              (display (pad:vw-frame (pad:play-snap))))
          "go")
        (pad:vi-each bs *pl-esc*))))

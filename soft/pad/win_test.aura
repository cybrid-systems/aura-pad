;; M14 window tree. Prints PAD_M14_OK or PAD_M14_FAIL.
;; Soft reserved: never bind quote.
(define *pad-home*
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))
(load (string-append *pad-home* "/soft/pad/buffer.aura"))
(load (string-append *pad-home* "/soft/pad/lines.aura"))
(load (string-append *pad-home* "/soft/pad/edit.aura"))
(load (string-append *pad-home* "/soft/pad/hl.aura"))
(load (string-append *pad-home* "/soft/pad/jump.aura"))
(load (string-append *pad-home* "/soft/pad/view.aura"))
(load (string-append *pad-home* "/soft/pad/lc.aura"))
(load (string-append *pad-home* "/soft/pad/keys.aura"))
(load (string-append *pad-home* "/soft/pad/card.aura"))
(load (string-append *pad-home* "/soft/pad/who.aura"))
(load (string-append *pad-home* "/soft/pad/play_in.aura"))
(load (string-append *pad-home* "/soft/pad/vi.aura"))
(load (string-append *pad-home* "/soft/pad/screen.aura"))
(load (string-append *pad-home* "/soft/pad/emacs.aura"))
(load (string-append *pad-home* "/soft/pad/file.aura"))
(load (string-append *pad-home* "/soft/pad/win.aura"))

(define *fail* 0)
(define *checks* 0)

(define (wt-ok tag)
  (set! *checks* (+ *checks* 1))
  (display "T ") (display tag) (display " OK") (newline))

(define (wt-bad tag got)
  (set! *checks* (+ *checks* 1))
  (set! *fail* (+ *fail* 1))
  (display "T ") (display tag) (display " FAIL ") (display got) (newline))

(define (wt-eq tag got want)
  (if (equal? got want) (wt-ok tag) (wt-bad tag got)))

(define (wt-has tag s needle)
  (wt-eq tag (if (string-contains? s needle) 1 0) 1))

(define (wt-arm! src)
  (pad:wn-reset!)
  (pad:play-reset! src)
  (set! *vi-on* #t)
  (set! *vi-mode* "normal")
  (set! *vi-op* "")
  (set! *vi-cx* #f)
  (set! *vw-rows* 6)
  (set! *vw-cols* 20)
  (set! *vw-top* 0)
  (set! *vw-left* 0))

(wt-arm! "hi")
(let ((s (pad:play-snap)))
  (wt-eq "one-frame" (if (string=? (pad:vw-frame s) s) 1 0) 1))
(wt-eq "one-many" (if (pad:wn-many?) 1 0) 0)

(wt-arm! "ab\ncd")
(wt-eq "split-v" (pad:wn-split! "V") "vi-do")
(wt-eq "split-say" *pl-say* "you can open another page next to this one")
(wt-eq "split-many" (if (pad:wn-many?) 1 0) 1)
(let ((s (pad:vw-frame (pad:play-snap))))
  (wt-has "wins-n" s "WINS n=2")
  (wt-has "win-a" s "WIN r=0 c=0 h=3 w=20 sel=1")
  (wt-has "win-b" s "WIN r=3 c=0 h=3 w=20 sel=0")
  (wt-eq "no-overlap" (if (pad:wn-overlap? (pad:wn-place *wn-tree* 0 0 6 20)) 1 0) 0)
  (write-file "/tmp/aura-pad-m14.snap" s))

(wt-arm! "ab\ncd")
(set! *vw-rows* 3)
(wt-eq "tiny" (pad:wn-split! "V") "vi-do")
(wt-eq "tiny-say" *pl-say* "that page would be too tiny")
(wt-eq "tiny-one" (if (pad:wn-many?) 1 0) 0)

(wt-arm! "ab")
(set! *vw-rows* 16)
(wt-eq "s1" (pad:wn-split! "V") "vi-do")
(wt-eq "s2" (pad:wn-split! "V") "vi-do")
(wt-eq "s3" (pad:wn-split! "V") "vi-do")
(wt-eq "s4" (pad:wn-split! "V") "vi-do")
(wt-eq "many-say" *pl-say* "too many pages on the screen")
(wt-eq "four" (pad:wn-count *wn-tree*) 4)

(wt-arm! "hello")
(pad:wn-split! "H")
(pad:play-cmd! "right")
(pad:wn-other!)
(wt-eq "other-say" *pl-say* "now this page")
(wt-eq "other-col" (caddr *pl-st*) 0)
(pad:wn-other!)
(wt-eq "back-col" (caddr *pl-st*) 1)
(wt-eq "del" (pad:wn-delete!) "vi-do")
(wt-eq "del-say" *pl-say* "closed that page")
(wt-eq "del-one" (if (pad:wn-many?) 1 0) 0)
(wt-eq "del-last" *pl-say* "closed that page")
(pad:wn-delete!)
(wt-eq "only-page" *pl-say* "this is the only page")
(pad:wn-only!)
(wt-eq "only-say" *pl-say* "this is the only page")

(wt-arm! "ab\ncd")
(pad:wn-split! "V")
(pad:wn-only!)
(wt-eq "keep-one" *pl-say* "just this page now")
(wt-eq "keep-many" (if (pad:wn-many?) 1 0) 0)
(wt-eq "src-kept" (pad:play-src) "ab\ncd")

(wt-arm! "ab\ncd")
(wt-eq "miss" (pad:wn-switch! "zoo") "vi-do")
(wt-eq "miss-say" *pl-say* "there is no pad with that name")
(wt-eq "miss-src" (pad:play-src) "ab\ncd")
(pad:wn-buf! "story" "a cat")
(pad:wn-switch! "story")
(wt-eq "story-src" (pad:play-src) "a cat")
(pad:wn-switch! "page")
(wt-eq "page-src" (pad:play-src) "ab\ncd")

(wt-eq "empty-mx" (pad:wn-command "" "") #f)
(wt-arm! "ab\ncd")
(pad:wn-help! "")
(wt-has "map" (pad:play-src) "Aura pad map")
(wt-has "map-split" (pad:play-src) "split opens another page")
(wt-has "map-say" *pl-say* "this page is the map")
(pad:wn-command "switch:page" "")
(wt-eq "map-back" (pad:play-src) "ab\ncd")

(wt-arm! "ab\ncd")
(pad:play-step! "IN 24 50")
(wt-eq "key-many" (if (pad:wn-many?) 1 0) 1)
(wt-has "key-say" *pl-say* "another page")

(write-file "/tmp/aura-pad-win.txt" "zz\n")
(pad:pf-open! "/tmp/aura-pad-win.txt")
(pad:wn-reset!)
(pad:play-reset! "zz")
(set! *vi-on* #t)
(set! *vw-rows* 6)
(set! *vw-cols* 20)
;; First split teaches the map. The file chord is the horizontal one.
(pad:wn-split! "V")
(pad:pf-line! "IN 24")
(pad:pf-line! "IN 51")
(wt-eq "file-split" (if (pad:wn-many?) 1 0) 1)
(wt-has "file-say" *pl-say* "beside")

(display "CHECKS ") (display *checks*)
(display " FAIL ") (display *fail*) (newline)
(if (= *fail* 0)
    (display "PAD_M14_OK")
    (display "PAD_M14_FAIL"))
(newline)

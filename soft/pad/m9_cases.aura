;; aura-pad M9 test cases, loaded by m9_test.aura. Every section is a
;; function: the entry file runs ONE top-level call, because forms of the
;; file being run that come after a set-code + eval-current are read back
;; wrong (see docs/m9.md). Soft reserved: never bind quote.

(define *fail* 0)
(define *checks* 0)
(define *acc-fail0* 0)

(define (expect tag got want)
  (set! *checks* (+ *checks* 1))
  (newline)
  (display "T ")
  (display tag)
  (display "=")
  (display (if (number? got) (pad:nstr got) "?"))
  (if (and (number? got) (= got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display (pad:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-str tag got want)
  (set! *checks* (+ *checks* 1))
  (newline)
  (display "T ")
  (display tag)
  (display "=")
  (display (if (string? got) got "?"))
  (if (and (string? got) (string=? got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display want)
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-true tag got)
  (expect-str tag (if got "yes" "no") "yes"))

(define (acc-begin!) (set! *acc-fail0* *fail*))
(define (acc-end! n)
  (newline)
  (display "M9_ACC ") (display (number->string n))
  (display (if (= *fail* *acc-fail0*) " OK" " FAIL"))
  (newline))

(define (lines1 a) (list (pad:type-codes a)))
(define (lines2 a b) (list (pad:type-codes a) (pad:type-codes b)))
(define (lines3 a b c) (list (pad:type-codes a) (pad:type-codes b) (pad:type-codes c)))
(define (xs-str n) (if (<= n 0) "" (string-append "x" (xs-str (- n 1)))))
(define *small-text* "hi\n  aura\npad")
(define *small-m3* (lines3 "hi" "  aura" "pad"))

(define real-set-code #f)
(define sc0 #f)
(define ev0 #f)
(define p1 #f)
(define p2 #f)
(define *big-L* #f)
(define b1 #f)
(define b2 #f)
(define *gap-L* #f)
(define sc-chk #f)
(define r-chk #f)
(define sc-g #f)
(define sc-k #f)
(define g-k #f)
(define code-k #f)
(define rk #f)
(define g-p #f)
(define code-p #f)
(define page-p #f)
(define heals-p #f)
(define rd #f)
(define sc-keys #f)
(define ev-keys #f)
(define *key-script* #f)
(define n-keys #f)
(define between #f)

(define (reject-case! tag who name lam want)
  (let* ((sc *ws-set-code-n*)
         (g (pad:pen-gen))
         (tt (pad:pen-total))
         (u (length *pen-undo*))
         (L (pad:es-L *pl-st*))
         (r (pad:pen-step! who name lam "kid")))
    (pad:pen-line! r who name)
    (expect-str (string-append tag "_V") (car r) "REJECT")
    (expect-str (string-append tag "_R") (cadr r) want)
    (expect (string-append tag "_SC") (- *ws-set-code-n* sc) 0)
    (expect (string-append tag "_GEN") (- (pad:pen-gen) g) 0)
    (expect (string-append tag "_TOTAL") (- (pad:pen-total) tt) 0)
    (expect (string-append tag "_UNDO") (- (length *pen-undo*) u) 0)
    (expect-true (string-append tag "_PAGE") (equal? (pad:es-L *pl-st*) L))))

(define (m9:intro)
  (newline)
  (display "M9 workspace notebook on Soft tip")
  (newline)
  (pad:used-line!)
  (pad:gaps-line!)
  (expect-true "Q_SANE" (pad:q-sane?))
  (expect-str "Q_USED" (pad:ws-names-str *pad-q-used*)
              "define-lookup.query:code.query:ref-counts.query:node-types")
  #t)
(define (m9:sec1)
  ;; 1. pad:ws-load! is set-code + eval-current only; a missing name is
  ;;    GAPS and the pad keeps working on the Soft buffer.
  (acc-begin!)
  (set! real-set-code *ws-set-code-fn*)
  (set! *ws-set-code-fn* (lambda (s) (pad-m9-unbound-set-code s)))
  (pad:play-reset! *small-text*)
  (expect-str "WS_GAP" (pad:ws-load! (pad:es-L *pl-st*)) "gap")
  (newline)
  (pad:ws-gaps-line!)
  (expect-str "WS_GAP_NAMES" (pad:ws-names-str *ws-gaps*) "set-code")
  (expect "WS_GAP_LOADS" *ws-loads* 0)
  (expect "WS_GAP_EVALS" *ws-eval-n* 0)
  (pad:play-cmd! "end")
  (pad:play-cmd! 33)
  (expect-str "WS_GAP_BUF" (pad:play-src) "hi!\n  aura\npad")
  (expect-true "WS_GAP_SNAP" (> (string-length (pad:play-snap)) 0))
  (set! *ws-set-code-fn* real-set-code)
  (set! *ws-gaps* (list))
  (set! sc0 *ws-set-code-n*)
  (set! ev0 *ws-eval-n*)
  (expect-str "WS_LOAD" (pad:ws-load! *small-m3*) "ok")
  (expect "WS_LOAD_SETCODE" (- *ws-set-code-n* sc0) 1)
  (expect "WS_LOAD_EVAL" (- *ws-eval-n* ev0) 1)
  (expect-str "WS_LOAD_NOTE" *ws-eval* "note")
  (expect-str "WS_GAPS_NONE" (pad:ws-names-str *ws-gaps*) "none")
  (acc-end! 1)
  #t)
(define (m9:sec2)
  ;; 2. Roundtrip load -> project -> load -> project equals the M3 lines.
  (acc-begin!)
  (set! p1 (pad:ws-project))
  (expect-true "RT_SMALL_P1" (equal? p1 *small-m3*))
  (pad:ws-load! p1)
  (set! p2 (pad:ws-project))
  (expect-true "RT_SMALL_P2" (equal? p2 *small-m3*))
  (expect-str "RT_SMALL_TEXT" (pad:v-src p2) *small-text*)
  (expect "RT_SMALL_ROWS" (length p2) 3)
  (set! *big-L* (pad:v-lines *lc-big-page*))
  (pad:ws-load! *big-L*)
  (set! b1 (pad:ws-project))
  (expect-true "RT_BIG_P1" (equal? b1 *big-L*))
  (pad:ws-load! b1)
  (set! b2 (pad:ws-project))
  (expect-true "RT_BIG_P2" (equal? b2 *big-L*))
  (expect-str "RT_BIG_TEXT" (pad:v-src b2) *lc-big-page*)
  (expect "RT_BIG_ROWS" (length b2) 12)
  (set! *gap-L* (lines3 "a" "" "b"))
  (pad:ws-load! *gap-L*)
  (expect-true "RT_EMPTY_ROW" (equal? (pad:ws-project) *gap-L*))
  (expect-true "RT_CODE_CANON" (string-prefix? (pad:q-code) "(begin "))
  (acc-end! 2)
  #t)
(define (m9:sec3)
  ;; 3. ctrl-s on the 12-row page: engine names >= Soft names; load cost
  ;;    printed next to the #4343 numbers.
  (acc-begin!)
  (pad:play-reset! *lc-big-page*)
  (set! sc-chk *ws-set-code-n*)
  (set! r-chk (pad:nb-check!))
  (pad:ws-check-line! r-chk)
  (expect-str "CHECK_OK" (car r-chk) "ok")
  (expect "CHECK_SETCODE" (- *ws-set-code-n* sc-chk) 1)
  (expect-str "CHECK_SOFT" (pad:ws-names-str (pad:nth r-chk 1)) "hello.bye.add.pet.greet")
  (expect-str "CHECK_MISSING" (pad:ws-names-str (pad:nth r-chk 3)) "none")
  (expect "CHECK_ENGINE_TOTAL" (pad:nth r-chk 5) 6)
  (expect-str "CHECK_SAY" *pl-say* "aura knows 5 names on this page")
  (expect-true "CHECK_MARK_HELLO" (member "hello@0:9" (pad:nth r-chk 6)))
  (expect-true "CHECK_NODE_TYPES" (pair? (pad:q-node-types)))
  (expect-true "CHECK_QCODE" (string-contains? (pad:q-code) "(define pet"))
  (newline)
  (display "M9LOAD ms=")
  (display (number->string *ws-load-ms*))
  (display " rows=12 src_len=")
  (display (number->string (string-length *lc-big-page*)))
  (display " note=aura#4343_aura#4350 soft_call_us_in_smoke_perf")
  (newline)
  (display "M9NODES ")
  (display (pad:ws-types-str))
  (newline)
  (display "M9REFS ")
  (display (pad:ws-ref-str (pad:nth r-chk 2)))
  (newline)
  (display "M9LOOKUP hello=")
  (display (let ((r (pad:define-lookup "hello")))
             (if (pair? r)
                 (string-append "line" (number->string (cadr (car r)))
                                ":col" (number->string (caddr (car r))))
                 "none")))
  (display " note=aura#4347")
  (newline)
  ;; guard REJECTs never reach set-code
  (set! sc-g *ws-set-code-n*)
  (expect-str "CHECK_OPEN" (car (pad:ws-check! (lines2 "(define (f x)" "  x"))) "open-paren")
  (expect-str "CHECK_PADNAME" (car (pad:ws-check! (lines1 "(define pad:x 1)"))) "pad-name")
  (expect "CHECK_GUARD_SETCODE" (- *ws-set-code-n* sc-g) 0)
  (expect-str "SAY_OPEN" (pad:ws-say "open-paren") "close every ( before checking")
  (acc-end! 3)
  #t)
(define (m9:sec4)
  ;; 4. REJECTed pen steps: no set-code, no generation bump, no undo push.
  (acc-begin!)
  (pad:play-reset! *lc-big-page*)
  (pad:nb-check!)
  (reject-case! "REJ_NONAME" "helper" "" "(lambda (x) x)" "no-name")
  (reject-case! "REJ_LOCKED" "helper" "hello" "(lambda (x) (display x))" "not-allowed")
  (reject-case! "REJ_MEAN" "helper" "hello" "(lambda (x) stupid)" "not-kind")
  (reject-case! "REJ_SHAPE" "macro" "hello" "42" "not-lambda")
  (reject-case! "REJ_NODEF" "law" "nobody" "(lambda (x) x)" "no-def")
  (reject-case! "REJ_WHO" "robot" "hello" "(lambda (x) x)" "not-allowed")
  (reject-case! "REJ_LONG" "helper" "hello"
                (string-append "(lambda (x) " (xs-str 120) ")") "too-long")
  (expect-str "SAY_NODEF" (pad:pen-say "no-def") "could not find where that name is born")
  (expect "REJ_COUNT" *pen-rejects* 7)
  (acc-end! 4)
  #t)
;; Pen page: the 12-row page with the (query:find hello) row swapped for
;; (add 2 3). query:* is not bound inside the workspace, so mutate:rebind's
;; typecheck rejects every rebind on a page that calls it.
(define *m9-pen-page*
  (string-append
    "(define (hello x) (+ x 1))\n"
    "(define (bye y) (hello y))\n"
    "(define (add a b) (+ a b))\n"
    "; kids write stories here\n"
    "(define pet \"cat\")\n"
    "(define (greet n) (add n 1))\n"
    "(hello 3)\n"
    "(bye 4)\n"
    "(greet (add 1 2))\n"
    "(display pet)\n"
    "(add 2 3)\n"
    "(hello (bye 5))"))

(define (m9:sec5)
  ;; 5. One KEEP rebind bumps generation exactly once; a failed probe is
  ;;    healed with ast:snapshot / ast:restore.
  (acc-begin!)
  (pad:play-reset! *m9-pen-page*)
  (expect-str "PEN_PAGE_CHECK" (car (pad:nb-check!)) "ok")
  (set! sc-k *ws-set-code-n*)
  (set! g-k (pad:pen-gen))
  (set! code-k (pad:q-code))
  (set! rk (pad:pen-step! "helper" "hello" "(lambda (x) (* x 2))" "double"))
  (pad:pen-line! rk "helper" "hello")
  (expect-str "KEEP_V" (car rk) "KEEP")
  (expect-str "KEEP_PROJ" (cadr rk) "row")
  (expect "KEEP_GEN" (pad:nth rk 3) 1)
  (expect-true "KEEP_TOTAL_MOVED" (> (pad:nth rk 4) 0))
  (expect "KEEP_SETCODE" (- *ws-set-code-n* sc-k) 0)
  (expect "KEEP_UNDO" (length *pen-undo*) 1)
  (expect-true "KEEP_ENGINE" (string-contains? (pad:q-code) "(* x 2)"))
  (expect-str "KEEP_ROW0"
              (pad:v-src (list (car (pad:es-L *pl-st*))))
              "(define hello (lambda (x) (* x 2)))")
  (expect-true "KEEP_SAFE_AFTER" (pad:m-safe?))
  (set! g-p (pad:pen-gen))
  (set! code-p (pad:q-code))
  (set! page-p (pad:es-L *pl-st*))
  (set! heals-p *ws-heals*)
  (set! rd (pad:pen-step! "helper" "bye" "(lambda (y) (+ y nope))" "probe"))
  (pad:pen-line! rd "helper" "bye")
  (expect-str "PROBE_V" (car rd) "DROP")
  (expect-str "PROBE_R" (cadr rd) "engine-no")
  (expect "PROBE_GEN_HEALED" (- (pad:pen-gen) g-p) 0)
  (expect-true "PROBE_CODE_HEALED" (string=? (pad:q-code) code-p))
  (expect-true "PROBE_PAGE_SAME" (equal? (pad:es-L *pl-st*) page-p))
  (expect "PROBE_HEALS" (- *ws-heals* heals-p) 1)
  (expect "PROBE_UNDO" (length *pen-undo*) 1)
  (expect-str "PROBE_SAY" (pad:nth rd 2) "aura could not use that change, page put back")
  (expect-str "UNDO_KEEP" (pad:pen-undo!) "ok")
  (expect-true "UNDO_CODE" (string=? (pad:q-code) code-k))
  (expect "UNDO_GEN" (- (pad:pen-gen) g-k) 0)
  (expect-str "UNDO_PAGE" (pad:play-src) *m9-pen-page*)
  (expect-str "UNDO_EMPTY" (pad:pen-undo!) "nothing-to-undo")
  (acc-end! 5)
  #t)
(define (m9:sec6)
  ;; 6. Keystrokes between checks make zero set-code calls.
  (acc-begin!)
  (pad:play-reset! *lc-big-page*)
  (pad:nb-line! "IN 19")
  (set! sc-keys *ws-set-code-n*)
  (set! ev-keys *ws-eval-n*)
  (set! *key-script*
  (list "KEY end" "IN 120" "IN 121" "IN 122" "IN 127" "KEY next-line"
        "KEY home" "IN 32" "KEY right" "KEY left" "IN 27" "IN 91" "IN 66"
        "IN 104" "IN 105" "KEY prev-line" "KEY end" "IN 33" "IN 127" "KEY undo"))
  (set! n-keys
  (let loop ((ks *key-script*) (n 0))
    (if (null? ks)
        n
        (begin
          (pad:nb-line! (car ks))
          (pad:play-snap)
          (loop (cdr ks) (+ n 1))))))
  (set! between (- *ws-set-code-n* sc-keys))
  (expect "KEYS_SETCODE" between 0)
  (expect "KEYS_EVAL" (- *ws-eval-n* ev-keys) 0)
  (pad:nb-line! "IN 19")
  (expect "CHECK_AFTER_KEYS" (- *ws-set-code-n* sc-keys) 1)
  (newline)
  (display "M9STATS ")
  (display (pad:ws-stats-str))
  (display " keys=")
  (display (number->string n-keys))
  (display " set_code_between_checks=")
  (display (number->string between))
  (newline)
  (acc-end! 6)
  #t)
(define (m9:outro)
  (newline)
  (display "TESTS checks=")
  (display (number->string *checks*))
  (display " fail=")
  (display (number->string *fail*))
  (newline)
  (if (= *fail* 0)
      (begin (display "PAD_M9_TEST_OK") (newline))
      (begin (display "PAD_M9_TEST_FAIL") (newline)))
  #t)

(define (m9:run-all)
  (m9:intro)
  (m9:sec1)
  (m9:sec2)
  (m9:sec3)
  (m9:sec4)
  (m9:sec5)
  (m9:sec6)
  (m9:outro))

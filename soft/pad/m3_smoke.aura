;; M3: multi-line buffer + command-helper propose. No HTTP.
;; Line ops with kid reasons, then helper fixtures: gate reject (set!,
;; eval), probe heal, worse DROP, tie DROP, better KEEP, re-propose tie DROP.
;; Goal "hi" / "aura" from seeded noise line "nwn". fiber_live only if joins land.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/rules.aura")
(load "/workspace/aura-pad/soft/pad/lines.aura")
(load "/workspace/aura-pad/soft/pad/helper.aura")

(define *fail* 0)
(define *fx* "/workspace/aura-pad/soft/pad/fixtures/m3/")

(define (fail! tag)
  (display tag)
  (newline)
  (set! *fail* (+ *fail* 1))
  *fail*)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (pad:nstr got))
  (if (= got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display (pad:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-str tag got want)
  (display tag)
  (display "=")
  (display got)
  (if (and (string? got) (string=? got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display want)
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (tag? r want)
  (and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) want)))

(define (op-text r)
  (if (pair? r)
      (string-append (pad:lines-text (car r))
                     "@" (number->string (car (cdr r)))
                     "," (number->string (car (cdr (cdr r)))))
      r))

(define (line-ops!)
  (let ((start (pad:start-lines))
        (two (list (list 104 105) (list 110 119 110)))
        (empty (list (list))))
    (expect-str "START_TEXT" (pad:lines-text start) "nwn")
    (expect "START_DIST" (pad:dist-lines start *goal-lines*) 8)
    ;; kid reasons
    (expect-str "OP_PREV_TOP" (op-text (pad:prev-line start 0 0)) "no-line")
    (expect-str "OP_NEXT_LAST" (op-text (pad:next-line start 0 2)) "no-line")
    (expect-str "OP_LEFT_HOME" (pad:lgate "left" start 0 0) "too-far")
    (expect-str "OP_RIGHT_END" (pad:lgate "right" start 0 3) "too-far")
    (expect-str "OP_KILL_EMPTY" (op-text (pad:kill-line empty 0 0)) "empty-buf")
    (expect-str "OP_BACK_EMPTY" (pad:lgate "back" empty 0 0) "empty-buf")
    (expect-str "OP_KILL_LAST_END" (op-text (pad:kill-line start 0 3)) "no-line")
    (expect-str "OP_BAD_KEY" (pad:lgate "jump" start 0 0) "not-a-key")
    (expect-str "OP_NOT_PRINT" (pad:lgate 72 start 0 0) "not-print")
    ;; real edits
    (expect-str "OP_OPEN" (op-text (pad:open-line (list (list 104 105 110 119 110)) 0 2))
                "hi|nwn@0,2")
    (expect-str "OP_NEXT" (op-text (pad:next-line two 0 2)) "hi|nwn@1,2")
    (expect-str "OP_PREV" (op-text (pad:prev-line two 1 3)) "hi|nwn@0,2")
    (expect-str "OP_KILL" (op-text (pad:kill-line two 1 1)) "hi|n@1,1")
    (expect-str "OP_KILL_JOIN" (op-text (pad:kill-line two 0 2)) "hinwn@0,2")
    (expect-str "OP_BACK_JOIN" (pad:lines-text (car (pad:lapply "back" two 1 0))) "hinwn")
    (expect "PLAN_KEYS" (length (pad:expand (list "kill-line" "type:hi" 97))) 4)
    (expect-str "PLAN_BAD" (pad:plan-check "kill-line") "not-a-plan")
    (expect-str "PLAN_TOKEN" (pad:plan-check (list "kill-line" #t)) "bad-token")
    0))

(define (main)
  (display "DIALECT=live-soft-editor-pad-m3")
  (newline)
  (line-ops!)
  (let ((seeded (pd:helper-seed! *helper-main-body*)))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        (display "PAD_M3_FAIL seed\n")
        (let ((main0 *helper-main-body*))
          (expect "MAIN_START" *main-score* 27)
          (expect-str "MAIN_TEXT" (pad:lines-text *lines*) "hi|au")
          ;; gate: set! and eval never reach the slot
          (if (not (tag? (pd:helper-propose-file! (string-append *fx* "bad.lambda"))
                         "helper_reject"))
              (fail! "REJECT_FAIL bad"))
          (expect-str "WORD_BAD" *helper-word* "set!")
          (if (not (tag? (pd:helper-propose-file! (string-append *fx* "noisy.lambda"))
                         "helper_reject"))
              (fail! "REJECT_FAIL noisy"))
          (expect-str "WORD_NOISY" *helper-word* "eval")
          ;; probe: not a plan -> heal!
          (if (not (tag? (pd:helper-propose-file! (string-append *fx* "ugly.lambda"))
                         "helper_heal"))
              (fail! "HEAL_FAIL"))
          (expect-str "HEAL_WHY" *helper-why* "not-a-plan")
          (if (not (pad:plan-ok? (pd:helper))) (fail! "SLOT_FAIL heal"))
          (expect "SLOT_AFTER_HEAL" (pad:score-plan (pd:helper)) 27)
          ;; worse: three kid rejects -> DROP + heal
          (if (not (tag? (pd:helper-propose-file! (string-append *fx* "worse.lambda"))
                         "helper_drop"))
              (fail! "DROP_FAIL worse"))
          (expect "WORSE_BASE" *helper-base* 27)
          (expect "WORSE_TRIAL" *helper-trial* 14)
          (expect "SLOT_AFTER_DROP" (pad:score-plan (pd:helper)) 27)
          ;; tie: different plan, same score -> DROP
          (if (not (tag? (pd:helper-propose-file! (string-append *fx* "tie.lambda"))
                         "helper_drop"))
              (fail! "DROP_FAIL tie"))
          (expect "TIE_TRIAL" *helper-trial* 27)
          (if (not (string=? *helper-main-body* main0)) (fail! "MAIN_FAIL drop"))
          (expect-str "TEXT_AFTER_DROP" (pad:lines-text *lines*) "hi|au")
          ;; better: reaches the goal -> KEEP + stamp
          (if (not (tag? (pd:helper-propose-file! (string-append *fx* "better.lambda"))
                         "helper_keep"))
              (fail! "KEEP_FAIL"))
          (expect "BETTER_BASE" *helper-base* 27)
          (expect "BETTER_TRIAL" *helper-trial* 31)
          (expect "MAIN_SCORE" *main-score* 31)
          (expect-str "MAIN_TEXT_KEEP" (pad:lines-text *lines*) "hi|aura")
          (expect "MAIN_LINE" *line* 1)
          (expect "MAIN_COL" *col* 4)
          (expect "MAIN_DIST" *ln-dist* 0)
          ;; the kept helper is now main: proposing it again is a tie
          (if (not (tag? (pd:helper-propose-file! (string-append *fx* "better.lambda"))
                         "helper_drop"))
              (fail! "DROP_FAIL again"))
          (expect "AGAIN_BASE" *helper-base* 31)
          (expect "KEEPS" *helper-keeps* 1)
          (expect "DROPS" *helper-drops* 3)
          (pad:stamp-world!)
          (if (string=? *world-line* "fiber_live")
              (if (not (and (> *race-backend* 0)
                            (= *race-joined* *race-spawned*)
                            (= *race-spawned* 8)))
                  (fail! "WORLD_FAIL"))
              (if (not (string=? *world-line* "host-sequential"))
                  (fail! "WORLD_FAIL")))
          (display "MAIN helper score=")
          (display (pad:nstr *main-score*))
          (display " body=")
          (display *helper-main-body*)
          (newline)
          (if (= *fail* 0)
              (display "PAD_M3_OK\n")
              (display "PAD_M3_FAIL\n"))))))

(main)

;; M3.5 live: one host-written goal3 helper lambda (MiniMax via
;; scripts/propose_minimax.py --helper3). Any honest gate result is
;; success; on KEEP the world undo must restore main 28 with an honest
;; re-score. A missing file or a Soft error is not success. No HTTP here.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/rules.aura")
(load "/workspace/aura-pad/soft/pad/lines.aura")
(load "/workspace/aura-pad/soft/pad/helper.aura")
(load "/workspace/aura-pad/soft/pad/edit.aura")

(define *fx* "/workspace/aura-pad/soft/pad/fixtures/m35/")

(define (live-tag? s)
  (or (string=? s "helper_keep")
      (string=? s "helper_drop")
      (string=? s "helper_heal")
      (string=? s "helper_reject")))

(define (tag-of r)
  (if (and (pair? r) (pair? (cdr r))) (car (cdr r)) "none"))

;; After a KEEP, undo it: main must come back to 28.
(define (undo-ok? tag)
  (if (not (string=? tag "helper_keep"))
      #t
      (let ((u (pd:helper-undo!)))
        (and (string=? (tag-of u) "helper_undo") (= *main-score* 28)))))

(define (main)
  (display "DIALECT=live-soft-editor-pad-m35")
  (newline)
  (pad:helper-use-goal3!)
  (let ((seeded (pd:helper-seed! (pd:clean (read-file (string-append *fx* "main.lambda"))))))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        (display "PAD_M35_LIVE_FAIL seed\n")
        (let ((path (getenv "PAD_PROPOSE_FILE")))
          (if (not (and (string? path) (> (string-length path) 0)))
              (display "PAD_M35_LIVE_FAIL path\n")
              (let* ((r (pd:helper-propose-file! path))
                     (tag (tag-of r))
                     (uok (undo-ok? tag)))
                (pad:stamp-world!)
                (display "LIVE tag=")
                (display tag)
                (display " trial=")
                (display (pad:nstr *helper-trial*))
                (display " undo=")
                (display (if uok "ok" "bad"))
                (newline)
                (if (and (live-tag? tag) uok)
                    (display "PAD_M35_LIVE_OK\n")
                    (display "PAD_M35_LIVE_FAIL\n"))))))))

(main)

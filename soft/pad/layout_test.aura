;; M15 layout worldlines. Prints PAD_M15_OK or PAD_M15_FAIL.
;; Soft reserved: never bind quote.
(define *pad-home*
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))
(load (string-append *pad-home* "/soft/pad/buffer.aura"))
(load (string-append *pad-home* "/soft/pad/lines.aura"))
(load (string-append *pad-home* "/soft/pad/edit.aura"))
(load (string-append *pad-home* "/soft/pad/hl.aura"))
(load (string-append *pad-home* "/soft/pad/jump.aura"))
(load (string-append *pad-home* "/soft/pad/view.aura"))
(load (string-append *pad-home* "/soft/pad/lc.aura"))
(load (string-append *pad-home* "/soft/pad/keys.aura"))
(load (string-append *pad-home* "/soft/pad/card.aura"))
(load (string-append *pad-home* "/soft/pad/who.aura"))
(load (string-append *pad-home* "/soft/pad/play_in.aura"))
(load (string-append *pad-home* "/soft/pad/vi.aura"))
(load (string-append *pad-home* "/soft/pad/screen.aura"))
(load (string-append *pad-home* "/soft/pad/emacs.aura"))
(load (string-append *pad-home* "/soft/pad/file.aura"))
(load (string-append *pad-home* "/soft/pad/win.aura"))

(define *fail* 0)
(define *checks* 0)

(define (lt-ok tag)
  (set! *checks* (+ *checks* 1))
  (display "T ") (display tag) (display " OK") (newline))

(define (lt-bad tag got)
  (set! *checks* (+ *checks* 1))
  (set! *fail* (+ *fail* 1))
  (display "T ") (display tag) (display " FAIL ") (display got) (newline))

(define (lt-eq tag got want)
  (if (equal? got want) (lt-ok tag) (lt-bad tag got)))

(define (lt-has tag s needle)
  (lt-eq tag (if (string-contains? s needle) 1 0) 1))

;; A normal key must not load the race. Publish the M7 before-number.
(lt-eq "quiet" (if *ly-ready* 1 0) 0)
(pad:play-reset! "ab")
(set! *vi-on* #t)
(pad:play-step! "IN 108")
(lt-eq "quiet-key" (if *ly-ready* 1 0) 0)
(display "LATENCY before=insert 3.6 ms, cursor 1.3 ms, twelve-row page, docs/ROADMAP.md. layout race is not on the key path.")
(newline)

(load (string-append *pad-home* "/soft/pad/layout.aura"))
(lt-eq "ready" (if *ly-ready* 1 0) 1)

(set! *ly-need* 1)
(pad:ly-goal!)
(lt-eq "sc-focus" (pad:ly-score (pad:ly-focus)) 70)
(lt-eq "sc-side" (if (< (pad:ly-score (pad:ly-side)) 70) 1 0) 1)
(lt-eq "gate-many" (pad:ly-why (pad:ly-fat)) "too-many")

(pad:ly-arm!)
(lt-eq "gate-ok" (if (pad:ly-why (pad:ly-focus)) "bad" "ok") "ok")
(lt-eq "arm-one" (if (pad:wn-many?) 1 0) 0)
(lt-eq "arm-src" (pad:play-src) "hi\naura")
(lt-eq "slot" (car (pd:layout)) "focus-story")

(let ((tree *wn-tree*) (live *wn-live*) (hist (length *ly-hist*)))
  (lt-eq "worse" (pad:ly-trial! *ly-side-body*) "drop")
  (lt-eq "worse-frame" (if (and (equal? *wn-tree* tree) (string=? *wn-live* live)) 1 0) 1)
  (lt-eq "worse-hist" (length *ly-hist*) hist)
  (lt-eq "worse-say" *pl-say* "the picture stays as it was"))

(let ((tree *wn-tree*) (hist (length *ly-hist*)))
  (lt-eq "tie" (pad:ly-trial! *ly-focus-body*) "drop")
  (lt-eq "tie-frame" (if (equal? *wn-tree* tree) 1 0) 1)
  (lt-eq "tie-hist" (length *ly-hist*) hist))

(set! *ly-need* 2)
(pad:ly-goal!)
(lt-eq "better" (pad:ly-trial! *ly-side-body*) "keep")
(lt-eq "better-say" *pl-say* "this layout wins!")
(lt-eq "better-h" (car *wn-tree*) "H")
(lt-eq "pt-line" (cadr *pl-st*) 1)
(lt-eq "pt-col" (caddr *pl-st*) 2)
(lt-eq "pt-top" *vw-top* 0)
(lt-eq "pt-left" *vw-left* 0)
(lt-eq "leaf-line" (list-ref (cadr *wn-tree*) 2) 1)
(lt-eq "leaf-col" (list-ref (cadr *wn-tree*) 3) 2)
(lt-eq "leaf-top" (list-ref (cadr *wn-tree*) 4) 0)
(lt-eq "leaf-left" (list-ref (cadr *wn-tree*) 5) 0)
(lt-eq "other" (cadr (caddr *wn-tree*)) "scratch")
(lt-eq "story" (pad:play-src) "hi\naura")
(lt-has "legend" *view-legend* "winner=side-helper")
(lt-eq "slot-side" (car (pd:layout)) "side-helper")

(lt-eq "undo" (pad:ly-undo!) "undo")
(lt-eq "undo-say" *pl-say* "took back the last keep")
(lt-eq "undo-one" (if (pad:wn-many?) 1 0) 0)
(lt-eq "undo-line" (cadr *pl-st*) 0)
(lt-eq "undo-col" (caddr *pl-st*) 0)
(lt-eq "undo-src" (pad:play-src) "hi\naura")

(set! *ly-need* 2)
(pad:ly-goal!)
(pad:ly-trial! *ly-side-body*)
(lt-eq "bad-undo" (pad:ly-undo-mismatch!) "fail")

(pad:ly-arm!)
(let ((tree *wn-tree*) (live *wn-live*) (hist (length *ly-hist*)))
  (lt-eq "empty" (pad:ly-trial! "(lambda () ())") "reject")
  (lt-eq "empty-say" *pl-say* "there is no page to show")
  (lt-eq "empty-frame" (if (and (equal? *wn-tree* tree) (string=? *wn-live* live)) 1 0) 1)
  (lt-eq "empty-hist" (length *ly-hist*) hist))

(let ((tree *wn-tree*) (hist (length *ly-hist*)))
  (lt-eq "nobuf" (pad:ly-trial! "(lambda () (list \"nope\" (list \"missing\" 0 0 0 0)))") "reject")
  (lt-eq "nobuf-say" *pl-say* "there is no pad with that name")
  (lt-eq "nobuf-frame" (if (equal? *wn-tree* tree) 1 0) 1)
  (lt-eq "nobuf-hist" (length *ly-hist*) hist))

(set! *vw-rows* 3)
(let ((tree *wn-tree*) (hist (length *ly-hist*)))
  (lt-eq "tiny" (pad:ly-trial! *ly-book-body*) "reject")
  (lt-eq "tiny-say" *pl-say* "that page would be too tiny")
  (lt-eq "tiny-frame" (if (equal? *wn-tree* tree) 1 0) 1)
  (lt-eq "tiny-hist" (length *ly-hist*) hist))
(set! *vw-rows* 16)

(pad:ly-arm!)
(lt-eq "book-cmd" (pad:ly-run! "layout:book" "") "vi-do")
(lt-eq "book-say" *pl-say* "this layout wins!")
(lt-eq "book-v" (car *wn-tree*) "V")
(lt-eq "book-n" (pad:wn-count *wn-tree*) 3)

(pad:wn-reset!)
(pad:play-reset! "hello")
(set! *vi-on* #t)
(set! *vw-rows* 16)
(set! *vw-cols* 40)
(set! *ly-hist* (list))
(set! *ly-need* 1)
(pad:ly-goal!)
(lt-eq "story-cmd" (pad:ly-run! "layout:story" "") "vi-do")
(lt-eq "story-say" *pl-say* "this layout wins!")
(lt-eq "story-src" (pad:play-src) "hi\naura")
(lt-eq "story-one" (if (pad:wn-many?) 1 0) 0)
(lt-eq "story-undo" (pad:ly-run! "layout:undo" "") "vi-do")
(lt-eq "story-back" (pad:play-src) "hello")
(lt-eq "story-back-say" *pl-say* "took back the last keep")

(lt-has "map-beside" (pad:wn-map "page") "layout:beside")
(lt-has "map-wins" (pad:wn-map "page") "this layout wins")
(lt-has "map-undo" (pad:wn-map "page") "layout:undo")

(display "CHECKS ") (display *checks*)
(display " FAIL ") (display *fail*) (newline)
(if (= *fail* 0)
    (display "PAD_M15_OK")
    (display "PAD_M15_FAIL"))
(newline)

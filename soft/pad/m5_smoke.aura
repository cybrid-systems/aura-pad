;; M5 smoke: Soft Aura HL tape, LSP-lite jump/refs, Soft query/mutate bridge.
;; Prints HL / JUMP / REJECT / QUERY / MUTATE / GAPS / PAD_M5_OK.
;; No HTTP. Soft reserved: never bind quote.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/hl.aura")
(load "/workspace/aura-pad/soft/pad/jump.aura")
(load "/workspace/aura-pad/soft/pad/query.aura")

(define *fail* 0)
(define (expect tag got want)
  (display "EXPECT ")
  (display tag)
  (display "=")
  (display (if (number? got) (pad:nstr got) (if (string? got) got "?")))
  (if (or (and (number? got) (number? want) (= got want))
          (and (string? got) (string? want) (string=? got want)))
      (display " OK")
      (begin (display " WANT=")
             (display (if (number? want) (pad:nstr want) want))
             (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define *hl*
  "(define (foo x) ; hi\n  (+ x 1))\n(query:find \"foo\")\n(mutate:summary)")
(define *fx*
  "(define (hello x) (+ x 1))\n(define (bye y) (hello y))\n(hello 3)\n")

(display "M5 soft Aura HL + jump/refs + query/mutate")
(newline)

(pad:hl-tape! *hl*)
(expect "HL_N" (string-length *hl*) 67)
(expect "HL_TOKS" (length (pad:hl-tokens *hl*)) 20)
(expect "HL_COLOR"
        (pad:hl-color *hl*)
        "PKKKKKK.PSSS.SP.CCCC...PS.S.NPP.PQQQQQQQQQQ.TTTTTP.PMMMMMMMMMMMMMMP")

;; Jump path: use -> def -> back; refs; kid REJECTs
(define j0 (pad:js-at *fx* 44))
(define r-goto (pad:goto-def j0))
(pad:jump-ok! "goto-def" (pad:hl-nth r-goto 1) (length (pad:hl-nth r-goto 3)))
(expect "GOTO" (car r-goto) "ok")
(expect "GOTO_PT" (pad:hl-nth r-goto 1) 9)
(define j1 (pad:jump-apply j0 r-goto))
(define r-back (pad:jump-back j1))
(pad:jump-ok! "jump-back" (pad:hl-nth r-back 1) 0)
(expect "BACK" (car r-back) "ok")
(expect "BACK_PT" (pad:hl-nth r-back 1) 44)
(define r-refs (pad:find-refs-cmd j0))
(pad:jump-ok! "find-refs" (pad:js-point j0) (length (pad:hl-nth r-refs 3)))
(expect "REFS" (car r-refs) "ok")
(expect "REFS_N" (length (pad:hl-nth r-refs 3)) 3)
(expect "REFS_STR" (pad:offs-str (pad:hl-nth r-refs 3)) "9.44.55")

(pad:jump-reject! 5 "no-symbol" "goto-def")
(expect "NOSYM" (car (pad:goto-def (pad:js-at *fx* 0))) "no-symbol")
(pad:jump-reject! 5 "no-def" "goto-def")
(let ((p+ (let loop ((ts (pad:hl-tokens *fx*)))
            (cond ((null? ts) 0)
                  ((string=? (pad:hl-nth (car ts) 3) "+")
                   (pad:hl-nth (car ts) 1))
                  (#t (loop (cdr ts)))))))
  (expect "NODEF" (car (pad:goto-def (pad:js-at *fx* p+))) "no-def"))
(pad:jump-reject! 5 "nothing-to-back" "jump-back")
(expect "NOBACK" (car (pad:jump-back (pad:js-at *fx* 9))) "nothing-to-back")

;; Query / mutate honest Soft tip surfaces
(define *qsrc* "(define (hello x) (+ x 1))\n(define (bye y) (hello y))\n")
(pad:query-tape! *qsrc*)
(pad:query-find-line! "hello")
(pad:mutate-line!)
(expect "Q_FIND" (length (pad:q-find "hello")) 1)
(expect "Q_DU" (length (pad:q-defuse "hello")) 2)
(expect "Q_DEFS" (length (pad:q-defines)) 2)
(expect "M_SAFE" (if (pad:m-safe?) "yes" "no") "yes")
(display "REBIND ")
(display (pad:m-rebind! "hello" "(lambda (x) (* x 2))" "double"))
(newline)
(pad:mutate-line!)
(expect "M_TOTAL" (pad:alist-get (pad:m-summary) ":total") 2)
(pad:gaps-line!)
(expect "GAP" (if (pad:q-gap? "define-lookup") "yes" "no") "yes")

(if (= *fail* 0)
    (begin (display "PAD_M5_OK") (newline))
    (begin (display "PAD_M5_FAIL fail=")
           (display (number->string *fail*))
           (newline)))

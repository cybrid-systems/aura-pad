;; Two keymap strategies race the SAME seeded key sequence.
;; map-gentle (mid 1): arrow moves, printable insert, refuse too-far /
;;   empty-line / overlong / not-print.
;; map-bold   (mid 2): bigger jumps (clamp), allow delete, looser insert.
;; Soft gate rejects before apply. Higher score KEEP; tie keeps gentle.
;; fiber_live only when both fiber joins return scores (joins==spawned,
;; backend>0). Otherwise host-sequential. Never a fake fiber_live.

(define *score-gentle* 0)
(define *score-bold* 0)
(define *rej-gentle* 0)
(define *rej-bold* 0)
(define *keep-mid* 0)
(define *drop-mid* 0)
(define *keep-reason* "boot")
(define *drop-reason* "boot")
(define *main-name* "none")
(define *main-mid* 0)
(define *main-score* 0)
(define *world-line* "host-sequential")
(define *race-backend* 0)
(define *race-spawned* 0)
(define *race-joined* 0)

(define (map-gentle) (pad:score 1 1))
(define (map-bold) (pad:score 2 2))

(define (pad:race-thunks! thunk-a thunk-b)
  (set! *race-spawned* (+ *race-spawned* 2))
  (let ((b (try (fiber:spawn-backend) (catch (e) 0))))
    (if (and (number? b) (> b 0))
        (set! *race-backend* b))
    (let* ((f1 (try (fiber:spawn thunk-a) (catch (e) #f)))
           (f2 (try (fiber:spawn thunk-b) (catch (e) #f)))
           (r1 (if (and (number? f1) (> f1 0))
                   (try (fiber:join f1) (catch (e) #f))
                   #f))
           (r2 (if (and (number? f2) (> f2 0))
                   (try (fiber:join f2) (catch (e) #f))
                   #f)))
      (if (and (number? f1) (number? f2)
               (> f1 0) (> f2 0)
               (not (= f1 f2))
               (number? r1) (number? r2))
          (begin
            (set! *race-joined* (+ *race-joined* 2))
            (list r1 r2))
          (list (thunk-a) (thunk-b))))))

(define (pad:finish-world!)
  (if (and (> *race-spawned* 0)
           (= *race-joined* *race-spawned*)
           (> *race-backend* 0))
      (set! *world-line* "fiber_live")
      (set! *world-line* "host-sequential"))
  *world-line*)

(define (pad:stamp-world!)
  (pad:finish-world!)
  (display "WORLD line=")
  (display *world-line*)
  (display " backend=")
  (display (number->string *race-backend*))
  (display " joins=")
  (display (number->string *race-joined*))
  (display "/")
  (display (number->string *race-spawned*))
  (newline)
  *world-line*)

;; Strictly higher score wins. A tie keeps gentle (mid 1).
(define (pad:decide! gentle bold)
  (set! *score-gentle* gentle)
  (set! *score-bold* bold)
  (cond
    ((> bold gentle)
     (set! *keep-mid* 2)
     (set! *drop-mid* 1)
     (set! *main-mid* 2)
     (set! *main-name* "map-bold")
     (set! *keep-reason* "higher-score-stamp")
     (set! *drop-reason* "lower-score-rollback")
     (set! *main-score* (pad:stamp! 2 2 "map-bold")))
    ((> gentle bold)
     (set! *keep-mid* 1)
     (set! *drop-mid* 2)
     (set! *main-mid* 1)
     (set! *main-name* "map-gentle")
     (set! *keep-reason* "higher-score-stamp")
     (set! *drop-reason* "lower-score-rollback")
     (set! *main-score* (pad:stamp! 1 1 "map-gentle")))
    (#t
     (set! *keep-mid* 1)
     (set! *drop-mid* 2)
     (set! *main-mid* 1)
     (set! *main-name* "map-gentle")
     (set! *keep-reason* "tie-keep-gentle-stamp")
     (set! *drop-reason* "tie-drop-bold-rollback")
     (set! *main-score* (pad:stamp! 1 1 "map-gentle"))))
  *main-mid*)

(define (pad:race!)
  (set! *race-backend* 0)
  (set! *race-spawned* 0)
  (set! *race-joined* 0)
  (set! *world-line* "host-sequential")
  (let ((pair (pad:race-thunks!
               (lambda () (map-gentle))
               (lambda () (map-bold)))))
    (pad:finish-world!)
    (display "RACE gentle=")
    (display (pad:nstr (car pair)))
    (display " bold=")
    (display (pad:nstr (car (cdr pair))))
    (newline)
    ;; Host audit pass: gate rejections for both lines. Writes nothing.
    (set! *rej-gentle* (pad:r-rejects (pad:audit-run 1 1 "map-gentle")))
    (set! *rej-bold* (pad:r-rejects (pad:audit-run 2 2 "map-bold")))
    (display "REJECTS mid=1 total=")
    (display (number->string *rej-gentle*))
    (display " mid=2 total=")
    (display (number->string *rej-bold*))
    (newline)
    (pad:decide! (car pair) (car (cdr pair))))
  *main-mid*)

(define (pad:audit!)
  (pad:stamp-world!)
  (display "MAIN slot=")
  (display *main-name*)
  (display " mid=")
  (display (number->string *main-mid*))
  (display " score=")
  (display (pad:nstr *main-score*))
  (display " edits=")
  (display (number->string *edits*))
  (display " rejects=")
  (display (number->string *rejects*))
  (display " dist=")
  (display (number->string *dist*))
  (display " len=")
  (display (number->string (length *buf*)))
  (display " point=")
  (display (number->string *point*))
  (newline)
  (display "KEEP mid=")
  (display (number->string *keep-mid*))
  (display " reason=")
  (display *keep-reason*)
  (newline)
  (display "DROP mid=")
  (display (number->string *drop-mid*))
  (display " reason=")
  (display *drop-reason*)
  (newline)
  0)

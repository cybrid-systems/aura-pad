;; aura-pad M1/M2 -- keymap param pack sim + one live key on the main buffer.
;; M0 does not load this file. A pack is (step room strict):
;;   step   1..8   cursor jump for left/right (clamped at the edges)
;;   room   1..32  max buffer length before insert says need-space
;;   strict 0 or 1 1 = gentle rules: too-far / not-print, key 5 = end
;;                 0 = bold rules: clamp moves, any letter, key 5 = home
;; map-gentle == (1 8 1), map-bold == (3 20 0). Same scores as M0.
;; Soft reserved: never bind the identifier quote.

(define *room-boost* 0)
(define *live-r* 0)
(define *key* 0)
(define *live-edits* 0)
(define *live-rej* 0)
(define *live-shown* 0)

(define (pad:pack-step p) (car p))
(define (pad:pack-room p) (car (cdr p)))
(define (pad:pack-strict p) (car (cdr (cdr p))))

(define (pad:pack-ok? p)
  (and (pair? p)
       (pair? (cdr p))
       (pair? (cdr (cdr p)))
       (null? (cdr (cdr (cdr p))))
       (number? (pad:pack-step p))
       (number? (pad:pack-room p))
       (number? (pad:pack-strict p))
       (>= (pad:pack-step p) 1)
       (<= (pad:pack-step p) 8)
       (>= (pad:pack-room p) 1)
       (<= (pad:pack-room p) 32)
       (or (= (pad:pack-strict p) 0)
           (= (pad:pack-strict p) 1))))

;; Soft gate for a pack. Same kid-friendly reasons as M0.
(define (pad:pgate p op arg buf point)
  (let ((len (length buf))
        (mx (pad:pack-room p))
        (st (= (pad:pack-strict p) 1)))
    (cond
      ((and (= op 0) (= point 0) st) "too-far")
      ((and (= op 1) (>= point len) st) "too-far")
      ((and (= op 3) (= point 0)) "empty-line")
      ((and (= op 2) (>= len mx)) "need-space")
      ((and (= op 4) (>= len mx)) "need-space")
      ((and (= op 2) st (> (modulo arg 30) 25)) "not-print")
      (#t "ok"))))

(define (pad:papply p op arg buf point)
  (let ((len (length buf))
        (step (pad:pack-step p))
        (st (= (pad:pack-strict p) 1)))
    (cond
      ((= op 0)
       (let ((np (- point step)))
         (list buf (if (< np 0) 0 np))))
      ((= op 1)
       (let ((np (+ point step)))
         (list buf (if (> np len) len np))))
      ((= op 2)
       (list (pad:insert buf point (+ 97 (modulo arg 26))) (+ point 1)))
      ((= op 3)
       (list (pad:delete-back buf point) (- point 1)))
      ((= op 4)
       (list (pad:insert buf point 32) (+ point 1)))
      ((= op 5)
       (if st (list buf len) (list buf 0)))
      (#t (list buf point)))))

;; Pure play of a pack. Writes no world slot -- fiber-safe.
;; Returns (score edits rejects dist buf point) like pad:sim.
(define (pad:psim p)
  (let loop ((i 0)
             (r (pad:seed-step *seed*))
             (buf (list))
             (pt 0)
             (edits 0)
             (rejs 0))
    (if (>= i *steps*)
        (let ((d (pad:dist buf *goal*)))
          (list (pad:score-of edits rejs d) edits rejs d buf pt))
        (let* ((op (pad:key-op r))
               (arg (pad:key-arg r))
               (reason (pad:pgate p op arg buf pt)))
          (if (string=? reason "ok")
              (let ((st (pad:papply p op arg buf pt)))
                (loop (+ i 1) (pad:seed-step r)
                      (car st) (car (cdr st)) (+ edits 1) rejs))
              (loop (+ i 1) (pad:seed-step r) buf pt edits (+ rejs 1)))))))

(define (pad:score-pack p)
  (pad:r-score (pad:psim p)))

(define (pad:stamp-pack! p tag)
  (let ((s (pad:psim p)))
    (set! *slot-tag* tag)
    (set! *buf* (pad:r-buf s))
    (set! *point* (pad:r-point s))
    (set! *edits* (pad:r-edits s))
    (set! *rejects* (pad:r-rejects s))
    (set! *dist* (pad:r-dist s))
    (set! *score* (pad:r-score s))
    (set! *steps-done* *steps*)
    (pad:r-score s)))

(define (pad:live-score) *score*)

;; --- live editor: one key at a time on the main buffer ---

(define (pad:reset-live!)
  (set! *buf* (list))
  (set! *point* 0)
  (set! *key* 0)
  (set! *live-edits* 0)
  (set! *live-rej* 0)
  (set! *live-shown* 0)
  (set! *room-boost* 0)
  (set! *live-r* (pad:seed-step *seed*))
  (set! *slot-tag* "live")
  0)

;; One key with pack p (+ room-boost). Never retcons earlier keys.
;; MUTATE at key 8 gives the kid two more letters of room.
(define (pad:live-key! p tag)
  (set! *slot-tag* tag)
  (let* ((r *live-r*)
         (op (pad:key-op r))
         (arg (pad:key-arg r))
         (pk (list (pad:pack-step p)
                   (+ (pad:pack-room p) *room-boost*)
                   (pad:pack-strict p)))
         (reason (pad:pgate pk op arg *buf* *point*)))
    (if (string=? reason "ok")
        (let ((st (pad:papply pk op arg *buf* *point*)))
          (set! *buf* (car st))
          (set! *point* (car (cdr st)))
          (set! *live-edits* (+ *live-edits* 1)))
        (begin
          (set! *live-rej* (+ *live-rej* 1))
          (if (< *live-shown* 4)
              (begin
                (set! *live-shown* (+ *live-shown* 1))
                (display "REJECT mid=0 reason=")
                (display reason)
                (display " key=")
                (display (number->string (+ *key* 1)))
                (display " slot=")
                (display tag)
                (newline)))))
    (set! *live-r* (pad:seed-step r))
    (set! *key* (+ *key* 1))
    (set! *dist* (pad:dist *buf* *goal*))
    (set! *score* (pad:score-of *live-edits* *live-rej* *dist*))
    (if (= *key* 8)
        (begin
          (set! *room-boost* 2)
          (display "MUTATE key=8 room-boost=2 slot=")
          (display tag)
          (newline)))
    *key*))

(define (pad:live-tape! tag)
  (display "LIVE key=")
  (display (number->string *key*))
  (display " len=")
  (display (number->string (length *buf*)))
  (display " point=")
  (display (number->string *point*))
  (display " edits=")
  (display (number->string *live-edits*))
  (display " rejects=")
  (display (number->string *live-rej*))
  (display " dist=")
  (display (number->string *dist*))
  (display " slot=")
  (display tag)
  (newline)
  *key*)

;; Lazy read stack. play.aura loads this file on the first "KEY check".
;; An arrow never loads it. Soft reserved: never bind quote.
;;
;; This order does not fix aura#4351. play.aura has already loaded the
;; editor, so std cannot be first among every pad file. A false baseline
;; or a false pad:q-sane? is a real leak: print GAPS read-leak, set the
;; status to insane, and do not set-code. Do not describe that failure
;; as aura#4351 being solved by this load order.
;;
;; pad:q-sane? does not exist until query.aura has loaded. Calling it
;; earlier is unbound and re-runs play.aura (R7), which is not a baseline.
;; query.aura also freezes *pad-q-gaps* and *pad-q-used* at load, and it
;; needs std/query first, so query.aura is not loaded to invent the name.

(define *read-based* #f)
(define *read-base* #f)
(define *read-join* #f)
(define *read-done* #f)
(define *read-q* #f)
(define *read-canary* "")
(define *read-frame* #f)
(define *read-cache* (list))
(define *read-status* "none")
(define *read-missing* "none")
(define *read-extra* "none")
;; (name id line col uses points). line is 1-based. uses may be 0.
;; Filled in the child, copied to the root after the switch.
(define *read-mean* (list))
;; Last checked projection. Empty until the first check succeeds.
;; The next check compares define bodies with this text.
(define *read-proj* "")
;; Sentence set by a re-check. Empty means the cursor sentence stands.
(define *read-report* "")
(define *read-dirty-ids* "none")
;; A child created from the root has no parent flat, and mutate:rebind
;; then refuses the copy. One anchor holds a flat so the read child can
;; rebind. The anchor is not the page, and it is not deleted.
(define *read-anchor* #f)
;; Slot so a test can stand in an unbound query:dirty-nodes.
(define *read-dirty-fn*
  (lambda (reason) (query:dirty-nodes reason)))

(define (pad:read-bool b)
  (if b "true" "false"))

(define (pad:read-show! s)
  (display s)
  (newline)
  0)

;; The three forms on query.aura line 171. Recorded once, before std.aura,
;; query.aura, and ws.aura load. This function does not call pad:q-sane?.
(define (pad:read-sane?)
  (if (not *read-based*)
      (begin
        (set! *read-join* string-join)
        (set! *read-base*
              (and (null? (list))
                   (not (pair? (null? (list 1))))
                   (not (null? (list 1)))))
        (set! *read-based* #t)))
  *read-base*)

(define (pad:read-leak!)
  (pad:read-show! "GAPS read-leak")
  (pad:read-show! "READ state=insane")
  (set! *pl-say* "insane")
  0)

;; The pad's own string-join (view.aura). Not a stand-in for either probe.
;; A rebound name is not called: std/string's copy hangs (aura#4372).
(define (pad:read-canary!)
  (set! *read-canary*
        (if (eq? string-join *read-join*)
            (string-join (list "a" "b") ",")
            "rebound"))
  (pad:read-show! (string-append "READ canary=" *read-canary*))
  (pad:read-show!
    (string-append "READ set_code=" (number->string *ws-set-code-n*)))
  (pad:read-show! "READ state=sane")
  (set! *pl-say* "sane")
  0)

;; std, then query, then ws, and only then pad:q-sane?.
(define (pad:read-stack!)
  (pad:read-show! "READ loads=std")
  (load (string-append *pad-home* "/soft/pad/std.aura"))
  (pad:read-show! "READ loads=query")
  (load (string-append *pad-home* "/soft/pad/query.aura"))
  (pad:read-show! "READ loads=ws")
  (load (string-append *pad-home* "/soft/pad/ws.aura"))
  (set! *read-q* (pad:q-sane?))
  (pad:read-show! (string-append "READ q-sane=" (pad:read-bool *read-q*)))
  (if *read-q*
      (pad:read-canary!)
      (begin
        (pad:read-show!
          (string-append "READ set_code=" (number->string *ws-set-code-n*)))
        (pad:read-leak!))))

(define (pad:read-load!)
  (if *read-done*
      0
      (begin
        (pad:read-show!
          (string-append "READ baseline=" (pad:read-bool (pad:read-sane?))))
        (if *read-base*
            (pad:read-stack!)
            (begin
              (pad:read-show! "READ q-sane=unbound")
              (pad:read-show! "READ set_code=0")
              (pad:read-leak!)))
        (set! *read-done* #t)
        (if *read-frame* (pad:play-emit!) 0))))

;; Page text plus a trailing #t so eval-current is not a procedure or a
;; pair (aura#4366). This is not the notebook rows define.
(define (pad:read-src L)
  (string-append (pad:v-src L) "\n#t\n"))

;; Workspace ids start at 0, and 0 is false. Accept every number, including 0.
(define (pad:read-id? c)
  (number? c))

(define (pad:read-row-name row)
  (if (and (pair? row) (pair? (cdr row)) (string? (cadr row)))
      (cadr row)
      ""))

(define (pad:read-has-name? rows name)
  (cond
    ((null? rows) #f)
    ((string=? (pad:read-row-name (car rows)) name) #t)
    (#t (pad:read-has-name? (cdr rows) name))))

(define (pad:read-plain v)
  (cond
    ((null? v) (list))
    ((or (number? v) (string? v) (eq? v #t) (eq? v #f)) v)
    ((pair? v) (cons (pad:read-plain (car v)) (pad:read-plain (cdr v))))
    (#t 0)))

(define (pad:read-lookup name)
  (try
    (let ((r (define-lookup name)))
      (if (pad:eng-err? r) (list) (pad:read-plain r)))
    (catch (e)
      (if (pad:unbound-msg? e) "gap" (list)))))

(define (pad:read-refs look)
  (if (and (pair? look) (pair? (car look)) (number? (car (car look))))
      (pad:read-plain (pad:q-ref-counts (car (car look))))
      -1))

(define (pad:read-note! s)
  (pad:read-show! s)
  (set! *read-status* "fail")
  0)

;; set-code in the child replaces that workspace, so the counter set! inside
;; pad:ws-set-code! may not be the root binding we switch back to. After
;; the switch, record the call on the root when the child copy was dropped.
(define (pad:read-back! c n0 e0 did-eval)
  (try (workspace :switch 0) (catch (e) #f))
  (try (workspace:delete c) (catch (e) #f))
  (if (= *ws-set-code-n* n0)
      (set! *ws-set-code-n* (+ n0 1))
      0)
  (if (and did-eval (= *ws-eval-n* e0))
      (set! *ws-eval-n* (+ e0 1))
      0)
  0)

;; M9 shape: missing = Soft defines the engine did not birth,
;; extra = engine births the Soft define scan missed. Log only.
;; A non-empty diff stays "checked" and does not write SAY.
;; pad:hl-tokens is the editor highlighter (play loads hl before view).
(define (pad:read-diff L)
  (let* ((toks (pad:hl-tokens (pad:v-src L)))
         (soft (pad:ws-soft-defs toks))
         (eng (pad:ws-engine-defs toks)))
    (list (pad:ws-diff soft eng) (pad:ws-diff eng soft))))

(define (pad:read-log-diff! miss extra)
  (let ((ms (pad:ws-names-str miss))
        (ex (pad:ws-names-str extra)))
    (set! *read-missing* ms)
    (set! *read-extra* ex)
    (pad:read-show! (string-append "READ missing=" ms))
    (pad:read-show! (string-append "READ extra=" ex))
    0))

(define (pad:read-finish! code0 t0 miss extra)
  (let ((rows (try (workspace :list) (catch (e) #f))))
    (if (not (or (null? rows) (pair? rows)))
        (pad:read-note! "READ list-fail")
        (if (pad:read-has-name? rows "read")
            (pad:read-note! "READ child-left")
            (if (not (and (string? code0) (> (string-length code0) 0)
                          (string=? (pad:q-code) code0)))
                (pad:read-note! "READ_DISAGREE")
                (let ((canary (string-join (list "a" "b") ",")))
                  (if (not (string=? canary "a,b"))
                      (pad:read-note! "GAPS read-leak")
                      (if (not (pad:q-sane?))
                          (pad:read-note! "GAPS read-leak")
                          (begin
                            (set! *ws-load-ms* (- (current-time-ms) t0))
                            (set! *read-status* "checked")
                            (pad:read-show!
                              (string-append "READ ms=" (number->string *ws-load-ms*)))
                            (pad:read-show! (string-append "READ " (pad:ws-stats-str)))
                            (pad:read-show! (string-append "READ canary=" canary))
                            (pad:read-show! "READ q-sane=true")
                            (pad:read-show! "READ root=same")
                            (pad:read-show! "READ state=checked")
                            (pad:read-log-diff! miss extra)
                            0)))))))))

;; query:ref-counts is the parent count. On this commit a define inside
;; begin reports 1 even when nothing calls it. The sentence's used count
;; is query:calls, so an alias can say used 0.
(define (pad:read-mean-refs id)
  (if (< id 0)
      0
      (let ((u (pad:q-ref-counts id)))
        (if (number? u) u 0))))

(define (pad:read-calls name)
  (try
    (let ((r (query:calls name)))
      (cond
        ((pad:eng-err? r) -1)
        ((null? r) 0)
        ((pair? r) (length r))
        (#t -1)))
    (catch (e)
      (if (pad:unbound-msg? e) "gap-calls" -1))))

;; One cache row: (name id line col calls points refs).
;; "gap" means define-lookup is unbound. "gap-calls" means query:calls is.
;; points come from pad:defs-for while this child is still current.
(define (pad:read-mean-row name toks src L)
  (let ((look (pad:read-lookup name)))
    (if (string? look)
        "gap"
        (let ((calls (pad:read-calls name)))
          (if (string? calls)
              calls
              (let ((id (if (and (pair? look) (pair? (car look))
                                 (number? (car (car look))))
                            (car (car look))
                            -1))
                    (pts (pad:read-plain (pad:defs-for toks src name))))
                (let ((lc (if (and (pair? pts) (number? (car pts)))
                              (pad:v-linecol L (car pts))
                              (list 0 0))))
                  (list name id (+ (car lc) 1) (cadr lc)
                        calls pts (pad:read-mean-refs id)))))))))

(define (pad:read-mean! names toks src L)
  (if (null? names)
      (list)
      (let ((row (pad:read-mean-row (car names) toks src L)))
        (if (string? row)
            row
            (let ((rest (pad:read-mean! (cdr names) toks src L)))
              (if (string? rest) rest (cons row rest)))))))

(define (pad:read-gather! c L n0 e0 code0 t0)
  ;; query.aura sets this hook on the root. A child workspace keeps the
  ;; initial #f, so pad:defs-for would ignore engine records. Install it
  ;; here, after set-code, before the birth points are taken.
  (set! *pad-def-lookup* pad:define-lookup)
  (let ((look (pad:read-lookup "hello")))
    (if (string? look)
        (begin
          (pad:read-back! c n0 e0 #t)
          (pad:read-note! "GAPS define-lookup"))
        (let* ((src (pad:v-src L))
               (toks (pad:hl-tokens src))
               (cache (list look
                            (pad:read-plain (pad:q-defines))
                            (pad:read-plain (pad:q-defuse "hello"))
                            (pad:read-plain (pad:q-node-types))
                            (pad:read-refs look)))
               (diff (pad:read-diff L))
               (mean (pad:read-mean! (pad:ws-soft-defs toks) toks src L)))
          (if (string? mean)
              (begin
                (pad:read-back! c n0 e0 #t)
                (pad:read-note!
                  (if (string=? mean "gap-calls")
                      "GAPS query:calls"
                      "GAPS define-lookup")))
              (let* ((code (pad:q-code))
                     (vs (cond
                           ((and (string? code) (string=? code src)) "same")
                           ((and (string? code) (> (string-length code) 0))
                            "differ")
                           (#t "empty")))
                     (jsrc *pad-jump-src*))
                (pad:read-back! c n0 e0 #t)
                (set! *pad-jump-src* jsrc)
                (set! *read-cache* cache)
                (set! *read-mean* mean)
                (pad:read-show! (string-append "READ jump=" jsrc))
                ;; The page is the projection. query:code is the canonical
                ;; program in the child, and it is not that text.
                (pad:read-show!
                  (string-append "READ query:code="
                    (string-append vs
                      (string-append " proj="
                        (string-append (number->string (string-length src))
                          (string-append " code="
                            (number->string
                              (if (string? code) (string-length code) 0))))))))
                (pad:read-finish! code0 t0 (car diff) (cadr diff))))))))

;; Dirty names are a sentence after the check. They never skip the
;; page set-code or the eval. The whole page is still lowered once.
(define (pad:read-switched! c L n0 e0 code0 t0 plan)
  (try (workspace :switch c) (catch (e) #f))
  (pad:read-show! (string-append "READ child=" (number->string c)))
  (let ((r1 (pad:ws-set-code! (pad:read-src L))))
    (if (not (string=? r1 "ok"))
        (begin
          (pad:read-back! c n0 e0 #f)
          (pad:read-note! "READ set-code-fail"))
        (let ((r2 (pad:ws-eval!)))
          (if (not (or (string=? r2 "ok") (string=? r2 "note")))
              (begin
                (pad:read-back! c n0 e0 #t)
                (pad:read-note! "READ eval-fail"))
              (let ((box (pad:read-ask! plan)))
                (if (and (pair? box) (string? (car box))
                         (string=? (car box) "gap"))
                    (begin
                      (pad:read-back! c n0 e0 #t)
                      (pad:read-note! "GAPS query:dirty-nodes"))
                    (begin
                      (pad:read-gather! c L n0 e0 code0 t0)
                      (pad:read-publish! box (pad:v-src L))))))))))

;; Call-head scan. Flat pad:hl-tokens, nested again with paren kind "P".
;; A comment or a string is not a call head. The pen word list is not this scan.
;; The five names are refused at the top of a file and anywhere a define's
;; init actually calls them, including inside begin, lambda, and let.
(define (pad:read-tok-text t)
  (car (cdr (cdr (cdr t)))))

(define (pad:read-open? t)
  (and (string=? (car t) "P") (string=? (pad:read-tok-text t) "(")))

(define (pad:read-close? t)
  (and (string=? (car t) "P") (string=? (pad:read-tok-text t) ")")))

(define (pad:read-atom? f)
  (and (pair? f) (string? (car f)) (string=? (car f) "a")))

(define (pad:read-nest? f)
  (and (pair? f) (string? (car f)) (string=? (car f) "n")))

(define (pad:read-comment? f)
  (and (pad:read-atom? f) (string=? (cadr f) "C")))

(define (pad:read-atom-text f)
  (if (pad:read-atom? f) (car (cdr (cdr f))) ""))

(define (pad:read-skip-c xs)
  (cond
    ((null? xs) xs)
    ((pad:read-comment? (car xs)) (pad:read-skip-c (cdr xs)))
    (#t xs)))

(define (pad:read-form toks)
  (if (pad:read-open? (car toks))
      (pad:read-nest (cdr toks) (list))
      (cons (list "a" (car (car toks)) (pad:read-tok-text (car toks)))
            (cdr toks))))

(define (pad:read-nest toks acc)
  (cond
    ((null? toks) (cons (cons "n" (reverse acc)) (list)))
    ((pad:read-close? (car toks))
     (cons (cons "n" (reverse acc)) (cdr toks)))
    (#t
     (let ((got (pad:read-form toks)))
       (pad:read-nest (cdr got) (cons (car got) acc))))))

(define (pad:read-top toks acc)
  (cond
    ((null? toks) (cons "n" (reverse acc)))
    ((pad:read-close? (car toks))
     (pad:read-top (cdr toks) (cons (list "a" "P" ")") acc)))
    (#t
     (let ((got (pad:read-form toks)))
       (pad:read-top (cdr got) (cons (car got) acc))))))

(define (pad:read-head-in xs)
  (cond
    ((null? xs) "")
    ((pad:read-comment? (car xs)) (pad:read-head-in (cdr xs)))
    ((pad:read-atom? (car xs)) (pad:read-atom-text (car xs)))
    (#t "")))

(define (pad:read-head form)
  (if (pad:read-nest? form) (pad:read-head-in (cdr form)) ""))

(define (pad:read-after-head xs)
  (let ((ys (pad:read-skip-c xs)))
    (if (null? ys) ys (pad:read-skip-c (cdr ys)))))

(define (pad:read-bad-head? s)
  (or (string=? s "require")
      (string=? s "load")
      (string=? s "display")
      (string=? s "write-file")
      (string=? s "set-code")))

(define (pad:read-let-head? s)
  (or (string=? s "let") (string=? s "let*") (string=? s "letrec")))

(define (pad:read-exprs-bad? xs)
  (cond
    ((null? xs) #f)
    ((pad:read-expr-bad? (car xs)) #t)
    (#t (pad:read-exprs-bad? (cdr xs)))))

;; The first form is a name, a signature, or an arg list. It is not a call.
(define (pad:read-tail-bad? xs)
  (if (null? xs) #f (pad:read-exprs-bad? (cdr xs))))

(define (pad:read-one-bind-bad? form)
  (if (not (pad:read-nest? form))
      #f
      (pad:read-tail-bad? (pad:read-skip-c (cdr form)))))

(define (pad:read-bind-list-bad? xs)
  (cond
    ((null? xs) #f)
    ((pad:read-one-bind-bad? (car xs)) #t)
    (#t (pad:read-bind-list-bad? (cdr xs)))))

(define (pad:read-bindings-bad? form)
  (if (pad:read-nest? form)
      (pad:read-bind-list-bad? (cdr form))
      #f))

(define (pad:read-let-rest-bad? xs)
  (if (null? xs)
      #f
      (if (pad:read-atom? (car xs))
          (pad:read-let-binds-bad? (cdr xs))
          (pad:read-let-binds-bad? xs))))

(define (pad:read-let-binds-bad? xs)
  (if (null? xs)
      #f
      (or (pad:read-bindings-bad? (car xs))
          (pad:read-exprs-bad? (cdr xs)))))

(define (pad:read-call-bad? form)
  (pad:read-exprs-bad? (pad:read-skip-c (cdr form))))

(define (pad:read-inside-bad? h form)
  (let ((xs (pad:read-after-head (cdr form))))
    (cond
      ((string=? h "begin") (pad:read-exprs-bad? xs))
      ((string=? h "lambda") (pad:read-tail-bad? xs))
      ((string=? h "define") (pad:read-tail-bad? xs))
      ((pad:read-let-head? h) (pad:read-let-rest-bad? xs))
      (#t (pad:read-call-bad? form)))))

(define (pad:read-expr-bad? form)
  (cond
    ((not (pad:read-nest? form)) #f)
    (#t
     (let ((h (pad:read-head form)))
       (if (pad:read-bad-head? h)
           #t
           (pad:read-inside-bad? h form))))))

(define (pad:read-top-ok? form)
  (cond
    ((not (pad:read-nest? form)) #t)
    (#t
     (let ((h (pad:read-head form)))
       (or (string=? h "define") (string=? h "export"))))))

(define (pad:read-forms-bad? xs)
  (cond
    ((null? xs) #f)
    ((not (pad:read-top-ok? (car xs))) #t)
    ((and (pad:read-nest? (car xs))
          (string=? (pad:read-head (car xs)) "define")
          (pad:read-tail-bad? (pad:read-after-head (cdr (car xs)))))
     #t)
    (#t (pad:read-forms-bad? (cdr xs)))))

(define (pad:read-guard-src? src)
  (pad:read-forms-bad? (cdr (pad:read-top (pad:hl-tokens src) (list)))))

(define (pad:read-guard? L)
  (pad:read-guard-src? (pad:v-src L)))

(define (pad:read-refuse!)
  (set! *pl-say* "aura did not check this file: it loads other code")
  (pad:read-note! *pl-say*)
  0)

(define (pad:read-current)
  (let ((id (try (workspace :current) (catch (e) #f))))
    (if (number? id) id -1)))

(define (pad:read-ws? c)
  (or (= c 32) (= c 9) (= c 10) (= c 13)))

(define (pad:read-back-ws s i)
  (if (or (< i 0) (not (pad:read-ws? (string-ref s i))))
      i
      (pad:read-back-ws s (- i 1))))

;; The '(' that opens a define sits just left of the define keyword.
(define (pad:read-open-left s i)
  (let ((j (pad:read-back-ws s (- i 1))))
    (if (and (>= j 0) (= (string-ref s j) 40)) j -1)))

(define (pad:read-skip-ws s i n)
  (if (or (>= i n) (not (pad:read-ws? (string-ref s i))))
      i
      (pad:read-skip-ws s (+ i 1) n)))

(define (pad:read-toks-at toks at)
  (cond
    ((null? toks) (list))
    ((>= (cadr (car toks)) at) toks)
    (#t (pad:read-toks-at (cdr toks) at))))

;; Exclusive end of the form whose '(' starts at open. Strings and
;; comments are not paren tokens, so a mark inside them does not count.
(define (pad:read-match-from toks d)
  (if (null? toks)
      -1
      (let ((t (car toks)))
        (if (not (string=? (car t) "P"))
            (pad:read-match-from (cdr toks) d)
            (if (string=? (pad:read-tok-text t) "(")
                (pad:read-match-from (cdr toks) (+ d 1))
                (if (<= d 1)
                    (caddr t)
                    (pad:read-match-from (cdr toks) (- d 1))))))))

(define (pad:read-match toks open)
  (if (< open 0) -1 (pad:read-match-from (pad:read-toks-at toks open) 0)))

(define (pad:read-lam? s)
  (and (string? s)
       (>= (string-length s) 7)
       (string=? (substring s 0 7) "(lambda")))

;; (define (name args) body) -> (lambda (args) body). The name is dropped
;; and the define's own closing paren is replaced by the lambda's.
(define (pad:read-sugar src toks prev prev2 name-tok)
  (if (not prev2)
      ""
      (let* ((n (string-length src))
             (open (pad:read-open-left src (cadr prev2)))
             (end (pad:read-match toks open))
             (param (cadr prev))
             (name-at (cadr name-tok))
             (after (pad:read-skip-ws src (caddr name-tok) n)))
        (if (or (< open 0) (< end 0) (>= param name-at) (> after (- end 1)))
            ""
            (string-append
              "(lambda "
              (string-append
                (substring src param name-at)
                (string-append (substring src after (- end 1)) ")")))))))

;; (define name <init>). A lambda init is already the rebind text.
(define (pad:read-value src toks prev name-tok)
  (if (not prev)
      ""
      (let* ((n (string-length src))
             (open (pad:read-open-left src (cadr prev)))
             (end (pad:read-match toks open))
             (at (pad:read-skip-ws src (caddr name-tok) n)))
        (if (or (< open 0) (< end 0) (> at (- end 1)))
            ""
            (substring src at (- end 1))))))

(define (pad:read-lam-of src toks prev prev2 name-tok)
  (if (and prev (string=? (car prev) "P"))
      (pad:read-sugar src toks prev prev2 name-tok)
      (pad:read-value src toks prev name-tok)))

;; Same hit as pad:ws-soft-defs. A comment between define and the name
;; is a miss, so that page stays a name-set change and does not rebind.
(define (pad:read-lam-walk all xs src prev prev2 acc)
  (if (null? xs)
      (reverse acc)
      (let* ((t (car xs))
             (k (car t))
             (hit (and (or (string=? k "S") (string=? k "Q") (string=? k "M"))
                       (or (and prev (string=? (car prev) "K")
                                (string=? (pad:read-tok-text prev) "define"))
                           (and prev (string=? (car prev) "P")
                                (string=? (pad:read-tok-text prev) "(")
                                prev2 (string=? (car prev2) "K")
                                (string=? (pad:read-tok-text prev2) "define"))))))
        (pad:read-lam-walk all (cdr xs) src t prev
          (if hit
              (cons (list (pad:read-tok-text t)
                          (pad:read-lam-of src all prev prev2 t))
                    acc)
              acc)))))

(define (pad:read-lams src)
  (let ((toks (pad:hl-tokens src)))
    (pad:read-lam-walk toks toks src #f #f (list))))

(define (pad:read-names=? a b)
  (cond
    ((and (null? a) (null? b)) #t)
    ((or (null? a) (null? b)) #f)
    ((string=? (car a) (car b)) (pad:read-names=? (cdr a) (cdr b)))
    (#t #f)))

(define (pad:read-forms=? a b)
  (cond
    ((and (null? a) (null? b)) #t)
    ((or (null? a) (null? b)) #f)
    ((string=? (cadr (car a)) (cadr (car b)))
     (pad:read-forms=? (cdr a) (cdr b)))
    (#t #f)))

;; (pairs bad?). bad means a changed init is not a lambda, so do not rebind.
(define (pad:read-body-pairs a b acc bad)
  (cond
    ((or (null? a) (null? b)) (list (reverse acc) bad))
    ((string=? (cadr (car a)) (cadr (car b)))
     (pad:read-body-pairs (cdr a) (cdr b) acc bad))
    ((pad:read-lam? (cadr (car b)))
     (pad:read-body-pairs (cdr a) (cdr b)
       (cons (list (car (car b)) (cadr (car b))) acc)
       bad))
    (#t (pad:read-body-pairs (cdr a) (cdr b) acc #t))))

;; (kind pairs). pairs is empty unless a lambda body actually changed.
;; fresh / same / other / comment do not rebind. comment still asks
;; the engine, which may report no dirty define.
(define (pad:read-plan prev src)
  (if (string=? prev "")
      (list "fresh" (list))
      (if (string=? prev src)
          (list "same" (list))
          (let ((na (pad:ws-soft-defs (pad:hl-tokens prev)))
                (nb (pad:ws-soft-defs (pad:hl-tokens src))))
            (if (not (pad:read-names=? na nb))
                (list "other" (list))
                (let ((fa (pad:read-lams prev))
                      (fb (pad:read-lams src)))
                  (if (pad:read-forms=? fa fb)
                      (list "comment" (list))
                      (let ((got (pad:read-body-pairs fa fb (list) #f)))
                        (if (cadr got)
                            (list "other" (list))
                            (list "body" (car got)))))))))))

(define (pad:read-save-one pair)
  (let ((ids (pad:read-plain (pad:q-defines-of (car pair)))))
    (list (car pair)
          (if (and (pair? ids) (number? (car ids))) (car ids) -1))))

(define (pad:read-save-ids pairs)
  (if (null? pairs)
      (list)
      (cons (pad:read-save-one (car pairs))
            (pad:read-save-ids (cdr pairs)))))

(define (pad:read-rebind-all pairs)
  (if (null? pairs)
      0
      (begin
        (let ((v (pad:m-rebind! (car (car pairs)) (cadr (car pairs)) "dirty")))
          (if (eq? v #t)
              0
              (pad:read-show!
                (string-append "READ rebind-skip " (car (car pairs))))))
        (pad:read-rebind-all (cdr pairs)))))

(define (pad:read-id-strs xs)
  (cond
    ((or (null? xs) (not (pair? xs))) (list))
    ((string? (car xs)) (cons (car xs) (pad:read-id-strs (cdr xs))))
    ((number? (car xs))
     (cons (number->string (car xs)) (pad:read-id-strs (cdr xs))))
    (#t (pad:read-id-strs (cdr xs)))))

(define (pad:read-dot xs)
  (cond
    ((null? xs) "none")
    ((null? (cdr xs)) (car xs))
    (#t (string-append (car xs) (string-append "." (pad:read-dot (cdr xs)))))))

(define (pad:read-mem? s xs)
  (cond
    ((null? xs) #f)
    ((string=? (car xs) s) #t)
    (#t (pad:read-mem? s (cdr xs)))))

(define (pad:read-sub-hot? id)
  (let ((c (try (query:dirty-subtree id) (catch (e) 0))))
    (and (number? c) (> c 0))))

;; Rebind can renumber a define. The id from before the rebind and the id
;; from after it are both checked against the dirty list.
(define (pad:read-hot? n ids)
  (and (number? n) (>= n 0)
       (or (pad:read-mem? (number->string n) ids)
           (pad:read-sub-hot? n))))

(define (pad:read-id-named name rows)
  (cond
    ((null? rows) -1)
    ((string=? (car (car rows)) name) (cadr (car rows)))
    (#t (pad:read-id-named name (cdr rows)))))

(define (pad:read-picked before after ids)
  (if (null? before)
      (list)
      (let ((name (car (car before)))
            (rest (pad:read-picked (cdr before) after ids)))
        (if (or (pad:read-hot? (cadr (car before)) ids)
                (pad:read-hot? (pad:read-id-named name after) ids))
            (cons name rest)
            rest))))

(define (pad:read-comma xs)
  (if (null? (cdr xs))
      (car xs)
      (string-append (car xs) (string-append ", " (pad:read-comma (cdr xs))))))

(define (pad:read-dirty-say names)
  (cond
    ((null? names) "nothing is dirty")
    ((null? (cdr names)) (string-append (car names) " is dirty"))
    (#t (string-append (pad:read-comma names) " are dirty"))))

;; Runs in the child. Returns a list. Root sentences are written after
;; the switch back, because a set! in the child is not the root binding.
;; Ids are captured before rebind: a name lookup can come back empty after.
(define (pad:read-dirty-box kind before pairs)
  (let ((raw (try (*read-dirty-fn* "general")
                  (catch (e)
                    (if (pad:unbound-msg? e) "gap" (list))))))
    (cond
      ((string? raw) (list "gap"))
      ((pad:eng-err? raw) (list "gap"))
      (#t
       (let* ((ids (pad:read-id-strs (if (pair? raw) (pad:read-plain raw) (list))))
              (after (pad:read-save-ids pairs)))
         (list "ok" (pad:read-dot ids)
               (pad:read-picked before after ids) kind))))))

(define (pad:read-ask! plan)
  (let ((pairs (cadr plan))
        (before (pad:read-save-ids (cadr plan))))
    (pad:read-rebind-all pairs)
    (pad:read-dirty-box (car plan) before pairs)))

(define (pad:read-publish! box src)
  (if (not (string=? *read-status* "checked"))
      0
      (let ((ids (cadr box))
            (names (car (cdr (cdr box))))
            (kind (car (cdr (cdr (cdr box))))))
        (set! *read-proj* src)
        (set! *read-dirty-ids* ids)
        (pad:read-show! (string-append "READ query:dirty-nodes=" ids))
        (if (or (string=? kind "body") (string=? kind "comment"))
            (let ((say (pad:read-dirty-say names)))
              (set! *pl-say* say)
              (set! *read-report* say)
              0)
            0))))

;; One anchor per process. Its flat is the parent of every "read" child.
;; A child created while the root flat is empty cannot rebind. The anchor
;; is not the page and it is not deleted.
(define (pad:read-anchor!)
  (if (number? *read-anchor*)
      *read-anchor*
      (let ((c (try (workspace :create "anchor") (catch (e) #f))))
        (if (not (number? c))
            #f
            (begin
              (try (workspace :switch c) (catch (e) #f))
              (if (not (= (pad:read-current) c))
                  (begin
                    (try (workspace :switch 0) (catch (e) #f))
                    #f)
                  (let ((ok (try (set-code "(define (boot) 1)\n#t\n")
                                 (catch (e) #f))))
                    (try (workspace :switch 0) (catch (e) #f))
                    (if (eq? ok #t)
                        (begin (set! *read-anchor* c) c)
                        (begin
                          (try (workspace:delete c) (catch (e) #f))
                          #f)))))))))

(define (pad:read-check! L)
  (set! *read-report* "")
  (if (pad:read-guard? L)
      (pad:read-refuse!)
      (let ((code0 (pad:q-code))
            (t0 (current-time-ms))
            (n0 *ws-set-code-n*)
            (e0 *ws-eval-n*)
            (plan (pad:read-plan *read-proj* (pad:v-src L))))
        (let ((a (pad:read-anchor!)))
          (if (not (number? a))
              (pad:read-note! "READ no-world")
              (begin
                (try (workspace :switch a) (catch (e) #f))
                (if (not (= (pad:read-current) a))
                    (begin
                      (try (workspace :switch 0) (catch (e) #f))
                      (pad:read-note! "READ no-world"))
                    (let ((c (try (workspace :create "read") (catch (e) #f))))
                      (if (not (pad:read-id? c))
                          (begin
                            (try (workspace :switch 0) (catch (e) #f))
                            (pad:read-note! "READ no-world"))
                          (pad:read-switched! c L n0 e0 code0 t0 plan))))))))))

(pad:read-show! "READ loaded")
(set! *read-ready* #t)

;; M5 Soft tests: Aura HL tokenize, goto-def / find-refs / jump-back,
;; Soft query:* / mutate:* bridge (honest tip surfaces only).
;; Numbers match scripts/hl_model.py --check. Ends PAD_M5_TEST_OK.
;; No HTTP, no fibers. Soft reserved: never bind quote.
;; std modules first, before any other load (aura#4351), via std.aura.
(load "/workspace/aura-pad/soft/pad/std.aura")
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/hl.aura")
(load "/workspace/aura-pad/soft/pad/jump.aura")
(load "/workspace/aura-pad/soft/pad/query.aura")

(define *fail* 0)
(define *checks* 0)

(define (expect tag got want)
  (set! *checks* (+ *checks* 1))
  (display "T ")
  (display tag)
  (display "=")
  (display (if (number? got) (pad:nstr got) "?"))
  (if (and (number? got) (= got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display (pad:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-str tag got want)
  (set! *checks* (+ *checks* 1))
  (display "T ")
  (display tag)
  (display "=")
  (display (if (string? got) got "?"))
  (if (and (string? got) (string=? got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display want)
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-true tag got)
  (expect-str tag (if got "yes" "no") "yes"))

(define *hl-demo*
  "(define (foo x) ; hi\n  (+ x 1))\n(query:find \"foo\")\n(mutate:summary)")

(define *fx*
  "(define (hello x) (+ x 1))\n(define (bye y) (hello y))\n(hello 3)\n; comment\n(query:find \"hello\")\n(mutate:summary)\n")

(define *hl-color-want*
  "PKKKKKK.PSSS.SP.CCCC...PS.S.NPP.PQQQQQQQQQQ.TTTTTP.PMMMMMMMMMMMMMMP")

(define (hl-tests!)
  (let* ((toks (pad:hl-tokens *hl-demo*))
         (col (pad:hl-color *hl-demo*)))
    (expect "HL_N" (string-length *hl-demo*) 67)
    (expect "HL_TOKS" (length toks) 20)
    (expect "HL_K" (pad:hl-count toks "K") 1)
    (expect "HL_Q" (pad:hl-count toks "Q") 1)
    (expect "HL_M" (pad:hl-count toks "M") 1)
    (expect "HL_C" (pad:hl-count toks "C") 1)
    (expect "HL_T" (pad:hl-count toks "T") 1)
    (expect "HL_P" (pad:hl-count toks "P") 10)
    (expect "HL_S" (pad:hl-count toks "S") 4)
    (expect "HL_Nlit" (pad:hl-count toks "N") 1)
    (expect-str "HL_COLOR" col *hl-color-want*)
    (expect-str "HL_TOK0" (car (car toks)) "P")
    (expect-str "HL_TOK1" (pad:hl-nth (pad:hl-nth toks 1) 3) "define")
    (expect-str "HL_TOK1K" (car (pad:hl-nth toks 1)) "K")
    ;; string/comment skipped for symbol scan: foo inside string is T
    (expect-true "HL_STR_HAS_FOO"
                 (let loop ((ts toks))
                   (cond
                     ((null? ts) #f)
                     ((and (string=? (car (car ts)) "T")
                           (string=? (pad:hl-nth (car ts) 3) "\"foo\"")) #t)
                     (#t (loop (cdr ts))))))
    0))

(define (jump-tests!)
  (let* ((defs (pad:find-defs *fx* "hello"))
         (refs (pad:find-refs *fx* "hello"))
         (dbye (pad:find-defs *fx* "bye")))
    (expect "DEF_HELLO" (car defs) 9)
    (expect "DEF_HELLO_N" (length defs) 1)
    (expect "REF_HELLO_N" (length refs) 3)
    (expect "REF_HELLO_0" (pad:hl-nth refs 0) 9)
    (expect "REF_HELLO_1" (pad:hl-nth refs 1) 44)
    (expect "REF_HELLO_2" (pad:hl-nth refs 2) 55)
    (expect "DEF_BYE" (car dbye) 36)
    (expect "DEFS_PLUS" (length (pad:find-defs *fx* "+")) 0)
    ;; goto-def from use at 44
    (let* ((j0 (pad:js-at *fx* 44))
           (r (pad:goto-def j0))
           (j1 (pad:jump-apply j0 r)))
      (expect-str "GOTO_OK" (car r) "ok")
      (expect "GOTO_PT" (pad:hl-nth r 1) 9)
      (expect "GOTO_STACK" (length (pad:hl-nth r 2)) 1)
      (let ((rb (pad:jump-back j1)))
        (expect-str "BACK_OK" (car rb) "ok")
        (expect "BACK_PT" (pad:hl-nth rb 1) 44))
      (let ((rr (pad:find-refs-cmd j0)))
        (expect-str "REFS_OK" (car rr) "ok")
        (expect "REFS_N" (length (pad:hl-nth rr 3)) 3)))
    ;; kid REJECT paths (state point unchanged)
    (let ((jbad (pad:js-at *fx* 0)))
      (expect-str "NOSYM" (car (pad:goto-def jbad)) "no-symbol")
      (expect "NOSYM_PT" (pad:hl-nth (pad:goto-def jbad) 1) 0)
      (expect-str "NOSYM_REF" (car (pad:find-refs-cmd jbad)) "no-symbol"))
    (let* ((p-plus
            (let loop ((ts (pad:hl-tokens *fx*)))
              (cond
                ((null? ts) 0)
                ((string=? (pad:hl-nth (car ts) 3) "+")
                 (pad:hl-nth (car ts) 1))
                (#t (loop (cdr ts))))))
           (jp (pad:js-at *fx* p-plus)))
      (expect-str "NODEF" (car (pad:goto-def jp)) "no-def")
      (expect "NODEF_PT" (pad:hl-nth (pad:goto-def jp) 1) p-plus))
    (expect-str "NOBACK" (car (pad:jump-back (pad:js-at *fx* 9))) "nothing-to-back")
    (expect-str "SAY_NOSYM" (pad:kid-say-jump "no-symbol")
                "put the cursor on a name first")
    (expect-str "SAY_NODEF" (pad:kid-say-jump "no-def")
                "could not find where that name is born")
    (expect-str "SAY_NOREF" (pad:kid-say-jump "no-ref")
                "that name is not used anywhere else")
    (expect-str "SAY_NOBACK" (pad:kid-say-jump "nothing-to-back")
                "nowhere to jump back to")
    ;; sym under point
    (expect-str "SYM_AT" (pad:sym-at *fx* 9) "hello")
    (expect-str "SYM_NONE" (pad:sym-at *fx* 0) "")
    0))

(define (query-tests!)
  (let ((src "(define (hello x) (+ x 1))\n(define (bye y) (hello y))\n"))
    (expect-str "Q_LOAD" (pad:q-load! src) "ok")
    (expect "Q_DEFS" (length (pad:q-defines)) 2)
    (expect "Q_FIND" (length (pad:q-find "hello")) 1)
    (expect "Q_DU" (length (pad:q-defuse "hello")) 2)
    (expect-true "Q_SAFE" (pad:m-safe?))
    (expect "Q_DEPTH" (pad:m-depth) 0)
    (expect-true "Q_QUOTA" (pad:m-quota?))
    (expect "Q_TOTAL0" (pad:alist-get (pad:m-summary) ":total") 0)
    (expect-true "Q_REBIND" (pad:m-rebind! "hello" "(lambda (x) (* x x))" "square"))
    (expect "Q_TOTAL2" (pad:alist-get (pad:m-summary) ":total") 2)
    (expect "Q_COMMIT" (pad:alist-get (pad:m-summary) ":committed") 2)
    (expect-str "Q_HELP" (pad:q-help "find") "Find first node-id matching name.")
    (expect "Q_CATS" (length (pad:q-categories)) 10)
    ;; Soft tip c69e644 binds these (aura#4345 closed): USED, not GAPS.
    (expect-true "USED_DEFLOOKUP" (pad:q-used? "define-lookup"))
    (expect-true "USED_QCODE" (pad:q-used? "query:code"))
    (expect-true "USED_QREF" (pad:q-used? "query:ref-counts"))
    (expect-true "USED_QNTYPES" (pad:q-used? "query:node-types"))
    (expect-str "GAPS_NONE" (if (null? *pad-q-gaps*) "yes" "no") "yes")
    (expect-true "JUMP_HOOK" (procedure? *pad-def-lookup*))
    (expect "DEFLOOKUP_HELLO" (length (pad:define-lookup "hello")) 1)
    (expect-true "QCODE_BEGIN" (string-prefix? (pad:q-code) "(begin "))
    (expect-true "QNTYPES_PAIR" (pair? (pad:q-node-types)))
    (expect-str "GAP_NO" (if (pad:q-gap? "query:find") "yes" "no") "no")
    0))

(hl-tests!)
(jump-tests!)
(query-tests!)

(display "TESTS checks=")
(display (number->string *checks*))
(display " fail=")
(display (number->string *fail*))
(newline)
(if (= *fail* 0)
    (begin (display "PAD_M5_TEST_OK") (newline))
    (begin (display "PAD_M5_TEST_FAIL") (newline)))

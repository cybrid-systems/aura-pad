;; aura-pad M8 -- intent worldline: kid goal + pd:goal helper race.
;; Kid gives a goal ("hi aura"); two command helpers race on fibers toward
;; it; Soft shows CARD a=.. b=.. KEEP=..; strictly higher score KEEP,
;; tie DROP + heal!; undo KEEP re-plays and re-scores (mismatch fails loud).
;; Hot slot pd:goal holds the trial helper; pd:gshadow is main.
;; Score (story): base - keys - 2*rejects - 3*dist - 4*unkind.
;; Gate: banned words + kind-word list + capability probe (exec/network/ffi
;; -> REJECT not-allowed when capability? is bound; else GAPS capability).
;; Needs buffer/rules/lines/hot/card. Soft reserved: never bind quote.

(load "/workspace/aura-pad/soft/pad/hot.aura")
(load "/workspace/aura-pad/soft/pad/card.aura")

(define *goal-main-body*
  "(lambda () (list \"kill-line\" \"type:hi\" \"open-line\" \"next-line\" \"type:au\"))")
(define *goal-seeded* 0)
(define *goal-base* 0)
(define *goal-trial* 0)
(define *goal-tag* "boot")
(define *goal-word* "")
(define *goal-why* "")
(define *goal-keeps* 0)
(define *goal-drops* 0)
(define *goal-history* (list))
(define *goal-undos* 0)
(define *goal-cap-gaps* 0)
(define *goal-cap-bound* 0)
(define *g-base* 40)
(define *g-goal-text* "hi aura")
(define *g-goal-lines* (list (list 104 105) (list 97 117 114 97)))
(define *g-page* (list (list)))
(define *g-score* 0)
(define *g-keys* 0)
(define *g-rej* 0)
(define *g-dist* 0)
(define *g-unkind* 0)
(define *g-tag* "none")
(define *g-card* "")
(define *goal-history-max* 8)

(define *goal-banned*
  (list "pd:goal" "pd:gshadow" "pad:gstamp" "pad:gsim" "*g-goal"
        "string->symbol" "require" "import" "define"))

(define *goal-cap-words* (list "exec" "network" "ffi"))

;; --- capability probe (once): bound? -> gate exec/network/ffi; else GAPS ---
(define (pd:goal-probe-cap!)
  (if (> *goal-cap-bound* 0)
      *goal-cap-bound*
      (let ((r (try (begin (capability? "Mutate") 1) (catch (e) 0))))
        (if (= r 1)
            (set! *goal-cap-bound* 1)
            (begin
              (set! *goal-cap-bound* 2)
              (set! *goal-cap-gaps* 1)
              (display "GAPS capability")
              (newline)))
        *goal-cap-bound*)))

(define (pd:goal-cap-word s)
  (let loop ((ws *goal-cap-words*))
    (cond
      ((null? ws) "")
      ((string-contains? s (car ws)) (car ws))
      (#t (loop (cdr ws))))))

;; --- goal text <-> lines ("hi aura" -> ("hi" "aura")) ---
(define (pad:goal-split text)
  (let* ((clean (pd:clean text))
         (n (string-length clean)))
    (if (= n 0)
        (list)
        (let loop ((i 0) (start 0) (acc (list)))
          (cond
            ((>= i n)
             (reverse (cons (substring clean start n) acc)))
            ((char=? (string-ref clean i) #\space)
             (if (= start i)
                 (loop (+ i 1) (+ i 1) acc)
                 (loop (+ i 1) (+ i 1)
                       (cons (substring clean start i) acc))))
            (#t (loop (+ i 1) start acc)))))))

(define (pad:goal-lines-of text)
  (map pad:type-codes (pad:goal-split text)))

(define (pad:goal-set-text! text)
  (let ((t (pd:clean text)))
    (if (= (string-length t) 0)
        (list #f "no-goal")
        (begin
          (set! *g-goal-text* t)
          (set! *g-goal-lines* (pad:goal-lines-of t))
          (list #t t)))))

;; Local kind-word list (m4's pad:mean-word is optional; do not call it
;; unbound -- try/catch can return an error string that looks "truthy").
(define *goal-mean-words* (list "stupid" "dumb" "hate" "idiot" "shut up"))
(define (pad:goal-mean-word s)
  (let loop ((ws *goal-mean-words*))
    (cond
      ((null? ws) "")
      ((string-contains? s (car ws)) (car ws))
      (#t (loop (cdr ws))))))

(define (pad:mean-word-goal s)
  (pad:goal-mean-word s))

(define (pad:goal-unkind plan)
  ;; Kind words are refused at the gate before a plan enters pd:goal.
  ;; Unkind penalty stays 0 here so score matches the host model.
  0)

(define (pad:gsim plan tag print)
  (let ((unk (pad:goal-unkind plan)))
    (let loop ((cs (pad:expand plan))
               (i 0)
               (L (pad:start-lines))
               (l 0)
               (col 0)
               (keys 0)
               (rej 0))
      (if (null? cs)
          (let ((d (pad:dist-lines L *g-goal-lines*)))
            (list (- *g-base* (+ keys (* 2 rej) (* 3 d) (* 4 unk)))
                  keys rej d unk L l col))
          (let* ((c (car cs))
                 (reason (pad:lgate c L l col)))
            (if (string=? reason "ok")
                (let ((st (pad:lapply c L l col)))
                  (loop (cdr cs) (+ i 1)
                        (car st) (car (cdr st)) (car (cdr (cdr st)))
                        (+ keys 1) rej))
                (begin
                  (if (and (= print 1) (< rej 4))
                      (pad:lreject! (+ i 1) c reason tag))
                  (loop (cdr cs) (+ i 1) L l col keys (+ rej 1)))))))))

(define (pad:g-score s) (car s))
(define (pad:g-keys s) (pad:nth s 1))
(define (pad:g-rej s) (pad:nth s 2))
(define (pad:g-dist s) (pad:nth s 3))
(define (pad:g-unk s) (pad:nth s 4))
(define (pad:g-lines s) (pad:nth s 5))
(define (pad:g-line s) (pad:nth s 6))
(define (pad:g-col s) (pad:nth s 7))

(define (pad:gscore-plan plan)
  (if (pad:plan-ok? plan)
      (pad:g-score (pad:gsim plan "race" 0))
      -999))

(define (pad:gstamp! plan tag)
  (let ((s (pad:gsim plan tag 0)))
    (set! *g-tag* tag)
    (set! *g-page* (pad:g-lines s))
    (set! *g-keys* (pad:g-keys s))
    (set! *g-rej* (pad:g-rej s))
    (set! *g-dist* (pad:g-dist s))
    (set! *g-unkind* (pad:g-unk s))
    (set! *g-score* (pad:g-score s))
    (display "TAPE kind=goal text=")
    (display (pad:lines-text *g-page*))
    (display " score=")
    (display (pad:nstr *g-score*))
    (display " slot=")
    (display tag)
    (newline)
    *g-score*))

;; --- gate ---
(define (pd:goal-bad-word s)
  (let ((w (pd:bad-word s)))
    (if (> (string-length w) 0)
        w
        (let loop ((ws *goal-banned*))
          (cond
            ((null? ws) "")
            ((string-contains? s (car ws)) (car ws))
            (#t (loop (cdr ws))))))))

(define (pd:goal-body-why body)
  (cond
    ((not (string? body)) "gate")
    ((< (string-length body) 11) "gate")
    ((> (string-length body) 1999) "gate")
    ((not (string-prefix? body "(lambda")) "gate")
    ((> (string-length (pd:goal-bad-word body)) 0) "gate")
    ((> (string-length (pad:mean-word-goal body)) 0) "kind")
    (#t
     (begin
       (pd:goal-probe-cap!)
       (let ((cw (pd:goal-cap-word body)))
         (if (and (= *goal-cap-bound* 1) (> (string-length cw) 0))
             "not-allowed"
             (if (and (= *goal-cap-bound* 2) (> (string-length cw) 0))
                 "gate"
                 "")))))))

(define (pd:goal-seed! body)
  (if (= *goal-seeded* 1)
      (list #t "seed")
      (let* ((src (string-append
                   "(define pd:goal " body ")\n"
                   "(define pd:gshadow " body ")\n"))
             (sc (try (set-code src) (catch (e) e))))
        (if (not (equal? sc #t))
            (list #f "seed")
            (begin
              (eval-current)
              (hot-strategy:register! "pd:goal" body)
              (set! *goal-main-body* body)
              (set! *goal-seeded* 1)
              (set! *race-backend* 0)
              (set! *race-spawned* 0)
              (set! *race-joined* 0)
              (let ((p (try (pd:gshadow) (catch (e) #f))))
                (if (and (pad:plan-ok? p)
                         (pad:plan-ok? (try (pd:goal) (catch (e) #f))))
                    (begin
                      (set! *main-name* "pd:gshadow")
                      (set! *main-score* (pad:gscore-plan p))
                      (display "MAIN goal start=")
                      (display (pad:nstr *main-score*))
                      (display " goal=")
                      (display *g-goal-text*)
                      (newline)
                      (pad:gstamp! p "pd:gshadow")
                      (list #t "seed"))
                    (list #f "probe"))))))))


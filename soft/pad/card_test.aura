;; Step 41. The proposal card and the classic keys that drive it.
;; Soft reserved: never bind quote.
(define *pad-home*
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))

(load (string-append *pad-home* "/soft/pad/std.aura"))
(load (string-append *pad-home* "/soft/pad/buffer.aura"))
(load (string-append *pad-home* "/soft/pad/lines.aura"))
(load (string-append *pad-home* "/soft/pad/edit.aura"))
(load (string-append *pad-home* "/soft/pad/hl.aura"))
(load (string-append *pad-home* "/soft/pad/jump.aura"))
(load (string-append *pad-home* "/soft/pad/view.aura"))
(load (string-append *pad-home* "/soft/pad/lc.aura"))
(load (string-append *pad-home* "/soft/pad/keys.aura"))
(load (string-append *pad-home* "/soft/pad/card.aura"))
(load (string-append *pad-home* "/soft/pad/who.aura"))
(load (string-append *pad-home* "/soft/pad/play_in.aura"))
(load (string-append *pad-home* "/soft/pad/vi.aura"))
(load (string-append *pad-home* "/soft/pad/screen.aura"))
(load (string-append *pad-home* "/soft/pad/emacs.aura"))
(load (string-append *pad-home* "/soft/pad/query.aura"))
(load (string-append *pad-home* "/soft/pad/ws.aura"))
(load (string-append *pad-home* "/soft/pad/pen.aura"))
(load (string-append *pad-home* "/soft/pad/why.aura"))
(load (string-append *pad-home* "/soft/pad/ux.aura"))
(load (string-append *pad-home* "/soft/pad/tx.aura"))

(define page "ab\ncd")

(define (say s)
  (display s)
  (newline)
  0)

(define (mark m)
  (say (string-append "MARK " m)))

(define (pad:card-classic?)
  (let ((v (getenv "PAD_CLASSIC")))
    (and (string? v) (string=? v "1"))))

(define (arm!)
  (pad:play-reset! page)
  (set! *pi-collect* #t)
  (set! *vi-on* #t)
  (set! *vi-mode* "normal")
  (set! *vi-vanchor* -1)
  (set! *vi-op* "")
  (set! *vi-line* "")
  (set! *vi-cx* #f)
  (set! *vi-base* "t")
  (set! *vi-num* 0)
  (set! *vi-num-op* 0)
  (set! *vi-seek* "")
  (set! *vi-obj* "")
  (set! *em-hit* #f)
  (set! *em-anchor* #f)
  (set! *tx-card* #f)
  (set! *ux-keys* 0)
  (pad:vi-title!)
  0)

(define (see tag)
  (say (string-append "CHECK " (string-append tag (string-append " say=" *pl-say*))))
  (say (string-append "CHECK " (string-append tag
        (if (number? *tx-card*) " card=on" " card=off"))))
  (say (string-append "CHECK " (string-append tag
        (string-append " col=" (number->string (pad:es-col *pl-st*))))))
  (say (string-append "CHECK " (string-append tag
        (string-append " row=" (number->string (pad:es-l *pl-st*))))))
  (say (string-append "CHECK " (string-append tag
        (if (string=? (pad:play-src) page) " page=same" " page=moved"))))
  (say (string-append "CHECK " (string-append tag (string-append " mode=" *vi-mode*))))
  0)

(define (keys!)
  (say (string-append "CHECK ux-keys=" (number->string *ux-keys*))))

(define (classic!)
  (arm!)
  (mark "boot")
  (see "boot")
  (keys!)
  (pad:play-step! "IN 106")
  (mark "down")
  (see "down")
  (pad:play-step! "IN 107")
  (mark "up")
  (see "up")
  (pad:play-step! "IN 108")
  (mark "moved")
  (see "moved")
  (pad:tx-card-show!)
  (mark "show")
  (see "show")
  (pad:play-step! "IN 104")
  (pad:play-step! "IN 106")
  (pad:play-step! "IN 107")
  (pad:play-step! "IN 108")
  (mark "hjkl")
  (see "hjkl")
  (pad:play-step! "IN 9")
  (mark "tab1")
  (see "tab1")
  (pad:play-step! "IN 9")
  (mark "tab2")
  (see "tab2")
  (pad:play-step! "IN 9")
  (mark "tab3")
  (see "tab3")
  (pad:play-step! "IN 13")
  (mark "keep")
  (see "keep")
  (pad:play-step! "IN 104")
  (mark "again")
  (see "again")
  (pad:tx-card-show!)
  (pad:play-step! "IN 9")
  (pad:play-step! "IN 13")
  (mark "drop")
  (see "drop")
  (pad:tx-card-show!)
  (pad:play-step! "IN 27")
  (mark "esc")
  (see "esc")
  (pad:play-step! "IN 108")
  (mark "free")
  (see "free")
  (set! *vi-line* "")
  (set! *vi-op* ":")
  (set! *vi-prompt* ": ")
  (pad:vi-type! 120)
  (mark "typed")
  (say (string-append "CHECK line=" *vi-line*))
  (pad:tx-card-show!)
  (pad:vi-type! 104)
  (mark "blocked-type")
  (say (string-append "CHECK line=" *vi-line*))
  (see "blocked-type")
  (pad:play-step! "IN 9")
  (pad:play-step! "IN 9")
  (pad:play-step! "IN 13")
  (mark "undo")
  (see "undo")
  (keys!)
  (mark "end")
  (say "CARD_CLASSIC_OK"))

(define (sentence!)
  (arm!)
  (pad:tx-card-show!)
  (mark "s0")
  (see "s0")
  (pad:ux-key! "KEY right")
  (mark "s1")
  (see "s1")
  (pad:ux-key! "KEY right")
  (mark "s2")
  (see "s2")
  (pad:ux-key! "KEY left")
  (mark "s3")
  (see "s3")
  (pad:ux-key! "IN 27 91 68")
  (mark "s4")
  (see "s4")
  (pad:ux-key! "IN 27 91 67")
  (mark "s5")
  (see "s5")
  (pad:ux-key! "IN 9")
  (mark "s6")
  (see "s6")
  (pad:ux-key! "KEY h")
  (mark "sh")
  (see "sh")
  (pad:ux-key! "IN 104")
  (mark "sb")
  (see "sb")
  (pad:ux-key! "IN 13")
  (mark "sact")
  (see "sact")
  (pad:tx-card-show!)
  (pad:ux-key! "IN 27")
  (mark "sdrop")
  (see "sdrop")
  (keys!)
  (mark "end")
  (say "CARD_SENTENCE_OK"))

(if (pad:card-classic?)
    (classic!)
    (sentence!))

;; M11g wire: redefine outro + run-all so g1..g4 and kr-stats run.
;; Loaded after m11_cases.aura and m11g_cases.aura (m11_test.aura).
;; Soft reserved: never bind quote.

(define (m11:outro)
  (newline)
  (display "M11STATS ") (display (pad:robot-stats-str))
  (display " ") (display (pad:time-stats-str))
  (display " ") (display (pad:world-stats-str))
  (display " ") (display (pad:kr-stats-str))
  (newline)
  (display "TESTS checks=") (display (number->string *m11-checks*))
  (display " fail=") (display (number->string *m11-fail*))
  (newline)
  (if (= *m11-fail* 0) (display "PAD_M11_TEST_OK") (display "PAD_M11_TEST_FAIL"))
  (newline))

(define (m11:run-all)
  (m11:intro)
  (m11:sec-a1)
  (m11:sec-a2)
  (m11:sec-a3)
  (m11:sec-b1)
  (m11:sec-b2)
  (m11:sec-b3)
  (m11:sec-c1)
  (m11:sec-c2)
  (m11:sec-c3)
  (m11:sec-d1)
  (m11:sec-d2)
  (m11:sec-d3)
  (m11:sec-e1)
  (m11:sec-e2)
  (m11:sec-e3)
  (m11:sec-f1)
  (m11:sec-f2)
  (m11:sec-g1)
  (m11:sec-g2)
  (m11:sec-g3)
  (m11:sec-g4)
  (m11:outro))

;; Sentence-line gate. The old pen gate stays at 120 and still refuses kid.
;; This gate allows the fingerprint labels kid, helper, macro, and law.
;; A form may be 4096 scalars, or 400 longer than the form it replaces.
;; A name the child set-code just introduced is born when the caller
;; says so. A refusal does not take a snapshot and does not write.
;; Needs view.aura (the recursive word scan), pen.aura (the word lists),
;; why.aura (pad:why-brackets-ok?), and the highlighter those call.
;; Soft reserved: never bind quote.

(define *tx-whos* (list "kid" "helper" "macro" "law"))
(define *tx-max-len* 4096)
(define *tx-slack* 400)

(define (pad:tx-mem? s xs)
  (cond
    ((null? xs) #f)
    ((and (string? (car xs)) (string=? s (car xs))) #t)
    (#t (pad:tx-mem? s (cdr xs)))))

(define (pad:tx-has? s xs)
  (cond
    ((null? xs) #f)
    ((and (string? (car xs)) (string-contains? s (car xs))) #t)
    (#t (pad:tx-has? s (cdr xs)))))

(define (pad:tx-limit-n n)
  (let ((room (+ n *tx-slack*)))
    (if (> room *tx-max-len*) room *tx-max-len*)))

(define (pad:tx-limit form-len)
  (pad:tx-limit-n (if (number? form-len) form-len 0)))

;; born? is #t only after the caller has seen the name in the child.
;; form-len is the scalar count of the form being replaced.
(define (pad:tx-gate who name lam born? form-len)
  (cond
    ((not (pad:tx-mem? who *tx-whos*)) "not-allowed")
    ((or (not (string? name)) (string=? name "")) "no-name")
    ((not (string? lam)) "not-lambda")
    ((pad:tx-has? lam *pen-mean*) "not-kind")
    ((pad:tx-has? lam *pen-banned*) "not-allowed")
    ((not (string-prefix? lam "(lambda")) "not-lambda")
    ((not (pad:why-brackets-ok? lam)) "brackets")
    ((> (string-length lam) (pad:tx-limit form-len)) "too-long")
    ((not (eq? born? #t)) "no-def")
    (#t "ok")))

;; Token fields from pad:hl-tokens: kind, start, end, text.
(define (pad:tx-kind t) (car t))
(define (pad:tx-a t) (cadr t))
(define (pad:tx-b t) (caddr t))
(define (pad:tx-txt t) (car (cdr (cdr (cdr t)))))

;; The outer "(" of the define whose name token starts at hit.
(define (pad:tx-def-open p3 p2 p1)
  (cond
    ((and p1 (string=? (pad:tx-kind p1) "K")
          (string=? (pad:tx-txt p1) "define")
          p2 (string=? (pad:tx-kind p2) "P"))
     (pad:tx-a p2))
    ((and p1 (string=? (pad:tx-kind p1) "P")
          p2 (string=? (pad:tx-kind p2) "K")
          (string=? (pad:tx-txt p2) "define")
          p3 (string=? (pad:tx-kind p3) "P"))
     (pad:tx-a p3))
    (#t -1)))

(define (pad:tx-open-walk toks hit p3 p2 p1)
  (if (null? toks)
      -1
      (let ((t (car toks)))
        (if (= (pad:tx-a t) hit)
            (pad:tx-def-open p3 p2 p1)
            (pad:tx-open-walk (cdr toks) hit p2 p1 t)))))

(define (pad:tx-pend depth txt)
  (cond
    ((string=? txt "(") (+ depth 1))
    ((string=? txt ")") (- depth 1))
    (#t depth)))

;; End offset of the form that opens at start. A paren inside a string
;; or a comment is not a P token, so it does not change the depth.
(define (pad:tx-end-walk toks start depth seen)
  (if (null? toks)
      -1
      (let ((t (car toks)))
        (if (< (pad:tx-a t) start)
            (pad:tx-end-walk (cdr toks) start depth seen)
            (if (not (string=? (pad:tx-kind t) "P"))
                (pad:tx-end-walk (cdr toks) start depth seen)
                (let ((d (pad:tx-pend depth (pad:tx-txt t))))
                  (if (and seen (= d 0))
                      (pad:tx-b t)
                      (pad:tx-end-walk (cdr toks) start d #t))))))))

(define (pad:tx-form name lam)
  (string-append "(define "
    (string-append name
      (string-append " " (string-append lam ")")))))

(define (pad:tx-replace src toks hit name lam)
  (let ((a (pad:tx-open-walk toks hit #f #f #f)))
    (if (< a 0)
        src
        (let ((b (pad:tx-end-walk toks a 0 #f)))
          (if (< b a)
              src
              (string-append (substring src 0 a)
                (string-append (pad:tx-form name lam)
                  (substring src b (string-length src)))))))))

;; Replace the define named name. Comments and blank lines outside that
;; form stay. A missing name returns the same text. This does not read
;; the workspace program and it does not call the one-line pen path.
(define (pad:proj-splice! src name lam)
  (if (or (not (string? src)) (not (string? name)) (not (string? lam))
          (string=? name ""))
      src
      (let ((toks (pad:hl-tokens src)))
        (let ((hits (pad:find-defs-in toks name)))
          (if (null? hits)
              src
              (pad:tx-replace src toks (car hits) name lam))))))

(define *tx-ew* #f)

(define (pad:tx-show! s)
  (display s)
  (newline)
  0)

(define (pad:tx-home)
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))

(define (pad:tx-live)
  (let ((v (getenv "PAD_LIVE")))
    (if (and (string? v) (string=? v "1")) "1" "0")))

(define (pad:tx-hard?)
  (let ((v (getenv "AURA_MUTATE_TYPE_GATE")))
    (and (string? v) (string=? v "hard"))))

(define (pad:tx-current)
  (let ((id (try (workspace :current) (catch (e) #f))))
    (if (number? id) id -1)))

(define (pad:tx-at s i n c)
  (if (>= i n)
      -1
      (if (= (string-ref s i) c)
          i
          (pad:tx-at s (+ i 1) n c))))

(define (pad:tx-blank? s i n)
  (if (>= i n)
      #t
      (let ((c (string-ref s i)))
        (if (or (= c 10) (= c 13) (= c 32))
            (pad:tx-blank? s (+ i 1) n)
            #f))))

(define (pad:tx-plain? s i n)
  (if (>= i n)
      (> n 0)
      (let ((c (string-ref s i)))
        (if (or (= c 47) (= c 92))
            #f
            (pad:tx-plain? s (+ i 1) n)))))

;; A fixture may end with one reject line. That is a person saying no
;; after the batch, not a second op.
(define (pad:tx-reject-rest? rest)
  (let ((n (string-length rest)))
    (let ((nl (pad:tx-at rest 0 n 10)))
      (let ((line (if (< nl 0) rest (substring rest 0 nl))))
        (let ((more (if (< nl 0) "" (substring rest (+ nl 1) n))))
          (and (string=? line "reject")
               (pad:tx-blank? more 0 (string-length more))))))))

;; One fixture line: name=(lambda ...). A second op is refused.
(define (pad:tx-op-line line)
  (let ((n (string-length line)))
    (let ((eq (pad:tx-at line 0 n 61)))
      (if (< eq 1)
          #f
          (let ((name (substring line 0 eq))
                (lam (substring line (+ eq 1) n)))
            (if (string-prefix? lam "(lambda")
                (list name lam)
                #f))))))

(define (pad:tx-one-op text)
  (if (not (string? text))
      #f
      (let ((n (string-length text)))
        (let ((nl (pad:tx-at text 0 n 10)))
          (let ((line (if (< nl 0) text (substring text 0 nl)))
                (rest (if (< nl 0) "" (substring text (+ nl 1) n))))
            (let ((human (pad:tx-reject-rest? rest)))
              (if (or human (pad:tx-blank? rest 0 (string-length rest)))
                  (let ((op (pad:tx-op-line line)))
                    (if op (list (car op) (cadr op) human) #f))
                  #f)))))))

;; A model reply is either ops plus checks, or one sentence.
;; More than four ops, a repeated name, or a body that does not open
;; with the lambda form is a gate refusal. This step does not run the form.
;; The cap matches the robot op cap.
(define *tx-max-ops* 4)

(define (pad:tx-unr line)
  (let ((n (string-length line)))
    (if (and (> n 0) (= (string-ref line (- n 1)) 13))
        (substring line 0 (- n 1))
        line)))

(define (pad:tx-take-line s i n)
  (let ((nl (pad:tx-at s i n 10)))
    (if (< nl 0)
        (list (substring s i n) n)
        (list (substring s i nl) (+ nl 1)))))

;; Head and tail around the first space. Both sides must be non-empty.
(define (pad:tx-field s)
  (let ((n (string-length s)))
    (let ((sp (pad:tx-at s 0 n 32)))
      (if (or (< sp 1) (>= sp (- n 1)))
          #f
          (list (substring s 0 sp) (substring s (+ sp 1) n))))))

(define (pad:tx-check-line line)
  (let ((n (string-length line)))
    (if (or (< n 7) (not (string=? (substring line 0 6) "check ")))
        #f
        (let ((name-rest (pad:tx-field (substring line 6 n))))
          (if (not name-rest)
              #f
              (let ((lit-want (pad:tx-field (cadr name-rest))))
                (if (not lit-want)
                    #f
                    (list (car name-rest) (car lit-want) (cadr lit-want)))))))))

(define (pad:tx-bad-lam? line)
  (let ((n (string-length line)))
    (let ((eq (pad:tx-at line 0 n 61)))
      (if (< eq 1)
          #f
          (not (string-prefix? (substring line (+ eq 1) n) "(lambda"))))))

(define (pad:tx-names ops)
  (if (null? ops)
      (list)
      (cons (car (car ops)) (pad:tx-names (cdr ops)))))

(define (pad:tx-dup? xs)
  (cond
    ((null? xs) #f)
    ((pad:tx-mem? (car xs) (cdr xs)) #t)
    (#t (pad:tx-dup? (cdr xs)))))

(define (pad:tx-finish text ops checks bad foreign)
  (let ((ops2 (reverse ops))
        (checks2 (reverse checks)))
    (cond
      ((eq? bad #t) (list "gate" "not-lambda"))
      ((or (eq? foreign #t) (null? ops2)) (list "prose" text))
      ((> (length ops2) *tx-max-ops*) (list "gate" "too-many"))
      ((pad:tx-dup? (pad:tx-names ops2)) (list "gate" "twice"))
      (#t (list "ops" ops2 checks2)))))

(define (pad:tx-see s j n ops checks bad foreign line)
  (if (pad:tx-blank? line 0 (string-length line))
      (pad:tx-walk s j n ops checks bad foreign)
      (let ((chk (pad:tx-check-line line)))
        (if chk
            (pad:tx-walk s j n ops (cons chk checks) bad foreign)
            (let ((op (pad:tx-op-line line)))
              (if op
                  (pad:tx-walk s j n (cons op ops) checks bad foreign)
                  (if (pad:tx-bad-lam? line)
                      (pad:tx-walk s j n ops checks #t foreign)
                      (pad:tx-walk s j n ops checks bad #t))))))))

(define (pad:tx-walk s i n ops checks bad foreign)
  (if (>= i n)
      (pad:tx-finish s ops checks bad foreign)
      (let ((got (pad:tx-take-line s i n)))
        (pad:tx-see s (cadr got) n ops checks bad foreign (pad:tx-unr (car got))))))

(define (pad:tx-parse text)
  (if (not (string? text))
      (list "prose" "")
      (pad:tx-walk text 0 (string-length text) (list) (list) #f #f)))

(define (pad:tx-read path)
  (let ((raw (try (read-file path) (catch (e) #f))))
    (if (string? raw) raw "")))

;; Same heal as pad:time-snap. 0 is a real id. eval-current runs in
;; whatever workspace is current, which the caller keeps as the child.
(define (pad:tx-snap!)
  (let ((snap (try (ast:snapshot "tx") (catch (e) #f))))
    (if (number? snap)
        (begin
          (try (ast:restore snap) (catch (e) #f))
          (try (eval-current) (catch (e) #f))
          snap)
        #f)))

(define (pad:tx-q-at s i acc)
  (if (< i 0)
      (list->string (cons 34 acc))
      (let ((c (string-ref s i)))
        (pad:tx-q-at s (- i 1)
          (if (or (= c 34) (= c 92))
              (cons 92 (cons c acc))
              (cons c acc))))))

(define (pad:tx-q s)
  (pad:tx-q-at s (- (string-length s) 1) (list 34)))

(define (pad:tx-load-in! tag path)
  (let ((c (try (workspace :create tag) (catch (e) #f))))
    (if (not (number? c))
        #f
        (begin
          (try (workspace :switch c) (catch (e) #f))
          (let ((ok (if (= (pad:tx-current) c)
                        (try (begin (load path) #t) (catch (e) #f))
                        #f)))
            (try (workspace :switch 0) (catch (e) #f))
            (try (workspace:delete c) (catch (e) #f))
            ok)))))

(define (pad:tx-ew-ready!)
  (if *tx-ew*
      #t
      (if (pad:tx-load-in! "tx-ew"
                          (string-append (pad:tx-home) "/soft/pad/eng_who.aura"))
          (begin (set! *tx-ew* #t) #t)
          #f)))

;; read.aura owns the sidecar write. Load it in a scratch so the file
;; child's program stays the page. A later KEEP finds the function bound.
(define (pad:tx-aw-ready!)
  (if (try pad:read-aw! (catch (e) #f))
      #t
      (begin
        (pad:tx-load-in! "tx-aw"
                         (string-append (pad:tx-home) "/soft/pad/read.aura"))
        (if (try pad:read-aw! (catch (e) #f)) #t #f))))

(define (pad:tx-fp! who)
  (let ((ok (and (try pad:ew-set! (catch (e) #f)) (pad:ew-set! who))))
    (if ok
        (pad:tx-show!
          (string-append "APPLY mutate:set-agent-fingerprint="
                         (number->string (pad:ew-fp who))))
        0)
    ok))

(define (pad:tx-rebind! name lam)
  (try
    (typed-mutate-atomic
      (list (string-append "(mutate:rebind "
                           (pad:tx-q name) " "
                           (pad:tx-q lam) " "
                           (pad:tx-q "closer") ")")))
    (catch (e) #f)))

(define (pad:tx-leave! c)
  (try (workspace :switch 0) (catch (e) #f))
  (if (number? c) (try (workspace:delete c) (catch (e) #f)) 0)
  0)

;; The KEEP child stays so a later who can read its provenance.
;; The next KEEP drops the previous one. Undo uses the child still held.
(define *tx-held* #f)
(define *tx-undo-who* "")
(define *tx-undos* (list))

(define (pad:tx-note-who! name)
  (let ((e (if (try pad:ew-prov (catch (e) #f)) (pad:ew-prov name) #f)))
    (set! *tx-undo-who*
          (if (or (not (pair? e)) (string=? (cadr e) "nobody"))
              "nobody has changed this yet"
              (if (try pad:ew-say (catch (e) #f))
                  (pad:ew-say "agree" #f e)
                  "nobody has changed this yet")))
    0))

(define (pad:tx-undo-push! snap text)
  (if (number? snap)
      (set! *tx-undos* (cons (list snap text *tx-undo-who*) *tx-undos*))
      0)
  0)

;; Remember the file child and return to the editor. The previous child
;; stays until the process exits: deleting a snapshotted child aborts.
(define (pad:tx-hold! c)
  (try (workspace :switch 0) (catch (e) #f))
  (set! *tx-held* c)
  0)

;; A child shares the parent flat until the first mutate. Renaming a
;; missing symbol clones that flat and changes nothing. The typed batch
;; then stamps its author on the clone. A clone taken inside the batch
;; records author 0.
(define (pad:tx-own!)
  (try (mutate:rename-symbol "no-such-pad" "still-no") (catch (e) #f))
  0)

(define (pad:tx-page)
  (let ((u (try *ux-lines* (catch (e) #f))))
    (if (pair? u)
        (pad:v-src u)
        (let ((p (try *read-proj* (catch (e) #f))))
          (if (and (string? p) (> (string-length p) 0)) p "")))))

(define (pad:tx-install! src)
  (if (string? (try *read-proj* (catch (e) #f)))
      (set! *read-proj* src)
      0)
  (if (try *ux-lines* (catch (e) #f))
      (set! *ux-lines* (pad:v-lines src))
      0)
  src)

;; The next key must still enter pad:play-cmd!. A dead closure stops
;; the KEEP and names the aura issue to file.
(define (pad:tx-probe!)
  (let ((r (try (pad:play-cmd! "home") (catch (e) e))))
    (if (string? r)
        (begin
          (pad:tx-show! (string-append "APPLY play-cmd=" r))
          #t)
        (begin
          (pad:tx-show! "GAPS snapshot-heal")
          (pad:tx-show! "TITLE snapshot restore left pad:play-cmd! invalid")
          #f))))

;; DROP heals the file child with restore. It does not set-code, does not
;; write a sidecar, and does not push undo. The child stays: deleting a
;; snapshotted child aborts. src is the projection from before this try.
(define (pad:tx-fail! c snap why src)
  (pad:tx-show! (string-append "DROP reason=" why))
  (let ((here (pad:tx-current)))
    (pad:tx-show! (string-append "DROP workspace=" (number->string here)))
    (let ((ok (if (and (number? snap) (= here c))
                  (try (ast:restore snap) (catch (e) #f))
                  #f)))
      (if (eq? ok #t)
          (try (eval-current) (catch (e) #f))
          (pad:tx-show! "DROP restore=no"))
      (let ((probed (if (eq? ok #t) (pad:tx-probe!) #f)))
        (try (workspace :switch 0) (catch (e) #f))
        (pad:tx-install! src)
        (if (and (eq? ok #t) probed)
            (begin
              (pad:tx-show! "DROP restore=1")
              (list "DROP" "aura cannot change this page yet"))
            (begin
              (pad:tx-show! "GAPS snapshot-heal")
              (list "DROP" "GAPS snapshot-heal")))))))

(define (pad:tx-keep! name lam src human?)
  (pad:tx-aw-ready!)
  (let ((c (try (workspace :create "apply") (catch (e) #f))))
    (if (not (number? c))
        (list "DROP" "aura cannot change this page yet")
        (begin
          (try (workspace :switch c) (catch (e) #f))
          (if (not (= (pad:tx-current) c))
              (begin
                (pad:tx-leave! c)
                (list "DROP" "aura cannot change this page yet"))
              (begin
                (pad:tx-show! (string-append "APPLY child=" (number->string c)))
                (pad:tx-own!)
                (let ((wrote (try (set-code (string-append src "\n#t\n"))
                                  (catch (e) #f))))
                  (if (not (eq? wrote #t))
                      (begin
                        (pad:tx-leave! c)
                        (list "DROP" "aura cannot change this page yet"))
                      (begin
                        (pad:tx-show! "APPLY set-code")
                        (let ((born (pair? (pad:define-lookup name))))
                          (let ((gate (pad:tx-gate "helper" name lam
                                                   (if born #t #f) 0)))
                            (pad:tx-show! (string-append "APPLY gate=" gate))
                            (if (not (string=? gate "ok"))
                                (begin
                                  (pad:tx-leave! c)
                                  (list "DROP" gate))
                                (let ((snap (pad:tx-snap!)))
                                  (pad:tx-show!
                                    (string-append "APPLY workspace="
                                      (number->string (pad:tx-current))))
                                  (if (not (number? snap))
                                      (begin
                                        (pad:tx-leave! c)
                                        (list "DROP" "aura cannot change this page yet"))
                                      (begin
                                        (pad:tx-show!
                                          (string-append "APPLY snap="
                                                         (number->string snap)))
                                        (if (not (pad:tx-probe!))
                                            (begin
                                              (pad:tx-leave! c)
                                              (list "DROP" "GAPS snapshot-heal"))
                                            (if (not (pad:tx-ew-ready!))
                                                (begin
                                                  (pad:tx-show!
                                                    "GAPS mutate:set-agent-fingerprint")
                                                  (pad:tx-leave! c)
                                                  (list "DROP"
                                                    "GAPS mutate:set-agent-fingerprint"))
                                                (begin
                                                  (try (workspace :switch c) (catch (e) #f))
                                                  (if (not (= (pad:tx-current) c))
                                                      (begin
                                                        (pad:tx-leave! c)
                                                        (list "DROP"
                                                          "aura cannot change this page yet"))
                                                      (if (not (pad:tx-fp! "helper"))
                                                          (begin
                                                            (pad:tx-show!
                                                              "GAPS mutate:set-agent-fingerprint")
                                                            (pad:tx-leave! c)
                                                            (list "DROP"
                                                              "GAPS mutate:set-agent-fingerprint"))
                                                          (begin
                                                          (pad:tx-note-who! name)
                                                          (let ((ok (pad:tx-rebind! name lam)))
                                                            (pad:tx-show!
                                                              (string-append
                                                                "APPLY typed-mutate-atomic="
                                                                (if (eq? ok #t) "ok" "no")))
                                                            (pad:tx-fp! "kid")
                                                            (if (not (eq? ok #t))
                                                                (pad:tx-fail! c snap "type" src)
                                                                (if (eq? human? #t)
                                                                    (pad:tx-fail! c snap "human" src)
                                                                    (let ((out (pad:proj-splice!
                                                                             src name lam)))
                                                                  (if (string=? out src)
                                                                      (begin
                                                                        (pad:tx-leave! c)
                                                                        (list "DROP" "no-row"))
                                                                      (begin
                                                                        (pad:tx-undo-push! snap src)
                                                                        (try (pad:read-aw! c out)
                                                                             (catch (e) #f))
                                                                        (pad:tx-hold! c)
                                                                        (pad:tx-install! out)
                                                                        (pad:tx-show! "APPLY splice")
                                                                        (list "KEEP"
                                                                          (string-append
                                                                            "helper changed "
                                                                            name)))))))))))))))))))))))))))))

;; One KEEP comes back. The file child is still here, so restore runs
;; on that workspace. Heal logs the workspace that is current.
(define (pad:tx-undo!)
  (if (null? *tx-undos*)
      (begin
        (pad:tx-show! "UNDO none=1")
        "nothing to undo")
      (let ((rec (car *tx-undos*)))
        (set! *tx-undos* (cdr *tx-undos*))
        (let ((snap (car rec)))
          (let ((text (cadr rec)))
            (let ((who (caddr rec)))
              (let ((c *tx-held*))
                (if (not (number? c))
                    (begin
                      (pad:tx-show! "TX_UNDO_DISAGREE")
                      "TX_UNDO_DISAGREE")
                    (begin
                      (try (workspace :switch c) (catch (e) #f))
                      (pad:tx-show!
                        (string-append "UNDO workspace="
                                       (number->string (pad:tx-current))))
                      (let ((ok (if (= (pad:tx-current) c)
                                    (try (ast:restore snap) (catch (e) #f))
                                    #f)))
                        (if (eq? ok #t)
                            (try (eval-current) (catch (e) #f))
                            (pad:tx-show! "UNDO restore=no"))
                        (try (workspace :switch 0) (catch (e) #f))
                        (if (try pad:read-undo-page! (catch (e) #f))
                            (pad:read-undo-page! text)
                            (pad:tx-install! text))
                        (let ((now (if (try pad:ux-who! (catch (e) #f))
                                       (pad:ux-who!)
                                       "")))
                          (if (and (eq? ok #t)
                                   (string=? (pad:tx-page) text)
                                   (string=? now who))
                              (begin
                                (pad:tx-show! "UNDO ok=1")
                                "undid one keep")
                              (begin
                                (pad:tx-show! "TX_UNDO_DISAGREE")
                                "TX_UNDO_DISAGREE")))))))))))))

(define (pad:tx-apply! name)
  (pad:tx-show! (string-append "APPLY live=" (pad:tx-live)))
  (pad:tx-show! "APPLY net=0")
  (if (or (not (string? name))
          (not (pad:tx-plain? name 0 (string-length name)))
          (not (pad:tx-hard?)))
      (begin
        (if (pad:tx-hard?) 0 (pad:tx-show! "GAPS type-gate"))
        (list "DROP" "aura cannot change this page yet"))
      (let ((text (pad:tx-read
                    (string-append (pad:tx-home)
                      (string-append "/soft/pad/fixtures/" name)))))
        (let ((op (pad:tx-one-op text)))
          (if (not op)
              (list "DROP" "aura cannot change this page yet")
              (pad:tx-keep! (car op) (cadr op) (pad:tx-page) (caddr op)))))))

;; A parsed proposal is one typed batch in a file child. robot.aura and
;; world.aura load on this path only. The heal is pad:tx-snap!. A type
;; failure restores that child and leaves the projection alone.
(define *tx-robot* #f)
(define *tx-world* #f)

(define (pad:tx-robot-ready!)
  (if *tx-robot*
      #t
      (if (pad:tx-load-in! "tx-robot"
                           (string-append (pad:tx-home) "/soft/pad/robot.aura"))
          (begin (set! *tx-robot* #t) #t)
          #f)))

(define (pad:tx-world-ready!)
  (if *tx-world*
      #t
      (if (pad:tx-load-in! "tx-world"
                           (string-append (pad:tx-home) "/soft/pad/world.aura"))
          (begin (set! *tx-world* #t) #t)
          #f)))

(define (pad:tx-gate-ops ops)
  (if (null? ops)
      "ok"
      (let ((op (car ops)))
        (let ((name (car op)))
          (let ((lam (cadr op)))
            (let ((born (if (pair? (pad:define-lookup name)) #t #f)))
              (let ((g (pad:tx-gate "helper" name lam born 0)))
                (if (string=? g "ok")
                    (pad:tx-gate-ops (cdr ops))
                    g))))))))

(define (pad:tx-ops-child! c ops checks src)
  (if (not (= (pad:tx-current) c))
      (begin
        (pad:tx-leave! c)
        (list "DROP" "aura cannot change this page yet"))
      (begin
        (pad:tx-show! (string-append "APPLY child=" (number->string c)))
        (pad:tx-own!)
        (let ((wrote (try (set-code (string-append src "\n#t\n")) (catch (e) #f))))
          (if (not (eq? wrote #t))
              (begin
                (pad:tx-leave! c)
                (list "DROP" "aura cannot change this page yet"))
              (begin
                (pad:tx-show! "APPLY set-code")
                (let ((gate (pad:tx-gate-ops ops)))
                  (pad:tx-show! (string-append "APPLY gate=" gate))
                  (if (not (string=? gate "ok"))
                      (begin
                        (pad:tx-leave! c)
                        (list "DROP" gate))
                      (let ((snap (pad:tx-snap!)))
                        (pad:tx-show!
                          (string-append "APPLY workspace="
                                         (number->string (pad:tx-current))))
                        (if (not (number? snap))
                            (begin
                              (pad:tx-leave! c)
                              (list "DROP" "aura cannot change this page yet"))
                            (begin
                              (pad:tx-show!
                                (string-append "APPLY snap=" (number->string snap)))
                              (if (not (pad:tx-probe!))
                                  (begin
                                    (pad:tx-leave! c)
                                    (list "DROP" "GAPS snapshot-heal"))
                                  (if (not (pad:tx-ew-ready!))
                                      (begin
                                        (pad:tx-show!
                                          "GAPS mutate:set-agent-fingerprint")
                                        (pad:tx-leave! c)
                                        (list "DROP"
                                          "GAPS mutate:set-agent-fingerprint"))
                                      (begin
                                        (try (workspace :switch c) (catch (e) #f))
                                        (if (not (= (pad:tx-current) c))
                                            (begin
                                              (pad:tx-leave! c)
                                              (list "DROP"
                                                "aura cannot change this page yet"))
                                            (if (not (pad:tx-fp! "helper"))
                                                (begin
                                                  (pad:tx-show!
                                                    "GAPS mutate:set-agent-fingerprint")
                                                  (pad:tx-leave! c)
                                                  (list "DROP"
                                                    "GAPS mutate:set-agent-fingerprint"))
                                                (let ((page-n (pad:tx-score checks)))
                                                  (let ((ok (pad:world-batch!
                                                              (pad:robot-tx-sexprs ops))))
                                                    (pad:tx-show!
                                                      (string-append
                                                        "APPLY ops="
                                                        (number->string (length ops))))
                                                    (pad:tx-show!
                                                      (string-append
                                                        "APPLY typed-mutate-atomic="
                                                        (if (eq? ok #t) "ok" "no")))
                                                    (pad:tx-fp! "kid")
                                                    (if (not (eq? ok #t))
                                                        (pad:tx-fail! c snap "type" src)
                                                        (begin
                                                          (let ((child-n (pad:tx-score checks)))
                                                            (pad:tx-score-show! page-n child-n)
                                                            (if (try pad:play-step! (catch (e) #f))
                                                                (pad:tx-blast-take! ops src)
                                                                0)
                                                            (try (workspace :switch 0)
                                                                 (catch (e) #f))
                                                            (pad:tx-show! "APPLY tried=1")
                                                            (list "tried"
                                                              "aura cannot change this page yet"
                                                              child-n page-n))))))))))))))))))))))

(define (pad:tx-ops! ops checks src)
  (set! *tx-exec* 0)
  (if (pad:tx-danger? ops)
      (begin
        (pad:tx-show! "SCORE exec=0")
        (pad:tx-show! "SCORE better=no")
        (list "no" "aura cannot change this page yet"))
      (if (not (and (pad:tx-robot-ready!) (pad:tx-world-ready!)))
          (list "DROP" "aura cannot change this page yet")
          (begin
            (if (try pad:play-step! (catch (e) #f))
                (pad:tx-blast-ready!)
                0)
            (let ((c (pad:world-open! "try")))
              (if (not (number? c))
                  (list "DROP" "aura cannot change this page yet")
                  (pad:tx-ops-child! c ops checks src)))))))

(define (pad:tx-dispatch! parsed)
  (let ((kind (car parsed)))
    (cond
      ((string=? kind "prose") (list "prose" (cadr parsed)))
      ((string=? kind "gate")
       (pad:tx-show! (string-append "APPLY gate=" (cadr parsed)))
       (list "DROP" (cadr parsed)))
      ((string=? kind "ops")
       (pad:tx-ops! (cadr parsed) (caddr parsed) (pad:tx-page)))
      (#t (list "DROP" "aura cannot change this page yet")))))

(define (pad:tx-run! text)
  (if (not (pad:tx-hard?))
      (begin
        (pad:tx-show! "GAPS type-gate")
        (list "DROP" "GAPS type-gate"))
      (if (not (string? text))
          (list "DROP" "aura cannot change this page yet")
          (pad:tx-dispatch! (pad:tx-parse text)))))

;; How many check calls this proposal made. A refused form stays at 0.
(define *tx-exec* 0)

(define (pad:tx-digit? c)
  (and (>= c 48) (<= c 57)))

(define (pad:tx-num-acc s i n acc bad)
  (if (>= i n)
      (if (eq? bad #t) #f acc)
      (let ((c (string-ref s i)))
        (if (pad:tx-digit? c)
            (pad:tx-num-acc s (+ i 1) n (+ (* acc 10) (- c 48)) bad)
            (pad:tx-num-acc s n n acc #t)))))

(define (pad:tx-num s)
  (if (not (string? s))
      #f
      (let ((n (string-length s)))
        (if (= n 0)
            #f
            (if (= (string-ref s 0) 45)
                (if (< n 2)
                    #f
                    (let ((v (pad:tx-num-acc s 1 n 0 #f)))
                      (if (number? v) (- 0 v) #f)))
                (pad:tx-num-acc s 0 n 0 #f))))))

(define (pad:tx-as-num v)
  (cond
    ((number? v) v)
    ((eq? v #t) 1)
    ((eq? v #f) 0)
    (#t #f)))

;; Call the function that is already bound. The model form is not passed in.
(define (pad:tx-call! name lit)
  (set! *tx-exec* (+ *tx-exec* 1))
  (try (eval (string-append "("
               (string-append name
                 (string-append " " (string-append lit ")")))))
       (catch (e) (list "raised"))))

(define (pad:tx-check-pass? chk)
  (let ((got (pad:tx-call! (car chk) (cadr chk))))
    (if (and (pair? got) (string? (car got)) (string=? (car got) "raised"))
        #f
        (let ((want (pad:tx-num (caddr chk))))
          (if (number? want)
              (let ((g (pad:tx-as-num got)))
                (and (number? g) (= g want)))
              (equal? got (caddr chk)))))))

(define (pad:tx-score checks)
  (if (not (pair? checks))
      0
      (+ (if (pad:tx-check-pass? (car checks)) 1 0)
         (pad:tx-score (cdr checks)))))

(define (pad:tx-score-show! page-n child-n)
  (pad:tx-show! (string-append "SCORE page=" (number->string page-n)))
  (pad:tx-show! (string-append "SCORE child=" (number->string child-n)))
  (pad:tx-show! (string-append "SCORE better="
                  (if (> child-n page-n) "yes" "no")))
  (pad:tx-show! (string-append "SCORE exec=" (number->string *tx-exec*)))
  (if (try pad:play-step! (catch (e) #f))
      (set! *tx-better* (if (> child-n page-n) #t #f))
      0)
  0)

(define (pad:tx-scan-ready!)
  (if (try pad:read-guard-src? (catch (e) #f))
      #t
      (pad:tx-aw-ready!)))

(define (pad:tx-scan-ops ops)
  (if (null? ops)
      #f
      (if (pad:read-guard-src?
            (pad:tx-form (car (car ops)) (cadr (car ops))))
          #t
          (pad:tx-scan-ops (cdr ops)))))

(define (pad:tx-danger? ops)
  (if (not (pad:tx-scan-ready!))
      #t
      (pad:tx-scan-ops ops)))

;; Splice every kept op. A missing name leaves that span unchanged.
;; These two sit above the card so the card slice stays a key path.
(define (pad:tx-card-splice! ops src)
  (if (not (pair? ops))
      src
      (pad:tx-card-splice! (cdr ops)
        (pad:proj-splice! src (car (car ops)) (cadr (car ops))))))

(define (pad:tx-card-keep!)
  (let ((out (pad:tx-card-splice! *tx-card-ops* (pad:tx-page))))
    (pad:tx-install! out)
    (if (try *pl-st* (catch (e) #f))
        (set! *pl-st* (pad:es-at (pad:v-lines out) 0 0))
        0)
    (pad:tx-show! "CARD keep=1")
    (set! *pl-say* "kept")
    "go"))

;; Three choices. The mark sits on one of them. Choosing closes the card.
;; Keep writes the projection only when the score was strictly higher
;; and the blast count agreed.
(define (pad:tx-card-say!)
  (let ((i *tx-card*))
    (set! *pl-say*
      (string-append
        (if (= i 0) "> keep" "keep")
        (string-append "   "
          (string-append
            (if (= i 1) "> drop" "drop")
            (string-append "   "
              (if (= i 2) "> undo" "undo"))))))
    *pl-say*))

(define (pad:tx-card-show!)
  (set! *tx-card* 0)
  (pad:tx-card-say!)
  (pad:tx-show! "CARD show=1")
  *pl-say*)

(define (pad:tx-card-at! i)
  (set! *tx-card* i)
  (pad:tx-card-say!)
  (pad:tx-show! (string-append "CARD at=" (number->string *tx-card*)))
  "go")

(define (pad:tx-card-step! d)
  (let ((n (+ *tx-card* d)))
    (pad:tx-card-at!
      (cond
        ((< n 0) 2)
        ((> n 2) 0)
        (#t n)))))

(define (pad:tx-card-block!)
  (pad:tx-show! "CARD block=1")
  (set! *pl-say* "finish this card first")
  "go")

(define (pad:tx-card-name)
  (cond
    ((= *tx-card* 1) "drop")
    ((= *tx-card* 2) "undo")
    (#t "keep")))

(define (pad:tx-card-act!)
  (let ((name (pad:tx-card-name)))
    (set! *tx-card* #f)
    (pad:tx-show! (string-append "CARD did=" name))
    (cond
      ((string=? name "undo")
       (set! *pl-say* (pad:tx-undo!)))
      ((string=? name "drop")
       (set! *pl-say* "did drop"))
      ((string=? name "keep")
       (if (eq? *tx-better* #t)
           (if (eq? *tx-blast-ok* #t)
               (pad:tx-card-keep!)
               (begin
                 (pad:tx-show! "TX_DISAGREE")
                 (set! *pl-say* "TX_DISAGREE")))
           (if (pair? *tx-card-ops*)
               (set! *pl-say* "that one is not better")
               (set! *pl-say* "did keep"))))
      (#t (set! *pl-say* (string-append "did " name))))
    "go"))

(define (pad:tx-card-drop!)
  (set! *tx-card* #f)
  (pad:tx-show! "CARD drop=1")
  (set! *pl-say* "dropped")
  "go")

(define (pad:tx-card-byte! b)
  (cond
    ((= b 13) (pad:tx-card-act!))
    ((= b 27) (pad:tx-card-drop!))
    ((= b 9) (pad:tx-card-step! 1))
    (#t (pad:tx-card-block!))))

(define (pad:tx-card-word! w)
  (cond
    ((or (string=? w "right") (string=? w "next-line"))
     (pad:tx-card-step! 1))
    ((or (string=? w "left") (string=? w "prev-line"))
     (pad:tx-card-step! -1))
    ((string=? w "home") (pad:tx-card-at! 0))
    ((string=? w "end") (pad:tx-card-at! 2))
    ((string=? w "enter") (pad:tx-card-act!))
    (#t (pad:tx-card-block!))))

(define (pad:tx-card-arrow! b)
  (cond
    ((or (= b 67) (= b 66)) (pad:tx-card-step! 1))
    ((or (= b 68) (= b 65)) (pad:tx-card-step! -1))
    ((= b 72) (pad:tx-card-at! 0))
    ((= b 70) (pad:tx-card-at! 2))
    (#t (pad:tx-card-block!))))

(define (pad:tx-card-in! bs)
  (cond
    ((not bs) (pad:tx-card-block!))
    ((null? (cdr bs)) (pad:tx-card-byte! (car bs)))
    ((and (pair? (cdr bs))
          (pair? (cdr (cdr bs)))
          (null? (cdr (cdr (cdr bs))))
          (= (car bs) 27)
          (or (= (cadr bs) 91) (= (cadr bs) 79)))
     (pad:tx-card-arrow! (caddr bs)))
    (#t (pad:tx-card-block!))))

;; Classic bytes. A whole arrow is not byte 9, so it does not move the mark.
(define (pad:tx-card-line! line)
  (let ((n (string-length line)))
    (if (and (> n 3) (string=? (substring line 0 3) "IN "))
        (let ((bs (pad:pi-parse line)))
          (if (not bs)
              (pad:tx-card-block!)
              (if (null? (cdr bs))
                  (pad:tx-card-byte! (car bs))
                  (pad:tx-card-block!))))
        (pad:tx-card-block!))))

(define (pad:tx-card-ux! line)
  (let ((n (string-length line)))
    (cond
      ((and (> n 4) (string=? (substring line 0 4) "KEY "))
       (pad:tx-card-word! (substring line 4 n)))
      ((and (> n 3) (string=? (substring line 0 3) "IN "))
       (pad:tx-card-in! (pad:pi-parse line)))
      (#t (pad:tx-card-block!)))))

;; One fixture, no network. The card stays up until Enter or Esc.
(define (pad:tx-propose-text! text)
  (pad:tx-show! "PROPOSE enter=1")
  (pad:tx-show! "PROPOSE net=0")
  (let ((parsed (pad:tx-parse text)))
    (set! *tx-better* #f)
    (set! *tx-touches* #f)
    (set! *tx-blast-ok* #f)
    (set! *tx-card-ops*
      (if (and (pair? parsed)
               (string? (car parsed))
               (string=? (car parsed) "ops"))
          (cadr parsed)
          (list)))
    (let ((kind (car (pad:tx-run! text))))
      (pad:tx-show! (string-append "PROPOSE kind=" kind))
      (pad:tx-card-show!)
      (if (and (eq? *tx-better* #t) (string? *tx-touches*))
          (set! *pl-say* *tx-touches*)
          (if (and (eq? *tx-better* #t) (eq? *tx-blast-ok* #f))
              (set! *pl-say* "TX_DISAGREE")
              0))
      *pl-say*)))

(define (pad:tx-propose!)
  (pad:tx-propose-text!
    (pad:tx-read
      (string-append (pad:tx-home)
        "/soft/pad/fixtures/propose_ok.txt"))))

;; Two ideas from one reply. A second separator is a third idea, refused.
(define (pad:tx-two-walk s i n)
  (if (>= i n)
      #f
      (let ((nl (pad:tx-at s i n 10)))
        (let ((line (if (< nl 0) (substring s i n) (substring s i nl)))
              (j (if (< nl 0) n (+ nl 1))))
          (if (string=? line "---")
              (list (substring s 0 i) (substring s j n))
              (if (< nl 0) #f (pad:tx-two-walk s j n)))))))

(define (pad:tx-two-parts s)
  (if (not (string? s))
      #f
      (let ((cut (pad:tx-two-walk s 0 (string-length s))))
        (if (not (pair? cut))
            #f
            (if (pad:tx-two-walk (cadr cut) 0 (string-length (cadr cut)))
                #f
                cut)))))

(define (pad:tx-child-score text)
  (let ((r (pad:tx-run! text)))
    (if (and (pair? r)
             (pair? (cdr r))
             (pair? (cdr (cdr r)))
             (number? (car (cdr (cdr r)))))
        (car (cdr (cdr r)))
        -1)))

(define (pad:tx-rules-ready!)
  (if (try pad:stamp-world! (catch (e) #f))
      #t
      (pad:tx-load-in! "tx-rules"
                       (string-append (pad:tx-home) "/soft/pad/rules.aura"))))

(define (pad:tx-num-pair? p)
  (and (pair? p)
       (number? (car p))
       (pair? (cdr p))
       (number? (cadr p))))

;; Submitted with the two-proposal sentence. The key loop does not call it.
;; fiber_live only when both joins return the same scores as the host.
(define (pad:tx-world-race! a b)
  (if (not (pad:tx-rules-ready!))
      (list -1 -1)
      (begin
        (set! *race-backend* 0)
        (set! *race-spawned* 0)
        (set! *race-joined* 0)
        (set! *world-line* "host-sequential")
        (let ((host (list (pad:tx-child-score a) (pad:tx-child-score b))))
          (let ((raced (pad:race-thunks!
                         (lambda () (pad:tx-child-score a))
                         (lambda () (pad:tx-child-score b)))))
            (if (not (and (pad:tx-num-pair? raced)
                          (= (car raced) (car host))
                          (= (cadr raced) (cadr host))))
                (set! *race-joined* 0))
            (pad:stamp-world!)
            (pad:tx-show! (string-append "SCORE a=" (number->string (car host))))
            (pad:tx-show! (string-append "SCORE b=" (number->string (cadr host))))
            (pad:tx-show!
              (string-append "RACE a="
                (number->string
                  (if (pad:tx-num-pair? raced) (car raced) -1))))
            (pad:tx-show!
              (string-append "RACE b="
                (number->string
                  (if (pad:tx-num-pair? raced) (cadr raced) -1))))
            host)))))

(define (pad:tx-world-text! text)
  (let ((parts (pad:tx-two-parts text)))
    (if (not (pair? parts))
        (list -1 -1)
        (pad:tx-world-race! (car parts) (cadr parts)))))

(define (pad:tx-world!)
  (pad:tx-world-text!
    (pad:tx-read
      (string-append (pad:tx-home)
        "/soft/pad/fixtures/propose_two.txt"))))

;; Blast card before KEEP. Loaded beside the file child, then counted
;; while that child is still current. Arrow keys do not enter here.
(define (pad:tx-blast-ready!)
  (if (try pad:blast-sites (catch (e) #f))
      #t
      (pad:tx-load-in! "tx-blast"
        (string-append (pad:tx-home) "/soft/pad/blast.aura"))))

(define (pad:tx-call-n name)
  (try
    (let ((r (query:calls name)))
      (if (and (or (pair? r) (null? r)) (not (pad:eng-err? r)))
          (length r)
          -1))
    (catch (e) -1)))

(define (pad:tx-name-dirty? name)
  (let ((ids (try (pad:q-defines-of name) (catch (e) #f))))
    (if (and (pair? ids) (number? (car ids)))
        (let ((d (try (query:dirty-nodes "general") (catch (e) #f))))
          (if (and (pair? d) (member (number->string (car ids)) d))
              #t
              #f))
        #f)))

(define (pad:tx-blast-rows ops src)
  (if (not (pair? ops))
      (list)
      (let ((name (car (car ops))))
        (cons (list name
                    (length (pad:blast-sites (pad:hl-tokens src) name #f #f (list)))
                    (pad:tx-call-n name)
                    (pad:blast-eng-calls name))
              (pad:tx-blast-rows (cdr ops) src)))))

(define (pad:tx-blast-row-ok? row)
  (let ((soft (cadr row))
        (eng (caddr row))
        (wrap (car (cdr (cdr (cdr row))))))
    (and (>= eng 0)
         (= soft eng)
         (= eng wrap)
         (pad:tx-name-dirty? (car row)))))

(define (pad:tx-blast-rows-ok? rows)
  (cond
    ((null? rows) #t)
    ((pad:tx-blast-row-ok? (car rows)) (pad:tx-blast-rows-ok? (cdr rows)))
    (#t #f)))

(define (pad:tx-blast-soft-sum rows acc)
  (if (null? rows)
      acc
      (pad:tx-blast-soft-sum (cdr rows) (+ acc (cadr (car rows))))))

(define (pad:tx-blast-eng-sum rows acc)
  (if (null? rows)
      acc
      (pad:tx-blast-eng-sum (cdr rows) (+ acc (caddr (car rows))))))

(define (pad:tx-blast-dots rows)
  (cond
    ((null? rows) "")
    ((null? (cdr rows)) (car (car rows)))
    (#t (string-append (car (car rows))
          (string-append "." (pad:tx-blast-dots (cdr rows)))))))

(define (pad:tx-blast-names rows)
  (if (null? rows)
      (list)
      (cons (car (car rows)) (pad:tx-blast-names (cdr rows)))))

(define (pad:tx-blast-show! rows soft eng)
  (pad:tx-show!
    (string-append "BLAST names="
      (string-append (pad:tx-blast-dots rows)
        (string-append " calls="
          (string-append (number->string soft)
            (string-append "/" (number->string eng)))))))
  0)

(define (pad:tx-blast-take! ops src)
  (if (not (try pad:blast-sites (catch (e) #f)))
      (begin
        (set! *tx-touches* #f)
        (set! *tx-blast-ok* #f)
        (pad:tx-show! "TX_DISAGREE")
        0)
      (let ((kept (pad:tx-card-splice! ops src)))
        (let ((rows (pad:tx-blast-rows ops kept)))
          (let ((soft (pad:tx-blast-soft-sum rows 0))
                (eng (pad:tx-blast-eng-sum rows 0)))
            (pad:tx-blast-show! rows soft eng)
            (if (and (pair? rows)
                     (pad:tx-blast-rows-ok? rows)
                     (= soft eng))
                (begin
                  (set! *tx-touches*
                    (string-append "touches "
                      (pad:blast-commas (pad:tx-blast-names rows))))
                  (set! *tx-blast-ok* #t))
                (begin
                  (set! *tx-touches* #f)
                  (set! *tx-blast-ok* #f)
                  (pad:tx-show! "TX_DISAGREE")))
            0)))))

;; Equal scores drop. Neither idea is written, including the one
;; whose fiber joined first.
(define (pad:tx-tie-text! text)
  (let ((parts (pad:tx-two-parts text)))
    (if (not (pair? parts))
        (list -1 -1)
        (let ((host (pad:tx-world-race! (car parts) (cadr parts))))
          (if (and (pad:tx-num-pair? host)
                   (= (car host) (cadr host))
                   (>= (car host) 0))
              (begin
                (pad:tx-show!
                  (string-append "TIE score=" (number->string (car host))))
                (if (string? (try *pl-say* (catch (e) #f)))
                    (set! *pl-say* "neither is better")
                    0)
                host)
              host)))))

(define (pad:tx-tie!)
  (pad:tx-tie-text!
    (pad:tx-read
      (string-append (pad:tx-home)
        "/soft/pad/fixtures/propose_tie.txt"))))

;; M4: two pads (story / scratch), find / replace, record / play, a
;; buffer-law race and a macro propose race on the kid story goal
;;   story   "a cat" / "the cat ran"  ->  "a dog" / "the dog ran" / "they had fun"
;;   scratch "my notes" / "they had fun" (must stay)
;; Law race (same keys, two laws): wrap-3 beats stop-3 -> KEEP law;
;; wrap-9 lets replace-all smash letters -> DROP law.
;; Macro fixtures (fixtures/m4/): undo REJECT when nothing kept, set! gate,
;; kind gate (mean word), bad-token heal, oops DROP 18 (kid REJECTs),
;; replay (rec / play) KEEP 44, smart KEEP 51, tie DROP 51, macro undo
;; 51 -> 44 with an honest re-score, smart KEEP again.
;; No HTTP. fiber_live only when every join lands.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/rules.aura")
(load "/workspace/aura-pad/soft/pad/lines.aura")
(load "/workspace/aura-pad/soft/pad/helper.aura")
(load "/workspace/aura-pad/soft/pad/edit.aura")
(load "/workspace/aura-pad/soft/pad/m4.aura")
(load "/workspace/aura-pad/soft/pad/macro.aura")

(define *fail* 0)
(define *fx* "/workspace/aura-pad/soft/pad/fixtures/m4/")
(define *law-keys*
  (list "replace-all:a=o" "eob" "find:cat" "replace:dog" "find-next" "replace:dog"))

(define (fail! tag)
  (display tag)
  (newline)
  (set! *fail* (+ *fail* 1))
  *fail*)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (pad:nstr got))
  (if (and (number? got) (= got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display (pad:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-str tag got want)
  (display tag)
  (display "=")
  (display got)
  (if (and (string? got) (string=? got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display want)
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (tag-of r)
  (if (and (pair? r) (pair? (cdr r))) (car (cdr r)) "none"))

(define (propose! name want)
  (let ((r (pd:macro-propose-file! (string-append *fx* name))))
    (expect-str (string-append "TAG_" name) (tag-of r) want)
    r))

(define (story-text)
  (pad:dot-text (pad:es-L (pad:buf-get (pad:ms-bufs *m4-state*) "story"))))

(define (main)
  (display "DIALECT=live-soft-editor-pad-m4")
  (newline)
  (set! *race-backend* 0)
  (set! *race-spawned* 0)
  (set! *race-joined* 0)
  ;; 1. buffer-law race: same keys, two laws
  (expect-str "LAW_START" (pad:law-str *m4-law*) "stop-3")
  (let ((r (pad:law-race! *law-wrap* *law-keys*)))
    (expect-str "LAW1" (car r) "law_keep")
    (expect "LAW1_BASE" (pad:nth r 1) -8)
    (expect "LAW1_TRIAL" (pad:nth r 2) 14))
  (let ((r (pad:law-race! *law-big* *law-keys*)))
    (expect-str "LAW2" (car r) "law_drop")
    (expect "LAW2_TRIAL" (pad:nth r 2) -7))
  (expect-str "LAW_MAIN" (pad:law-str *m4-law*) "wrap-3")
  ;; 2. macro propose race on the story goal
  (let ((seeded (pd:macro-seed! (pd:clean (read-file (string-append *fx* "main.lambda"))))))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        (display "PAD_M4_FAIL seed\n")
        (begin
          (expect "MAIN_START" *main-score* 30)
          (expect-str "MAIN_TEXT" (story-text) "a.dog|the.dog.ran|they.had.fun")
          (expect-str "UNDO_EMPTY" (tag-of (pd:macro-undo!)) "macro_undo_reject")
          (propose! "bad.lambda" "macro_reject")
          (expect-str "WORD_BAD" *macro-word* "set!")
          (propose! "mean.lambda" "macro_reject")
          (expect-str "WORD_MEAN" *macro-word* "stupid")
          (propose! "ugly.lambda" "macro_heal")
          (expect-str "HEAL_WHY" *macro-why* "bad-token")
          (expect "AFTER_HEAL" (pad:mscore-plan (pd:macro)) 30)
          (propose! "oops.lambda" "macro_drop")
          (expect "OOPS_TRIAL" *macro-trial* 18)
          (propose! "replay.lambda" "macro_keep")
          (expect "REPLAY_TRIAL" *macro-trial* 44)
          (expect "REPLAY_MACRO" (length (pad:ms-macro *m4-state*)) 2)
          (propose! "smart.lambda" "macro_keep")
          (expect "SMART_BASE" *macro-base* 44)
          (expect "SMART_TRIAL" *macro-trial* 51)
          (propose! "tie.lambda" "macro_drop")
          (expect-str "TIE_WHY" *drop-reason* "tie-is-not-better-rollback")
          (expect "TIE_SLOT" (pad:mscore-plan (pd:macro)) 51)
          (expect "HISTORY" (length *macro-history*) 2)
          (expect-str "UNDO_1" (tag-of (pd:macro-undo!)) "macro_undo")
          (expect "UNDO_1_SCORE" *main-score* 44)
          (expect "UNDO_1_STAMP" *m4-score* 44)
          (expect "SLOT_MAIN" (pad:mscore-plan (pd:mshadow)) 44)
          (propose! "smart.lambda" "macro_keep")
          (expect "AGAIN_BASE" *macro-base* 44)
          (expect "AGAIN_TRIAL" *macro-trial* 51)
          (expect-str "TEXT_FINAL" (story-text) "a.dog|the.dog.ran|they.had.fun")
          (expect "KEEPS" *macro-keeps* 3)
          (expect "DROPS" *macro-drops* 2)
          (expect "UNDOS" *macro-undos* 1)
          (expect "LAW_KEEPS" *law-keeps* 1)
          (expect "LAW_DROPS" *law-drops* 1)
          (pad:stamp-world!)
          (if (string=? *world-line* "fiber_live")
              (if (not (and (> *race-backend* 0)
                            (= *race-joined* *race-spawned*)
                            (= *race-spawned* 14)))
                  (fail! "WORLD_FAIL"))
              (if (not (string=? *world-line* "host-sequential"))
                  (fail! "WORLD_FAIL")))
          (display "MAIN macro score=")
          (display (pad:nstr *main-score*))
          (display " law=")
          (display (pad:law-str *m4-law*))
          (display " body=")
          (display *macro-main-body*)
          (newline)
          (if (= *fail* 0)
              (display "PAD_M4_OK\n")
              (display "PAD_M4_FAIL\n"))))))

(main)

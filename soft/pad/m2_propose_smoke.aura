;; M2 fixture propose. No HTTP. gate reject, probe heal, DROP, KEEP.
;; Main starts as the M0 winner map-bold (3 20 0), score 9 on 24 keys.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/rules.aura")
(load "/workspace/aura-pad/soft/pad/pack.aura")
(load "/workspace/aura-pad/soft/pad/propose.aura")

(define *fail* 0)
(define *fx* "/workspace/aura-pad/soft/pad/fixtures/")

(define (fail! tag)
  (display tag)
  (newline)
  (set! *fail* (+ *fail* 1))
  *fail*)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (pad:nstr got))
  (if (= got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display (pad:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (tag? r want)
  (and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) want)))

(define (pack= p a b c)
  (and (pad:pack-ok? p)
       (= (pad:pack-step p) a)
       (= (pad:pack-room p) b)
       (= (pad:pack-strict p) c)))

(define (main)
  (display "DIALECT=live-soft-editor-pad-m2")
  (newline)
  (let ((seeded (pd:strategy-seed! *bold-body*)))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        (display "PAD_M2_PROPOSE_FAIL seed\n")
        (begin
          (set! *main-score* (pad:score-pack (pd:shadow)))
          (expect "MAIN_START" *main-score* 9)
          (if (not (tag? (pd:propose-file! (string-append *fx* "bad.lambda"))
                         "propose_reject"))
              (fail! "REJECT_FAIL"))
          (if (not (pack= (pd:law) 3 20 0)) (fail! "SLOT_FAIL reject"))
          (if (not (tag? (pd:propose-file! (string-append *fx* "noisy.lambda"))
                         "propose_reject"))
              (fail! "REJECT_FAIL noisy"))
          (if (not (string=? *gate-word* "display")) (fail! "WORD_FAIL noisy"))
          (if (not (tag? (pd:propose-file! (string-append *fx* "ugly.lambda"))
                         "propose_heal"))
              (fail! "HEAL_FAIL"))
          (if (not (pack= (pd:law) 3 20 0)) (fail! "SLOT_FAIL heal"))
          (if (not (tag? (pd:propose-file! (string-append *fx* "worse.lambda"))
                         "propose_drop"))
              (fail! "DROP_FAIL"))
          (expect "WORSE_BASE" *base-last* 9)
          (expect "WORSE_TRIAL" *trial-last* -2)
          (if (not (pack= (pd:law) 3 20 0)) (fail! "SLOT_FAIL drop"))
          (if (not (string=? *main-body* *bold-body*)) (fail! "MAIN_FAIL drop"))
          (if (not (tag? (pd:propose-file! (string-append *fx* "better.lambda"))
                         "propose_keep"))
              (fail! "KEEP_FAIL"))
          (expect "BETTER_BASE" *base-last* 9)
          (expect "BETTER_TRIAL" *trial-last* 10)
          (expect "MAIN_SCORE" *main-score* 10)
          (expect "LIVE_SCORE" (pad:live-score) 10)
          (if (not (pack= (pd:law) 1 12 0)) (fail! "SLOT_FAIL keep"))
          (pad:stamp-world!)
          (if (string=? *world-line* "fiber_live")
              (if (not (and (> *race-backend* 0)
                            (= *race-joined* *race-spawned*)
                            (= *race-spawned* 4)))
                  (fail! "WORLD_FAIL"))
              (if (not (string=? *world-line* "host-sequential"))
                  (fail! "WORLD_FAIL")))
          (if (= *fail* 0)
              (display "PAD_M2_PROPOSE_OK\n")
              (display "PAD_M2_PROPOSE_FAIL\n"))))))

(main)

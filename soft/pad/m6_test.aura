;; M6 Soft tests: SNAP packer (view.aura) + Soft keymap/play (keys.aura).
;; The C viewport has no logic to test; every decision is checked here.
;; Numbers match scripts/snap_model.py --check. Ends PAD_M6_TEST_OK.
;; No HTTP, no fibers. Soft reserved: never bind quote.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/lines.aura")
(load "/workspace/aura-pad/soft/pad/edit.aura")
(load "/workspace/aura-pad/soft/pad/hl.aura")
(load "/workspace/aura-pad/soft/pad/jump.aura")
(load "/workspace/aura-pad/soft/pad/view.aura")
(load "/workspace/aura-pad/soft/pad/lc.aura")
(load "/workspace/aura-pad/soft/pad/keys.aura")

(define *fail* 0)
(define *checks* 0)

(define (expect tag got want)
  (set! *checks* (+ *checks* 1))
  (display "T ")
  (display tag)
  (display "=")
  (display (if (number? got) (pad:nstr got) "?"))
  (if (and (number? got) (= got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display (pad:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

;; One-line view of a string: newline shown as "|" so a T line never splits.
(define (show s)
  (list->string (map (lambda (c) (if (= (char->integer c) 10) #\| c))
                     (string->list s))))

(define (expect-str tag got want)
  (set! *checks* (+ *checks* 1))
  (display "T ")
  (display tag)
  (display "=")
  (display (if (string? got) (show got) "?"))
  (if (and (string? got) (string=? got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display (show want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (lc-str lc)
  (string-append (number->string (car lc)) ":" (number->string (car (cdr lc)))))

(define (cmd-str c) (if (number? c) (string-append "char-" (number->string c)) c))

(define *fx*
  "(define (hello x) (+ x 1)) ; hi\n(define (bye y) (hello y))\n(hello 3)")

(define (view-tests!)
  (let ((L (pad:v-lines *fx*)))
    (expect "SPLIT_N" (length (pad:v-split "a\nb\n")) 3)
    (expect-str "SPLIT_LAST" (pad:nth (pad:v-split "a\nb\n") 2) "")
    (expect "SPLIT_EMPTY" (length (pad:v-split "")) 1)
    (expect "ROWS" (length L) 3)
    (expect-str "ROUNDTRIP" (pad:v-src L) *fx*)
    (expect "POINT_0_0" (pad:v-point L 0 0) 0)
    (expect "POINT_1_0" (pad:v-point L 1 0) 32)
    (expect "POINT_2_1" (pad:v-point L 2 1) 60)
    (expect-str "LC_60" (lc-str (pad:v-linecol L 60)) "2:1")
    (expect-str "LC_31" (lc-str (pad:v-linecol L 31)) "0:31")
    (expect-str "LC_32" (lc-str (pad:v-linecol L 32)) "1:0")
    (expect-str "LC_CLAMP" (lc-str (pad:v-linecol L 999)) "2:9")
    (expect-str "LC_NEG" (lc-str (pad:v-linecol L -4)) "0:0")
    (expect-str "MARKS_HELLO" (pad:v-marks *fx* 60)
                ".........ddddd...................................rrrrr......rrrrr...")
    (expect "MARKS_LEN" (string-length (pad:v-marks *fx* 60)) (string-length *fx*))
    (expect-str "MARKS_PAREN" (pad:v-marks "(f 1)" 0) ".....")
    (expect-str "MARKS_USE" (pad:v-marks "(f 1)" 1) ".r...")
    (expect-str "MARKS_KW" (pad:v-marks "(define a)\n(define b)" 2)
                ".rrrrrr.....rrrrrr...")
    (expect-str "SNAP_TINY"
                (pad:snap-text "t" (pad:v-lines "(f 1)") 0 1 "hi")
                (string-append "SNAP v1 pad\nTITLE t\nCURSOR line=0 col=1\nSAY hi\n"
                               "LEGEND " *view-legend* "\nROWS n=1\n"
                               "T (f 1)\nH PS.NP\nM .r...\nEND\n"))
    (expect-str "SNAP_EMPTY_ROW"
                (pad:v-rows (pad:v-split "a\n") (pad:hl-color "a\n") "..")
                "T a\nH S\nM .\nT \nH \nM \n")
    (let ((s (pad:snap-text "kid" L 2 1 "x")))
      (expect "SNAP_LINES" (length (pad:v-split s)) (+ 6 (* 3 3) 1 1))
      (expect-str "SNAP_HEAD" (car (pad:v-split s)) "SNAP v1 pad")
      (expect-str "SNAP_CURSOR" (pad:nth (pad:v-split s) 2) "CURSOR line=2 col=1")
      (expect-str "SNAP_H0" (pad:nth (pad:v-split s) 7) "H PKKKKKK.PSSSSS.SP.PS.S.NPP.CCCC")
      (expect-str "SNAP_END" (pad:nth (pad:v-split s) 15) "END"))
    0))

(define (key-tests!)
  (expect-str "KEY_CHAR" (cmd-str (car (pad:key-step (list) 104))) "char-104")
  (expect-str "KEY_CTRL_G" (cmd-str (car (pad:key-step (list) 7))) "goto-def")
  (expect-str "KEY_CTRL_Q" (cmd-str (car (pad:key-step (list) 17))) "quit")
  (expect-str "KEY_DEL" (cmd-str (car (pad:key-step (list) 127))) "back")
  (expect-str "KEY_TAB" (cmd-str (car (pad:key-step (list) 9))) "unknown")
  (expect-str "KEY_ESC" (cmd-str (car (pad:key-step (list) 27))) "pending")
  (expect-str "KEY_CSI" (cmd-str (car (pad:key-step (list 27) 91))) "pending")
  (expect-str "KEY_UP" (cmd-str (car (pad:key-step (list 27 91) 65))) "prev-line")
  (expect-str "KEY_DOWN" (cmd-str (car (pad:key-step (list 27 91) 66))) "next-line")
  (expect-str "KEY_RIGHT" (cmd-str (car (pad:key-step (list 27 91) 67))) "right")
  (expect-str "KEY_LEFT" (cmd-str (car (pad:key-step (list 27 91) 68))) "left")
  (expect-str "KEY_CSI_BAD" (cmd-str (car (pad:key-step (list 27 91) 90))) "unknown")
  (expect "KEY_ESC_CLEARS" (length (car (cdr (pad:key-step (list 27 91) 65)))) 0)
  (expect-str "KEY_ESC_X" (cmd-str (car (pad:key-step (list 27) 120))) "unknown")
  0)

(define (play-tests!)
  (pad:play-reset! *play-start*)
  (expect "PLAY_MAXCOL" *max-col* 40)
  (expect-str "PLAY_DOWN" (pad:play-line! "IN 27") "pending")
  (pad:play-line! "IN 91")
  (expect-str "PLAY_DOWN_OK" (pad:play-line! "IN 66") "ok")
  (pad:play-line! "IN 5")
  (expect "PLAY_END_COL" (pad:es-col *pl-st*) 9)
  (pad:play-line! "IN 127")
  (pad:play-line! "IN 127")
  (pad:play-line! "IN 52")
  (pad:play-line! "IN 41")
  (expect-str "PLAY_TEXT" (pad:play-src) "(define (hello x) (+ x 1))\n(hello 4)")
  (pad:play-line! "IN 1")
  (pad:play-line! "KEY right")
  (expect-str "PLAY_GOTO" (pad:play-line! "IN 7") "ok")
  (expect-str "PLAY_GOTO_LC" (lc-str (list (pad:es-l *pl-st*) (pad:es-col *pl-st*))) "0:9")
  (expect-str "PLAY_GOTO_SAY" *pl-say* "jumped to where hello is born")
  (pad:play-line! "IN 2")
  (expect-str "PLAY_BACK_LC" (lc-str (list (pad:es-l *pl-st*) (pad:es-col *pl-st*))) "1:1")
  (pad:play-line! "IN 18")
  (expect-str "PLAY_REFS_SAY" *pl-say* "hello is used 2 times")
  (expect-str "PLAY_TAB" (pad:play-line! "IN 9") "unknown")
  (expect-str "PLAY_TAB_SAY" *pl-say* "that key does nothing yet")
  (expect-str "PLAY_NOBACK" (pad:play-line! "IN 2") "nothing-to-back")
  (expect-str "PLAY_NOBACK_SAY" *pl-say* "nowhere to jump back to")
  (pad:play-line! "IN 1")
  (expect-str "PLAY_NOSYM" (pad:play-line! "IN 7") "no-symbol")
  (expect-str "PLAY_UP_TOP" (begin (pad:play-line! "KEY bob")
                                   (pad:play-line! "KEY prev-line")) "no-line")
  (expect-str "PLAY_UNDO" (begin (pad:play-line! "IN 31") (pad:play-src))
              "(define (hello x) (+ x 1))\n(hello 4")
  (expect-str "PLAY_ENTER" (begin (pad:play-line! "KEY eob")
                                  (pad:play-line! "IN 13")
                                  (lc-str (list (pad:es-l *pl-st*) (pad:es-col *pl-st*))))
              "2:0")
  (expect "PLAY_ROWS" (length (pad:es-L *pl-st*)) 3)
  (expect-str "PLAY_QUIT" (pad:play-line! "IN 17") "quit")
  (expect-str "PLAY_JUNK" (pad:play-line! "hello?") "unknown")
  (let ((s (pad:play-snap)))
    (expect-str "PLAY_SNAP_HEAD" (car (pad:v-split s)) "SNAP v1 pad"))
  0)

(view-tests!)
(key-tests!)
(play-tests!)

(display "TESTS checks=")
(display (number->string *checks*))
(display " fail=")
(display (number->string *fail*))
(newline)
(if (= *fail* 0)
    (begin (display "PAD_M6_TEST_OK") (newline))
    (begin (display "PAD_M6_TEST_FAIL") (newline)))

;; Step 17. A clean save writes the bytes from open.
;; The em dash stays UTF-8. Soft reserved: never bind quote.
(define *pad-home*
  (let ((h (getenv "AURA_PAD_HOME")))
    (if (and (string? h) (> (string-length h) 0)) h "/workspace/aura-pad")))

(load (string-append *pad-home* "/soft/pad/buffer.aura"))
(load (string-append *pad-home* "/soft/pad/lines.aura"))
(load (string-append *pad-home* "/soft/pad/edit.aura"))
(load (string-append *pad-home* "/soft/pad/hl.aura"))
(load (string-append *pad-home* "/soft/pad/jump.aura"))
(load (string-append *pad-home* "/soft/pad/view.aura"))
(load (string-append *pad-home* "/soft/pad/lc.aura"))
(load (string-append *pad-home* "/soft/pad/keys.aura"))
(load (string-append *pad-home* "/soft/pad/file.aura"))

(define (pad:em-other-dirty) "")

(define (say s)
  (display s)
  (newline)
  0)

(define *raw-dash* (list->string (list 226 128 148)))

(define (raw:open! label path)
  (let ((r (pad:pf-open! path)))
    (say (string-append label
                        " open=" r
                        " ro=" (if *pf-ro* "true" "false")
                        " nl=" (if *pf-nl* "true" "false")
                        " encode=" (if (string=? (pad:utf-encode (car *pl-st*)) *pf-saved*)
                                       "saved" "diff")
                        " play=" (if (string=? (pad:play-src) *pf-saved*)
                                     "saved" "diff")
                        " dash=" (if (>= (string-index *pf-saved* *raw-dash* 0) 0)
                                     "bytes" "folded")))))

(raw:open! "RAW" (getenv "PAD_SAVE_RAW"))
(say (string-append "RAW save=" (pad:pf-save!)))
(say (string-append "RAW quit=" (pad:pf-quit! #f)))
(raw:open! "NONE" (getenv "PAD_SAVE_NONE"))
(say (string-append "NONE save=" (pad:pf-save!)))
(say "SAVE_RAW_UNIT_OK")

;; M2: propose -> gate -> race vs current main -> KEEP or DROP + heal.
;; The host writes one (lambda () (list step room strict)) file. Soft does
;; not speak HTTP. pd:shadow is the current main pack, pd:law the trial.
;; KEEP only when trial > base. A tie DROPs.

(load "/workspace/aura-pad/soft/pad/hot.aura")

(define (pd:propose-score! clean)
  (let ((pair (pad:race-thunks!
               (lambda () (pad:score-pack (pd:shadow)))
               (lambda () (pad:score-pack (pd:law))))))
    (let ((base (car pair))
          (trial (car (cdr pair))))
      (set! *base-last* base)
      (set! *trial-last* trial)
      (display "RACE base=")
      (display (pad:nstr base))
      (display " trial=")
      (display (pad:nstr trial))
      (newline)
      (if (> trial base)
          (begin
            (set! *main-body* clean)
            (set! *main-score* trial)
            (set! *main-name* "pd:law")
            (set! *keep-reason* "higher-score-stamp")
            (set! *propose-tag* "propose_keep")
            (display "KEEP reason=higher-score-stamp score=")
            (display (pad:nstr trial))
            (newline)
            (display "PROPOSE tag=propose_keep")
            (newline)
            (pad:stamp-pack! (pd:law) "pd:law")
            (list #t "propose_keep"))
          (begin
            (hot-strategy:heal!)
            (set! *drop-reason* (if (= trial base)
                                    "tie-is-not-better-rollback"
                                    "lower-score-rollback"))
            (set! *propose-tag* "propose_drop")
            (display "HEAL name=pd:law reason=score")
            (newline)
            (display "DROP reason=")
            (display *drop-reason*)
            (display " score=")
            (display (pad:nstr trial))
            (newline)
            (display "PROPOSE tag=propose_drop")
            (newline)
            (list #f "propose_drop"))))))

(define (pd:propose-body! body)
  (let ((clean (pd:clean body)))
    (let ((r (pd:apply-body! clean "propose")))
      (cond
        ((and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) "swap"))
         (pd:propose-score! clean))
        ((and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) "probe"))
         (set! *propose-tag* "propose_heal")
         (display "PROPOSE tag=propose_heal")
         (newline)
         (list #f "propose_heal"))
        (#t
         (set! *propose-tag* "propose_reject")
         (display "PROPOSE tag=propose_reject")
         (newline)
         (list #f "propose_reject"))))))

(define (pd:propose-file! path)
  (pd:sync-main!)
  (display "PROPOSE file=")
  (display path)
  (newline)
  (let ((body (try (read-file path) (catch (e) #f))))
    (if (not (string? body))
        (begin
          (pd:gate-reject! "read" "")
          (set! *propose-tag* "propose_reject")
          (display "PROPOSE tag=propose_reject")
          (newline)
          (list #f "propose_reject"))
        (pd:propose-body! body))))

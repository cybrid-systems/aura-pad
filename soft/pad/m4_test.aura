;; M4 Soft tests: two pads, find / replace, record / play, buffer law,
;; macro body gate. Every new token: REJECT paths (kid reason, state
;; untouched, no key spent, one reject counted) and a success path. Then a
;; plan table re-computed by scripts/m4_model.py --check,
;; fixture scores, law scores, text helpers, kid words, M3/M3.5 compat.
;; Prints T lines and ends PAD_M4_TEST_OK. No HTTP, no fibers, no hot slots.
(load "/workspace/aura-pad/soft/pad/buffer.aura")
(load "/workspace/aura-pad/soft/pad/rules.aura")
(load "/workspace/aura-pad/soft/pad/lines.aura")
(load "/workspace/aura-pad/soft/pad/helper.aura")
(load "/workspace/aura-pad/soft/pad/edit.aura")
(load "/workspace/aura-pad/soft/pad/m4.aura")
(load "/workspace/aura-pad/soft/pad/macro.aura")

(define *fail* 0)
(define *checks* 0)
(define law-main *law-main*)
(define law-wrap *law-wrap*)
(define law-big *law-big*)

(define (expect tag got want)
  (set! *checks* (+ *checks* 1))
  (display "T ")
  (display tag)
  (display "=")
  (display (if (number? got) (pad:nstr got) "?"))
  (if (and (number? got) (= got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display (pad:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-str tag got want)
  (set! *checks* (+ *checks* 1))
  (display "T ")
  (display tag)
  (display "=")
  (display (if (string? got) got "?"))
  (if (and (string? got) (string=? got want))
      (display " OK")
      (begin
        (display " WANT=")
        (display want)
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-true tag got)
  (expect-str tag (if got "yes" "no") "yes"))

(define (sv r) (if (string? r) r (pad:ms-view r)))

;; Run one token. A refused token must return the reason, and the player
;; must skip it: same state out, no key spent, one reject counted.
(define (op! tag c m want)
  (let ((r (pad:mop c m)))
    (if (string? r)
        (let ((p (pad:mplay-from m (list c))))
          (expect-str (string-append tag "_SAME") (pad:ms-view (car p)) (pad:ms-view m))
          (expect (string-append tag "_KEYS") (pad:nth p 1) 0)
          (expect (string-append tag "_REJ") (pad:nth p 2) 1)))
    (expect-str tag (sv r) want)
    r))

;; State after a plan (rejects skipped).
(define (after plan law) (car (pad:mplay-from (pad:mstart law) plan)))

(define *m0* (pad:mstart *law-main*))
(define *mw* (pad:mstart *law-wrap*))
(define *tail* " scratch=my.notes|they.had.fun")

(define (find-tests!)
  (op! "FIND" "find:cat" *m0*
       (string-append "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0" *tail* " find=cat rec=off macro=0"))
  (op! "FIND_EMPTY" "find:" *m0* "empty-needle")
  (op! "FIND_CAPS" "find:Cat" *m0* "not-print")
  (op! "FIND_COW" "find:cow" *m0* "not-found")
  (op! "FIND_AT_POINT" "find:a" *m0*
       (string-append "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0" *tail* " find=a rec=off macro=0"))
  (op! "FIND_SPACE" "find: ran" *m0*
       (string-append "story:a.cat|the.cat.ran@1,7 kill=none mark=none undo=0" *tail* " find=.ran rec=off macro=0"))
  (op! "NEXT_NONE" "find-next" *m0* "empty-needle")
  (let ((f (pad:mop "find:cat" *m0*)))
    (let ((n (op! "NEXT" "find-next" f
                  (string-append "story:a.cat|the.cat.ran@1,4 kill=none mark=none undo=0" *tail* " find=cat rec=off macro=0"))))
      (op! "NEXT_END" "find-next" n "not-found")))
  (let ((f (pad:mop "find:cat" *mw*)))
    (op! "NEXT_WRAP" "find-next" (pad:mop "find-next" f)
         (string-append "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0" *tail* " find=cat rec=off macro=0")))
  (op! "FIND_NOWRAP" "find:cat" (pad:mop "eob" *m0*) "not-found")
  (op! "FIND_WRAP" "find:cat" (pad:mop "eob" *mw*)
       (string-append "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0" *tail* " find=cat rec=off macro=0"))
  0)

(define (replace-tests!)
  (op! "REP_NONEEDLE" "replace:dog" *m0* "empty-needle")
  (let ((f (pad:mop "find:cat" *m0*)))
    (let ((r (op! "REP" "replace:dog" f
                  (string-append "story:a.dog|the.cat.ran@0,5 kill=none mark=none undo=1" *tail* " find=cat rec=off macro=0"))))
      (op! "REP_GONE" "replace:dog" r "not-found")
      (op! "REP_UNDO" "undo" r
           (string-append "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0" *tail* " find=cat rec=off macro=0")))
    (op! "REP_MOVED" "replace:dog" (pad:mop "right" f) "not-found")
    (op! "REP_MEAN" "replace:dumb" f "not-kind")
    (op! "REP_CAPS" "replace:Dog" f "not-print")
    (op! "REP_EMPTY_NEW" "replace:" f
         (string-append "story:a.|the.cat.ran@0,2 kill=none mark=none undo=1" *tail* " find=cat rec=off macro=0")))
  (op! "REP_FULL" "replace:far far" (pad:mop "find:ran" *m0*) "need-space")
  ;; replace clears the mark (it is a text change)
  (let ((m (pad:mop "set-mark" (pad:mop "find:cat" *m0*))))
    (expect-str "REP_MARK" (sv (pad:mop "kill-region" (pad:mop "replace:dog" m))) "no-mark"))
  0)

(define (all-tests!)
  (op! "ALL" "replace-all:cat=dog" *m0*
       (string-append "story:a.dog|the.dog.ran@0,0 kill=none mark=none undo=1" *tail* " find=none rec=off macro=0"))
  (op! "ALL_NOEQ" "replace-all:cat" *m0* "not-a-key")
  (op! "ALL_EMPTY" "replace-all:=dog" *m0* "empty-needle")
  (op! "ALL_CAPS" "replace-all:cat=DOG" *m0* "not-print")
  (op! "ALL_MEAN" "replace-all:cat=idiot" *m0* "not-kind")
  (op! "ALL_COW" "replace-all:cow=dog" *m0* "not-found")
  (op! "ALL_MANY" "replace-all:a=o" *m0* "too-many")
  (op! "ALL_BIG" "replace-all:a=o" (pad:mstart *law-big*)
       (string-append "story:o.cot|the.cot.ron@0,0 kill=none mark=none undo=1" *tail* " find=none rec=off macro=0"))
  (op! "ALL_FULL" "replace-all:ran=rocket" *m0* "need-space")
  (op! "ALL_DELETE" "replace-all:the =" *m0*
       (string-append "story:a.cat|cat.ran@0,0 kill=none mark=none undo=1" *tail* " find=none rec=off macro=0"))
  ;; point is clamped when its line gets shorter
  (op! "ALL_CLAMP" "replace-all:cat ran=x" (pad:mop "eob" *m0*)
       (string-append "story:a.cat|the.x@1,5 kill=none mark=none undo=1" *tail* " find=none rec=off macro=0"))
  ;; replace-all only looks at the current pad
  (op! "ALL_OTHER_PAD" "replace-all:cat=dog" (pad:mop "switch:scratch" *m0*) "not-found")
  0)

(define (switch-tests!)
  (let ((s (op! "SWITCH" "switch:scratch" *m0*
                "scratch:my.notes|they.had.fun@0,0 kill=none mark=none undo=0 story=a.cat|the.cat.ran find=none rec=off macro=0")))
    (op! "SWITCH_SAME" "switch:scratch" s "already-there")
    (op! "SWITCH_BACK" "switch:story" s (pad:ms-view *m0*)))
  (op! "SWITCH_SAME_STORY" "switch:story" *m0* "already-there")
  (op! "SWITCH_ZOO" "switch:zoo" *m0* "no-buffer")
  (op! "SWITCH_EMPTY" "switch:" *m0* "no-buffer")
  ;; each pad keeps its own point
  (let ((m (after (list "end" "switch:scratch" "eob" "switch:story") *law-main*)))
    (expect "PAD_POINT_STORY" (pad:es-col (pad:ms-st m)) 5)
    (expect "PAD_POINT_SCRATCH" (pad:es-col (pad:buf-get (pad:ms-bufs m) "scratch")) 12))
  ;; the kill text travels with you
  (let ((m (after (list "switch:scratch" "next-line" "kill-line" "switch:story") *law-main*)))
    (expect-str "KILL_TRAVELS" (pad:kill-str (pad:es-kill (pad:ms-st m))) "they.had.fun"))
  ;; undo is per pad
  (let ((m (after (list "type:x" "switch:scratch") *law-main*)))
    (op! "UNDO_PER_PAD" "undo" m "nothing-to-undo"))
  0)

(define (macro-tests!)
  (op! "REC" "rec" *m0*
       (string-append "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0" *tail* " find=none rec=on macro=0"))
  (let ((r (pad:mop "rec" *m0*)))
    (op! "REC_TWICE" "rec" r "busy-recording")
    (op! "STOP_EMPTY" "stop" r "empty-macro")
    (op! "PLAY_BUSY" "play" r "busy-recording")
    (let ((r2 (pad:mop "right" r)))
      (expect "REC_ONE" (length (pad:ms-macro r2)) 1)
      (expect "REC_SKIPS_REJECT" (length (pad:ms-macro (car (pad:mplay-from r2 (list "jump"))))) 1)
      (let ((s (op! "STOP" "stop" r2
                    (string-append "story:a.cat|the.cat.ran@0,1 kill=none mark=none undo=0" *tail* " find=none rec=off macro=1"))))
        (op! "PLAY" "play" s
             (string-append "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0" *tail* " find=none rec=off macro=1"))
        ;; play costs one key; inner refusals count as rejects
        (let ((p (pad:mplay-from (pad:mop "eob" s) (list "play"))))
          (expect "PLAY_INNER_KEYS" (pad:nth p 1) 1)
          (expect "PLAY_INNER_REJ" (pad:nth p 2) 1)
          (expect-str "PLAY_INNER_WHY" (pad:nth (pad:mstep "play" (pad:mop "eob" s)) 4) "too-far")))))
  (op! "STOP_NONE" "stop" *m0* "not-recording")
  (op! "PLAY_NONE" "play" *m0* "no-macro")
  (let ((full (after (list "rec" "end" "home" "end" "home" "end" "home"
                           "end" "home" "end" "home" "end" "home") *law-main*)))
    (expect "MACRO_LEN" (length (pad:ms-macro full)) 12)
    (op! "MACRO_FULL" "end" full "macro-full")
    (op! "MACRO_FULL_STOP" "stop" full
         (string-append "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0" *tail* " find=none rec=off macro=12")))
  ;; a recorded find-next + replace replays on the next spot
  (let ((m (after (list "find:cat" "rec" "replace:dog" "find-next" "stop" "play") *law-main*)))
    (expect-str "PLAY_REPLACE" (pad:dot-text (pad:es-L (pad:ms-st m))) "a.dog|the.dog.ran"))
  0)

;; Re-computed by scripts/m4_model.py --check (views, rejects, FX_/LAW_ numbers).
(define (row name law plan view rej) (list name law plan view rej))
(define *plans*
  (list
        (row "find_ok" law-main (list "find:cat")
             "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 0)
        (row "find_empty" law-main (list "find:")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "find_missing" law-main (list "find:cow")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "find_caps" law-main (list "find:Cat")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "find_line2" law-main (list "find:ran")
             "story:a.cat|the.cat.ran@1,8 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=ran rec=off macro=0" 0)
        (row "find_next" law-main (list "find:cat" "find-next")
             "story:a.cat|the.cat.ran@1,4 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 0)
        (row "find_next_end" law-main (list "find:cat" "find-next" "find-next")
             "story:a.cat|the.cat.ran@1,4 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 1)
        (row "find_next_none" law-main (list "find-next")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "find_nowrap" law-main (list "eob" "find:cat")
             "story:a.cat|the.cat.ran@1,11 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "find_wrap" law-wrap (list "eob" "find:cat")
             "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 0)
        (row "next_wrap" law-wrap (list "find:cat" "find-next" "find-next")
             "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 0)
        (row "replace_one" law-main (list "find:cat" "replace:dog")
             "story:a.dog|the.cat.ran@0,5 kill=none mark=none undo=1 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 0)
        (row "replace_none" law-main (list "replace:dog")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "replace_moved" law-main (list "find:cat" "right" "replace:dog")
             "story:a.cat|the.cat.ran@0,3 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 1)
        (row "replace_mean" law-main (list "find:cat" "replace:dumb")
             "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 1)
        (row "replace_full" law-main (list "find:ran" "replace:far far")
             "story:a.cat|the.cat.ran@1,8 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=ran rec=off macro=0" 1)
        (row "replace_undo" law-main (list "find:cat" "replace:dog" "undo")
             "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 0)
        (row "replace_two" law-main (list "find:cat" "replace:dog" "find-next" "replace:dog")
             "story:a.dog|the.dog.ran@1,7 kill=none mark=none undo=2 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 0)
        (row "all_ok" law-main (list "replace-all:cat=dog")
             "story:a.dog|the.dog.ran@0,0 kill=none mark=none undo=1 scratch=my.notes|they.had.fun find=none rec=off macro=0" 0)
        (row "all_empty" law-main (list "replace-all:=dog")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "all_noeq" law-main (list "replace-all:cat")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "all_missing" law-main (list "replace-all:cow=dog")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "all_many" law-main (list "replace-all:a=o")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "all_big" law-big (list "replace-all:a=o")
             "story:o.cot|the.cot.ron@0,0 kill=none mark=none undo=1 scratch=my.notes|they.had.fun find=none rec=off macro=0" 0)
        (row "all_full" law-main (list "replace-all:ran=rocket")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "all_mean" law-main (list "replace-all:cat=idiot")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "all_undo" law-main (list "replace-all:cat=dog" "undo")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 0)
        (row "switch_ok" law-main (list "switch:scratch")
             "scratch:my.notes|they.had.fun@0,0 kill=none mark=none undo=0 story=a.cat|the.cat.ran find=none rec=off macro=0" 0)
        (row "switch_same" law-main (list "switch:story")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "switch_zoo" law-main (list "switch:zoo")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "switch_back" law-main (list "switch:scratch" "eob" "switch:story")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 0)
        (row "switch_kill" law-main (list "switch:scratch" "kill-line" "switch:story" "yank")
             "story:a.cat|the.cat.ran@0,0 kill=my.notes mark=none undo=0 scratch=|they.had.fun find=none rec=off macro=0" 1)
        (row "switch_yank" law-main (list "switch:scratch" "eob" "set-mark" "left" "left" "left" "copy-region" "switch:story" "end" "yank")
             "story:a.catfun|the.cat.ran@0,8 kill=fun mark=none undo=1 scratch=my.notes|they.had.fun find=none rec=off macro=0" 0)
        (row "switch_find" law-main (list "find:cat" "switch:scratch" "find-next")
             "scratch:my.notes|they.had.fun@0,0 kill=none mark=none undo=0 story=a.cat|the.cat.ran find=cat rec=off macro=0" 1)
        (row "rec_play" law-main (list "rec" "type:ab" "stop" "play")
             "story:ababa.cat|the.cat.ran@0,4 kill=none mark=none undo=4 scratch=my.notes|they.had.fun find=none rec=off macro=2" 0)
        (row "rec_twice" law-main (list "rec" "rec")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=on macro=0" 1)
        (row "stop_none" law-main (list "stop")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "stop_empty" law-main (list "rec" "stop")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=on macro=0" 1)
        (row "play_none" law-main (list "play")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 1)
        (row "play_busy" law-main (list "rec" "right" "play")
             "story:a.cat|the.cat.ran@0,1 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=on macro=1" 1)
        (row "rec_reject" law-main (list "rec" "left" "right" "stop" "play")
             "story:a.cat|the.cat.ran@0,2 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=1" 1)
        (row "rec_full" law-main (list "rec" "end" "home" "end" "home" "end" "home" "end" "home" "end" "home" "end" "home" "end" "home" "stop")
             "story:a.cat|the.cat.ran@0,0 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=12" 2)
        (row "play_oops" law-main (list "find:cat" "rec" "replace:dog" "find-next" "stop" "play")
             "story:a.dog|the.dog.ran@1,7 kill=none mark=none undo=2 scratch=my.notes|they.had.fun find=cat rec=off macro=2" 1)
        (row "play_switch" law-main (list "rec" "switch:scratch" "stop" "play")
             "scratch:my.notes|they.had.fun@0,0 kill=none mark=none undo=0 story=a.cat|the.cat.ran find=none rec=off macro=1" 1)
        (row "law_main" law-main (list "replace-all:a=o" "eob" "find:cat" "replace:dog" "find-next" "replace:dog")
             "story:a.cat|the.cat.ran@1,11 kill=none mark=none undo=0 scratch=my.notes|they.had.fun find=none rec=off macro=0" 5)
        (row "law_wrap" law-wrap (list "replace-all:a=o" "eob" "find:cat" "replace:dog" "find-next" "replace:dog")
             "story:a.dog|the.dog.ran@1,7 kill=none mark=none undo=2 scratch=my.notes|they.had.fun find=cat rec=off macro=0" 1)
        (row "law_big" law-big (list "replace-all:a=o" "eob" "find:cat" "replace:dog" "find-next" "replace:dog")
             "story:o.cot|the.cot.ron@1,11 kill=none mark=none undo=1 scratch=my.notes|they.had.fun find=none rec=off macro=0" 4)))

(define (plan-tests!)
  (let loop ((xs *plans*) (n 0))
    (if (null? xs)
        (expect "PLAN_COUNT" n 47)
        (let* ((r (car xs))
               (p (pad:mplay-from (pad:mstart (pad:nth r 1)) (pad:nth r 2))))
          (expect-str (string-append "PLAN_" (pad:nth r 0)) (pad:ms-view (car p)) (pad:nth r 3))
          (expect (string-append "PLAN_" (pad:nth r 0) "_REJ") (pad:nth p 2) (pad:nth r 4))
          (loop (cdr xs) (+ n 1))))))

(define *fx* "/workspace/aura-pad/soft/pad/fixtures/m4/")

(define (fixture-plan name)
  (let* ((body (pd:clean (read-file (string-append *fx* name))))
         (sc (set-code (string-append "(define pd:m4-probe " body ")\n"))))
    (eval-current)
    (pd:m4-probe)))

(define (fx-score name) (pad:m-score (pad:msim (fixture-plan name) *law-wrap* "test" 0)))

(define (helper-tests!)
  (expect-true "MATCH_AT" (pad:match-at? (pad:codes "the cat") (pad:codes "cat") 4))
  (expect-true "MATCH_AT_NO" (not (pad:match-at? (pad:codes "the cat") (pad:codes "cat") 5)))
  (expect "FIND_IN" (pad:find-in (pad:codes "a cat cat") (pad:codes "cat") 3) 6)
  (expect "FIND_IN_NONE" (pad:find-in (pad:codes "a cat") (pad:codes "dog") 0) -1)
  (expect "COUNT_IN" (pad:count-in (pad:codes "aaaa") (pad:codes "aa")) 2)
  (expect "COUNT_ALL" (pad:count-all *story0* (pad:codes "a")) 4)
  (expect-str "REPLACE_IN" (pad:line-text (pad:replace-in (pad:codes "aaa") (pad:codes "a") (pad:codes "bb"))) "bbbbbb")
  (expect "SEARCH_NOWRAP" (length (pad:search *story0* (pad:codes "cat") 1 5 0)) 0)
  (expect "SEARCH_WRAP" (car (cdr (pad:search *story0* (pad:codes "cat") 1 5 1))) 2)
  (expect "SPLIT_NONE" (length (pad:split-rep "cat")) 0)
  (expect-str "SPLIT_NEW" (car (cdr (cdr (pad:split-rep "cat=dog")))) "dog")
  (expect-true "PRINTABLE" (pad:printable? (pad:codes "a b")))
  (expect-true "PRINTABLE_NO" (not (pad:printable? (pad:codes "a-b"))))
  (expect-str "MEAN" (pad:mean-word "you are dumb") "dumb")
  (expect-str "MEAN_NONE" (pad:mean-word "you are kind") "")
  (expect-str "LAW_STR" (pad:law-str *law-wrap*) "wrap-3")
  0)

(define (kid-tests!)
  (let loop ((rs (list "empty-needle" "not-found" "too-many" "not-kind" "no-buffer"
                       "busy-recording" "not-recording" "empty-macro" "no-macro"
                       "macro-full" "already-there" "nothing-to-undo"))
             (n 0))
    (if (null? rs)
        (expect "SAY_KNOWN" n 12)
        (loop (cdr rs)
              (if (string=? (pad:kid-say (car rs)) "the gate said no") n (+ n 1)))))
  (expect-str "SAY_NOT_FOUND" (pad:kid-say "not-found") "could not find that word")
  (expect-str "SAY_TOO_MANY" (pad:kid-say "too-many") "that word is in too many spots")
  (expect-str "SAY_KIND" (pad:kid-say "not-kind") "let us use kind words")
  (pad:mreject! 1 "find:cow" "not-found" "story" "test")
  0)

(define (score-tests!)
  (expect "START_DIST" (pad:mdist (pad:mstart *law-main*)) 19)
  (expect "START_SCORE" (pad:m-score (pad:msim (list) *law-main* "test" 0)) 3)
  (expect "FX_MAIN" (fx-score "main.lambda") 30)
  (expect "FX_OOPS" (fx-score "oops.lambda") 18)
  (expect "FX_REPLAY" (fx-score "replay.lambda") 44)
  (expect "FX_SMART" (fx-score "smart.lambda") 51)
  (expect "FX_TIE" (fx-score "tie.lambda") 51)
  ;; ugly.lambda's plan, built in Soft: on Soft 18b48dc..0ba8690 a workspace
  ;; #t comes back as 1 (out/newaura/repro/bool_ws.aura), so the fixture
  ;; value is checked through the same list made here.
  (expect-str "FX_UGLY" (pad:plan-check (list "find:cat" #t "play")) "bad-token")
  (let ((keys (list "replace-all:a=o" "eob" "find:cat" "replace:dog" "find-next" "replace:dog")))
    (expect "LAW_MAIN_SCORE" (pad:m-score (pad:msim keys *law-main* "test" 0)) -8)
    (expect "LAW_WRAP_SCORE" (pad:m-score (pad:msim keys *law-wrap* "test" 0)) 14)
    (expect "LAW_BIG_SCORE" (pad:m-score (pad:msim keys *law-big* "test" 0)) -7))
  (expect "NOT_PLAN" (pad:mscore-plan "play") -999)
  ;; body gate (no slot touched)
  (expect-str "BODY_OK" (pd:macro-body-why "(lambda () (list \"play\"))") "")
  (expect-str "BODY_SET" (pd:macro-body-why "(lambda () (set! x 1))") "gate")
  (expect-str "BODY_SLOT" (pd:macro-body-why "(lambda () (pd:mshadow))") "gate")
  (expect-str "BODY_WORLD" (pd:macro-body-why "(lambda () (list *m4-score*))") "gate")
  (expect-str "BODY_DEFINE" (pd:macro-body-why "(lambda () (define y 2))") "gate")
  (expect-str "BODY_MEAN" (pd:macro-body-why "(lambda () (list \"type:i hate you\"))") "kind")
  (expect-str "BODY_SHORT" (pd:macro-body-why "(lambda)") "gate")
  (expect-str "BODY_NOT_LAMBDA" (pd:macro-body-why "(list \"play\" \"play\")") "gate")
  ;; M3 / M3.5 numbers unchanged
  (expect "M3_MAIN" (pad:score-plan (list "kill-line" "type:hi" "open-line" "next-line" "type:au")) 27)
  (expect "M35_BEST" (pad:escore-plan (list "kill-line" "type:hi" "open-line" "next-line" "indent"
                                            "type:aura" "open-line" "next-line" "type:pad")) 45)
  ;; mstamp writes the M4 world and prints TAPE + SCORE
  (set! *m4-law* *law-wrap*)
  (expect "STAMP" (pad:mstamp! (fixture-plan "smart.lambda") "test") 51)
  (expect-str "STAMP_STORY" (pad:dot-text (pad:es-L (pad:buf-get (pad:ms-bufs *m4-state*) "story")))
              "a.dog|the.dog.ran|they.had.fun")
  0)

(define (main)
  (display "DIALECT=live-soft-editor-pad-m4-test")
  (newline)
  (find-tests!)
  (replace-tests!)
  (all-tests!)
  (switch-tests!)
  (macro-tests!)
  (plan-tests!)
  (helper-tests!)
  (kid-tests!)
  (score-tests!)
  (display "TESTS checks=")
  (display (number->string *checks*))
  (display " fail=")
  (display (number->string *fail*))
  (newline)
  (if (= *fail* 0)
      (display "PAD_M4_TEST_OK\n")
      (display "PAD_M4_TEST_FAIL\n")))

(main)

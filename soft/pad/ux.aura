;; Sentence line. The flag chooses the frame and, when it is on, the keys.
;; Soft reserved: never bind quote.

(define (pad:ux-on?)
  (let ((v (getenv "PAD_SENTENCE")))
    (and (string? v) (string=? v "1"))))

;; Words typed on the sentence line. Page focus is where letters land
;; until Tab. "line" is the sentence. Arrows move the page either way.
(define *ux-line* "")
(define *ux-focus* "page")
(define *ux-utf* (list))

(define (pad:ux-ends? name suf)
  (let ((n (string-length name))
        (m (string-length suf)))
    (and (>= n m)
         (string=? (substring name (- n m) n) suf))))

(define (pad:ux-kind name)
  (if (or (pad:ux-ends? name ".story") (pad:ux-ends? name ".txt"))
      "story"
      "aura"))

;; File frame only. No file keeps today's legend and SAY.
(define (pad:ux-chrome!)
  (if (and (pad:ux-on?) *pf-on*)
      (begin
        (set! *pl-title*
              (string-append *pf-name* "  " (pad:ux-kind *pf-name*) "  new"))
        (set! *view-legend* (string-append "> " *ux-line*))
        (if *pf-ro* 0 (set! *pl-say* "not checked yet"))
        0)
      0))

;; Page the empty sentence checks. A test may set these. The editor
;; buffer is used when the test did not.
(define *ux-lines* (list))
(define *ux-point* 0)
;; Tokens for the sentence under the cursor. The same line list is
;; reused until an edit replaces it, so an arrow does not scan again.
(define *ux-page* #f)
(define *ux-toks* (list))
;; Byte span of the sentence already on SAY. An arrow inside it
;; keeps that sentence. A different column scans once.
(define *ux-say-a* -1)
(define *ux-say-b* -1)
(define *ux-say-s* "")

(define (pad:ux-toks L)
  (if (eq? L *ux-page*)
      *ux-toks*
      (begin
        (set! *ux-page* L)
        (set! *ux-say-a* -1)
        (set! *ux-say-b* -1)
        (set! *ux-toks* (pad:hl-tokens (pad:v-src L)))
        *ux-toks*)))

(define (pad:ux-nth xs i)
  (if (= i 0) (car xs) (pad:ux-nth (cdr xs) (- i 1))))

(define (pad:ux-page)
  (if (pair? *ux-lines*)
      *ux-lines*
      (try (pad:es-L *pl-st*) (catch (e) (list)))))

;; Empty sentence is check. where reads the cache. save, open, and quit
;; call the file pad. They are not M-x words. A shorter word is not where.
(define (pad:say-intent line)
  (let ((n (string-length line)))
    (cond
      ((string=? line "") (list "check" ""))
      ((string=? line "save") (list "save" ""))
      ((string=? line "quit") (list "quit" ""))
      ((string=? line "where") (list "where" ""))
      ((and (> n 6) (string=? (substring line 0 6) "where "))
       (list "where" (substring line 6 n)))
      ((and (> n 5) (string=? (substring line 0 5) "open "))
       (list "open" (substring line 5 n)))
      ((and (> n 6) (string=? (substring line 0 6) "apply "))
       (list "apply" (substring line 6 n)))
      ((string=? line "who") (list "who" ""))
      (#t (list "later" line)))))

;; Directory of the open file, with the trailing slash.
(define (pad:ux-dir path)
  (let ((n (string-length path))
        (m (string-length (pad:pf-base path))))
    (if (= n m)
        ""
        (substring path 0 (- n m)))))

(define (pad:ux-file-save!)
  (pad:pf-save!)
  (set! *ux-line* "")
  *pl-say*)

(define (pad:ux-file-open! rel)
  (pad:pf-open! (string-append (pad:ux-dir *pf-path*) rel))
  (set! *ux-line* "")
  (set! *ux-focus* "page")
  (set! *ux-point* 0)
  (if *read-ready*
      (begin
        (set! *read-status* "none")
        (set! *read-mean* (list)))
      0)
  (pad:ux-chrome!)
  *pl-say*)

(define (pad:ux-file-quit!)
  (let ((armed *pf-quit*))
    (set! *pf-quit* #f)
    (set! *ux-line* "")
    (pad:ux-legend!)
    (pad:pf-quit! armed)))

(define (pad:ux-find name rows)
  (cond
    ((null? rows) #f)
    ((string=? name (car (car rows))) (car rows))
    (#t (pad:ux-find name (cdr rows)))))

(define (pad:ux-on-line line rows)
  (cond
    ((null? rows) #f)
    ((= line (pad:ux-nth (car rows) 2)) (car rows))
    (#t (pad:ux-on-line line (cdr rows)))))

(define (pad:ux-hit? p pts)
  (cond
    ((null? pts) #f)
    ((and (number? (car pts)) (= p (car pts))) #t)
    (#t (pad:ux-hit? p (cdr pts)))))

;; True when point sits on the birth token, not only on its first column.
(define (pad:ux-at-def? p name L row)
  (let ((tok (pad:sym-tok-in (pad:ux-toks L) p)))
    (and tok
         (string=? (pad:ux-nth tok 3) name)
         (pad:ux-hit? (cadr tok) (pad:ux-nth row 5)))))

;; Cache only. Does not call define-lookup and does not set-code.
(define (pad:ux-say-of row at-def)
  (let ((name (car row))
        (line (number->string (pad:ux-nth row 2)))
        (uses (number->string (pad:ux-nth row 4))))
    (if at-def
        (string-append name " born line " line ", used " uses)
        (string-append name " used here, born line " line))))

(define (pad:ux-say-slow L p rows)
  (let ((tok (pad:sym-tok-in (pad:ux-toks L) p)))
    (if tok
        (begin (set! *ux-say-a* (cadr tok)) (set! *ux-say-b* (caddr tok)))
        (begin (set! *ux-say-a* p) (set! *ux-say-b* (+ p 1))))
    (let ((name (if tok (pad:ux-nth tok 3) ""))
          (line (+ (car (pad:v-linecol L p)) 1)))
      (let ((row (if (string=? name "")
                     (pad:ux-on-line line rows)
                     (let ((hit (pad:ux-find name rows)))
                       (if hit hit (pad:ux-on-line line rows))))))
        (if (not row)
            (begin (set! *ux-say-a* -1) (set! *ux-say-b* -1) *pl-say*)
            (begin
              (set! *pl-say*
                    (pad:ux-say-of row (if (string=? name "")
                                           #t
                                           (and tok
                                                (string=? name (pad:ux-nth tok 3))
                                                (pad:ux-hit? (cadr tok)
                                                              (pad:ux-nth row 5))))))
              (set! *ux-say-s* *pl-say*)
              *pl-say*))))))

(define (pad:ux-say-at)
  (let ((rows *read-mean*)
        (p *ux-point*))
    (if (null? rows)
        *pl-say*
        (if (and (>= p *ux-say-a*) (< p *ux-say-b*) (string=? *pl-say* *ux-say-s*))
            *pl-say*
            (pad:ux-say-slow (pad:ux-page) p rows)))))

(define (pad:ux-arrow! d)
  (set! *ux-point* (+ *ux-point* d))
  (if (< *ux-point* 0) (set! *ux-point* 0) 0)
  (pad:ux-say-at)
  0)

(define (pad:ux-ins xs i ch)
  (cond
    ((null? xs) (list ch))
    ((= i 0) (cons ch xs))
    (#t (cons (car xs) (pad:ux-ins (cdr xs) (- i 1) ch)))))

(define (pad:ux-set-line L i row)
  (if (= i 0)
      (cons row (cdr L))
      (cons (car L) (pad:ux-set-line (cdr L) (- i 1) row))))

;; First edit after a check. The projection changes. set-code does not.
;; query:dirty-nodes is the next check, not this insert.
(define (pad:ux-insert! ch)
  (if (not (and (pad:ux-on?)
                (or (string=? *read-status* "checked")
                    (string=? *read-status* "stale"))))
      0
      (let ((lc (pad:v-linecol *ux-lines* *ux-point*)))
        (set! *ux-lines*
              (pad:ux-set-line *ux-lines* (car lc)
                               (pad:ux-ins (pad:ux-nth *ux-lines* (car lc))
                                           (cadr lc) ch)))
        (set! *ux-point* (+ *ux-point* 1))
        (set! *read-status* "stale")
        (set! *pl-say* "check again to ask aura")
        0)))

(define (pad:ux-check!)
  (if (not *read-ready*)
      (load (string-append *pad-home* "/soft/pad/read.aura"))
      0)
  (if *read-ready*
      (begin
        (if (not *read-done*) (pad:read-load!) 0)
        (pad:read-check! (pad:ux-page))
        (if (string=? *read-status* "checked")
            (if (and (string? *read-report*) (> (string-length *read-report*) 0))
                *pl-say*
                (begin
                  (set! *ux-say-a* -1)
                  (set! *ux-say-b* -1)
                  (pad:ux-toks (pad:ux-page))
                  (pad:ux-say-at)))
            0))
      0))

;; where NAME, or where under the cursor. A checked cache is not checked
;; again. A stale cache is checked once, then the answer comes from the row.
(define (pad:ux-where-say asked)
  (let* ((page (pad:ux-page))
         (src (pad:v-src page))
         (at (pad:sym-at src *ux-point*))
         (nm (if (string=? asked "") at asked)))
    (let ((row (if (string=? nm "") #f (pad:ux-find nm *read-mean*))))
      (if (not row)
          (begin (set! *pl-say* "not a name") *pl-say*)
          (let ((at-def (if (string=? at nm)
                            (pad:ux-at-def? *ux-point* nm page row)
                            #t)))
            (set! *pl-say* (pad:ux-say-of row at-def))
            *pl-say*)))))

(define (pad:ux-where! asked)
  (if (string=? *read-status* "checked")
      0
      (pad:ux-check!))
  (set! *ux-line* "")
  (if (string=? *read-status* "checked")
      (pad:ux-where-say asked)
      *pl-say*))

;; load swaps the current workspace program. Bring tx.aura in on a
;; scratch workspace so the root program stays the editor.
(define (pad:ux-current)
  (let ((id (try (workspace :current) (catch (e) #f))))
    (if (number? id) id -1)))

(define (pad:ux-load-tx!)
  (let ((c (try (workspace :create "tx-load") (catch (e) #f))))
    (if (not (number? c))
        #f
        (begin
          (try (workspace :switch c) (catch (e) #f))
          (let ((ok (if (= (pad:ux-current) c)
                        (try
                          (begin
                            (load (string-append *pad-home*
                                                 "/soft/pad/tx.aura"))
                            #t)
                          (catch (e) #f))
                        #f)))
            (try (workspace :switch 0) (catch (e) #f))
            (try (workspace:delete c) (catch (e) #f))
            ok)))))

(define (pad:ux-tx-ready!)
  (if (try pad:tx-apply! (catch (e) #f))
      #t
      (pad:ux-load-tx!)))

;; Define that starts on the cursor line, or "".
(define (pad:ux-def-walk toks prev prev2 line page)
  (if (null? toks)
      ""
      (let ((t (car toks)))
        (let ((txt (pad:ux-nth t 3)))
          (let ((hit (and (or (string=? (car t) "S")
                              (string=? (car t) "Q")
                              (string=? (car t) "M"))
                          (or (and prev (string=? (car prev) "K")
                                   (string=? (pad:ux-nth prev 3) "define"))
                              (and prev (string=? (car prev) "P")
                                   (string=? (pad:ux-nth prev 3) "(")
                                   prev2 (string=? (car prev2) "K")
                                   (string=? (pad:ux-nth prev2 3) "define"))))))
            (if (and hit (= (car (pad:v-linecol page (cadr t))) line))
                txt
                (pad:ux-def-walk (cdr toks) t prev line page)))))))

(define (pad:ux-who-name)
  (let ((page (pad:ux-page)))
    (if (not (pair? page))
        ""
        (pad:ux-def-walk (pad:hl-tokens (pad:v-src page)) #f #f
                         (car (pad:v-linecol page *ux-point*)) page))))

;; Switching back re-evals this file's defines, which clears the page.
;; Put the page and the cursor back after the engine answers.
(define (pad:ux-who!)
  (set! *ux-line* "")
  (let ((name (pad:ux-who-name)))
    (let ((lines *ux-lines*))
      (let ((point *ux-point*))
        (let ((focus *ux-focus*))
          (let ((say (if (or (string=? name "")
                             (not (try pad:ew-say-name (catch (err) #f))))
                         "nobody has changed this yet"
                         (pad:ew-say-name name))))
            (set! *ux-lines* lines)
            (set! *ux-point* point)
            (set! *ux-focus* focus)
            (set! *pl-say* say)
            say))))))

;; apply NAME reads a fixture in the repo. It does not open the network
;; and it does not call M-x.
(define (pad:ux-apply! name)
  (set! *ux-line* "")
  (if (not (pad:ux-tx-ready!))
      (begin
        (set! *pl-say* "aura cannot change this page yet")
        *pl-say*)
      (let ((r (pad:tx-apply! name)))
        (set! *pl-say* (cadr r))
        *pl-say*)))

;; Empty sentence Enter. Arrows stay on pad:ux-arrow! / pad:ux-say-at.
(define (pad:say-run!)
  (if (not (pad:ux-on?))
      0
      (let ((hit (pad:say-intent *ux-line*)))
        (let ((intent (car hit)))
          (cond
            ((string=? intent "check")
             (begin
               (pad:ux-check!)
               (cond
                 ((and (string=? *read-status* "checked")
                       (string? *read-report*)
                       (> (string-length *read-report*) 0))
                  *pl-say*)
                 ((string=? *read-status* "checked") (pad:ux-say-at))
                 ((string=? *pl-say*
                            "aura did not check this file: it loads other code")
                  *pl-say*)
                 (#t (set! *pl-say* "aura could not read this page, keep typing")))
               *pl-say*))
            ((string=? intent "where") (pad:ux-where! (cadr hit)))
            ((string=? intent "save") (pad:ux-file-save!))
            ((string=? intent "open") (pad:ux-file-open! (cadr hit)))
            ((string=? intent "quit") (pad:ux-file-quit!))
            ((string=? intent "apply") (pad:ux-apply! (cadr hit)))
            ((string=? intent "who") (pad:ux-who!))
            (#t
             (begin
               (set! *pl-say* "aura cannot change this page yet")
               *pl-say*)))))))

(define (pad:ux-legend!)
  (set! *view-legend* (string-append "> " *ux-line*))
  0)

(define (pad:ux-draw!)
  (pad:ux-legend!)
  (pad:play-emit!)
  "go")

;; A page edit after a check expires the cache. Arrows do not.
;; *read-ready* is false until read.aura loads, so this does not
;; touch *read-status* on a movement or a first draft.
(define (pad:ux-note-edit!)
  (if *read-ready*
      (if (or (string=? *read-status* "checked")
              (string=? *read-status* "stale"))
          (begin
            (set! *read-status* "stale")
            (set! *pl-say* "check again to ask aura"))
          0)
      0))

;; Page text goes through pad:play-cmd!. A scalar above 126 is one cell.
(define (pad:ux-mark-say! n)
  (set! *pl-say* (string-append "this mark is " (pad:utf-encode (list (list n)))))
  #t)

(define (pad:ux-mark-here!)
  (let* ((st *pl-st*)
         (ln (list-ref (car st) (cadr st)))
         (col (caddr st))
         (n (if (< col (length ln)) (list-ref ln col) 0)))
    (if (and (< col (length ln)) (> n 126))
        (pad:ux-mark-say! n)
        #f)))

(define (pad:ux-edit! cmd)
  (let ((say *pl-say*)
        (r (pad:play-cmd! cmd)))
    (set! *ux-point* (pad:play-point))
    (if (and (string? r) (string=? r "ok"))
        (pad:ux-note-edit!)
        (if (not *read-ready*) (set! *pl-say* say) 0))
    (if (and (string? r) (string=? r "ok") (number? cmd) (> cmd 126))
        (pad:ux-mark-say! cmd)
        0)
    (pad:ux-draw!)
    (if (and (string? r) (string=? r "quit")) "quit" "go")))

(define (pad:ux-move! cmd)
  (let ((say *pl-say*)
        (r (pad:play-cmd! cmd)))
    (set! *ux-point* (pad:play-point))
    (if (and (string? r) (string=? r "ok") (pad:ux-mark-here!))
        0
        (if *read-ready*
            (if (string=? *read-status* "checked") (pad:ux-say-at) 0)
            (if (and (string? r) (string=? r "ok")) 0 (set! *pl-say* say))))
    (pad:ux-draw!)
    "go"))

(define (pad:ux-add! ch)
  (set! *ux-line* (string-append *ux-line* (list->string (list ch))))
  (pad:ux-draw!))

(define (pad:ux-tab!)
  (if (string=? *ux-focus* "page")
      (set! *ux-focus* "line")
      (set! *ux-focus* "page"))
  (pad:ux-draw!))

;; Page: Esc does nothing to SAY. Line: clear a draft, or leave the line.
(define (pad:ux-esc!)
  (if (string=? *ux-focus* "line")
      (if (string=? *ux-line* "")
          (set! *ux-focus* "page")
          (set! *ux-line* ""))
      0)
  (pad:ux-draw!))

(define (pad:ux-enter!)
  (if (string=? *ux-focus* "line")
      (let ((r (pad:say-run!)))
        (if (and (string? r) (string=? r "quit"))
            "quit"
            (pad:ux-draw!)))
      (pad:ux-edit! "enter")))

(define (pad:ux-back!)
  (if (string=? *ux-focus* "line")
      (let ((n (string-length *ux-line*)))
        (if (> n 0)
            (set! *ux-line* (substring *ux-line* 0 (- n 1)))
            0)
        (pad:ux-draw!))
      (pad:ux-edit! "back")))

;; ctrl-x is not a prefix here. SAY stays. *pf-cx* stays clear.
(define (pad:ux-ignore!)
  (set! *pf-cx* #f)
  (pad:ux-draw!))

(define (pad:ux-one! cmd)
  (cond
    ((number? cmd)
     (if (and (>= cmd 32) (<= cmd 126))
         (if (string=? *ux-focus* "line")
             (pad:ux-add! cmd)
             (pad:ux-edit! cmd))
         (pad:ux-ignore!)))
    ((string=? cmd "enter") (pad:ux-enter!))
    ((string=? cmd "back") (pad:ux-back!))
    ((or (string=? cmd "left") (string=? cmd "right")
         (string=? cmd "prev-line") (string=? cmd "next-line")
         (string=? cmd "home") (string=? cmd "end"))
     (pad:ux-move! cmd))
    (#t (pad:ux-ignore!))))

;; One read()'s bytes. A lone 27 is Esc. An arrow is the whole
;; "IN 27 91 N" line, decoded by pad:key-step. Byte 9 never inserts.
(define (pad:ux-feed! bs esc)
  (if (null? bs)
      (begin (set! *pl-esc* esc) "go")
      (pad:ux-take! (car bs) (cdr bs) esc)))

(define (pad:ux-take! b rest esc)
  (if (and (null? esc) (or (= b 9) (= b 26)))
      (begin
        (if (= b 9)
            (pad:ux-tab!)
            (begin
              (set! *pl-say* "aura cannot change this page yet")
              (pad:ux-draw!)))
        (if (null? rest) "go" (pad:ux-feed! rest (list))))
      (let ((step (pad:key-step esc b)))
        (let ((cmd (car step)))
          (if (and (string? cmd) (string=? cmd "pending"))
              (pad:ux-feed! rest (cadr step))
              (begin
                (set! *pl-esc* (list))
                (let ((r (pad:ux-one! cmd)))
                  (if (or (string=? r "quit") (null? rest))
                      r
                      (pad:ux-feed! rest (list))))))))))

;; Bytes 128-255 accumulate until one scalar is complete. A lead stays
;; here and is not passed to pad:play-cmd!. pad:key-step is unchanged.
(define (pad:ux-high? bs)
  (cond
    ((null? bs) #f)
    ((>= (car bs) 128) #t)
    (#t (pad:ux-high? (cdr bs)))))

(define (pad:ux-drop-last xs)
  (reverse (cdr (reverse xs))))

(define (pad:ux-utf-put! n)
  (if (pad:ux-scalar? n)
      (if (string=? *ux-focus* "line")
          (pad:ux-add! (pad:utf-fold n))
          (pad:ux-edit! n))
      (begin
        (set! *pl-say* "not-print")
        (pad:ux-draw!)
        "go")))

(define (pad:ux-utf-go! bs)
  (cond
    ((null? bs) "go")
    ((and (null? *ux-utf*) (not (pad:ux-high? bs)))
     (pad:ux-feed! bs (list)))
    ((and (pair? *ux-utf*) (not (pad:ux-high? bs)))
     (set! *ux-utf* (list))
     (set! *pl-say* "bad utf8")
     (pad:ux-draw!)
     (pad:ux-feed! bs (list)))
    (#t (pad:ux-utf-push! (car bs) (cdr bs)))))

(define (pad:ux-utf-bad! b rest)
  (let ((prev (pad:ux-drop-last *ux-utf*)))
    (set! *ux-utf* (list))
    (set! *pl-say* "bad utf8")
    (pad:ux-draw!)
    (cond
      ((null? prev) (pad:ux-utf-go! rest))
      ((< b 128) (pad:ux-utf-go! (cons b rest)))
      ((> (pad:utf-len b) 0)
       (set! *ux-utf* (list b))
       (pad:ux-utf-go! rest))
      (#t (pad:ux-utf-go! rest)))))

(define (pad:ux-utf-push! b rest)
  (if (and (null? *ux-utf*) (< b 128))
      (let ((r (pad:ux-feed! (list b) (list))))
        (if (and (string? r) (string=? r "quit"))
            "quit"
            (pad:ux-utf-go! rest)))
      (begin
        (set! *ux-utf* (append *ux-utf* (list b)))
        (let ((hit (pad:utf-classify *ux-utf*)))
          (cond
            ((string=? (car hit) "wait") (pad:ux-utf-go! rest))
            ((string=? (car hit) "ok")
             (set! *ux-utf* (list))
             (let ((r (pad:ux-utf-put! (cadr hit))))
               (if (and (string? r) (string=? r "quit"))
                   "quit"
                   (pad:ux-utf-go! rest))))
            (#t (pad:ux-utf-bad! b rest)))))))

;; Scripted hjkl move the page. They are not letters on the sentence.
(define (pad:ux-word! w)
  (cond
    ((string=? w "h") (pad:ux-move! "left"))
    ((string=? w "j") (pad:ux-move! "next-line"))
    ((string=? w "k") (pad:ux-move! "prev-line"))
    ((string=? w "l") (pad:ux-move! "right"))
    ((or (string=? w "left") (string=? w "right")
         (string=? w "home") (string=? w "end")
         (string=? w "prev-line") (string=? w "next-line"))
     (pad:ux-move! w))
    ((string=? w "enter") (pad:ux-enter!))
    ((string=? w "back") (pad:ux-back!))
    (#t (pad:play-step! (string-append "KEY " w)))))

(define (pad:ux-key! line)
  (cond
    ((string=? line "QUIT") "quit")
    ((and (string-prefix? line "KEY ") (> (string-length line) 4))
     (pad:ux-word! (substring line 4 (string-length line))))
    ((string-prefix? line "IN ")
     (let ((bs (pad:pi-parse line)))
       (if (not bs)
           (begin (pad:play-reject! "unknown") (pad:ux-draw!))
           (if (and (null? *pl-esc*)
                    (or (pair? *ux-utf*) (pad:ux-high? bs)))
               (pad:ux-utf-go! bs)
               (if (and (null? *pl-esc*) (null? (cdr bs)) (= (car bs) 27))
                   (pad:ux-esc!)
                   (pad:ux-feed! bs *pl-esc*))))))
    (#t (pad:play-step! line))))
